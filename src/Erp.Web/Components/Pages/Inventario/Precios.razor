@page "/precios"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Inventario
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IProductoPrecioRepository PrecioRepository
@inject IProductoRepository ProductoRepository
@inject IBodegaRepository BodegaRepository

<PageTitle>@L("Precios de productos")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Precios de productos")</h1>
    <p>@L("Mantenimiento de precios por producto, bodega y moneda.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="barra-herramientas">
    <input type="search" placeholder="@L("Buscar por código o descripción")" aria-label="@L("Buscar producto por código o descripción")" @bind="textoBusqueda" @bind:event="oninput" />
    <select @bind="filtroProId" aria-label="@L("Producto")">
        <option value="0">@L("Todos los productos")</option>
        @foreach (var p in ProductosVisibles)
        {
            <option value="@p.ProId">@p.ProCodigo - @p.ProDescripcion</option>
        }
    </select>
    <select @bind="filtroEstado" aria-label="@L("Estado")">
        <option value="A">@L("Vigentes")</option>
        <option value="I">@L("Desactivados")</option>
        <option value="">@L("Todos")</option>
    </select>
    <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />
    <span class="barra-herramientas-separador"></span>
    <BotonIcono Icono="plus" Tooltip="@L("Nuevo precio")" Etiqueta="@L("Nuevo precio")" Variante="primario" OnClick="MostrarFormularioNuevo" />
    <BotonIcono Icono="upload" Tooltip="@L("Importar desde Excel")" Etiqueta="@L("Importar Excel")" OnClick="() => mostrarImportar = !mostrarImportar" />
</div>

@if (mostrarImportar)
{
    <ImportadorExcel Titulo="@L("Importar precios desde Excel")"
                      Columnas="@(new[] { "pro_codigo", "bod_codigo", "mon_codigo", "ppr_precio_unitario_venta", "ppr_descripcion", "ppr_vigencia_desde", "ppr_vigencia_hasta" })"
                      OnImportar="ImportarAsync" />
}

@if (mostrarNuevo)
{
    <EditForm Model="nuevoPrecio" OnValidSubmit="CrearPrecioAsync" class="panel-formulario">
        <DataAnnotationsValidator />
        <ResumenValidacion />
        <div class="campo">
            <label for="precios-precio-proid">@L("Producto")</label>
            <select id="precios-precio-proid" @bind="nuevoPrecio.ProId">
                <option value="0">@L("Seleccione...")</option>
                @foreach (var p in productos)
                {
                    <option value="@p.ProId">@p.ProCodigo - @p.ProDescripcion</option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="precios-precio-bodid">@L("Bodega")</label>
            <select id="precios-precio-bodid" @bind="nuevoPrecio.BodId">
                <option value="0">@L("Seleccione...")</option>
                @foreach (var bod in bodegas)
                {
                    <option value="@bod.BodId">@bod.BodDescripcion</option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="precios-precio-monid">@L("Moneda")</label>
            <select id="precios-precio-monid" @bind="nuevoPrecio.MonId">
                <option value="0">@L("Seleccione...")</option>
                @foreach (var mon in monedas)
                {
                    <option value="@mon.MonId">@mon.MonCodigo</option>
                }
            </select>
        </div>
        <div class="campo"><label for="precios-precio-preciounitarioventa">@L("Precio unitario de venta")</label><InputNumber id="precios-precio-preciounitarioventa" @bind-Value="nuevoPrecio.PrecioUnitarioVenta" step="0.01" /></div>
        <div class="campo"><label for="precios-precio-descripcion">@L("Descripción")</label><InputText id="precios-precio-descripcion" @bind-Value="nuevoPrecio.Descripcion" /></div>
        <div class="campo"><label for="precios-precio-vigenciadesde">@L("Vigencia desde")</label><InputDate id="precios-precio-vigenciadesde" @bind-Value="nuevoPrecio.VigenciaDesde" /></div>
        <div class="campo"><label for="precios-precio-vigenciahasta">@L("Vigencia hasta")</label><InputDate id="precios-precio-vigenciahasta" @bind-Value="nuevoPrecio.VigenciaHasta" /></div>
        <div class="acciones-fila">
            <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario" TipoBoton="submit" />
            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevo = false" />
        </div>
    </EditForm>
}

<table class="tabla-datos">
    <thead>
        <tr><th>@L("Producto")</th><th>@L("Bodega")</th><th>@L("Moneda")</th><th class="num">@L("Precio")</th><th class="col-fecha">@L("Desde")</th><th class="col-fecha">@L("Hasta")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr>
    </thead>
    <tbody>
        @if (!PreciosVisibles.Any())
        {
            <tr><td colspan="8">@L("Sin precios para los filtros seleccionados.")</td></tr>
        }
        @foreach (var p in PreciosVisibles)
        {
            <tr>
                @if (editandoId == p.PprId)
                {
                    <td>@p.ProCodigo - @p.ProDescripcion</td>
                    <td>
                        <select @bind="editBodId" aria-label="@L("Bodega")">
                            @foreach (var bod in bodegas)
                            {
                                <option value="@bod.BodId">@bod.BodDescripcion</option>
                            }
                        </select>
                    </td>
                    <td>@p.MonCodigo</td>
                    <td class="num"><InputNumber @bind-Value="editPrecioUnitarioVenta" step="0.01" aria-label="@L("Precio")" /></td>
                    <td class="col-fecha"><InputDate @bind-Value="editVigenciaDesde" aria-label="@L("Vigencia desde")" /></td>
                    <td class="col-fecha"><InputDate @bind-Value="editVigenciaHasta" aria-label="@L("Vigencia hasta")" /></td>
                    <td class="col-estado">@(p.PprEstado == "A" ? L("Vigente") : L("Desactivado"))</td>
                    <td class="col-acciones">
                        <div class="acciones-fila">
                            <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="GuardarEdicionAsync" />
                            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => editandoId = null" />
                        </div>
                    </td>
                }
                else
                {
                    <td>@p.ProCodigo - @p.ProDescripcion</td>
                    <td>@p.BodDescripcion</td>
                    <td>@p.MonCodigo</td>
                    <td class="num">@p.PprPrecioUnitarioVenta.ToString("N2")</td>
                    <td class="col-fecha">@p.PprVigenciaDesde.ToString("dd/MM/yyyy")</td>
                    <td class="col-fecha">@(p.PprVigenciaHasta?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="col-estado">@(p.PprEstado == "A" ? L("Vigente") : L("Desactivado"))</td>
                    <td class="col-acciones">
                        @if (p.PprEstado == "A")
                        {
                            <div class="acciones-fila">
                                <BotonIcono Icono="pencil" Tooltip="@L("Editar")" OnClick="() => Editar(p)" />
                                <BotonIcono Icono="trash-2" Tooltip="@L("Desactivar precio")" Confirmacion="@L("¿Desactivar el precio?")" Variante="peligro" OnClick="() => EliminarAsync(p)" />
                            </div>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<ProductoPrecio> precios = Array.Empty<ProductoPrecio>();
    private IReadOnlyList<Producto> productos = Array.Empty<Producto>();
    private IReadOnlyList<Bodega> bodegas = Array.Empty<Bodega>();
    private IReadOnlyList<MonedaInventario> monedas = Array.Empty<MonedaInventario>();

    private int filtroProId;
    private string filtroEstado = "A";
    // Búsqueda por código o descripción: filtra la lista de productos y la tabla.
    private string textoBusqueda = "";

    private static bool Coincide(string codigo, string descripcion, string texto) =>
        texto.Length == 0 || codigo.Contains(texto, StringComparison.CurrentCultureIgnoreCase)
        || descripcion.Contains(texto, StringComparison.CurrentCultureIgnoreCase);

    // El producto elegido sigue en la lista aunque no coincida con el texto.
    private IEnumerable<Producto> ProductosVisibles =>
        productos.Where(p => p.ProId == filtroProId || Coincide(p.ProCodigo, p.ProDescripcion, textoBusqueda.Trim()));

    private IEnumerable<ProductoPrecio> PreciosVisibles =>
        precios.Where(p => Coincide(p.ProCodigo, p.ProDescripcion, textoBusqueda.Trim()));
    private bool mostrarNuevo;
    private bool mostrarImportar;
    private string? mensaje;
    private bool esMensajeError;

    private readonly PrecioModelo nuevoPrecio = new();

    private int? editandoId;
    private int editBodId;
    private decimal editPrecioUnitarioVenta;
    private DateTime editVigenciaDesde;
    private DateTime? editVigenciaHasta;

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoRepository.ConsultarAsync(null, null, prtId: null, estado: "A", pagina: 1, tamanioPagina: 500);
        bodegas = await BodegaRepository.ConsultarAsync(sucId: null, estado: "A");
        monedas = await PrecioRepository.ConsultarMonedasAsync();
        await BuscarAsync();
    }

    private async Task<int?> ObtenerUsuIdActualAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var estado = await AuthenticationStateTask;
        return estado.User.ObtenerUsuId();
    }

    private async Task BuscarAsync()
    {
        precios = await PrecioRepository.ConsultarAsync(
            filtroProId == 0 ? null : filtroProId,
            bodId: null,
            string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado);
    }

    private void MostrarFormularioNuevo()
    {
        mensaje = null;
        nuevoPrecio.ProId = 0;
        nuevoPrecio.BodId = 0;
        nuevoPrecio.MonId = 0;
        nuevoPrecio.PrecioUnitarioVenta = 0;
        nuevoPrecio.Descripcion = null;
        nuevoPrecio.VigenciaDesde = DateTime.Today;
        nuevoPrecio.VigenciaHasta = null;
        mostrarNuevo = true;
    }

    private async Task CrearPrecioAsync()
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.InsertarAsync(
                nuevoPrecio.ProId, nuevoPrecio.BodId, nuevoPrecio.MonId, nuevoPrecio.PrecioUnitarioVenta,
                nuevoPrecio.Descripcion, nuevoPrecio.VigenciaDesde, nuevoPrecio.VigenciaHasta, usuId);
            mostrarNuevo = false;
            mensaje = L("Precio creado correctamente.");
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private void Editar(ProductoPrecio precio)
    {
        editandoId = precio.PprId;
        editBodId = precio.BodId;
        editPrecioUnitarioVenta = precio.PprPrecioUnitarioVenta;
        editVigenciaDesde = precio.PprVigenciaDesde;
        editVigenciaHasta = precio.PprVigenciaHasta;
        mensaje = null;
    }

    private async Task GuardarEdicionAsync()
    {
        if (editandoId is null) return;
        try
        {
            var precio = precios.First(p => p.PprId == editandoId.Value);
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.ActualizarAsync(
                editandoId.Value, editBodId, precio.MonId, editPrecioUnitarioVenta,
                precio.PprDescripcion, editVigenciaDesde, editVigenciaHasta, usuId);
            editandoId = null;
            mensaje = L("Cambios guardados.");
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task EliminarAsync(ProductoPrecio precio)
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.EliminarAsync(precio.PprId, usuId);
            mensaje = L("Precio desactivado.");
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task ImportarAsync(IReadOnlyList<Dictionary<string, string>> filas)
    {
        var usuId = await ObtenerUsuIdActualAsync();
        var exitosas = 0;
        var errores = new List<string>();

        foreach (var fila in filas)
        {
            try
            {
                var proCodigo = fila.GetValueOrDefault("pro_codigo", "").Trim();
                var bodCodigo = fila.GetValueOrDefault("bod_codigo", "").Trim();
                var monCodigo = fila.GetValueOrDefault("mon_codigo", "").Trim();
                var descripcion = fila.GetValueOrDefault("ppr_descripcion", "").Trim();

                var producto = productos.FirstOrDefault(p => p.ProCodigo.Equals(proCodigo, StringComparison.OrdinalIgnoreCase))
                    ?? throw new InvalidOperationException($"No existe el producto '{proCodigo}'.");
                var bodega = bodegas.FirstOrDefault(b => b.BodCodigo.Equals(bodCodigo, StringComparison.OrdinalIgnoreCase))
                    ?? throw new InvalidOperationException($"No existe la bodega '{bodCodigo}'.");
                var moneda = monedas.FirstOrDefault(m => m.MonCodigo.Equals(monCodigo, StringComparison.OrdinalIgnoreCase))
                    ?? throw new InvalidOperationException($"No existe la moneda '{monCodigo}'.");

                var precio = decimal.Parse(fila.GetValueOrDefault("ppr_precio_unitario_venta", "0"), System.Globalization.CultureInfo.InvariantCulture);
                var vigenciaDesde = DateTime.Parse(fila.GetValueOrDefault("ppr_vigencia_desde", ""), System.Globalization.CultureInfo.InvariantCulture);
                var vigenciaHastaTexto = fila.GetValueOrDefault("ppr_vigencia_hasta", "");
                DateTime? vigenciaHasta = string.IsNullOrWhiteSpace(vigenciaHastaTexto)
                    ? null
                    : DateTime.Parse(vigenciaHastaTexto, System.Globalization.CultureInfo.InvariantCulture);

                await PrecioRepository.InsertarAsync(producto.ProId, bodega.BodId, moneda.MonId, precio,
                    string.IsNullOrWhiteSpace(descripcion) ? null : descripcion, vigenciaDesde, vigenciaHasta, usuId);
                exitosas++;
            }
            catch (Exception ex)
            {
                errores.Add(MensajesError.Traducir(ex));
            }
        }

        mensaje = errores.Count == 0
            ? L("Se importaron {0} precios correctamente.", exitosas)
            : L("Se importaron {0} de {1}. Errores: {2}", exitosas, filas.Count, string.Join(" | ", errores.Take(5)));
        esMensajeError = errores.Count > 0;
        mostrarImportar = false;
        await BuscarAsync();
    }

    private sealed class PrecioModelo
    {
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione un producto")] public int ProId { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione una bodega")] public int BodId { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione una moneda")] public int MonId { get; set; }
        public decimal PrecioUnitarioVenta { get; set; }
        public string? Descripcion { get; set; }
        public DateTime VigenciaDesde { get; set; } = DateTime.Today;
        public DateTime? VigenciaHasta { get; set; }
    }
}
