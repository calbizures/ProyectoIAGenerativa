@page "/productos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Inventario
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IProductoRepository ProductoRepository
@inject IProductoCaracteristicaRepository CaracteristicaRepository
@inject IProductoPrecioRepository PrecioRepository
@inject IBodegaRepository BodegaRepository

<PageTitle>Productos</PageTitle>

<div class="pagina-encabezado">
    <h1>Productos</h1>
    <p>Catálogo de productos y servicios, con sus características, existencias y precios.</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-filtros">
        <input placeholder="Buscar por código" aria-label="Buscar por código" @bind="filtroCodigo" />
        <input placeholder="Buscar por descripción" aria-label="Buscar por descripción" @bind="filtroDescripcion" />
        <select @bind="filtroEstado" aria-label="Estado">
            <option value="A">Activos</option>
            <option value="I">Inactivos</option>
            <option value="">Todos</option>
        </select>
        <BotonIcono Icono="search" Tooltip="Buscar" Etiqueta="Buscar" OnClick="BuscarAsync" />

        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_CREAR">
            <Authorized>
                <BotonIcono Icono="plus" Tooltip="Nuevo producto" Etiqueta="Nuevo producto" Variante="primario" OnClick="MostrarFormularioNuevo" />
            </Authorized>
        </AuthorizeView>
    </div>

    @if (mostrarNuevo)
    {
        <EditForm Model="nuevoProducto" OnValidSubmit="CrearProductoAsync" class="panel-formulario">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label>Código</label><InputText @bind-Value="nuevoProducto.Codigo" /></div>
            <div class="campo"><label>Descripción</label><InputText @bind-Value="nuevoProducto.Descripcion" /></div>
            <div class="campo">
                <label>Tipo de producto</label>
                <select @bind="nuevoProducto.PrtId">
                    <option value="0">Seleccione...</option>
                    @foreach (var tipo in tiposProducto)
                    {
                        <option value="@tipo.PrtId">@tipo.PrtDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label>Clasificación</label>
                <select @bind="nuevoProducto.TipoItem">
                    <option value="B">Bien</option>
                    <option value="S">Servicio</option>
                </select>
            </div>
            <div class="campo campo-checkbox">
                <label><input type="checkbox" @bind="nuevoProducto.ManejaExistencia" /> Maneja existencia</label>
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Guardar" Etiqueta="Guardar" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNuevo = false" />
            </div>
        </EditForm>
    }

    <table class="tabla-datos">
        <thead>
            <tr>
                <th class="col-codigo">Código</th>
                <th>Descripción</th>
                <th class="col-telefono">Tipo</th>
                <th class="num col-estado">Existencia</th>
                <th class="num col-monto">Costo unitario</th>
                <th class="col-estado">Estado</th>
                <th class="col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                <tr class="@(seleccionado?.ProId == p.ProId ? "fila-seleccionada" : "")">
                    <td class="col-codigo">@p.ProCodigo</td>
                    <td>@p.ProDescripcion</td>
                    <td class="col-telefono">@p.PrtDescripcion</td>
                    <td class="num col-estado">@(p.ProManejaExistencia ? p.ProTotalCantidad.ToString("N0") : "—")</td>
                    <td class="num col-monto">@p.ProCostoUnitario.ToString("N2")</td>
                    <td class="col-estado"><span class="estado-badge @(p.ProEstado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(p.ProEstado == "A" ? "Activo" : "Inactivo")</span></td>
                    <td class="col-acciones">
                        <div class="acciones-fila">
                            <BotonIcono Icono="eye" Tooltip="Ver detalle" OnClick="() => SeleccionarAsync(p)" />
                            <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_EDITAR">
                                <Authorized>
                                    @if (p.ProEstado == "A")
                                    {
                                        <BotonIcono Icono="trash-2" Tooltip="Desactivar producto" Variante="peligro" OnClick="() => DesactivarAsync(p)" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (pestanaActiva == "editar" && seleccionado is not null)
{
    <div class="panel-formulario">
        <h2>Editar: @seleccionado.ProDescripcion</h2>
        <EditForm Model="edicionProducto" OnValidSubmit="GuardarEdicionAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label>Código</label><InputText @bind-Value="edicionProducto.Codigo" /></div>
            <div class="campo"><label>Descripción</label><InputText @bind-Value="edicionProducto.Descripcion" /></div>
            <div class="campo">
                <label>Tipo de producto</label>
                <select @bind="edicionProducto.PrtId">
                    @foreach (var tipo in tiposProducto)
                    {
                        <option value="@tipo.PrtId">@tipo.PrtDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label>Clasificación</label>
                <select @bind="edicionProducto.TipoItem">
                    <option value="B">Bien</option>
                    <option value="S">Servicio</option>
                </select>
            </div>
            <div class="campo campo-checkbox">
                <label><input type="checkbox" @bind="edicionProducto.ManejaExistencia" /> Maneja existencia</label>
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Guardar cambios" Etiqueta="Guardar cambios" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="CancelarEdicionAsync" />
            </div>
        </EditForm>
    </div>
}
else if (pestanaActiva == "detalle" && seleccionado is not null)
{
    <div class="panel-detalle">
        <h2>Detalle: @seleccionado.ProDescripcion</h2>

        <div class="campo"><label>Código</label><span class="valor-detalle">@seleccionado.ProCodigo</span></div>
        <div class="campo"><label>Descripción</label><span class="valor-detalle">@seleccionado.ProDescripcion</span></div>
        <div class="campo"><label>Tipo de producto</label><span class="valor-detalle">@seleccionado.PrtDescripcion</span></div>
        <div class="campo"><label>Clasificación</label><span class="valor-detalle">@(seleccionado.ProTipoItem == "B" ? "Bien" : "Servicio")</span></div>
        <div class="campo campo-checkbox"><label>Maneja existencia</label><span class="valor-detalle">@(seleccionado.ProManejaExistencia ? "Sí" : "No")</span></div>
        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_EDITAR">
            <Authorized>
                <div class="acciones-fila">
                    <BotonIcono Icono="pencil" Tooltip="Editar" Etiqueta="Editar" OnClick="IniciarEdicion" />
                </div>
            </Authorized>
        </AuthorizeView>

        <h3>Existencia por bodega</h3>
        <table class="tabla-datos">
            <thead><tr><th>Bodega</th><th class="num">Existencia</th></tr></thead>
            <tbody>
                @if (existenciasPorBodega.Count == 0)
                {
                    <tr><td colspan="2">Sin movimientos registrados.</td></tr>
                }
                @foreach (var existencia in existenciasPorBodega)
                {
                    <tr>
                        <td>@existencia.BodDescripcion</td>
                        <td class="num">@existencia.Existencia.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
else if (pestanaActiva == "caracteristicas" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>Características: @seleccionado.ProDescripcion</h2>
        <div class="barra-herramientas">
            <BotonIcono Icono="plus" Tooltip="Agregar característica" Etiqueta="Agregar característica" Variante="primario" OnClick="() => mostrarNuevaCaracteristica = !mostrarNuevaCaracteristica" />
        </div>
        @if (mostrarNuevaCaracteristica)
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label>Tipo</label>
                    <select @bind="nuevaCaracteristica.PtcId">
                        <option value="0">Seleccione...</option>
                        @foreach (var tipo in tiposCaracteristica)
                        {
                            <option value="@tipo.PtcId">@tipo.PtcDescripcion</option>
                        }
                    </select>
                </div>
                <div class="campo"><label>Valor</label><input @bind="nuevaCaracteristica.Valor" /></div>
                <div class="campo"><label>Descripción</label><input @bind="nuevaCaracteristica.Descripcion" /></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="Guardar característica" Etiqueta="Guardar" Variante="primario" OnClick="CrearCaracteristicaAsync" />
                    <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNuevaCaracteristica = false" />
                </div>
            </div>
        }
        <table class="tabla-datos">
            <thead><tr><th>Tipo</th><th>Valor</th><th>Descripción</th><th class="col-acciones">Acciones</th></tr></thead>
            <tbody>
                @if (caracteristicasProducto.Count == 0)
                {
                    <tr><td colspan="4">Sin características registradas.</td></tr>
                }
                @foreach (var c in caracteristicasProducto)
                {
                    <tr>
                        @if (pcaEditandoId == c.PcaId)
                        {
                            <td>@c.PtcDescripcion</td>
                            <td><input @bind="pcaEditValor" /></td>
                            <td><input @bind="pcaEditDescripcion" /></td>
                            <td>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="Guardar" Variante="primario" OnClick="GuardarCaracteristicaAsync" />
                                    <BotonIcono Icono="x" Tooltip="Cancelar" OnClick="() => pcaEditandoId = null" />
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@c.PtcDescripcion</td>
                            <td>@c.PcaValor</td>
                            <td>@c.PcaDescripcion</td>
                            <td>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="pencil" Tooltip="Editar" OnClick="() => EditarCaracteristica(c)" />
                                    <BotonIcono Icono="trash-2" Tooltip="Eliminar" Variante="peligro" OnClick="() => EliminarCaracteristicaAsync(c)" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
else if (pestanaActiva == "precios" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>Precios: @seleccionado.ProDescripcion</h2>
        <div class="barra-herramientas">
            <BotonIcono Icono="plus" Tooltip="Agregar precio" Etiqueta="Agregar precio" Variante="primario" OnClick="() => mostrarNuevoPrecio = !mostrarNuevoPrecio" />
        </div>
        @if (mostrarNuevoPrecio)
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label>Bodega</label>
                    <select @bind="nuevoPrecio.BodId">
                        <option value="0">Seleccione...</option>
                        @foreach (var bod in bodegasDisponibles)
                        {
                            <option value="@bod.BodId">@bod.BodDescripcion</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label>Moneda</label>
                    <select @bind="nuevoPrecio.MonId">
                        <option value="0">Seleccione...</option>
                        @foreach (var mon in monedasDisponibles)
                        {
                            <option value="@mon.MonId">@mon.MonCodigo</option>
                        }
                    </select>
                </div>
                <div class="campo"><label>Precio unitario de venta</label><input type="number" step="0.01" @bind="nuevoPrecio.PrecioUnitarioVenta" /></div>
                <div class="campo"><label>Descripción</label><input @bind="nuevoPrecio.Descripcion" /></div>
                <div class="campo"><label>Vigencia desde</label><input type="date" @bind="nuevoPrecio.VigenciaDesde" /></div>
                <div class="campo"><label>Vigencia hasta</label><input type="date" @bind="nuevoPrecio.VigenciaHasta" /></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="Guardar precio" Etiqueta="Guardar" Variante="primario" OnClick="CrearPrecioAsync" />
                    <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNuevoPrecio = false" />
                </div>
            </div>
        }
        <table class="tabla-datos">
            <thead><tr><th>Bodega</th><th>Moneda</th><th class="num">Precio</th><th class="col-fecha">Desde</th><th class="col-fecha">Hasta</th><th class="col-acciones">Acciones</th></tr></thead>
            <tbody>
                @if (preciosProducto.Count == 0)
                {
                    <tr><td colspan="6">Sin precios vigentes.</td></tr>
                }
                @foreach (var p in preciosProducto)
                {
                    <tr>
                        @if (editandoPrecioId == p.PprId)
                        {
                            <td>
                                <select @bind="editPrecioBodId">
                                    @foreach (var bod in bodegasDisponibles)
                                    {
                                        <option value="@bod.BodId">@bod.BodDescripcion</option>
                                    }
                                </select>
                            </td>
                            <td>@p.MonCodigo</td>
                            <td class="num"><input type="number" step="0.01" @bind="editPrecioUnitarioVenta" /></td>
                            <td class="col-fecha"><input type="date" @bind="editPrecioVigenciaDesde" /></td>
                            <td class="col-fecha"><input type="date" @bind="editPrecioVigenciaHasta" /></td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="Guardar" Variante="primario" OnClick="GuardarEdicionPrecioAsync" />
                                    <BotonIcono Icono="x" Tooltip="Cancelar" OnClick="() => editandoPrecioId = null" />
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@p.BodDescripcion</td>
                            <td>@p.MonCodigo</td>
                            <td class="num">@p.PprPrecioUnitarioVenta.ToString("N2")</td>
                            <td class="col-fecha">@p.PprVigenciaDesde.ToString("dd/MM/yyyy")</td>
                            <td class="col-fecha">@(p.PprVigenciaHasta?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="pencil" Tooltip="Editar" OnClick="() => EditarPrecio(p)" />
                                    <BotonIcono Icono="trash-2" Tooltip="Desactivar precio" Variante="peligro" OnClick="() => EliminarPrecioAsync(p)" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<Producto> productos = Array.Empty<Producto>();
    private IReadOnlyList<ProductoTipo> tiposProducto = Array.Empty<ProductoTipo>();
    private IReadOnlyList<ProductoExistenciaBodega> existenciasPorBodega = Array.Empty<ProductoExistenciaBodega>();
    private IReadOnlyList<ProductoTipoCaracteristica> tiposCaracteristica = Array.Empty<ProductoTipoCaracteristica>();
    private IReadOnlyList<ProductoCaracteristica> caracteristicasProducto = Array.Empty<ProductoCaracteristica>();
    private IReadOnlyList<ProductoPrecio> preciosProducto = Array.Empty<ProductoPrecio>();
    private IReadOnlyList<MonedaInventario> monedasDisponibles = Array.Empty<MonedaInventario>();
    private IReadOnlyList<Bodega> bodegasDisponibles = Array.Empty<Bodega>();
    private Producto? seleccionado;
    private string pestanaActiva = "lista";

    private IReadOnlyList<PestanaItem> Pestanas => seleccionado is null
        ? new[] { new PestanaItem("lista", "Lista") }
        : pestanaActiva == "editar"
            ? new[] { new PestanaItem("lista", "Lista"), new PestanaItem("detalle", "Detalle"), new PestanaItem("editar", "Editar"), new PestanaItem("caracteristicas", "Características"), new PestanaItem("precios", "Precios") }
            : new[] { new PestanaItem("lista", "Lista"), new PestanaItem("detalle", "Detalle"), new PestanaItem("caracteristicas", "Características"), new PestanaItem("precios", "Precios") };

    private bool mostrarNuevaCaracteristica;
    private readonly CaracteristicaModelo nuevaCaracteristica = new();
    private int? pcaEditandoId;
    private string pcaEditValor = "";
    private string? pcaEditDescripcion;

    private bool mostrarNuevoPrecio;
    private readonly PrecioModelo nuevoPrecio = new();
    private int? editandoPrecioId;
    private int editPrecioBodId;
    private decimal editPrecioUnitarioVenta;
    private DateTime editPrecioVigenciaDesde;
    private DateTime? editPrecioVigenciaHasta;

    private string filtroCodigo = "";
    private string filtroDescripcion = "";
    private string filtroEstado = "A";
    private bool mostrarNuevo;
    private string? mensaje;
    private bool esMensajeError;

    private readonly ProductoModelo nuevoProducto = new();
    private readonly ProductoModelo edicionProducto = new();

    protected override async Task OnInitializedAsync()
    {
        tiposProducto = await ProductoRepository.ConsultarTiposAsync();
        tiposCaracteristica = await CaracteristicaRepository.ConsultarTiposAsync("A");
        bodegasDisponibles = await BodegaRepository.ConsultarAsync(sucId: null, estado: "A");
        monedasDisponibles = await PrecioRepository.ConsultarMonedasAsync();
        await BuscarAsync();
    }

    private async Task<int?> ObtenerUsuIdActualAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var estado = await AuthenticationStateTask;
        return estado.User.ObtenerUsuId();
    }

    private async Task BuscarAsync()
    {
        productos = await ProductoRepository.ConsultarAsync(
            string.IsNullOrWhiteSpace(filtroCodigo) ? null : filtroCodigo,
            string.IsNullOrWhiteSpace(filtroDescripcion) ? null : filtroDescripcion,
            prtId: null,
            string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado,
            pagina: 1,
            tamanioPagina: 100);
    }

    private void MostrarFormularioNuevo()
    {
        mensaje = null;
        nuevoProducto.Codigo = "";
        nuevoProducto.Descripcion = "";
        nuevoProducto.PrtId = 0;
        nuevoProducto.TipoItem = "B";
        nuevoProducto.ManejaExistencia = true;
        mostrarNuevo = true;
    }

    private async Task CrearProductoAsync()
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await ProductoRepository.InsertarAsync(
                nuevoProducto.Codigo, nuevoProducto.Descripcion, nuevoProducto.PrtId,
                nuevoProducto.TipoItem, nuevoProducto.ManejaExistencia, idPadre: null, usuId);
            mostrarNuevo = false;
            mensaje = "Producto creado correctamente.";
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task SeleccionarAsync(Producto producto)
    {
        seleccionado = producto;
        pestanaActiva = "detalle";
        mensaje = null;

        var (_, existencias) = await ProductoRepository.ConsultarPorIdAsync(producto.ProId);
        existenciasPorBodega = existencias;

        mostrarNuevaCaracteristica = false;
        pcaEditandoId = null;
        caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(producto.ProId);

        mostrarNuevoPrecio = false;
        preciosProducto = await PrecioRepository.ConsultarAsync(producto.ProId, bodId: null, estado: "A");
    }

    private void IniciarEdicion()
    {
        if (seleccionado is null) return;
        edicionProducto.Codigo = seleccionado.ProCodigo;
        edicionProducto.Descripcion = seleccionado.ProDescripcion;
        edicionProducto.PrtId = seleccionado.PrtId;
        edicionProducto.TipoItem = seleccionado.ProTipoItem;
        edicionProducto.ManejaExistencia = seleccionado.ProManejaExistencia;
        mensaje = null;
        pestanaActiva = "editar";
    }

    private void CancelarEdicionAsync()
    {
        pestanaActiva = "detalle";
    }

    private void EditarCaracteristica(ProductoCaracteristica caracteristica)
    {
        pcaEditandoId = caracteristica.PcaId;
        pcaEditValor = caracteristica.PcaValor;
        pcaEditDescripcion = caracteristica.PcaDescripcion;
    }

    private async Task CrearCaracteristicaAsync()
    {
        if (seleccionado is null) return;
        if (nuevaCaracteristica.PtcId == 0 || string.IsNullOrWhiteSpace(nuevaCaracteristica.Valor))
        {
            mensaje = "Debe seleccionar el tipo e indicar el valor de la característica.";
            esMensajeError = true;
            return;
        }

        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await CaracteristicaRepository.InsertarAsync(seleccionado.ProId, nuevaCaracteristica.PtcId, nuevaCaracteristica.Valor, nuevaCaracteristica.Descripcion, usuId);
            caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(seleccionado.ProId);
            mostrarNuevaCaracteristica = false;
            nuevaCaracteristica.PtcId = 0;
            nuevaCaracteristica.Valor = "";
            nuevaCaracteristica.Descripcion = null;
            mensaje = "Característica agregada.";
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task GuardarCaracteristicaAsync()
    {
        if (seleccionado is null || pcaEditandoId is null) return;
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await CaracteristicaRepository.ActualizarAsync(pcaEditandoId.Value, pcaEditValor, pcaEditDescripcion, usuId);
            caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(seleccionado.ProId);
            pcaEditandoId = null;
            mensaje = "Característica actualizada.";
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
