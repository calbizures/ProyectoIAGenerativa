@page "/productos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Inventario
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IProductoRepository ProductoRepository
@inject IProductoCaracteristicaRepository CaracteristicaRepository
@inject IProductoPrecioRepository PrecioRepository
@inject IBodegaRepository BodegaRepository
@inject Erp.Data.Compras.IProductoProveedorRepository ProductoProveedorRepository
@inject Erp.Data.Compras.IProveedorRepository ProveedorRepository

<PageTitle>@L("Productos")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Productos")</h1>
    <p>@L("Catálogo de productos y servicios, con sus características, existencias y precios.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-filtros">
        <input placeholder="@L("Buscar por código")" aria-label="@L("Buscar por código")" @bind="filtroCodigo" />
        <input placeholder="@L("Buscar por descripción")" aria-label="@L("Buscar por descripción")" @bind="filtroDescripcion" type="search" @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarAsync(); })" />
        <select @bind="filtroEstado" aria-label="@L("Estado")">
            <option value="A">@L("Activos")</option>
            <option value="I">@L("Inactivos")</option>
            <option value="">@L("Todos")</option>
        </select>
        <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />

        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_CREAR">
            <Authorized>
                <BotonIcono Icono="plus" Tooltip="@L("Nuevo producto")" Etiqueta="@L("Nuevo producto")" Variante="primario" OnClick="MostrarFormularioNuevo" />
            </Authorized>
        </AuthorizeView>
    </div>

    @if (mostrarNuevo)
    {
        <EditForm Model="nuevoProducto" OnValidSubmit="CrearProductoAsync" class="panel-formulario">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label for="productos-producto-codigo">@L("Código")</label><InputText id="productos-producto-codigo" @bind-Value="nuevoProducto.Codigo" /></div>
            <div class="campo"><label for="productos-producto-descripcion">@L("Descripción")</label><InputText id="productos-producto-descripcion" @bind-Value="nuevoProducto.Descripcion" /></div>
            <div class="campo">
                <label for="productos-producto-prtid">@L("Tipo de producto")</label>
                <select id="productos-producto-prtid" @bind="nuevoProducto.PrtId">
                    <option value="0">@L("Seleccione...")</option>
                    @foreach (var tipo in tiposProducto)
                    {
                        <option value="@tipo.PrtId">@tipo.PrtDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="productos-producto-tipoitem">@L("Clasificación")</label>
                <select id="productos-producto-tipoitem" @bind="nuevoProducto.TipoItem">
                    <option value="B">@L("Bien")</option>
                    <option value="S">@L("Servicio")</option>
                </select>
            </div>
            <div class="campo">
                <label for="productos-producto-umeid">@L("Unidad de medida")</label>
                <select id="productos-producto-umeid" @bind="nuevoProducto.UmeId">
                    <option value="0">@L("Según la clasificación")</option>
                    @foreach (var u in unidadesMedida)
                    {
                        <option value="@u.UmeId">@u.UmeCodigo - @u.UmeDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo campo-checkbox">
                <label><input type="checkbox" @bind="nuevoProducto.ManejaExistencia" /> @L("Maneja existencia")</label>
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevo = false" />
            </div>
        </EditForm>
    }

    <table class="tabla-datos">
        <thead>
            <tr>
                <th class="col-codigo">@L("Código")</th>
                <th>@L("Descripción")</th>
                <th class="col-telefono">@L("Tipo")</th>
                <th class="num col-estado">@L("Existencia")</th>
                <th class="num col-monto">@L("Costo unitario")</th>
                <th class="col-estado">@L("Estado")</th>
                <th class="col-acciones">@L("Acciones")</th>
            </tr>
        </thead>
        <tbody>
            @if (!productos.Any())
            {
                <tr><td colspan="7" class="doc-tabla-vacia">@L("Ningún producto coincide con la búsqueda.")</td></tr>
            }
            @foreach (var p in productos)
            {
                <tr class="@(seleccionado?.ProId == p.ProId ? "fila-seleccionada" : "")">
                    <td class="col-codigo">@p.ProCodigo</td>
                    <td>@p.ProDescripcion</td>
                    <td class="col-telefono">@p.PrtDescripcion</td>
                    <td class="num col-estado">@(p.ProManejaExistencia ? p.ProTotalCantidad.ToString("N0") : "—")</td>
                    <td class="num col-monto">@p.ProCostoUnitario.ToString("N2")</td>
                    <td class="col-estado"><span class="estado-badge @(p.ProEstado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(p.ProEstado == "A" ? L("Activo") : L("Inactivo"))</span></td>
                    <td class="col-acciones">
                        <div class="acciones-fila">
                            <BotonIcono Icono="eye" Tooltip="@L("Ver detalle")" OnClick="() => SeleccionarAsync(p)" />
                            <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_EDITAR">
                                <Authorized>
                                    @if (p.ProEstado == "A")
                                    {
                                        <BotonIcono Icono="trash-2" Tooltip="@L("Desactivar producto")" Confirmacion="@L("¿Desactivar el producto?")" Variante="peligro" OnClick="() => DesactivarAsync(p)" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (pestanaActiva == "editar" && seleccionado is not null)
{
    <div class="panel-formulario">
        <h2>@L("Editar: {0}", seleccionado.ProDescripcion)</h2>
        <EditForm Model="edicionProducto" OnValidSubmit="GuardarEdicionAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label for="productos-edicionproducto-codigo">@L("Código")</label><InputText id="productos-edicionproducto-codigo" @bind-Value="edicionProducto.Codigo" /></div>
            <div class="campo"><label for="productos-edicionproducto-descripcion">@L("Descripción")</label><InputText id="productos-edicionproducto-descripcion" @bind-Value="edicionProducto.Descripcion" /></div>
            <div class="campo">
                <label for="productos-edicionproducto-prtid">@L("Tipo de producto")</label>
                <select id="productos-edicionproducto-prtid" @bind="edicionProducto.PrtId">
                    @foreach (var tipo in tiposProducto)
                    {
                        <option value="@tipo.PrtId">@tipo.PrtDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="productos-edicionproducto-tipoitem">@L("Clasificación")</label>
                <select id="productos-edicionproducto-tipoitem" @bind="edicionProducto.TipoItem">
                    <option value="B">@L("Bien")</option>
                    <option value="S">@L("Servicio")</option>
                </select>
            </div>
            <div class="campo">
                <label for="productos-edicionproducto-umeid">@L("Unidad de medida")</label>
                <select id="productos-edicionproducto-umeid" @bind="edicionProducto.UmeId">
                    @foreach (var u in unidadesMedida.Where(u => u.UmeEstado == "A" || u.UmeId == edicionProducto.UmeId))
                    {
                        <option value="@u.UmeId">@u.UmeCodigo - @u.UmeDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo campo-checkbox">
                <label><input type="checkbox" @bind="edicionProducto.ManejaExistencia" /> @L("Maneja existencia")</label>
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Guardar cambios")" Etiqueta="@L("Guardar cambios")" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="CancelarEdicionAsync" />
            </div>
        </EditForm>
    </div>
}
else if (pestanaActiva == "detalle" && seleccionado is not null)
{
    <div class="panel-detalle">
        <h2>@L("Detalle: {0}", seleccionado.ProDescripcion)</h2>

        <div class="campo"><label>@L("Código")</label><span class="valor-detalle">@seleccionado.ProCodigo</span></div>
        <div class="campo"><label>@L("Descripción")</label><span class="valor-detalle">@seleccionado.ProDescripcion</span></div>
        <div class="campo"><label>@L("Tipo de producto")</label><span class="valor-detalle">@seleccionado.PrtDescripcion</span></div>
        <div class="campo"><label>@L("Clasificación")</label><span class="valor-detalle">@(seleccionado.ProTipoItem == "B" ? L("Bien") : L("Servicio"))</span></div>
        <div class="campo"><label>@L("Unidad de medida")</label><span class="valor-detalle">@(seleccionado.UmeDescripcion ?? "—")</span></div>
        <div class="campo campo-checkbox"><label>@L("Maneja existencia")</label><span class="valor-detalle">@(seleccionado.ProManejaExistencia ? L("Sí") : L("No"))</span></div>
        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_EDITAR">
            <Authorized>
                <div class="acciones-fila">
                    <BotonIcono Icono="pencil" Tooltip="@L("Editar")" Etiqueta="@L("Editar")" OnClick="IniciarEdicion" />
                </div>
            </Authorized>
        </AuthorizeView>

        <h3>@L("Existencia por bodega")</h3>
        <table class="tabla-datos">
            <thead><tr><th>@L("Bodega")</th><th class="num">@L("Existencia")</th></tr></thead>
            <tbody>
                @if (existenciasPorBodega.Count == 0)
                {
                    <tr><td colspan="2">@L("Sin movimientos registrados.")</td></tr>
                }
                @foreach (var existencia in existenciasPorBodega)
                {
                    <tr>
                        <td>@existencia.BodDescripcion</td>
                        <td class="num">@existencia.Existencia.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
else if (pestanaActiva == "caracteristicas" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>@L("Características: {0}", seleccionado.ProDescripcion)</h2>
        <div class="barra-herramientas">
            <BotonIcono Icono="plus" Tooltip="@L("Agregar característica")" Etiqueta="@L("Agregar característica")" Variante="primario" OnClick="() => mostrarNuevaCaracteristica = !mostrarNuevaCaracteristica" />
        </div>
        @if (mostrarNuevaCaracteristica)
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label for="productos-caracteristica-ptcid">@L("Tipo")</label>
                    <select id="productos-caracteristica-ptcid" @bind="nuevaCaracteristica.PtcId">
                        <option value="0">@L("Seleccione...")</option>
                        @foreach (var tipo in tiposCaracteristica)
                        {
                            <option value="@tipo.PtcId">@tipo.PtcDescripcion</option>
                        }
                    </select>
                </div>
                <div class="campo"><label for="productos-caracteristica-valor">@L("Valor")</label><input id="productos-caracteristica-valor" @bind="nuevaCaracteristica.Valor" /></div>
                <div class="campo"><label for="productos-caracteristica-descripcion">@L("Descripción")</label><input id="productos-caracteristica-descripcion" @bind="nuevaCaracteristica.Descripcion" /></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar característica")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="CrearCaracteristicaAsync" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevaCaracteristica = false" />
                </div>
            </div>
        }
        <table class="tabla-datos">
            <thead><tr><th>@L("Tipo")</th><th>@L("Valor")</th><th>@L("Descripción")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @if (caracteristicasProducto.Count == 0)
                {
                    <tr><td colspan="4">@L("Sin características registradas.")</td></tr>
                }
                @foreach (var c in caracteristicasProducto)
                {
                    <tr>
                        @if (pcaEditandoId == c.PcaId)
                        {
                            <td>@c.PtcDescripcion</td>
                            <td><input @bind="pcaEditValor" /></td>
                            <td><input @bind="pcaEditDescripcion" /></td>
                            <td>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="GuardarCaracteristicaAsync" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => pcaEditandoId = null" />
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@c.PtcDescripcion</td>
                            <td>@c.PcaValor</td>
                            <td>@c.PcaDescripcion</td>
                            <td>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="pencil" Tooltip="@L("Editar")" OnClick="() => EditarCaracteristica(c)" />
                                    <BotonIcono Icono="trash-2" Tooltip="@L("Eliminar")" Confirmacion="@L("¿Eliminar la característica?")" Variante="peligro" OnClick="() => EliminarCaracteristicaAsync(c)" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
else if (pestanaActiva == "precios" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>@L("Precios: {0}", seleccionado.ProDescripcion)</h2>
        <div class="barra-herramientas">
            <BotonIcono Icono="plus" Tooltip="@L("Agregar precio")" Etiqueta="@L("Agregar precio")" Variante="primario" OnClick="() => mostrarNuevoPrecio = !mostrarNuevoPrecio" />
        </div>
        @if (mostrarNuevoPrecio)
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label for="productos-precio-bodid">@L("Bodega")</label>
                    <select id="productos-precio-bodid" @bind="nuevoPrecio.BodId">
                        <option value="0">@L("Seleccione...")</option>
                        @foreach (var bod in bodegasDisponibles)
                        {
                            <option value="@bod.BodId">@bod.BodDescripcion</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="productos-precio-monid">@L("Moneda")</label>
                    <select id="productos-precio-monid" @bind="nuevoPrecio.MonId">
                        <option value="0">@L("Seleccione...")</option>
                        @foreach (var mon in monedasDisponibles)
                        {
                            <option value="@mon.MonId">@mon.MonCodigo</option>
                        }
                    </select>
                </div>
                <div class="campo"><label for="productos-precio-preciounitarioventa">@L("Precio unitario de venta")</label><input id="productos-precio-preciounitarioventa" type="number" step="0.01" @bind="nuevoPrecio.PrecioUnitarioVenta" /></div>
                <div class="campo"><label for="productos-precio-descripcion">@L("Descripción")</label><input id="productos-precio-descripcion" @bind="nuevoPrecio.Descripcion" /></div>
                <div class="campo"><label for="productos-precio-vigenciadesde">@L("Vigencia desde")</label><input id="productos-precio-vigenciadesde" type="date" @bind="nuevoPrecio.VigenciaDesde" /></div>
                <div class="campo"><label for="productos-precio-vigenciahasta">@L("Vigencia hasta")</label><input id="productos-precio-vigenciahasta" type="date" @bind="nuevoPrecio.VigenciaHasta" /></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar precio")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="CrearPrecioAsync" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevoPrecio = false" />
                </div>
            </div>
        }
        <table class="tabla-datos">
            <thead><tr><th>@L("Bodega")</th><th>@L("Moneda")</th><th class="num">@L("Precio")</th><th class="col-fecha">@L("Desde")</th><th class="col-fecha">@L("Hasta")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @if (preciosProducto.Count == 0)
                {
                    <tr><td colspan="6">@L("Sin precios vigentes.")</td></tr>
                }
                @foreach (var p in preciosProducto)
                {
                    <tr>
                        @if (editandoPrecioId == p.PprId)
                        {
                            <td>
                                <select @bind="editPrecioBodId">
                                    @foreach (var bod in bodegasDisponibles)
                                    {
                                        <option value="@bod.BodId">@bod.BodDescripcion</option>
                                    }
                                </select>
                            </td>
                            <td>@p.MonCodigo</td>
                            <td class="num"><input type="number" step="0.01" @bind="editPrecioUnitarioVenta" /></td>
                            <td class="col-fecha"><input type="date" @bind="editPrecioVigenciaDesde" /></td>
                            <td class="col-fecha"><input type="date" @bind="editPrecioVigenciaHasta" /></td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="GuardarEdicionPrecioAsync" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => editandoPrecioId = null" />
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@p.BodDescripcion</td>
                            <td>@p.MonCodigo</td>
                            <td class="num">@p.PprPrecioUnitarioVenta.ToString("N2")</td>
                            <td class="col-fecha">@p.PprVigenciaDesde.ToString("dd/MM/yyyy")</td>
                            <td class="col-fecha">@(p.PprVigenciaHasta?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="pencil" Tooltip="@L("Editar")" OnClick="() => EditarPrecio(p)" />
                                    <BotonIcono Icono="trash-2" Tooltip="@L("Desactivar precio")" Confirmacion="@L("¿Desactivar el precio?")" Variante="peligro" OnClick="() => EliminarPrecioAsync(p)" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (pestanaActiva == "proveedores" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>@L("Proveedores: {0}", seleccionado.ProDescripcion)</h2>
        <div class="barra-herramientas">
            <BotonIcono Icono="plus" Tooltip="@L("Relacionar un proveedor")" Etiqueta="@L("Agregar proveedor")" Variante="primario" OnClick="MostrarNuevoProveedorProducto" />
        </div>
        @if (mostrarNuevoProveedor)
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label for="pp-proveedor">@L("Proveedor")</label>
                    <select id="pp-proveedor" @bind="nuevoProveedorId">
                        <option value="0">@L("Seleccione...")</option>
                        @foreach (var p in proveedoresActivos.Where(p => proveedoresProducto.All(r => r.PrvId != p.PrvId)))
                        {
                            <option value="@p.PrvId">@p.PrvNombreComercial (@p.PrvCodigo)</option>
                        }
                    </select>
                </div>
                <div class="campo"><label for="pp-codigo">@L("Código del producto en el catálogo del proveedor")</label><input id="pp-codigo" maxlength="64" @bind="nuevoProveedorCodigo" /></div>
                <label class="casilla"><input type="checkbox" @bind="nuevoProveedorPreferido" /> @L("Proveedor preferido")</label>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario"
                                OnClick="() => GuardarProveedorProductoAsync(null, nuevoProveedorId, nuevoProveedorPreferido, nuevoProveedorCodigo)" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevoProveedor = false" />
                </div>
            </div>
        }
        <table class="tabla-datos">
            <thead><tr><th>@L("Proveedor")</th><th>@L("Código del proveedor")</th><th class="num col-monto">@L("Último costo (sin IVA)")</th><th class="col-fecha">@L("Última compra")</th><th class="col-estado">@L("Preferido")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @if (proveedoresProducto.Count == 0)
                {
                    <tr><td colspan="6">@L("Ningún proveedor relacionado. También se relacionan al grabar una compra.")</td></tr>
                }
                @foreach (var r in proveedoresProducto)
                {
                    <tr>
                        @if (pppEditandoId == r.PppId)
                        {
                            <td>@r.Proveedor</td>
                            <td><input maxlength="64" aria-label="@L("Código del proveedor")" @bind="pppEditCodigo" /></td>
                            <td class="num col-monto">@(r.UltimoCosto?.ToString("N2") ?? "—")</td>
                            <td class="col-fecha">@(r.FechaUltimaCompra?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="col-estado"><input type="checkbox" aria-label="@L("Preferido")" @bind="pppEditPreferido" /></td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="() => GuardarProveedorProductoAsync(r.PppId, r.PrvId, pppEditPreferido, pppEditCodigo)" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => pppEditandoId = null" />
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@r.Proveedor <span class="texto-tenue">@r.PrvCodigo</span></td>
                            <td>@(r.CodigoProveedor ?? "—")</td>
                            <td class="num col-monto">@(r.UltimoCosto?.ToString("N2") ?? "—")</td>
                            <td class="col-fecha">@(r.FechaUltimaCompra?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="col-estado">@if (r.Preferido) { <span class="estado-badge estado-badge-activo">@L("Preferido")</span> } else { <span class="texto-tenue">@L("Alterno")</span> }</td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="pencil" Tooltip="@L("Editar")" OnClick="() => { pppEditandoId = r.PppId; pppEditCodigo = r.CodigoProveedor; pppEditPreferido = r.Preferido; }" />
                                    <BotonIcono Icono="trash-2" Tooltip="@L("Quitar el proveedor")" Confirmacion="@L("¿Quitar este proveedor del producto?")" Variante="peligro" OnClick="() => EliminarProveedorProductoAsync(r)" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<Producto> productos = Array.Empty<Producto>();
    private IReadOnlyList<ProductoTipo> tiposProducto = Array.Empty<ProductoTipo>();
    private IReadOnlyList<ProductoExistenciaBodega> existenciasPorBodega = Array.Empty<ProductoExistenciaBodega>();
    private IReadOnlyList<ProductoTipoCaracteristica> tiposCaracteristica = Array.Empty<ProductoTipoCaracteristica>();
    private IReadOnlyList<ProductoCaracteristica> caracteristicasProducto = Array.Empty<ProductoCaracteristica>();
    private IReadOnlyList<ProductoPrecio> preciosProducto = Array.Empty<ProductoPrecio>();
    private IReadOnlyList<MonedaInventario> monedasDisponibles = Array.Empty<MonedaInventario>();
    private IReadOnlyList<Bodega> bodegasDisponibles = Array.Empty<Bodega>();
    private Producto? seleccionado;
    private string pestanaActiva = "lista";

    private IReadOnlyList<PestanaItem> Pestanas => seleccionado is null
        ? new[] { new PestanaItem("lista", L("Lista")) }
        : pestanaActiva == "editar"
            ? new[] { new PestanaItem("lista", L("Lista")), new PestanaItem("detalle", L("Detalle")), new PestanaItem("editar", L("Editar")), new PestanaItem("caracteristicas", L("Características")), new PestanaItem("precios", L("Precios")), new PestanaItem("proveedores", L("Proveedores")) }
            : new[] { new PestanaItem("lista", L("Lista")), new PestanaItem("detalle", L("Detalle")), new PestanaItem("caracteristicas", L("Características")), new PestanaItem("precios", L("Precios")), new PestanaItem("proveedores", L("Proveedores")) };

    private bool mostrarNuevaCaracteristica;
    private readonly CaracteristicaModelo nuevaCaracteristica = new();
    private int? pcaEditandoId;
    private string pcaEditValor = "";
    private string? pcaEditDescripcion;

    private bool mostrarNuevoPrecio;
    private readonly PrecioModelo nuevoPrecio = new();
    private int? editandoPrecioId;
    private int editPrecioBodId;
    private decimal editPrecioUnitarioVenta;
    private DateTime editPrecioVigenciaDesde;
    private DateTime? editPrecioVigenciaHasta;

    private string filtroCodigo = "";
    private string filtroDescripcion = "";
    private string filtroEstado = "A";
    private bool mostrarNuevo;
    private string? mensaje;
    private bool esMensajeError;

    private List<UnidadMedida> unidadesMedida = new();
    private readonly ProductoModelo nuevoProducto = new();
    private readonly ProductoModelo edicionProducto = new();

    protected override async Task OnInitializedAsync()
    {
        tiposProducto = await ProductoRepository.ConsultarTiposAsync();
        tiposCaracteristica = await CaracteristicaRepository.ConsultarTiposAsync("A");
        bodegasDisponibles = await BodegaRepository.ConsultarAsync(sucId: null, estado: "A");
        monedasDisponibles = await PrecioRepository.ConsultarMonedasAsync();
        unidadesMedida = (await BodegaRepository.ConsultarUnidadesAsync(soloActivas: false)).ToList();
        await BuscarAsync();
    }

    private async Task<int?> ObtenerUsuIdActualAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var estado = await AuthenticationStateTask;
        return estado.User.ObtenerUsuId();
    }

    private async Task BuscarAsync()
    {
        productos = await ProductoRepository.ConsultarAsync(
            string.IsNullOrWhiteSpace(filtroCodigo) ? null : filtroCodigo,
            string.IsNullOrWhiteSpace(filtroDescripcion) ? null : filtroDescripcion,
            prtId: null,
            string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado,
            pagina: 1,
            tamanioPagina: 100);
    }

    private void MostrarFormularioNuevo()
    {
        mensaje = null;
        nuevoProducto.Codigo = "";
        nuevoProducto.Descripcion = "";
        nuevoProducto.PrtId = 0;
        nuevoProducto.TipoItem = "B";
        nuevoProducto.ManejaExistencia = true;
        nuevoProducto.UmeId = 0;
        mostrarNuevo = true;
    }

    private async Task CrearProductoAsync()
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await ProductoRepository.InsertarAsync(
                nuevoProducto.Codigo, nuevoProducto.Descripcion, nuevoProducto.PrtId,
                nuevoProducto.TipoItem, nuevoProducto.ManejaExistencia, idPadre: null, usuId,
                umeId: nuevoProducto.UmeId == 0 ? null : nuevoProducto.UmeId);
            mostrarNuevo = false;
            mensaje = L("Producto creado correctamente.");
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task SeleccionarAsync(Producto producto)
    {
        seleccionado = producto;
        pestanaActiva = "detalle";
        mensaje = null;

        var (_, existencias) = await ProductoRepository.ConsultarPorIdAsync(producto.ProId);
        existenciasPorBodega = existencias;

        mostrarNuevaCaracteristica = false;
        pcaEditandoId = null;
        caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(producto.ProId);

        mostrarNuevoPrecio = false;
        preciosProducto = await PrecioRepository.ConsultarAsync(producto.ProId, bodId: null, estado: "A");

        await CargarProveedoresProductoAsync();
    }

    // Pestaña Proveedores: quién vende el producto (inv_producto_proveedor).
    private IReadOnlyList<Erp.Data.Compras.ProductoProveedor> proveedoresProducto = Array.Empty<Erp.Data.Compras.ProductoProveedor>();
    private IReadOnlyList<Erp.Data.Compras.Proveedor> proveedoresActivos = Array.Empty<Erp.Data.Compras.Proveedor>();
    private bool mostrarNuevoProveedor;
    private int nuevoProveedorId;
    private string? nuevoProveedorCodigo;
    private bool nuevoProveedorPreferido;
    private int? pppEditandoId;
    private string? pppEditCodigo;
    private bool pppEditPreferido;

    private async Task CargarProveedoresProductoAsync()
    {
        if (seleccionado is null) return;
        mostrarNuevoProveedor = false;
        pppEditandoId = null;
        try
        {
            proveedoresProducto = await ProductoProveedorRepository.ConsultarAsync(null, seleccionado.ProId);
            if (proveedoresActivos.Count == 0)
                proveedoresActivos = await ProveedorRepository.ConsultarAsync(null, "A");
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private void MostrarNuevoProveedorProducto()
    {
        mostrarNuevoProveedor = !mostrarNuevoProveedor;
        nuevoProveedorId = 0;
        nuevoProveedorCodigo = null;
        nuevoProveedorPreferido = proveedoresProducto.Count == 0;
    }

    private async Task GuardarProveedorProductoAsync(int? pppId, int prvId, bool preferido, string? codigo)
    {
        if (seleccionado is null) return;
        if (prvId <= 0)
        {
            mensaje = L("Seleccione el proveedor.");
            esMensajeError = true;
            return;
        }
        try
        {
            await ProductoProveedorRepository.GuardarAsync(pppId, prvId, seleccionado.ProId, preferido, codigo, await ObtenerUsuIdActualAsync());
            mensaje = pppId is null ? L("Proveedor relacionado con el producto.") : L("Cambios guardados.");
            esMensajeError = false;
            await CargarProveedoresProductoAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task EliminarProveedorProductoAsync(Erp.Data.Compras.ProductoProveedor relacion)
    {
        try
        {
            await ProductoProveedorRepository.EliminarAsync(relacion.PppId, await ObtenerUsuIdActualAsync());
            mensaje = L("{0} ya no aparece como proveedor del producto.", relacion.Proveedor);
            esMensajeError = false;
            await CargarProveedoresProductoAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private void IniciarEdicion()
    {
        if (seleccionado is null) return;
        edicionProducto.Codigo = seleccionado.ProCodigo;
        edicionProducto.Descripcion = seleccionado.ProDescripcion;
        edicionProducto.PrtId = seleccionado.PrtId;
        edicionProducto.TipoItem = seleccionado.ProTipoItem;
        edicionProducto.ManejaExistencia = seleccionado.ProManejaExistencia;
        edicionProducto.UmeId = seleccionado.UmeId ?? 0;
        mensaje = null;
        pestanaActiva = "editar";
    }

    private void CancelarEdicionAsync()
    {
        pestanaActiva = "detalle";
    }

    private void EditarCaracteristica(ProductoCaracteristica caracteristica)
    {
        pcaEditandoId = caracteristica.PcaId;
        pcaEditValor = caracteristica.PcaValor;
        pcaEditDescripcion = caracteristica.PcaDescripcion;
    }

    private async Task CrearCaracteristicaAsync()
    {
        if (seleccionado is null) return;
        if (nuevaCaracteristica.PtcId == 0 || string.IsNullOrWhiteSpace(nuevaCaracteristica.Valor))
        {
            mensaje = L("Debe seleccionar el tipo e indicar el valor de la característica.");
            esMensajeError = true;
            return;
        }

        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await CaracteristicaRepository.InsertarAsync(seleccionado.ProId, nuevaCaracteristica.PtcId, nuevaCaracteristica.Valor, nuevaCaracteristica.Descripcion, usuId);
            caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(seleccionado.ProId);
            mostrarNuevaCaracteristica = false;
            nuevaCaracteristica.PtcId = 0;
            nuevaCaracteristica.Valor = "";
            nuevaCaracteristica.Descripcion = null;
            mensaje = L("Característica agregada.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task GuardarCaracteristicaAsync()
    {
        if (seleccionado is null || pcaEditandoId is null) return;
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await CaracteristicaRepository.ActualizarAsync(pcaEditandoId.Value, pcaEditValor, pcaEditDescripcion, usuId);
            caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(seleccionado.ProId);
            pcaEditandoId = null;
            mensaje = L("Característica actualizada.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task EliminarCaracteristicaAsync(ProductoCaracteristica caracteristica)
    {
        if (seleccionado is null) return;
        try
        {
            await CaracteristicaRepository.EliminarAsync(caracteristica.PcaId);
            caracteristicasProducto = await CaracteristicaRepository.ConsultarAsync(seleccionado.ProId);
            mensaje = L("Característica eliminada.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task CrearPrecioAsync()
    {
        if (seleccionado is null) return;
        if (nuevoPrecio.BodId == 0 || nuevoPrecio.MonId == 0)
        {
            mensaje = L("Debe seleccionar bodega y moneda para el precio.");
            esMensajeError = true;
            return;
        }

        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.InsertarAsync(
                seleccionado.ProId, nuevoPrecio.BodId, nuevoPrecio.MonId, nuevoPrecio.PrecioUnitarioVenta,
                nuevoPrecio.Descripcion, nuevoPrecio.VigenciaDesde, nuevoPrecio.VigenciaHasta, usuId);
            preciosProducto = await PrecioRepository.ConsultarAsync(seleccionado.ProId, bodId: null, estado: "A");
            mostrarNuevoPrecio = false;
            nuevoPrecio.BodId = 0;
            nuevoPrecio.MonId = 0;
            nuevoPrecio.PrecioUnitarioVenta = 0;
            nuevoPrecio.Descripcion = null;
            nuevoPrecio.VigenciaDesde = DateTime.Today;
            nuevoPrecio.VigenciaHasta = null;
            mensaje = L("Precio agregado.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task EliminarPrecioAsync(ProductoPrecio precio)
    {
        if (seleccionado is null) return;
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.EliminarAsync(precio.PprId, usuId);
            preciosProducto = await PrecioRepository.ConsultarAsync(seleccionado.ProId, bodId: null, estado: "A");
            mensaje = L("Precio desactivado.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private void EditarPrecio(ProductoPrecio precio)
    {
        editandoPrecioId = precio.PprId;
        editPrecioBodId = precio.BodId;
        editPrecioUnitarioVenta = precio.PprPrecioUnitarioVenta;
        editPrecioVigenciaDesde = precio.PprVigenciaDesde;
        editPrecioVigenciaHasta = precio.PprVigenciaHasta;
        mensaje = null;
    }

    private async Task GuardarEdicionPrecioAsync()
    {
        if (seleccionado is null || editandoPrecioId is null) return;
        try
        {
            var precio = preciosProducto.First(p => p.PprId == editandoPrecioId.Value);
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.ActualizarAsync(
                editandoPrecioId.Value, editPrecioBodId, precio.MonId, editPrecioUnitarioVenta,
                precio.PprDescripcion, editPrecioVigenciaDesde, editPrecioVigenciaHasta, usuId);
            editandoPrecioId = null;
            preciosProducto = await PrecioRepository.ConsultarAsync(seleccionado.ProId, bodId: null, estado: "A");
            mensaje = L("Cambios guardados.");
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task GuardarEdicionAsync()
    {
        if (seleccionado is null) return;
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await ProductoRepository.ActualizarAsync(
                seleccionado.ProId, edicionProducto.Codigo, edicionProducto.Descripcion, edicionProducto.PrtId,
                edicionProducto.TipoItem, edicionProducto.ManejaExistencia, idPadre: null, porcentajeRentabilidad: null, usuId,
                umeId: edicionProducto.UmeId == 0 ? null : edicionProducto.UmeId);
            mensaje = L("Cambios guardados.");
            esMensajeError = false;
            await BuscarAsync();
            seleccionado = productos.FirstOrDefault(p => p.ProId == seleccionado.ProId) ?? seleccionado;
            pestanaActiva = "detalle";
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task DesactivarAsync(Producto producto)
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await ProductoRepository.EliminarAsync(producto.ProId, usuId);
            mensaje = L("Producto desactivado.");
            esMensajeError = false;
            if (seleccionado?.ProId == producto.ProId)
            {
                seleccionado = null;
                pestanaActiva = "lista";
            }
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private sealed class ProductoModelo
    {
        [Required] public string Codigo { get; set; } = "";
        [Required] public string Descripcion { get; set; } = "";
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione un tipo de producto")] public int PrtId { get; set; }
        public string TipoItem { get; set; } = "B";
        public bool ManejaExistencia { get; set; } = true;
        public int UmeId { get; set; }
    }

    private sealed class CaracteristicaModelo
    {
        public int PtcId { get; set; }
        public string Valor { get; set; } = "";
        public string? Descripcion { get; set; }
    }

    private sealed class PrecioModelo
    {
        public int BodId { get; set; }
        public int MonId { get; set; }
        public decimal PrecioUnitarioVenta { get; set; }
        public string? Descripcion { get; set; }
        public DateTime VigenciaDesde { get; set; } = DateTime.Today;
        public DateTime? VigenciaHasta { get; set; }
    }
}
