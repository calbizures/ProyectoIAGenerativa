    private async Task CrearPrecioAsync()
    {
        if (seleccionado is null) return;
        if (nuevoPrecio.BodId == 0 || nuevoPrecio.MonId == 0)
        {
            mensaje = "Debe seleccionar bodega y moneda para el precio.";
            esMensajeError = true;
            return;
        }

        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await PrecioRepository.InsertarAsync(
                seleccionado.ProId, nuevoPrecio.BodId, nuevoPrecio.MonId, nuevoPrecio.PrecioUnitarioVenta,
                nuevoPrecio.Descripcion, nuevoPrecio.VigenciaDesde, nuevoPrecio.VigenciaHasta, usuId);
            preciosProducto = await PrecioRepository.ConsultarAsync(seleccionado.ProId, bodId: null, estado: "A");
            mostrarNuevoPrecio = false;
            nuevoPrecio.BodId = 0;
            nuevoPrecio.MonId = 0;
            nuevoPrecio.PrecioUnitarioVenta = 0;
            nuevoPrecio.Descripcion = null;
            nuevoPrecio.VigenciaDesde = DateTime.Today;
            nuevoPrecio.VigenciaHasta = null;
            mensaje = "Precio agregado.";
            esMensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

