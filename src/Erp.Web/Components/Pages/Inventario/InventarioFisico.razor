@page "/inventario/fisico"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:INVENTARIO_FISICO")]
@using Erp.Data.Inventario
@using Erp.Web.Reportes
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IInventarioFisicoRepository TomaRepository
@inject IBodegaRepository BodegaRepository

<PageTitle>Inventario físico</PageTitle>

<div class="pagina-encabezado">
    <h1>Inventario físico</h1>
    <p>Abra una toma por bodega, registre el conteo junto a la existencia del sistema y aplíquela: las diferencias generan el documento de ajuste (sobrante o faltante) y su póliza.</p>
</div>

<BorradorDocumento TDatos="BorradorConteo" Clave="inventario-fisico" Nombre="un conteo de inventario"
                   Capturar="CapturarBorrador" Describir="DescribirBorrador" Restaurar="RestaurarBorradorAsync" />

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-herramientas">
        <select @bind="filtroSucId" @bind:after="CambiarSucursalAsync" aria-label="Sucursal">
            <option value="">Todas las sucursales</option>
            @foreach (var s in bodegas.GroupBy(b => (b.SucId, b.SucDescripcion)))
            {
                <option value="@s.Key.SucId">@s.Key.SucDescripcion</option>
            }
        </select>
        <select @bind="filtroBodId" @bind:after="BuscarAsync" aria-label="Bodega">
            <option value="">Todas las bodegas</option>
            @foreach (var b in BodegasDeSucursal)
            {
                <option value="@b.BodId">@b.BodDescripcion</option>
            }
        </select>
        <select @bind="filtroEstado" @bind:after="BuscarAsync" aria-label="Estado">
            <option value="">Todos los estados</option>
            <option value="B">En conteo</option>
            <option value="A">Aplicadas</option>
            <option value="N">Anuladas</option>
        </select>
        <span class="barra-herramientas-separador"></span>
        <BotonIcono Icono="plus" Tooltip="Abrir una toma de inventario" Etiqueta="Nueva toma" Variante="primario" OnClick="IniciarNueva" />
    </div>

    @if (mostrarNueva)
    {
        <div class="panel-formulario">
            <h2>Nueva toma de inventario</h2>
            <div class="campo">
                <label for="toma-bodega">Bodega</label>
                <select id="toma-bodega" @bind="nuevaBodId">
                    @foreach (var b in BodegasDeSucursal)
                    {
                        <option value="@b.BodId">@b.SucDescripcion · @b.BodDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo"><label for="toma-fecha">Fecha del conteo</label><input id="toma-fecha" type="date" @bind="nuevaFecha" /></div>
            <div class="campo"><label for="toma-obs">Observaciones</label><input id="toma-obs" maxlength="250" @bind="nuevaObservaciones" /></div>
            <label class="casilla"><input type="checkbox" @bind="nuevaSoloConExistencia" /> Solo productos con existencia en la bodega</label>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Abrir la toma" Etiqueta="Abrir toma" Variante="primario" OnClick="CrearAsync" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNueva = false" />
            </div>
        </div>
    }

    @if (tomas.Count == 0)
    {
        <p class="estado-vacio">No hay tomas de inventario con esos filtros.</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead><tr><th class="col-codigo">Toma</th><th class="col-fecha">Fecha</th><th>Bodega</th><th class="num col-estado">Contados</th><th class="num col-monto">Sobrante</th><th class="num col-monto">Faltante</th><th class="col-estado">Estado</th><th class="col-acciones">Acciones</th></tr></thead>
            <tbody>
                @foreach (var t in tomas)
                {
                    <tr class="@(seleccionada?.TfiId == t.TfiId ? "fila-seleccionada" : "")">
                        <td class="col-codigo">#@t.TfiId</td>
                        <td class="col-fecha">@t.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@t.Bodega<br /><span class="texto-tenue">@t.Sucursal@(string.IsNullOrEmpty(t.Observaciones) ? "" : $" · {t.Observaciones}")</span></td>
                        <td class="num col-estado">@t.Contados / @t.Productos</td>
                        <td class="num col-monto">@(t.Estado == "A" ? t.ValorSobrante.ToString("N2") : "—")</td>
                        <td class="num col-monto">@(t.Estado == "A" ? t.ValorFaltante.ToString("N2") : "—")</td>
                        <td class="col-estado"><span class="estado-badge @ClaseEstado(t.Estado)">@NombreEstado(t.Estado)</span></td>
                        <td class="col-acciones">
                            <div class="acciones-fila">
                                <BotonIcono Icono="@(t.Estado == "B" ? "clipboard-list" : "eye")" Tooltip="@(t.Estado == "B" ? "Registrar conteo" : "Ver detalle")" OnClick="() => AbrirAsync(t)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (pestanaActiva == "toma" && seleccionada is not null)
{
    <section class="tarjeta">
        <div class="maestro-detalle-encabezado">
            <h2>Toma #@seleccionada.TfiId · @seleccionada.Bodega</h2>
            <span class="estado-badge @ClaseEstado(seleccionada.Estado)">@NombreEstado(seleccionada.Estado)</span>
        </div>
        <div class="resumen-totales">
            <span>Fecha: <strong>@seleccionada.Fecha.ToString("dd/MM/yyyy")</strong></span>
            <span>Contados: <strong>@lineas.Count(l => ConteoDe(l) is not null) de @lineas.Count</strong></span>
            <span>Sobrante: <strong>Q @ValorSobrante.ToString("N2")</strong></span>
            <span>Faltante: <strong>Q @ValorFaltante.ToString("N2")</strong></span>
            @if (seleccionada.Estado == "N" && seleccionada.MotivoAnulacion is not null)
            {
                <span>Anulada: <strong>@seleccionada.MotivoAnulacion</strong></span>
            }
        </div>
        @if (EnConteo)
        {
            <p class="texto-ayuda">La existencia es la del sistema en este momento (no se modifica). Anote el conteo; los productos sin conteo no se ajustan. Al aplicar, la diferencia se calcula contra la existencia de ese momento y se valora al costo promedio.</p>
        }

        <div class="barra-herramientas">
            <input placeholder="Buscar por código o descripción" aria-label="Buscar producto" @bind="filtroProducto" @bind:event="oninput" />
            <label class="casilla"><input type="checkbox" @bind="soloDiferencias" /> Solo con diferencia</label>
            <span class="barra-herramientas-separador"></span>
            <a class="boton-icono boton-icono-con-etiqueta" href="reportes/inventario/toma/@(seleccionada.TfiId).xlsx" download title="Hoja de conteo en Excel">
                <Icono Nombre="download" Tamano="16" /><span class="boton-icono-etiqueta">Hoja de conteo</span>
            </a>
            @if (EnConteo)
            {
                <label class="boton-icono boton-icono-con-etiqueta" title="Subir la hoja de conteo llena (columnas Código y Conteo)">
                    <Icono Nombre="upload" Tamano="16" /><span class="boton-icono-etiqueta">Importar conteo</span>
                    <InputFile OnChange="ImportarConteoAsync" accept=".xlsx" class="oculto" />
                </label>
            }
        </div>

        <table class="tabla-datos">
            <thead><tr><th class="col-codigo">Código</th><th>Producto</th><th class="col-estado">Unidad</th><th class="num col-monto">Existencia</th><th class="num col-monto">Conteo</th><th class="num col-monto">Diferencia</th><th class="num col-monto">Costo</th><th class="num col-monto">Valor</th></tr></thead>
            <tbody>
                @if (!LineasVisibles.Any())
                {
                    <tr><td colspan="8" class="doc-tabla-vacia">Ningún producto coincide con el filtro.</td></tr>
                }
                @foreach (var l in LineasVisibles)
                {
                    var conteo = ConteoDe(l);
                    var diferencia = conteo is null ? (decimal?)null : conteo.Value - l.Existencia;
                    <tr class="@(diferencia is > 0 ? "fila-sobrante" : diferencia is < 0 ? "fila-faltante" : "")">
                        <td class="col-codigo">@l.Codigo</td>
                        <td>@l.Descripcion<br /><span class="texto-tenue">@l.TipoProducto</span></td>
                        <td class="col-estado">@l.Unidad</td>
                        <td class="num col-monto">@l.Existencia.ToString("#,##0.##")</td>
                        <td class="num col-monto">
                            @if (EnConteo)
                            {
                                <input class="entrada-numero" type="number" min="0" step="any" aria-label="@($"Conteo de {l.Codigo}")"
                                       value="@conteo" @onchange="e => CambiarConteo(l, e)" />
                            }
                            else
                            {
                                @(conteo?.ToString("#,##0.##") ?? "—")
                            }
                        </td>
                        <td class="num col-monto">@(diferencia?.ToString("+#,##0.##;-#,##0.##;0") ?? "")</td>
                        <td class="num col-monto">@(l.CostoUnitario?.ToString("N2") ?? "")</td>
                        <td class="num col-monto">@(diferencia is null or 0 ? "" : Math.Round(diferencia.Value * (l.CostoUnitario ?? 0), 2).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (EnConteo)
        {
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Guardar el conteo" Etiqueta="Guardar conteo" Variante="primario" Deshabilitado="guardando" OnClick="GuardarConteoAsync" />
                <BotonIcono Icono="check-check" Tooltip="Aplicar la toma y generar los ajustes" Etiqueta="Aplicar ajustes"
                            Confirmacion="@($"¿Aplicar la toma? Sobrante Q {ValorSobrante:N2}, faltante Q {ValorFaltante:N2}.")" Deshabilitado="guardando" OnClick="AplicarAsync" />
            </div>
        }
        @if (seleccionada.Estado != "N")
        {
            <div class="fila-edicion">
                <label for="motivo-toma">Anular la toma@(seleccionada.Estado == "A" ? " (revierte los ajustes y sus pólizas)" : "")</label>
                <input id="motivo-toma" maxlength="200" placeholder="Motivo de la anulación" @bind="motivoAnulacion" @bind:event="oninput" />
                <BotonIcono Icono="ban" Tooltip="Anular la toma" Etiqueta="Anular" Variante="peligro" Deshabilitado="motivoAnulacion.Trim().Length < 5 || guardando" OnClick="AnularAsync" />
            </div>
        }
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<BodegaDetalle> bodegas = Array.Empty<BodegaDetalle>();
    private IReadOnlyList<TomaFisica> tomas = Array.Empty<TomaFisica>();
    private IReadOnlyList<TomaFisicaLinea> lineas = Array.Empty<TomaFisicaLinea>();
    private readonly Dictionary<int, decimal?> conteos = new();
    private TomaFisica? seleccionada;

    private string pestanaActiva = "lista";
    private int? filtroSucId;
    private int? filtroBodId;
    private string filtroEstado = "";
    private string filtroProducto = "";
    private bool soloDiferencias;

    private bool mostrarNueva;
    private int nuevaBodId;
    private DateTime nuevaFecha = DateTime.Today;
    private string nuevaObservaciones = "";
    private bool nuevaSoloConExistencia = true;

    private string motivoAnulacion = "";
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    private bool EnConteo => seleccionada?.Estado == "B";

    private IReadOnlyList<PestanaItem> Pestanas => seleccionada is null
        ? new[] { new PestanaItem("lista", "Tomas") }
        : new[] { new PestanaItem("lista", "Tomas"), new PestanaItem("toma", $"Toma #{seleccionada.TfiId}") };

    private IEnumerable<BodegaDetalle> BodegasDeSucursal =>
        bodegas.Where(b => b.BodEstado == "A" && (filtroSucId is null || b.SucId == filtroSucId));

    private IEnumerable<TomaFisicaLinea> LineasVisibles => lineas.Where(l =>
        (filtroProducto.Length == 0 || l.Codigo.Contains(filtroProducto, StringComparison.OrdinalIgnoreCase)
            || l.Descripcion.Contains(filtroProducto, StringComparison.OrdinalIgnoreCase))
        && (!soloDiferencias || (ConteoDe(l) is { } c && c != l.Existencia)));

    private decimal ValorSobrante => lineas.Sum(l => ConteoDe(l) is { } c && c > l.Existencia ? Math.Round((c - l.Existencia) * (l.CostoUnitario ?? 0), 2) : 0);
    private decimal ValorFaltante => lineas.Sum(l => ConteoDe(l) is { } c && c < l.Existencia ? Math.Round((l.Existencia - c) * (l.CostoUnitario ?? 0), 2) : 0);

    private decimal? ConteoDe(TomaFisicaLinea l) => conteos.TryGetValue(l.ProId, out var c) ? c : l.Conteo;

    private static string NombreEstado(string estado) => estado switch { "B" => "En conteo", "A" => "Aplicada", _ => "Anulada" };
    private static string ClaseEstado(string estado) => estado switch { "B" => "estado-badge-pendiente", "A" => "estado-badge-activo", _ => "estado-badge-inactivo" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bodegas = await BodegaRepository.ConsultarDetalleAsync(null, soloActivas: false);
            var usuario = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User;
            filtroSucId = usuario?.ObtenerSucId();
            if (filtroSucId is not null && bodegas.All(b => b.SucId != filtroSucId)) filtroSucId = null;
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private async Task CambiarSucursalAsync()
    {
        filtroBodId = null;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        try
        {
            tomas = await TomaRepository.ConsultarAsync(filtroSucId, filtroBodId, filtroEstado == "" ? null : filtroEstado);
            if (seleccionada is not null) seleccionada = tomas.FirstOrDefault(t => t.TfiId == seleccionada.TfiId) ?? seleccionada;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarNueva()
    {
        mensaje = null;
        nuevaBodId = filtroBodId ?? BodegasDeSucursal.FirstOrDefault()?.BodId ?? 0;
        nuevaFecha = DateTime.Today;
        nuevaObservaciones = "";
        mostrarNueva = true;
    }

    private async Task CrearAsync()
    {
        if (nuevaBodId == 0)
        {
            mensaje = "Seleccione la bodega.";
            esMensajeError = true;
            return;
        }
        try
        {
            var id = await TomaRepository.CrearAsync(nuevaBodId, nuevaFecha, nuevaObservaciones, nuevaSoloConExistencia, await ObtenerUsuIdActualAsync());
            mostrarNueva = false;
            await BuscarAsync();
            var toma = tomas.FirstOrDefault(t => t.TfiId == id);
            if (toma is not null) await AbrirAsync(toma);
            MostrarOk($"Toma #{id} abierta. Registre el conteo de cada producto.");
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AbrirAsync(TomaFisica toma)
    {
        seleccionada = toma;
        conteos.Clear();
        motivoAnulacion = "";
        filtroProducto = "";
        soloDiferencias = toma.Estado != "B";
        pestanaActiva = "toma";
        try { lineas = await TomaRepository.ConsultarLineasAsync(toma.TfiId); }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void CambiarConteo(TomaFisicaLinea linea, ChangeEventArgs e)
    {
        var texto = e.Value?.ToString();
        conteos[linea.ProId] = decimal.TryParse(texto, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var valor) && valor >= 0
            ? valor : null;
    }

    private async Task GuardarConteoAsync()
    {
        if (seleccionada is null) return;
        guardando = true;
        try
        {
            await GuardarPendientesAsync();
            MostrarOk("Conteo guardado. Puede seguir contando o aplicar la toma.");
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    private async Task GuardarPendientesAsync()
    {
        if (seleccionada is null || conteos.Count == 0) return;
        await TomaRepository.GuardarConteoAsync(seleccionada.TfiId, conteos.Select(c => (c.Key, c.Value)).ToList(), await ObtenerUsuIdActualAsync());
        conteos.Clear();
        lineas = await TomaRepository.ConsultarLineasAsync(seleccionada.TfiId);
        await BuscarAsync();
    }

    private async Task ImportarConteoAsync(InputFileChangeEventArgs e)
    {
        if (seleccionada is null) return;
        try
        {
            using var memoria = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoria);
            memoria.Position = 0;
            using var lector = LectorExcel.Leer(memoria, ReportesExcel.ColumnasConteo);
            var porCodigo = lineas.ToDictionary(l => l.Codigo, StringComparer.OrdinalIgnoreCase);
            int aplicados = 0, desconocidos = 0;
            foreach (var fila in lector.Filas)
            {
                var codigo = lector.Texto(fila, "Código");
                if (codigo is null) continue;
                var conteo = lector.Numero(fila, "Conteo");
                if (!porCodigo.TryGetValue(codigo, out var linea)) { desconocidos++; continue; }
                if (conteo is null) continue;
                conteos[linea.ProId] = Math.Max(0, conteo.Value);
                aplicados++;
            }
            if (lector.Errores.Count > 0)
            {
                mensaje = string.Join(" ", lector.Errores.Take(5).Select(m => (m.Fila > 0 ? $"Fila {m.Fila}: " : "") + m.Mensaje));
                esMensajeError = true;
                return;
            }
            MostrarOk($"Se leyeron {aplicados} conteos{(desconocidos > 0 ? $" ({desconocidos} códigos no están en esta toma)" : "")}. Revise y presione Guardar conteo.");
        }
        catch (Exception)
        {
            mensaje = "No se pudo leer el archivo. Verifique que sea un libro de Excel (.xlsx) válido.";
            esMensajeError = true;
        }
    }

    // ---- Borrador: los conteos escritos y aún no guardados se conservan al salir ----
    private sealed record BorradorConteo(int TfiId, string Bodega, Dictionary<int, decimal?> Conteos);

    private BorradorConteo? CapturarBorrador() =>
        seleccionada is null || !EnConteo || conteos.Count == 0 ? null
            : new BorradorConteo(seleccionada.TfiId, seleccionada.Bodega, new Dictionary<int, decimal?>(conteos));

    private static string DescribirBorrador(BorradorConteo b) =>
        $"toma #{b.TfiId} de {b.Bodega}, {b.Conteos.Count} {(b.Conteos.Count == 1 ? "producto contado" : "productos contados")}";

    private async Task RestaurarBorradorAsync(BorradorConteo b)
    {
        try
        {
            var toma = (await TomaRepository.ConsultarAsync(null, null, "B")).FirstOrDefault(t => t.TfiId == b.TfiId);
            if (toma is null)
            {
                mensaje = $"La toma #{b.TfiId} ya no está en conteo (se aplicó o se anuló): el conteo sin guardar no se puede recuperar.";
                esMensajeError = true;
                return;
            }
            await AbrirAsync(toma);
            foreach (var l in lineas)
                if (b.Conteos.TryGetValue(l.ProId, out var conteo)) conteos[l.ProId] = conteo;
            MostrarOk($"Se {(conteos.Count == 1 ? "recuperó 1 conteo" : $"recuperaron {conteos.Count} conteos")} sin guardar de la toma #{b.TfiId}. Presione Guardar conteo para grabarlos.");
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AplicarAsync()
    {
        if (seleccionada is null) return;
        guardando = true;
        try
        {
            await GuardarPendientesAsync();
            await TomaRepository.AplicarAsync(seleccionada.TfiId, await ObtenerUsuIdActualAsync());
            await BuscarAsync();
            var toma = tomas.FirstOrDefault(t => t.TfiId == seleccionada.TfiId);
            if (toma is not null) await AbrirAsync(toma);
            MostrarOk($"Toma aplicada: sobrante Q {toma?.ValorSobrante:N2} y faltante Q {toma?.ValorFaltante:N2}, con sus documentos de ajuste y pólizas.");
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    private async Task AnularAsync()
    {
        if (seleccionada is null) return;
        guardando = true;
        try
        {
            await TomaRepository.AnularAsync(seleccionada.TfiId, motivoAnulacion.Trim(), await ObtenerUsuIdActualAsync());
            await BuscarAsync();
            var toma = tomas.FirstOrDefault(t => t.TfiId == seleccionada.TfiId);
            if (toma is not null) await AbrirAsync(toma);
            MostrarOk("Toma anulada.");
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
