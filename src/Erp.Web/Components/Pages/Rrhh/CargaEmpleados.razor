@page "/rrhh/carga-empleados"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:RRHH_ADMIN")]
@using Erp.Data.Cargas
@using Erp.Data.General
@using Erp.Web.Reportes
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject ICargasRepository CargasRepository
@inject IGeneralRepository GeneralRepository

<PageTitle>Carga de empleados</PageTitle>

<div class="pagina-encabezado">
    <h1>Carga de empleados desde Excel</h1>
    <p>Alta o actualización de empleados por código, con su plaza (su departamento es el centro de costo), salario y datos de pago de nómina.</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="pasos-carga">
    <div class="panel-formulario">
        <h3>1. Descargue la plantilla</h3>
        <p class="texto-ayuda">Trae la hoja para llenar, las instrucciones y las plazas, bancos y tipos de documento válidos.</p>
        <a class="boton-icono boton-icono-con-etiqueta" href="reportes/rrhh/plantilla-empleados.xlsx" download>
            <Icono Nombre="download" Tamano="16" /><span class="boton-icono-etiqueta">Plantilla de Excel</span>
        </a>
    </div>
    <div class="panel-formulario">
        <h3>2. Suba el archivo lleno</h3>
        <div class="campo">
            <label for="emp-cia">Compañía</label>
            <select id="emp-cia" @bind="ciaId" @bind:after="RevalidarAsync">
                @foreach (var c in companias)
                {
                    <option value="@c.CiaId">@c.CiaNombreComercial</option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="emp-archivo">Archivo (.xlsx)</label>
            <InputFile id="emp-archivo" OnChange="LeerArchivoAsync" accept=".xlsx" />
        </div>
    </div>
    <div class="panel-formulario">
        <h3>3. Revise y grabe</h3>
        @if (resultado?.Resumen is { } r)
        {
            <div class="resumen-totales">
                <span>Filas: <strong>@r.Filas</strong></span>
                <span>Nuevos: <strong>@r.Nuevos</strong></span>
                <span>Actualizados: <strong>@r.Actualizados</strong></span>
            </div>
        }
        else
        {
            <p class="texto-ayuda">El archivo se valida completo; si alguna fila tiene error no se graba ninguna.</p>
        }
        <BotonIcono Icono="save" Tooltip="Grabar los empleados" Etiqueta="Grabar empleados" Variante="primario"
                    Deshabilitado="!PuedeGrabar || guardando" OnClick="GrabarAsync" />
    </div>
</div>

@if (resultado is not null)
{
    <section class="tarjeta">
        <h2>Validación de @nombreArchivo</h2>
        <MensajesCargaVista Mensajes="resultado.Mensajes" />
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly string[] Obligatorias = { "Código", "Primer nombre", "Primer apellido", "Salario base", "Forma pago" };

    private IReadOnlyList<Compania> companias = Array.Empty<Compania>();
    private int ciaId;
    private List<FilaEmpleado> filas = new();
    private ResultadoCarga<ResumenEmpleados>? resultado;
    private string nombreArchivo = "";
    private bool lecturaConErrores;
    private List<MensajeCarga> erroresLectura = new();
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    private bool PuedeGrabar => resultado is not null && !resultado.TieneErrores && !lecturaConErrores && filas.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            companias = await GeneralRepository.ConsultarCompaniasAsync(soloActivas: true);
            ciaId = companias.FirstOrDefault()?.CiaId ?? 0;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private async Task LeerArchivoAsync(InputFileChangeEventArgs e)
    {
        mensaje = null;
        resultado = null;
        filas = new();
        nombreArchivo = e.File.Name;
        try
        {
            using var memoria = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoria);
            memoria.Position = 0;
            using var lector = LectorExcel.Leer(memoria, ReportesExcel.ColumnasEmpleados);
            var faltantes = lector.ColumnasFaltantes(Obligatorias).ToList();
            if (lector.Errores.Count == 0 && faltantes.Count > 0)
                lector.Errores.Add(new MensajeCarga { Mensaje = $"Faltan las columnas: {string.Join(", ", faltantes)}." });
            if (lector.Errores.Count == 0)
                foreach (var f in lector.Filas)
                    filas.Add(new FilaEmpleado
                    {
                        Fila = f.RowNumber(),
                        Codigo = lector.Texto(f, "Código"),
                        PrimerNombre = lector.Texto(f, "Primer nombre"),
                        SegundoNombre = lector.Texto(f, "Segundo nombre"),
                        PrimerApellido = lector.Texto(f, "Primer apellido"),
                        SegundoApellido = lector.Texto(f, "Segundo apellido"),
                        // "Masculino", "m", "M" → M; lo mismo con tipo de nómina, forma de pago y tipo de cuenta.
                        Genero = lector.Letra(f, "Género"),
                        FechaNacimiento = lector.Fecha(f, "Fecha nacimiento"),
                        FechaIngreso = lector.Fecha(f, "Fecha ingreso"),
                        TipoDocumento = lector.Texto(f, "Tipo documento"),
                        NumeroDocumento = lector.Texto(f, "Número documento"),
                        AfiliacionIGSS = lector.Texto(f, "Afiliación IGSS"),
                        Nit = lector.Texto(f, "NIT"),
                        Email = lector.Texto(f, "Email"),
                        Direccion = lector.Texto(f, "Dirección"),
                        Plaza = lector.Texto(f, "Plaza"),
                        SalarioBase = lector.Numero(f, "Salario base"),
                        TipoNomina = lector.Letra(f, "Tipo nómina"),
                        FormaPago = lector.Letra(f, "Forma pago"),
                        Banco = lector.Texto(f, "Banco"),
                        TipoCuenta = lector.Letra(f, "Tipo cuenta"),
                        NumeroCuenta = lector.Texto(f, "Número cuenta")
                    });

            erroresLectura = lector.Errores.ToList();
            lecturaConErrores = erroresLectura.Count > 0;
            // Sin encabezados válidos no hay filas que validar.
            if (erroresLectura.Any(m => m.Fila == 0))
            {
                resultado = new ResultadoCarga<ResumenEmpleados> { Mensajes = erroresLectura };
                return;
            }
            await RevalidarAsync();
        }
        catch (Exception ex) when (ex is not Microsoft.Data.SqlClient.SqlException)
        {
            mensaje = "No se pudo leer el archivo. Verifique que sea un libro de Excel (.xlsx) válido y que no esté abierto en otro programa.";
            esMensajeError = true;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    // Valida en la base y junta esos mensajes con los valores que no se pudieron leer.
    private async Task RevalidarAsync()
    {
        if (filas.Count == 0) return;
        try
        {
            var validacion = await CargasRepository.ProcesarEmpleadosAsync(ciaId, filas, soloValidar: true, await ObtenerUsuIdActualAsync());
            resultado = new ResultadoCarga<ResumenEmpleados>
            {
                Mensajes = erroresLectura.Concat(validacion.Mensajes).OrderBy(m => m.Fila).ThenBy(m => m.Tipo == "E" ? 0 : 1).ToList(),
                Resumen = validacion.Resumen
            };
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task GrabarAsync()
    {
        guardando = true;
        try
        {
            resultado = await CargasRepository.ProcesarEmpleadosAsync(ciaId, filas, soloValidar: false, await ObtenerUsuIdActualAsync());
            if (resultado.Resumen?.Grabado == true)
            {
                mensaje = $"Empleados grabados: {resultado.Resumen.Nuevos} nuevo(s) y {resultado.Resumen.Actualizados} actualizado(s).";
                esMensajeError = false;
                filas = new();
            }
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
