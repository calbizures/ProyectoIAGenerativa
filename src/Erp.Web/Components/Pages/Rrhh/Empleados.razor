@page "/rrhh/empleados"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:RRHH_ADMIN")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Caja
@using Erp.Data.General
@using Erp.Data.Rrhh
@using Erp.Data.Security
@using Erp.Data.Ventas
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IRrhhRepository RrhhRepository
@inject IIgssRepository IgssRepository
@inject IGeneralRepository GeneralRepository
@inject IUsuarioRepository UsuarioRepository
@inject IVendedorRepository VendedorRepository

<PageTitle>@L("Empleados")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Empleados")</h1>
    <p>@L("Ficha del empleado, su plaza y su vínculo con el usuario del sistema y el vendedor.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-herramientas">
        <input placeholder="@L("Buscar por código o nombre")" aria-label="@L("Buscar por código o nombre")" @bind="filtro" type="search" @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarAsync(); })" />
        <select @bind="filtroEstado" aria-label="@L("Estado")">
            <option value="A">@L("Activos")</option>
            <option value="B">@L("De baja")</option>
            <option value="">@L("Todos")</option>
        </select>
        <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />
        <span class="barra-herramientas-separador"></span>
        <a class="boton-icono boton-icono-con-etiqueta" href="rrhh/carga-empleados" title="@L("Alta o actualización de empleados desde Excel")">
            <Icono Nombre="upload" Tamano="16" /><span class="boton-icono-etiqueta">@L("Cargar desde Excel")</span>
        </a>
        <BotonIcono Icono="user-plus" Tooltip="@L("Nuevo empleado")" Etiqueta="@L("Nuevo empleado")" Variante="primario" OnClick="IniciarNuevo" />
    </div>

    @if (empleados.Count == 0)
    {
        <p class="estado-vacio">@L("No hay empleados que coincidan con la búsqueda.")</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr><th class="col-codigo">@L("Código")</th><th>@L("Nombre")</th><th>@L("Puesto")</th><th>@L("Departamento")</th><th class="col-estado">@L("Nómina")</th><th>@L("Pago")</th><th class="col-fecha">@L("Ingreso")</th><th class="num col-monto">@L("Salario base")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr>
            </thead>
            <tbody>
                @foreach (var e in empleados)
                {
                    <tr class="@(seleccionado?.IdEmpleado == e.IdEmpleado ? "fila-seleccionada" : "")">
                        <td class="col-codigo">@e.CodigoEmpleado</td>
                        <td>@e.NombreCompleto</td>
                        <td>@e.Puesto</td>
                        <td>@e.Departamento</td>
                        <td class="col-estado">@NombreTipoNomina(e.TipoNomina)</td>
                        <td>@(e.FormaPago switch { "T" => L("Transferencia · {0}", e.Banco), "C" => L("Cheque"), _ => L("Sin definir") })</td>
                        <td class="col-fecha">@e.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td class="num col-monto">@e.SalarioBase.ToString("N2")</td>
                        <td class="col-estado"><span class="estado-badge @(e.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(e.Estado == "A" ? L("Activo") : L("De baja"))</span></td>
                        <td class="col-acciones">
                            <div class="acciones-fila">
                                <BotonIcono Icono="eye" Tooltip="@L("Ver detalle")" OnClick="() => SeleccionarAsync(e.IdEmpleado)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (pestanaActiva == "detalle" && seleccionado is not null)
{
    <div class="panel-detalle panel-ancho">
        <h2>@seleccionado.CodigoEmpleado — @seleccionado.NombreCompleto</h2>
        <div class="campo"><label>@L("Estado")</label><span class="valor-detalle">@(seleccionado.Estado == "A" ? L("Activo") : L("De baja desde {0:dd/MM/yyyy}", seleccionado.FechaBaja))</span></div>
        <div class="campo"><label>@L("Compañía")</label><span class="valor-detalle">@companias.FirstOrDefault(c => c.CiaId == seleccionado.CiaId)?.CiaNombreComercial</span></div>
        <div class="campo"><label>@L("Documento")</label><span class="valor-detalle">@NombreTipoDocumento(seleccionado.IdTipoDocumentoIdentificacion) @seleccionado.NumeroDocumento</span></div>
        <div class="campo"><label>@L("Afiliación IGSS")</label><span class="valor-detalle">@seleccionado.NumeroAfiliacionIGSS</span></div>
        <div class="campo"><label>@L("NIT")</label><span class="valor-detalle">@seleccionado.Nit</span></div>
        <div class="campo"><label>@L("Correo electrónico")</label><span class="valor-detalle">@seleccionado.Email</span></div>
        <div class="campo"><label>@L("Género")</label><span class="valor-detalle">@(seleccionado.Genero switch { "M" => L("Masculino"), "F" => L("Femenino"), _ => "—" })</span></div>
        <div class="campo"><label>@L("Fecha de nacimiento")</label><span class="valor-detalle">@(seleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</span></div>
        <div class="campo"><label>@L("Fecha de ingreso")</label><span class="valor-detalle">@seleccionado.FechaIngreso.ToString("dd/MM/yyyy")</span></div>
        <div class="campo campo-ancho"><label>@L("Dirección")</label><span class="valor-detalle">@(seleccionado.DireccionCompleta ?? "—")</span></div>
        <div class="campo"><label>@L("Departamento")</label><span class="valor-detalle">@(seleccionado.Departamento ?? "—")</span></div>
        <div class="campo"><label>@L("Municipio")</label><span class="valor-detalle">@(seleccionado.Municipio ?? "—")</span></div>
        <div class="campo"><label>@L("Plaza")</label><span class="valor-detalle">@(plazas.FirstOrDefault(p => p.IdPlaza == seleccionado.IdPlaza)?.Descripcion ?? L("Sin plaza"))</span></div>
        <div class="campo"><label>@L("Salario base")</label><span class="valor-detalle">Q @seleccionado.SalarioBase.ToString("N2")</span></div>

        <div class="acciones-fila">
            <BotonIcono Icono="pencil" Tooltip="@L("Editar")" Etiqueta="@L("Editar")" OnClick="IniciarEdicion" />
            @if (seleccionado.Estado == "A")
            {
                <label class="filtro-campo">@L("Fecha de baja") <input type="date" @bind="fechaBaja" /></label>
                <BotonIcono Icono="ban" Tooltip="@L("Dar de baja")" Etiqueta="@L("Dar de baja")" Variante="peligro" Confirmacion="@(L("¿Dar de baja al empleado el {0:dd/MM/yyyy}?", fechaBaja))" OnClick="DarBajaAsync" />
            }
            else
            {
                <BotonIcono Icono="refresh-cw" Tooltip="@L("Reactivar")" Etiqueta="@L("Reactivar")" OnClick="ReactivarAsync" />
            }
        </div>

        <h3>@L("Vínculos con el sistema")</h3>
        <p class="texto-ayuda">@L("El usuario y el vendedor son roles del empleado: al facturar, el sistema propone como vendedor el del usuario que inició sesión.")</p>
        <div class="campo">
            <label for="emp-usuario">@L("Usuario del sistema")</label>
            <div class="fila-edicion">
                <select id="emp-usuario" @bind="usuIdVinculo">
                    <option value="">@L("(Sin usuario)")</option>
                    @foreach (var u in usuarios)
                    {
                        <option value="@u.UsuId">@u.UsuUsuario (@u.UsuCodigo)</option>
                    }
                </select>
                <BotonIcono Icono="link" Tooltip="@L("Guardar usuario")" Etiqueta="@L("Asignar")" OnClick="AsignarUsuarioAsync" />
            </div>
        </div>
        <div class="campo">
            <label for="emp-vendedor">@L("Vendedor")</label>
            <div class="fila-edicion">
                <select id="emp-vendedor" @bind="pveIdVinculo">
                    <option value="">@L("(No es vendedor)")</option>
                    @foreach (var v in vendedores)
                    {
                        <option value="@v.PveId">@v.PveCodigo — @v.PveNombres @v.PveApellidos</option>
                    }
                </select>
                <BotonIcono Icono="link" Tooltip="@L("Guardar vendedor")" Etiqueta="@L("Asignar")" OnClick="AsignarVendedorAsync" />
            </div>
        </div>

        <h3>@L("Pago de nómina")</h3>
        <p class="texto-ayuda">@L("No se paga en efectivo. El empleado entra solo en las nóminas de su tipo y su departamento (por la plaza) es el centro de costo de su sueldo.")</p>
        <div class="panel-formulario panel-ancho">
            <div class="campo">
                <label for="emp-tipo-nomina">@L("Tipo de nómina")</label>
                <select id="emp-tipo-nomina" @bind="pagoTipoNomina">
                    <option value="S">@L("Semanal")</option>
                    <option value="Q">@L("Quincenal")</option>
                    <option value="M">@L("Mensual")</option>
                </select>
            </div>
            <div class="campo">
                <label for="emp-forma-pago">@L("Forma de pago")</label>
                <select id="emp-forma-pago" @bind="pagoForma">
                    <option value="">@L("Seleccione...")</option>
                    <option value="T">@L("Transferencia a su cuenta")</option>
                    <option value="C">@L("Cheque")</option>
                </select>
            </div>
            <div class="campo">
                <label for="emp-banco">@L("Banco")</label>
                <select id="emp-banco" @bind="pagoGefId">
                    <option value="">@L("(Sin banco)")</option>
                    @foreach (var b in bancos)
                    {
                        <option value="@b.GefId">@b.GefDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="emp-tipo-cuenta">@L("Tipo de cuenta")</label>
                <select id="emp-tipo-cuenta" @bind="pagoTipoCuenta">
                    <option value="">@L("(Sin cuenta)")</option>
                    <option value="M">@L("Monetaria")</option>
                    <option value="A">@L("Ahorro")</option>
                </select>
            </div>
            <div class="campo">
                <label for="emp-numero-cuenta">@L("Número de cuenta")</label>
                <input id="emp-numero-cuenta" maxlength="30" @bind="pagoNumeroCuenta" />
                @if (pagoForma == "T")
                {
                    <small class="texto-ayuda">@L("Obligatorios para transferencia: banco, tipo y número de cuenta.")</small>
                }
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Guardar datos de pago")" Etiqueta="@L("Guardar pago")" Variante="primario" OnClick="GuardarPagoAsync" />
            </div>
        </div>

        <h3>@L("IGSS y libro de salarios")</h3>
        <p class="texto-ayuda">@L("El centro de trabajo fija las tasas del IGSS, IRTRA e INTECAP y la planilla en la que se reporta. Si no se indica, se toma la sucursal del departamento del empleado.")</p>
        <div class="panel-formulario panel-ancho">
            <div class="campo">
                <label for="emp-centro">@L("Centro de trabajo (IGSS)")</label>
                <select id="emp-centro" @bind="laboralSucId">
                    <option value="">@L("(La sucursal de su departamento)")</option>
                    @foreach (var c in centrosTrabajo)
                    {
                        <option value="@c.SucId">@c.Codigo — @c.Descripcion@(c.CentroTrabajo is null ? "" : L(" · centro {0}", c.CentroTrabajo))</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="emp-nacionalidad">@L("Nacionalidad")</label>
                <input id="emp-nacionalidad" maxlength="40" placeholder="GUATEMALTECA" @bind="laboralNacionalidad" />
            </div>
            <div class="campo">
                <label for="emp-jornada">@L("Jornada")</label>
                <select id="emp-jornada" @bind="laboralJornada">
                    <option value="D">@L("Diurna (48 horas semanales)")</option>
                    <option value="M">@L("Mixta (42 horas semanales)")</option>
                    <option value="N">@L("Nocturna (36 horas semanales)")</option>
                </select>
            </div>
            <div class="campo">
                <label for="emp-tiempo">@L("Contrato")</label>
                <select id="emp-tiempo" @bind="laboralTiempo">
                    <option value="TC">@L("Tiempo completo")</option>
                    <option value="TP">@L("Tiempo parcial")</option>
                </select>
            </div>
            @if (igss is not null)
            {
                <div class="campo">
                    <label for="emp-tipo-planilla">@L("Tipo de planilla del IGSS")</label>
                    <select id="emp-tipo-planilla" @bind="igss.IdIgssTipoPlanilla">
                        <option value="">@L("(Sin asignar)")</option>
                        @foreach (var t in tiposPlanilla)
                        {
                            <option value="@t.IdTipoPlanilla">@t.Codigo · @t.Nombre</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="emp-condicion">@L("Condición laboral")</label>
                    <select id="emp-condicion" @bind="igss.CondicionLaboral">
                        <option value="P">@L("Permanente")</option>
                        <option value="T">@L("Temporal")</option>
                    </select>
                </div>
                <div class="campo">
                    <label for="emp-tipo-salario">@L("Tipo de salario (IGSS)")</label>
                    <select id="emp-tipo-salario" @bind="igss.IgssTipoSalario">
                        @foreach (var t in catalogosIgss.TiposSalario)
                        {
                            <option value="@t.Codigo">@t.Texto</option>
                        }
                    </select>
                </div>
                @if (laboralTiempo == "TP")
                {
                    <div class="campo">
                        <label for="emp-horas">@L("Horas diarias (tiempo parcial)")</label>
                        <input id="emp-horas" type="number" min="0.5" max="24" step="0.5" @bind="igss.HorasDiarias" />
                    </div>
                }
                <div class="campo campo-ancho">
                    <label for="emp-ocupacion">@L("Ocupación (CIUO-88)")</label>
                    <select id="emp-ocupacion" @bind="igss.IgssOcupacion">
                        <option value="">@(igss.OcupacionPuesto is null ? L("(Sin ocupación: asígnela al puesto)") : L("La del puesto: {0} · {1}", igss.OcupacionPuesto, igss.OcupacionPuestoDescripcion))</option>
                        @foreach (var o in catalogosIgss.Ocupaciones)
                        {
                            <option value="@o.Codigo">@o.Texto</option>
                        }
                    </select>
                </div>
            }
            @if (seleccionado.FolioLibroSalarios is int folio)
            {
                <div class="campo"><label>@L("Folio del libro de salarios")</label><span class="valor-detalle">@folio</span></div>
            }
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Guardar datos laborales")" Etiqueta="@L("Guardar datos laborales")" Variante="primario" OnClick="GuardarLaboralAsync" />
            </div>
        </div>

        <h3>@L("Historial de plazas y salario")</h3>
        @if (historial.Count == 0)
        {
            <p class="estado-vacio">@L("Sin historial.")</p>
        }
        else
        {
            <table class="tabla-datos">
                <thead><tr><th>@L("Plaza")</th><th class="col-fecha">@L("Desde")</th><th class="col-fecha">@L("Hasta")</th><th class="num col-monto">@L("Salario")</th></tr></thead>
                <tbody>
                    @foreach (var h in historial)
                    {
                        <tr>
                            <td>@h.Plaza</td>
                            <td class="col-fecha">@h.FechaDel.ToString("dd/MM/yyyy")</td>
                            <td class="col-fecha">@(h.FechaAl?.ToString("dd/MM/yyyy") ?? L("Vigente"))</td>
                            <td class="num col-monto">@h.Salario.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else if (pestanaActiva == "editar")
{
    <div class="panel-formulario">
        <h2>@(modelo.IdEmpleado == 0 ? L("Nuevo empleado") : L("Editar: {0}", modelo.CodigoEmpleado))</h2>
        <EditForm Model="modelo" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label for="empleados-codigoempleado">@L("Código de empleado")</label><InputText id="empleados-codigoempleado" @bind-Value="modelo.CodigoEmpleado" /></div>
            <div class="campo">
                <label for="empleados-ciaid">@L("Compañía")</label>
                <InputSelect id="empleados-ciaid" @bind-Value="modelo.CiaId">
                    @foreach (var c in companias)
                    {
                        <option value="@c.CiaId">@c.CiaNombreComercial</option>
                    }
                </InputSelect>
            </div>
            <div class="campo"><label for="empleados-primernombre">@L("Primer nombre")</label><InputText id="empleados-primernombre" @bind-Value="modelo.PrimerNombre" /></div>
            <div class="campo"><label for="empleados-segundonombre">@L("Segundo nombre")</label><InputText id="empleados-segundonombre" @bind-Value="modelo.SegundoNombre" /></div>
            <div class="campo"><label for="empleados-primerapellido">@L("Primer apellido")</label><InputText id="empleados-primerapellido" @bind-Value="modelo.PrimerApellido" /></div>
            <div class="campo"><label for="empleados-segundoapellido">@L("Segundo apellido")</label><InputText id="empleados-segundoapellido" @bind-Value="modelo.SegundoApellido" /></div>
            <div class="campo"><label for="empleados-apellidocasada">@L("Apellido de casada")</label><InputText id="empleados-apellidocasada" @bind-Value="modelo.ApellidoCasada" /></div>
            <div class="campo">
                <label for="empleados-genero">@L("Género")</label>
                <InputSelect id="empleados-genero" @bind-Value="modelo.Genero">
                    <option value="">@L("(Sin indicar)")</option>
                    <option value="M">@L("Masculino")</option>
                    <option value="F">@L("Femenino")</option>
                </InputSelect>
            </div>
            <div class="campo"><label for="empleados-fechanacimiento">@L("Fecha de nacimiento")</label><InputDate id="empleados-fechanacimiento" @bind-Value="modelo.FechaNacimiento" /></div>
            <div class="campo"><label for="empleados-fechaingreso">@L("Fecha de ingreso")</label><InputDate id="empleados-fechaingreso" @bind-Value="modelo.FechaIngreso" /></div>
            <div class="campo"><label for="empleados-direccion">@L("Dirección")</label><InputText id="empleados-direccion" @bind-Value="modelo.Direccion" placeholder="@L("Calle, número, zona o colonia")" /></div>
            <SelectorUbicacion @bind-ProvId="modelo.ProvId" IdPrefijo="empleados" />
            <div class="campo">
                <label for="empleados-idtipodocumentoidentificacion">@L("Tipo de documento")</label>
                <InputSelect id="empleados-idtipodocumentoidentificacion" @bind-Value="modelo.IdTipoDocumentoIdentificacion">
                    <option value="">@L("(Sin indicar)")</option>
                    @foreach (var t in tiposDocumento)
                    {
                        <option value="@t.Id">@t.Descripcion</option>
                    }
                </InputSelect>
            </div>
            <div class="campo"><label for="empleados-numerodocumento">@L("Número de documento")</label><InputText id="empleados-numerodocumento" @bind-Value="modelo.NumeroDocumento" /></div>
            <div class="campo"><label for="empleados-numeroafiliacionigss">@L("Afiliación IGSS")</label><InputText id="empleados-numeroafiliacionigss" @bind-Value="modelo.NumeroAfiliacionIGSS" /></div>
            <div class="campo"><label for="empleados-nit">@L("NIT")</label><InputText id="empleados-nit" @bind-Value="modelo.Nit" /></div>
            <div class="campo"><label for="empleados-email">@L("Correo electrónico")</label><InputText id="empleados-email" @bind-Value="modelo.Email" /></div>
            <div class="campo">
                <label for="empleados-idplaza">@L("Plaza")</label>
                <InputSelect id="empleados-idplaza" @bind-Value="modelo.IdPlaza">
                    <option value="">@L("(Sin plaza)")</option>
                    @foreach (var p in plazas.Where(p => p.Estado == "A" && (p.IdEmpleadoOcupante is null || p.IdEmpleadoOcupante == modelo.IdEmpleado)))
                    {
                        <option value="@p.IdPlaza">@p.Descripcion — @p.Puesto (@p.Departamento)</option>
                    }
                </InputSelect>
            </div>
            <div class="campo"><label for="empleados-salariobase">@L("Salario base mensual")</label><InputNumber id="empleados-salariobase" @bind-Value="modelo.SalarioBase" step="0.01" /></div>
            <p class="texto-ayuda">@L("Cambiar la plaza o el salario cierra el registro vigente del historial y abre uno nuevo.")</p>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="CancelarEdicion" />
            </div>
        </EditForm>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<EmpleadoResumen> empleados = Array.Empty<EmpleadoResumen>();
    private IReadOnlyList<Compania> companias = Array.Empty<Compania>();
    private IReadOnlyList<Plaza> plazas = Array.Empty<Plaza>();
    private IReadOnlyList<CatalogoRrhh> tiposDocumento = Array.Empty<CatalogoRrhh>();
    private IReadOnlyList<Usuario> usuarios = Array.Empty<Usuario>();
    private IReadOnlyList<Vendedor> vendedores = Array.Empty<Vendedor>();

    private Empleado? seleccionado;
    private IReadOnlyList<HistorialPlaza> historial = Array.Empty<HistorialPlaza>();
    private EmpleadoModelo modelo = new();
    private int? usuIdVinculo;
    private int? pveIdVinculo;
    private IReadOnlyList<EntidadFinanciera> bancos = Array.Empty<EntidadFinanciera>();
    private string pagoTipoNomina = "M";
    private string pagoForma = "";
    private int? pagoGefId;
    private string pagoTipoCuenta = "";
    private string pagoNumeroCuenta = "";
    private DateTime fechaBaja = DateTime.Today;
    private IReadOnlyList<SucursalIgss> centrosTrabajo = Array.Empty<SucursalIgss>();
    private int? laboralSucId;
    private string laboralNacionalidad = "";
    private string laboralJornada = "D";
    // Datos para la planilla del IGSS (script 55).
    private EmpleadoIgss? igss;
    private IgssCatalogos catalogosIgss = new();
    private IReadOnlyList<IgssTipoPlanilla> tiposPlanilla = Array.Empty<IgssTipoPlanilla>();
    private string laboralTiempo = "TC";

    private string pestanaActiva = "lista";
    private string filtro = "";
    private string filtroEstado = "A";
    private string? mensaje;
    private bool esMensajeError;

    private IReadOnlyList<PestanaItem> Pestanas
    {
        get
        {
            var lista = new List<PestanaItem> { new("lista", L("Lista")) };
            if (seleccionado is not null) lista.Add(new("detalle", L("Detalle")));
            if (pestanaActiva == "editar") lista.Add(new("editar", modelo.IdEmpleado == 0 ? L("Nuevo") : L("Editar")));
            return lista;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            companias = await GeneralRepository.ConsultarCompaniasAsync(soloActivas: true);
            tiposDocumento = await RrhhRepository.ConsultarCatalogoAsync("TipoDocumentoIdentificacion", soloActivos: true);
            usuarios = await UsuarioRepository.ConsultarAsync(null, "A", 1, 500);
            vendedores = await VendedorRepository.ConsultarAsync("A");
            var tipoBanco = (await GeneralRepository.ConsultarTiposEntidadAsync()).FirstOrDefault(t => t.GeftDescripcion == "Banco");
            if (tipoBanco is not null) bancos = await GeneralRepository.ConsultarEntidadesAsync(tipoBanco.GeftId, soloActivas: true);
            await CargarPlazasAsync();
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task CargarPlazasAsync() => plazas = await RrhhRepository.ConsultarPlazasAsync(soloActivos: false);

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private string? NombreTipoDocumento(int? id) => tiposDocumento.FirstOrDefault(t => t.Id == id)?.Descripcion;

    private async Task BuscarAsync()
    {
        try
        {
            empleados = await RrhhRepository.ConsultarEmpleadosAsync(
                string.IsNullOrWhiteSpace(filtro) ? null : filtro.Trim(),
                string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task SeleccionarAsync(int idEmpleado)
    {
        mensaje = null;
        try
        {
            var (empleado, hist) = await RrhhRepository.ConsultarEmpleadoPorIdAsync(idEmpleado);
            seleccionado = empleado;
            historial = hist;
            usuIdVinculo = empleado?.UsuId;
            pveIdVinculo = empleado?.PveId;
            pagoTipoNomina = empleado?.TipoNomina ?? "M";
            pagoForma = empleado?.FormaPago ?? "";
            pagoGefId = empleado?.GefId;
            pagoTipoCuenta = empleado?.TipoCuenta ?? "";
            pagoNumeroCuenta = empleado?.NumeroCuenta ?? "";
            laboralSucId = empleado?.SucId;
            laboralNacionalidad = empleado?.Nacionalidad ?? "";
            laboralJornada = empleado?.Jornada ?? "D";
            laboralTiempo = empleado?.TiempoContrato ?? "TC";
            centrosTrabajo = empleado is null ? Array.Empty<SucursalIgss>() : await RrhhRepository.ConsultarSucursalesIgssAsync(empleado.CiaId);
            catalogosIgss = await IgssRepository.ConsultarCatalogosAsync();
            igss = empleado is null ? null : (await IgssRepository.ConsultarEmpleadoAsync(empleado.IdEmpleado)).Empleado;
            tiposPlanilla = empleado is null ? Array.Empty<IgssTipoPlanilla>()
                : (await IgssRepository.ConsultarTiposPlanillaAsync(empleado.CiaId)).Where(t => t.Estado == "A" || t.IdTipoPlanilla == igss?.IdIgssTipoPlanilla).ToList();
            fechaBaja = DateTime.Today;
            pestanaActiva = empleado is null ? "lista" : "detalle";
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarNuevo()
    {
        mensaje = null;
        modelo = new EmpleadoModelo { CiaId = companias.FirstOrDefault()?.CiaId ?? 0 };
        pestanaActiva = "editar";
    }

    private void IniciarEdicion()
    {
        if (seleccionado is null) return;
        mensaje = null;
        modelo = EmpleadoModelo.Desde(seleccionado);
        pestanaActiva = "editar";
    }

    private void CancelarEdicion() => pestanaActiva = seleccionado is null ? "lista" : "detalle";

    private async Task GuardarAsync()
    {
        try
        {
            if (!Erp.Data.General.NitValidador.EsValido(modelo.Nit) || Erp.Data.General.NitValidador.EsConsumidorFinal(modelo.Nit))
                throw new InvalidOperationException(Erp.Data.General.NitValidador.MensajeInvalido(modelo.Nit));
            modelo.Nit = Erp.Data.General.NitValidador.Formatear(modelo.Nit);
            var id = await RrhhRepository.GuardarEmpleadoAsync(modelo.AEmpleado(), await ObtenerUsuIdActualAsync());
            var eraNuevo = modelo.IdEmpleado == 0;
            await CargarPlazasAsync();
            await BuscarAsync();
            await SeleccionarAsync(id);
            MostrarOk(eraNuevo ? L("Empleado creado correctamente.") : L("Cambios guardados."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task DarBajaAsync()
    {
        if (seleccionado is null) return;
        try
        {
            await RrhhRepository.DarBajaEmpleadoAsync(seleccionado.IdEmpleado, fechaBaja, await ObtenerUsuIdActualAsync());
            await CargarPlazasAsync();
            await BuscarAsync();
            await SeleccionarAsync(seleccionado.IdEmpleado);
            MostrarOk(L("Empleado dado de baja; su plaza quedó vacante."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task ReactivarAsync()
    {
        if (seleccionado is null) return;
        try
        {
            await RrhhRepository.ReactivarEmpleadoAsync(seleccionado.IdEmpleado, await ObtenerUsuIdActualAsync());
            await BuscarAsync();
            await SeleccionarAsync(seleccionado.IdEmpleado);
            MostrarOk(L("Empleado reactivado. Asígnele una plaza si corresponde."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AsignarUsuarioAsync()
    {
        if (seleccionado is null) return;
        try
        {
            await RrhhRepository.AsignarUsuarioAsync(seleccionado.IdEmpleado, usuIdVinculo, await ObtenerUsuIdActualAsync());
            MostrarOk(usuIdVinculo is null ? L("Se quitó el usuario del empleado.") : L("Usuario asignado al empleado."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string NombreTipoNomina(string tipo) => tipo switch { "S" => L("Semanal"), "Q" => L("Quincenal"), _ => L("Mensual") };

    private async Task GuardarPagoAsync()
    {
        if (seleccionado is null) return;
        if (pagoForma == "")
        {
            mensaje = L("Seleccione la forma de pago: transferencia o cheque.");
            esMensajeError = true;
            return;
        }
        try
        {
            await RrhhRepository.GuardarPagoEmpleadoAsync(seleccionado.IdEmpleado, pagoTipoNomina, pagoForma, pagoGefId,
                pagoTipoCuenta == "" ? null : pagoTipoCuenta, string.IsNullOrWhiteSpace(pagoNumeroCuenta) ? null : pagoNumeroCuenta.Trim(),
                await ObtenerUsuIdActualAsync());
            await BuscarAsync();
            MostrarOk(L("Datos de pago de nómina guardados."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task GuardarLaboralAsync()
    {
        if (seleccionado is null) return;
        try
        {
            await RrhhRepository.GuardarLaboralEmpleadoAsync(seleccionado.IdEmpleado, laboralSucId,
                string.IsNullOrWhiteSpace(laboralNacionalidad) ? null : laboralNacionalidad.Trim(), laboralJornada, laboralTiempo,
                await ObtenerUsuIdActualAsync());
            if (igss is not null)
            {
                if (laboralTiempo != "TP") igss.HorasDiarias = null;
                await IgssRepository.GuardarEmpleadoAsync(igss, await ObtenerUsuIdActualAsync());
            }
            seleccionado.SucId = laboralSucId;
            seleccionado.Nacionalidad = string.IsNullOrWhiteSpace(laboralNacionalidad) ? null : laboralNacionalidad.Trim().ToUpperInvariant();
            seleccionado.Jornada = laboralJornada;
            seleccionado.TiempoContrato = laboralTiempo;
            MostrarOk(L("Datos laborales guardados."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AsignarVendedorAsync()
    {
        if (seleccionado is null) return;
        try
        {
            await RrhhRepository.AsignarVendedorAsync(seleccionado.IdEmpleado, pveIdVinculo, await ObtenerUsuIdActualAsync());
            MostrarOk(pveIdVinculo is null ? L("Se quitó el vendedor del empleado.") : L("Vendedor asignado al empleado."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private sealed class EmpleadoModelo
    {
        public int IdEmpleado { get; set; }
        [Required] public string CodigoEmpleado { get; set; } = "";
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione la compañía.")] public int CiaId { get; set; }
        [Required] public string PrimerNombre { get; set; } = "";
        public string? SegundoNombre { get; set; }
        [Required] public string PrimerApellido { get; set; } = "";
        public string? SegundoApellido { get; set; }
        public string? ApellidoCasada { get; set; }
        public string? Genero { get; set; }
        public DateTime? FechaNacimiento { get; set; }
        public DateTime FechaIngreso { get; set; } = DateTime.Today;
        public string? Direccion { get; set; }
        public int? ProvId { get; set; }
        public int? IdTipoDocumentoIdentificacion { get; set; }
        public string? NumeroDocumento { get; set; }
        public string? NumeroAfiliacionIGSS { get; set; }
        public string? Nit { get; set; }
        [EmailAddress] public string? Email { get; set; }
        public int? IdPlaza { get; set; }
        [Range(0, 9999999, ErrorMessage = "El salario base no puede ser negativo.")] public decimal SalarioBase { get; set; }

        public static EmpleadoModelo Desde(Empleado e) => new()
        {
            IdEmpleado = e.IdEmpleado, CodigoEmpleado = e.CodigoEmpleado, CiaId = e.CiaId,
            PrimerNombre = e.PrimerNombre, SegundoNombre = e.SegundoNombre, PrimerApellido = e.PrimerApellido,
            SegundoApellido = e.SegundoApellido, ApellidoCasada = e.ApellidoCasada, Genero = e.Genero,
            FechaNacimiento = e.FechaNacimiento, FechaIngreso = e.FechaIngreso, Direccion = e.Direccion, ProvId = e.ProvId,
            IdTipoDocumentoIdentificacion = e.IdTipoDocumentoIdentificacion, NumeroDocumento = e.NumeroDocumento,
            NumeroAfiliacionIGSS = e.NumeroAfiliacionIGSS, Nit = e.Nit, Email = e.Email, IdPlaza = e.IdPlaza,
            SalarioBase = e.SalarioBase,
        };

        public Empleado AEmpleado() => new()
        {
            IdEmpleado = IdEmpleado, CodigoEmpleado = CodigoEmpleado.Trim(), CiaId = CiaId,
            PrimerNombre = PrimerNombre.Trim(), SegundoNombre = Vacio(SegundoNombre), PrimerApellido = PrimerApellido.Trim(),
            SegundoApellido = Vacio(SegundoApellido), ApellidoCasada = Vacio(ApellidoCasada), Genero = Vacio(Genero),
            FechaNacimiento = FechaNacimiento, FechaIngreso = FechaIngreso, Direccion = Vacio(Direccion), ProvId = ProvId,
            IdTipoDocumentoIdentificacion = IdTipoDocumentoIdentificacion, NumeroDocumento = Vacio(NumeroDocumento),
            NumeroAfiliacionIGSS = Vacio(NumeroAfiliacionIGSS), Nit = Vacio(Nit), Email = Vacio(Email), IdPlaza = IdPlaza,
            SalarioBase = SalarioBase,
        };

        private static string? Vacio(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
    }
}
