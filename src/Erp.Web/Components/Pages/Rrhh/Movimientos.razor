@page "/rrhh/movimientos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:RRHH_ADMIN")]
@using Erp.Data.Rrhh
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IRrhhRepository RrhhRepository

<PageTitle>@L("Movimientos de nómina")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Movimientos de nómina")</h1>
    <p>@L("Ingresos y descuentos manuales por empleado (horas extra, comisiones, ISR, anticipos, préstamos). Se aplican en la nómina cuyo período incluye su fecha.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<div class="barra-herramientas">
    <select @bind="filtroEmpleado" aria-label="@L("Empleado")">
        <option value="">@L("Todos los empleados")</option>
        @foreach (var e in empleados)
        {
            <option value="@e.IdEmpleado">@e.CodigoEmpleado — @e.NombreCompleto</option>
        }
    </select>
    <FiltroPeriodo @bind-Desde="filtroDel" @bind-Hasta="filtroAl" AlCambiar="BuscarAsync" />
    <label class="filtro-campo"><input type="checkbox" @bind="soloPendientes" /> @L("Solo pendientes")</label>
    <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />
    <span class="barra-herramientas-separador"></span>
    <BotonIcono Icono="plus" Tooltip="@L("Nuevo movimiento")" Etiqueta="@L("Nuevo movimiento")" Variante="primario" OnClick="Nuevo" />
</div>

@if (edicion is not null)
{
    <div class="panel-formulario">
        <h2>@(edicion.IdMovimientoNomina == 0 ? L("Nuevo movimiento") : L("Editar movimiento"))</h2>
        <div class="campo">
            <label for="mov-emp">@L("Empleado")</label>
            <select id="mov-emp" @bind="edicion.IdEmpleado">
                <option value="0">@L("Seleccione...")</option>
                @foreach (var e in empleados)
                {
                    <option value="@e.IdEmpleado">@e.CodigoEmpleado — @e.NombreCompleto</option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="mov-tipo">@L("Tipo de movimiento")</label>
            <select id="mov-tipo" @bind="edicion.IdTipoMovimientoNomina">
                <option value="0">@L("Seleccione...")</option>
                <optgroup label="@L("Ingresos (suman)")">
                    @foreach (var t in tiposManuales.Where(t => t.Naturaleza == "I"))
                    {
                        <option value="@t.IdTipoMovimientoNomina">@t.Descripcion</option>
                    }
                </optgroup>
                <optgroup label="@L("Descuentos (restan)")">
                    @foreach (var t in tiposManuales.Where(t => t.Naturaleza == "D"))
                    {
                        <option value="@t.IdTipoMovimientoNomina">@t.Descripcion</option>
                    }
                </optgroup>
            </select>
        </div>
        <div class="campo"><label for="mov-monto">@L("Monto (Q)")</label><input id="mov-monto" type="number" step="0.01" @bind="edicion.Monto" /></div>
        @if (PideHoras)
        {
            <div class="campo">
                <label for="mov-horas">@L("Horas extra trabajadas")</label>
                <input id="mov-horas" type="number" step="0.5" min="0" @bind="edicion.Horas" />
                <small class="texto-ayuda">@L("Obligatorio: el libro de salarios registra las horas extraordinarias de cada período.")</small>
            </div>
        }
        <div class="campo"><label for="mov-fecha">@L("Fecha de aplicación")</label><input id="mov-fecha" type="date" @bind="edicion.FechaAplicacion" /></div>
        <div class="campo"><label for="mov-desc">@L("Descripción")</label><input id="mov-desc" @bind="edicion.Descripcion" /></div>
        <div class="acciones-fila">
            <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="GuardarAsync" />
            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => edicion = null" />
        </div>
    </div>
}

@if (movimientos.Count == 0)
{
    <p class="estado-vacio">@L("No hay movimientos con esos filtros.")</p>
}
else
{
    <div class="resumen-totales">
        <span>@L("Ingresos:") <strong>Q @movimientos.Where(m => m.Estado == "A" && m.Naturaleza == "I").Sum(m => m.Monto).ToString("N2")</strong></span>
        <span>@L("Descuentos:") <strong>Q @movimientos.Where(m => m.Estado == "A" && m.Naturaleza == "D").Sum(m => m.Monto).ToString("N2")</strong></span>
    </div>
    <table class="tabla-datos">
        <thead>
            <tr><th class="col-fecha">@L("Fecha")</th><th>@L("Empleado")</th><th>@L("Tipo")</th><th>@L("Descripción")</th><th class="num col-monto">@L("Monto")</th><th>@L("Nómina")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr>
        </thead>
        <tbody>
            @foreach (var m in movimientos)
            {
                <tr>
                    <td class="col-fecha">@m.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                    <td>@m.CodigoEmpleado — @m.Empleado</td>
                    <td>@m.TipoMovimiento@(m.Horas is decimal h ? $" ({h:0.##} h)" : "")</td>
                    <td>@m.Descripcion</td>
                    <td class="num col-monto">@(m.Naturaleza == "D" ? "−" : "+")@m.Monto.ToString("N2")</td>
                    <td>@(m.Nomina ?? L("Pendiente"))</td>
                    <td class="col-estado"><span class="estado-badge @(m.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(m.Estado == "A" ? L("Activo") : L("Anulado"))</span></td>
                    <td class="col-acciones">
                        <div class="acciones-fila">
                            @if (m.Estado == "A" && m.IdNomina is null)
                            {
                                <BotonIcono Icono="pencil" Tooltip="@L("Editar")" OnClick="() => Editar(m)" />
                                <BotonIcono Icono="ban" Tooltip="@L("Anular movimiento")" Confirmacion="@L("¿Anular el movimiento?")" Variante="peligro" OnClick="() => AnularAsync(m)" />
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<EmpleadoResumen> empleados = Array.Empty<EmpleadoResumen>();
    private IReadOnlyList<TipoMovimientoNomina> tiposManuales = Array.Empty<TipoMovimientoNomina>();
    private IReadOnlyList<MovimientoNomina> movimientos = Array.Empty<MovimientoNomina>();
    private MovimientoNomina? edicion;

    private int? filtroEmpleado;
    private DateTime? filtroDel = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? filtroAl = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private bool soloPendientes;
    private string? mensaje;
    private bool esMensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            empleados = await RrhhRepository.ConsultarEmpleadosAsync(null, "A");
            tiposManuales = (await RrhhRepository.ConsultarTiposMovimientoAsync(soloActivos: true)).Where(t => t.FormaCalculo == "M").ToList();
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private async Task BuscarAsync()
    {
        try
        {
            movimientos = await RrhhRepository.ConsultarMovimientosAsync(filtroEmpleado, filtroDel, filtroAl, soloPendientes);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void Nuevo()
    {
        mensaje = null;
        edicion = new MovimientoNomina { IdEmpleado = filtroEmpleado ?? 0, FechaAplicacion = DateTime.Today };
    }

    private void Editar(MovimientoNomina m)
    {
        mensaje = null;
        edicion = new MovimientoNomina
        {
            IdMovimientoNomina = m.IdMovimientoNomina, IdEmpleado = m.IdEmpleado, IdTipoMovimientoNomina = m.IdTipoMovimientoNomina,
            Descripcion = m.Descripcion, Monto = m.Monto, FechaAplicacion = m.FechaAplicacion, Horas = m.Horas
        };
    }

    // Los tipos que van a la columna de salario extraordinario piden las horas.
    private bool PideHoras => edicion is not null
        && tiposManuales.FirstOrDefault(t => t.IdTipoMovimientoNomina == edicion.IdTipoMovimientoNomina)?.ColumnaLibro == "EXTRAORDINARIO";

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private async Task GuardarAsync()
    {
        if (edicion is null) return;
        if (edicion.IdEmpleado <= 0 || edicion.IdTipoMovimientoNomina <= 0)
        {
            mensaje = L("Seleccione el empleado y el tipo de movimiento.");
            esMensajeError = true;
            return;
        }
        try
        {
            await RrhhRepository.GuardarMovimientoAsync(
                edicion.IdMovimientoNomina == 0 ? null : edicion.IdMovimientoNomina, edicion.IdEmpleado, edicion.IdTipoMovimientoNomina,
                string.IsNullOrWhiteSpace(edicion.Descripcion) ? null : edicion.Descripcion.Trim(), edicion.Monto, edicion.FechaAplicacion,
                PideHoras ? edicion.Horas : null, await ObtenerUsuIdActualAsync());
            mensaje = L("Movimiento guardado.");
            esMensajeError = false;
            edicion = null;
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AnularAsync(MovimientoNomina m)
    {
        try
        {
            await RrhhRepository.AnularMovimientoAsync(m.IdMovimientoNomina, await ObtenerUsuIdActualAsync());
            mensaje = L("Movimiento anulado.");
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }
}
