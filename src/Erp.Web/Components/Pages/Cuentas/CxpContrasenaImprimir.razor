@page "/cxp/contrasenas/{CpaId:int}/imprimir"
@layout Erp.Web.Components.Layout.ReporteLayout
@attribute [Authorize(Policy = "Permiso:CXP_CONTRASENA,CXP_PAGO_PROGRAMADO")]
@using System.Globalization
@using Erp.Data.Pagos
@using Erp.Web.Reportes
@inject IPagosRepository PagosRepository

<PageTitle>@(enc is null ? L("Contraseña de pago") : L("Contraseña de pago {0}", enc.Numero))</PageTitle>

@if (enc is null)
{
    <p class="mensaje-error" role="alert">@(error ?? L("No existe la contraseña {0}.", CpaId))</p>
}
else
{
    <style>
        @@page { size: letter portrait; margin: 11mm 12mm; }
        @@media print { body { background: #fff; } .reporte-pagina { padding: 0; max-width: none; } }
    </style>

    <div class="reporte-acciones fac-acciones">
        <button type="button" class="boton-icono boton-icono-primario boton-icono-con-etiqueta" onclick="window.print()">
            <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">@L("Imprimir")</span>
        </button>
        <span class="texto-tenue">@L("Formato carta. Entregue el original al proveedor y archive la copia firmada.")</span>
    </div>

    <article class="fac-carta">
        @if (enc.Estado == "A") { <div class="fac-marca">@L("ANULADA")</div> }
        <header class="fac-cab">
            <div class="fac-emisor">
                @if (enc.TieneLogo) { <img class="fac-logo" src="@($"compania/logo?cia={enc.CiaId}&v={enc.LogoActualizado?.Ticks ?? 0}")" alt="" /> }
                <div>
                    <div class="fac-comercial">@enc.NombreComercial</div>
                    <div class="fac-razon">@enc.NombreEmisor</div>
                    <div>@L("NIT {0}", enc.NitEmisor)</div>
                    <div>@enc.DireccionEmisor</div>
                    @if (!string.IsNullOrWhiteSpace(enc.TelefonoEmisor)) { <div>@L("Tel. {0}", enc.TelefonoEmisor)</div> }
                </div>
            </div>
            <div class="fac-doc">
                <div class="fac-doc-tipo">@L("CONTRASEÑA DE PAGO")</div>
                <div class="fac-doc-sub">@L("Presente este documento para cobrar")</div>
                <dl>
                    <dt>@L("Número")</dt><dd>@enc.Numero</dd>
                    <dt>@L("Fecha")</dt><dd>@enc.Fecha.ToString("dd/MM/yyyy")</dd>
                    <dt>@L("Fecha de pago")</dt><dd><strong>@enc.FechaPago.ToString("dddd dd/MM/yyyy", Es)</strong></dd>
                </dl>
            </div>
        </header>
        @if (enc.Estado == "A")
        {
            <p class="fac-aviso">CONTRASEÑA ANULADA@(string.IsNullOrWhiteSpace(enc.MotivoAnulacion) ? "" : $" — {enc.MotivoAnulacion}")</p>
        }
        else if (enc.Estado == "P")
        {
            <p class="fac-aviso">PAGADA @(enc.Cheque is not null ? L("CON CHEQUE {0}", enc.Cheque) : L("POR TRANSFERENCIA ({0})", enc.Lote))</p>
        }

        <section class="fac-partes">
            <div class="fac-bloque">
                <div class="fac-bloque-titulo">@L("Proveedor")</div>
                <div class="fac-fila"><span>@L("Nombre")</span><strong>@enc.Proveedor</strong></div>
                <div class="fac-fila"><span>@L("Código")</span>@enc.ProveedorCodigo</div>
                <div class="fac-fila"><span>@L("NIT")</span>@(string.IsNullOrWhiteSpace(enc.Nit) ? "—" : enc.Nit)</div>
                @if (!string.IsNullOrWhiteSpace(enc.ProveedorDireccion)) { <div class="fac-fila"><span>@L("Dirección")</span>@enc.ProveedorDireccion</div> }
            </div>
            <div class="fac-bloque">
                <div class="fac-bloque-titulo">@L("Forma de pago")</div>
                @if (enc.FormaPago == "T")
                {
                    <div class="fac-fila"><span>@L("Pago")</span><strong>@L("Transferencia bancaria")</strong></div>
                    <div class="fac-fila"><span>@L("Banco")</span>@(enc.Banco ?? "—")</div>
                    <div class="fac-fila"><span>@L("Cuenta")</span>@(enc.TipoCuenta == "A" ? L("Ahorro") : L("Monetaria")) @CuentaOculta(enc.CuentaProveedor)</div>
                }
                else
                {
                    <div class="fac-fila"><span>@L("Pago")</span><strong>@L("Cheque")</strong></div>
                    <div class="fac-fila"><span>@L("A nombre de")</span>@enc.Proveedor</div>
                }
                <div class="fac-fila"><span>@L("Emitió")</span>@enc.Usuario</div>
            </div>
        </section>

        <table class="fac-items">
            <thead>
                <tr><th class="num">#</th><th>@L("Documento")</th><th class="col-fecha">@L("Fecha")</th><th class="num">@L("Cuota")</th><th class="col-fecha">@L("Vence")</th><th class="num">@L("Monto")</th></tr>
            </thead>
            <tbody>
                @{ var i = 0; }
                @foreach (var l in enc.Lineas)
                {
                    <tr>
                        <td class="num">@(++i)</td>
                        <td>@l.Documento</td>
                        <td class="col-fecha">@l.FechaDocumento.ToString("dd/MM/yyyy")</td>
                        <td class="num">@l.Cuota</td>
                        <td class="col-fecha">@l.Vencimiento.ToString("dd/MM/yyyy")</td>
                        <td class="num">@l.Monto.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <section class="fac-pie-tabla">
            <div class="fac-notas">
                <div class="fac-letras"><span>@L("Total en letras")</span>@NumeroALetras.Convertir(enc.Total)</div>
                @if (!string.IsNullOrWhiteSpace(enc.Observaciones))
                {
                    <div class="fac-mini">
                        <div class="fac-bloque-titulo">@L("Observaciones")</div>
                        <p class="cot-observaciones">@enc.Observaciones</p>
                    </div>
                }
            </div>
            <div class="fac-totales">
                <div class="fac-total"><span>@L("TOTAL A PAGAR")</span>Q @enc.Total.ToString("N2")</div>
            </div>
        </section>

        <section class="oc-firmas oc-firmas-2">
            <div><span class="oc-firma-linea"></span>@L("Entregó: {0}", enc.Usuario)</div>
            <div><span class="oc-firma-linea"></span>@L("Recibió (nombre, firma y DPI)")</div>
        </section>

        <footer class="fac-final">
            <div class="fac-final-texto">
                <div>@L("El pago se hace a partir de la fecha indicada{0}. Cite el número {1} en cualquier consulta.", enc.FormaPago == "T" ? L(" por transferencia a la cuenta registrada") : L(", contra entrega de esta contraseña"), enc.Numero)</div>
            </div>
        </footer>
    </article>

    @if (Auto == 1)
    {
        <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    }
}

@code {
    [Parameter] public int CpaId { get; set; }
    [SupplyParameterFromQuery] public int? Auto { get; set; }

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-GT");
    private Contrasena? enc;
    private string? error;

    // En el papel solo los últimos 4 dígitos de la cuenta del proveedor.
    private static string CuentaOculta(string? cuenta) =>
        string.IsNullOrWhiteSpace(cuenta) ? "—" : cuenta.Length <= 4 ? cuenta : new string('•', 4) + cuenta[^4..];

    protected override async Task OnInitializedAsync()
    {
        try { enc = await PagosRepository.ConsultarContrasenaAsync(CpaId); }
        catch (Exception ex) { error = MensajesError.Traducir(ex); }
    }
}
