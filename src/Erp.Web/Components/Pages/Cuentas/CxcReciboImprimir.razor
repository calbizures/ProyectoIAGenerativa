@page "/cxc/recibos/imprimir"
@layout Erp.Web.Components.Layout.ReporteLayout
@attribute [Authorize(Policy = "Permiso:CXC_ADMIN")]
@using Erp.Data.Cuentas
@inject ICuentasRepository CuentasRepository

<PageTitle>@L("Recibo de caja {0}", Id)</PageTitle>

<div class="reporte-acciones">
    <button type="button" class="boton-icono boton-icono-primario boton-icono-con-etiqueta" onclick="window.print()">
        <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">@L("Imprimir o guardar PDF")</span>
    </button>
</div>

@if (recibo is null)
{
    <p class="mensaje-error" role="alert">@(error ?? L("No existe el recibo {0}.", Id))</p>
}
else
{
    var enc = recibo.Encabezado;
    <div class="reporte-encabezado">
        <div>
            <LogoCompania Clase="reporte-logo" />
            <div class="reporte-compania">@enc.Compania</div>
            <div class="texto-tenue">@L("NIT {0} · {1}", enc.CompaniaNit, enc.CompaniaDireccion)</div>
            <h1>@L("Recibo de caja No. {0}", enc.PpeId)</h1>
        </div>
        <div class="reporte-meta">
            @enc.Fecha.ToString("dd/MM/yyyy HH:mm")<br />
            @enc.Sucursal · @enc.Caja<br />
            @L("Cajero: {0}", enc.Usuario)
        </div>
    </div>

    @if (enc.Estado == "N")
    {
        <p class="recibo-anulado">@L("ANULADO — {0}", enc.MotivoAnulacion)</p>
    }

    <p class="recibo-cliente">
        @L("Recibimos de") <strong>@enc.Cliente</strong> @L("({0}, NIT {1}) la cantidad de", enc.ClienteCodigo, enc.ClienteNit ?? "C/F") <strong>Q@(recibo.Aplicaciones.Sum(a => a.Monto).ToString("N2"))</strong>@L(", aplicada así:")
    </p>

    <table class="tabla-datos">
        <thead><tr><th>@L("Documento")</th><th class="num">@L("Cuota")</th><th class="col-fecha">@L("Vencimiento")</th><th class="num">@L("Monto aplicado")</th></tr></thead>
        <tbody>
            @foreach (var a in recibo.Aplicaciones)
            {
                <tr>
                    <td>@a.Documento</td>
                    <td class="num">@(a.Cuota?.ToString() ?? L("Pago inicial"))</td>
                    <td class="col-fecha">@(a.Vencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="num">@a.Monto.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><td colspan="3">@L("Total")</td><td class="num">Q@(recibo.Aplicaciones.Sum(a => a.Monto).ToString("N2"))</td></tr></tfoot>
    </table>

    <h2>@L("Forma de pago")</h2>
    <table class="tabla-datos">
        <thead><tr><th>@L("Forma")</th><th>@L("Entidad")</th><th>@L("Referencia")</th><th class="num">@L("Monto")</th></tr></thead>
        <tbody>
            @foreach (var f in recibo.Formas)
            {
                <tr><td>@f.Forma</td><td>@(f.Entidad ?? "—")</td><td>@(f.Referencia ?? "—")</td><td class="num">@f.Monto.ToString("N2")</td></tr>
            }
        </tbody>
    </table>

    <div class="recibo-firmas">
        <div>@L("Recibí conforme")</div>
        <div>@L("Entregué conforme")</div>
    </div>
}

<p class="reporte-pie">@L("Impreso el {0}.", DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>

@code {
    [SupplyParameterFromQuery] public int Id { get; set; }

    private ReciboDetalle? recibo;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { recibo = await CuentasRepository.ConsultarReciboAsync(Id); }
        catch (Exception ex) { error = MensajesError.Traducir(ex); }
    }
}
