@page "/cxc/antiguedad/imprimir"
@layout Erp.Web.Components.Layout.ReporteLayout
@attribute [Authorize(Policy = "Permiso:CXC_ADMIN,VENTAS_FACTURA_CREAR,VENTAS_FACTURA_ANULAR")]

<AntiguedadReporte EsCliente="true" FechaCorte="@(Fecha ?? DateTime.Today)" TerceroId="Id" Vista="@(Vista ?? "tercero")" />

@code {
    [SupplyParameterFromQuery] public DateTime? Fecha { get; set; }
    [SupplyParameterFromQuery] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? Vista { get; set; }
}
