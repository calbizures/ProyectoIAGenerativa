@* Estado de cuenta de un cliente (CxC) o un proveedor (CxP). *@
@using Erp.Data.Cuentas
@using Erp.Data.Ventas
@inject ICuentasRepository CuentasRepository

<div class="pagina-encabezado">
    <h1>Estado de cuenta de @(EsCliente ? "clientes" : "proveedores")</h1>
    <p>Documentos con saldo y movimientos (@(EsCliente ? "facturas, pagos y notas" : "compras, cheques y notas")) con saldo corrido.</p>
</div>

@if (mensaje is not null)
{
    <p class="mensaje-error" role="alert">@mensaje</p>
}

<div class="barra-filtros">
    <div class="filtro-tercero">
        <SelectorTercero EsCliente="EsCliente" Seleccionado="tercero" SeleccionadoChanged="CambiarTerceroAsync" />
    </div>
    <FiltroPeriodo @bind-Desde="desde" @bind-Hasta="hasta" AlCambiar="ConsultarAsync" />
    <BotonIcono Icono="search" Tooltip="Consultar" Etiqueta="Consultar" Variante="primario" Deshabilitado="tercero is null" OnClick="ConsultarAsync" />
    @if (tercero is not null)
    {
        <span class="barra-herramientas-separador"></span>
        <a class="boton-icono boton-icono-con-etiqueta" href="@UrlExcel" download title="Exportar a Excel">
            <Icono Nombre="download" Tamano="16" /><span class="boton-icono-etiqueta">Excel</span>
        </a>
        <a class="boton-icono boton-icono-con-etiqueta" href="@UrlImprimir" target="_blank" rel="noopener" title="Abrir el estado de cuenta para imprimir">
            <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">Imprimir</span>
        </a>
        @if (!EsCliente && consultado && documentos.Sum(d => d.Saldo) > 0)
        {
            <a class="boton-icono boton-icono-primario boton-icono-con-etiqueta" href="@($"cxp/pagos?prv={tercero.Id}&todo=1")" title="Pagar todo el saldo del proveedor con un cheque">
                <Icono Nombre="banknote" Tamano="16" /><span class="boton-icono-etiqueta">Pagar saldo con cheque</span>
            </a>
        }
    }
</div>

@if (tercero is null)
{
    @if (cartera.Count == 0)
    {
        <p class="estado-vacio">No hay @(EsCliente ? "clientes" : "proveedores") con saldo pendiente. Busque uno arriba para ver su historial.</p>
    }
    else
    {
        <section class="tarjeta" aria-labelledby="titulo-cartera">
            <div class="maestro-detalle-encabezado">
                <h2 id="titulo-cartera">@(EsCliente ? "Clientes" : "Proveedores") con saldo</h2>
                <span class="texto-tenue">@cartera.Count · saldo Q@(cartera.Sum(g => g.Total).ToString("N2")) · vencido Q@(cartera.Sum(g => g.Total - g.Rangos[0]).ToString("N2"))</span>
            </div>
            <p class="texto-tenue">Elija uno para ver su estado de cuenta, o búsquelo arriba.</p>
            <table class="tabla-datos cartera-lista">
                <thead>
                    <tr><th class="col-codigo">Código</th><th>@(EsCliente ? "Cliente" : "Proveedor")</th><th class="num">Documentos</th><th class="num">Vencido</th><th class="num">Saldo</th><th class="col-acciones"><span class="sr-only">Acción</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var g in cartera.OrderByDescending(g => g.Total - g.Rangos[0]).ThenByDescending(g => g.Total))
                    {
                        var vencido = g.Total - g.Rangos[0];
                        <tr>
                            <td class="col-codigo">@g.Codigo</td>
                            <td><button type="button" class="boton-enlace" @onclick="() => CambiarTerceroAsync(new TerceroSeleccion(g.Id, g.Codigo, g.Nombre))">@g.Nombre</button></td>
                            <td class="num">@g.Documentos.Count</td>
                            <td class="num @(vencido > 0 ? "antiguedad-vencido" : "")">@(vencido > 0 ? vencido.ToString("N2") : "—")</td>
                            <td class="num"><strong>@g.Total.ToString("N2")</strong></td>
                            <td class="col-acciones">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="eye" Tooltip="Ver estado de cuenta" OnClick="() => CambiarTerceroAsync(new TerceroSeleccion(g.Id, g.Codigo, g.Nombre))" />
                                    @if (!EsCliente)
                                    {
                                        <a class="boton-icono" href="@($"cxp/pagos?prv={g.Id}&todo=1")" aria-label="@($"Pagar el saldo de {g.Nombre} con cheque")">
                                            <Icono Nombre="banknote" Tamano="16" /><span class="boton-icono-tip" role="tooltip">Pagar saldo con cheque</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
else if (consultado)
{
    <div class="kpi-fila">
        <div class="kpi"><span class="kpi-etiqueta">Saldo pendiente</span><span class="kpi-valor">Q@(documentos.Sum(d => d.Saldo).ToString("N2"))</span></div>
        <div class="kpi"><span class="kpi-etiqueta">Documentos con saldo</span><span class="kpi-valor">@documentos.Count</span></div>
        <div class="kpi kpi-alerta"><span class="kpi-etiqueta">Con cuotas vencidas</span><span class="kpi-valor">@documentos.Count(d => d.ProximoVencimiento < DateTime.Today)</span></div>
    </div>

    <BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestana" />

    @if (pestana == "documentos")
    {
        <DocumentosSaldoTabla Documentos="documentos" EsCliente="EsCliente" SeleccionadoId="documentoSeleccionado?.EncId" OnSeleccionar="SeleccionarDocumentoAsync"
                              UrlPagar="@(EsCliente ? null : d => $"cxp/pagos?prv={tercero!.Id}&enc={d.EncId}")" />
        @if (documentoSeleccionado is not null)
        {
            <section class="tarjeta" aria-labelledby="titulo-cuotas">
                <h2 id="titulo-cuotas">Cuotas de @documentoSeleccionado.Documento</h2>
                <CuotasTabla EsCliente="EsCliente" CuotasCliente="cuotasCliente" CuotasProveedor="cuotasProveedor" />
            </section>
        }
    }
    else
    {
        <EstadoCuentaTabla Movimientos="movimientos" SaldoInicial="@(movimientos.FirstOrDefault()?.SaldoInicial ?? 0)" />
    }
}

@code {
    [Parameter] public bool EsCliente { get; set; } = true;
    // Tercero con el que abre la pantalla (p. ej. desde la antigüedad de saldos).
    [Parameter] public int? TerceroId { get; set; }

    private static readonly IReadOnlyList<PestanaItem> Pestanas = new[]
    {
        new PestanaItem("documentos", "Documentos con saldo"),
        new PestanaItem("movimientos", "Movimientos"),
    };

    private TerceroSeleccion? tercero;
    private DateTime? desde = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? hasta = DateTime.Today;
    private string pestana = "documentos";
    private bool consultado;
    private IReadOnlyList<DocumentoSaldo> documentos = Array.Empty<DocumentoSaldo>();
    private IReadOnlyList<MovimientoEstadoCuenta> movimientos = Array.Empty<MovimientoEstadoCuenta>();
    private DocumentoSaldo? documentoSeleccionado;
    private IReadOnlyList<CuotaPlanPago> cuotasCliente = Array.Empty<CuotaPlanPago>();
    private IReadOnlyList<CuotaProveedor> cuotasProveedor = Array.Empty<CuotaProveedor>();
    private string? mensaje;
    private List<AntiguedadGrupo> cartera = new();

    private string Modulo => EsCliente ? "cxc" : "cxp";
    private string Filtros => $"id={tercero?.Id}{(desde is null ? "" : $"&desde={desde:yyyy-MM-dd}")}{(hasta is null ? "" : $"&hasta={hasta:yyyy-MM-dd}")}";
    private string UrlExcel => $"reportes/{Modulo}/estado-cuenta.xlsx?{Filtros}";
    private string UrlImprimir => $"{Modulo}/estado-cuenta/imprimir?{Filtros}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filas = EsCliente
                ? await CuentasRepository.ConsultarAntiguedadClientesAsync(DateTime.Today, null)
                : await CuentasRepository.ConsultarAntiguedadProveedoresAsync(DateTime.Today, null);
            cartera = AntiguedadGrupo.Agrupar(filas);
        }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); }

        var inicial = cartera.FirstOrDefault(g => g.Id == TerceroId);
        if (inicial is not null) await CambiarTerceroAsync(new TerceroSeleccion(inicial.Id, inicial.Codigo, inicial.Nombre));
    }

    private async Task CambiarTerceroAsync(TerceroSeleccion? nuevo)
    {
        tercero = nuevo;
        consultado = false;
        documentoSeleccionado = null;
        if (tercero is not null) await ConsultarAsync();
    }

    private async Task ConsultarAsync()
    {
        if (tercero is null) return;
        try
        {
            if (EsCliente)
            {
                documentos = await CuentasRepository.ConsultarDocumentosCxcAsync(tercero.Id, soloPendientes: true);
                movimientos = await CuentasRepository.ConsultarEstadoCuentaClienteAsync(tercero.Id, desde, hasta);
            }
            else
            {
                documentos = await CuentasRepository.ConsultarDocumentosCxpAsync(tercero.Id, soloPendientes: true);
                movimientos = await CuentasRepository.ConsultarEstadoCuentaProveedorAsync(tercero.Id, desde, hasta);
            }
            documentoSeleccionado = null;
            consultado = true;
            mensaje = null;
        }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); }
    }

    private async Task SeleccionarDocumentoAsync(DocumentoSaldo documento)
    {
        documentoSeleccionado = documento;
        try
        {
            if (EsCliente) cuotasCliente = await CuentasRepository.ConsultarCuotasClienteAsync(documento.EncId);
            else cuotasProveedor = await CuentasRepository.ConsultarCuotasProveedorAsync(documento.EncId);
        }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); }
    }
}
