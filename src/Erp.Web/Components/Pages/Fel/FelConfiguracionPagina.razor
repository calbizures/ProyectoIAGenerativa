@page "/fel/configuracion"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:FEL_ADMIN")]
@using Erp.Data.Fel
@using Erp.Data.General
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IFelRepository FelRepository
@inject IGeneralRepository GeneralRepository
@inject Erp.Web.Fel.FelConsultaNitServicio ConsultaNit

<PageTitle>@L("Configuración FEL")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Configuración de factura electrónica")</h1>
    <p>@L("Todo lo que va en el XML del DTE sale de aquí: certificador, datos del emisor, frases, establecimientos, tipos de DTE y unidades de medida.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

@if (companias.Count > 1)
{
    <div class="barra-filtros">
        <label class="filtro-campo" for="fel-cia">@L("Compañía")
            <select id="fel-cia" value="@ciaId" @onchange="CambiarCompaniaAsync">
                @foreach (var c in companias)
                {
                    <option value="@c.CiaId">@c.CiaNombreComercial</option>
                }
            </select>
        </label>
    </div>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestana" />

@if (pestana == "general" && config is not null)
{
    <section class="tarjeta" aria-labelledby="t-cert">
        <h2 id="t-cert">@L("Certificador")</h2>
        <div class="panel-formulario panel-ancho fel-formulario">
            <div class="campo">
                <label for="c-cert">@L("Certificador")</label>
                <select id="c-cert" @bind="config.Certificador">
                    <option value="SIMULADOR">@L("Simulador (pruebas, sin validez fiscal)")</option>
                    <option value="INFILE">@L("INFILE")</option>
                </select>
            </div>
            <div class="campo">
                <label for="c-amb">@L("Ambiente")</label>
                <select id="c-amb" @bind="config.Ambiente"><option value="PRUEBAS">@L("Pruebas")</option><option value="PRODUCCION">@L("Producción")</option></select>
            </div>
            <label class="campo-checkbox"><input type="checkbox" @bind="config.Activo" /> @L("Certificar automáticamente al grabar")</label>
            <div class="campo campo-ancho"><label for="c-url">@L("URL de certificación")</label><input id="c-url" @bind="config.UrlCertificacion" maxlength="256" /></div>
            <div class="campo campo-ancho"><label for="c-urla">@L("URL de anulación")</label><input id="c-urla" @bind="config.UrlAnulacion" maxlength="256" /></div>
            <div class="campo"><label for="c-uf">@L("Usuario de firma")</label><input id="c-uf" @bind="config.UsuarioFirma" maxlength="64" /></div>
            <div class="campo"><label for="c-ua">@L("Usuario de la API")</label><input id="c-ua" @bind="config.UsuarioApi" maxlength="64" /></div>
            <div class="campo"><label for="c-cc">@L("Correo de copia")</label><input id="c-cc" type="email" @bind="config.CorreoCopia" maxlength="128" /></div>
            <div class="campo"><label for="c-to">@L("Tiempo de espera (segundos)")</label><input id="c-to" type="number" min="5" max="300" @bind="config.TimeoutSegundos" /></div>
            <div class="campo campo-ancho"><label for="c-ns">@L("Espacio de nombres del DTE")</label><input id="c-ns" @bind="config.XmlnsDte" maxlength="128" /></div>
            <div class="campo"><label for="c-ver">@L("Versión del DTE")</label><input id="c-ver" @bind="config.VersionDte" maxlength="10" /></div>
        </div>
        <p class="texto-ayuda">@L("Las llaves de firma y de la API no se guardan en la base: van en la configuración de la aplicación como") <code>Fel:Credenciales:@(config.Nit.Replace("-", "")):LlaveFirma</code> @L("y") <code>:LlaveApi</code> @L("(appsettings, variables de entorno o secretos del servidor).")</p>
    </section>

    <section class="tarjeta" aria-labelledby="t-emi">
        <h2 id="t-emi">@L("Emisor ({0}, NIT {1})", config.Compania, config.Nit)</h2>
        <div class="panel-formulario panel-ancho fel-formulario">
            <div class="campo campo-ancho"><label for="e-nom">@L("Nombre del emisor (razón social en SAT)")</label><input id="e-nom" @bind="config.NombreEmisor" maxlength="256" /></div>
            <div class="campo">
                <label for="e-afi">@L("Afiliación IVA")</label>
                <select id="e-afi" @bind="config.AfiliacionIva">
                    <option value="GEN">@L("GEN · General")</option>
                    <option value="PEQ">@L("PEQ · Pequeño contribuyente")</option>
                    <option value="EXE">@L("EXE · Exento")</option>
                    <option value="AGR">@L("AGR · Agropecuario")</option>
                    <option value="AGE">@L("AGE · Agropecuario especial")</option>
                    <option value="ECE">@L("ECE · Electrónico especial")</option>
                </select>
            </div>
            <div class="campo"><label for="e-cor">@L("Correo del emisor")</label><input id="e-cor" type="email" @bind="config.CorreoEmisor" maxlength="128" /></div>
        </div>
        <h3>@L("Consumidor final")</h3>
        <div class="panel-formulario panel-ancho fel-formulario">
            <div class="campo">
                <label for="cf-maximo">@L("Monto desde el que se exige NIT o CUI (Q)")</label>
                <input id="cf-maximo" type="number" min="0" step="0.01" @bind="montoMaximoCf" />
                <small class="texto-ayuda">@L("Una factura por este monto o más no se emite a CF (regla de SAT). Vacío: sin límite.")</small>
            </div>
        </div>
        <h3>@L("Receptor por defecto")</h3>
        <p class="texto-ayuda">@L("Se usa cuando el cliente no tiene dirección, código postal, municipio o departamento.")</p>
        <div class="panel-formulario panel-ancho fel-formulario">
            <div class="campo"><label for="r-dir">@L("Dirección")</label><input id="r-dir" @bind="config.ReceptorDireccion" maxlength="128" /></div>
            <div class="campo"><label for="r-cp">@L("Código postal")</label><input id="r-cp" @bind="config.ReceptorCodigoPostal" maxlength="10" /></div>
            <div class="campo"><label for="r-mun">@L("Municipio")</label><input id="r-mun" @bind="config.ReceptorMunicipio" maxlength="64" /></div>
            <div class="campo"><label for="r-dep">@L("Departamento")</label><input id="r-dep" @bind="config.ReceptorDepartamento" maxlength="64" /></div>
            <div class="campo"><label for="r-pais">@L("País")</label><input id="r-pais" @bind="config.ReceptorPais" maxlength="2" /></div>
        </div>
        <div class="acciones-fila">
            <BotonIcono Icono="save" Tooltip="@L("Guardar configuración")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="GuardarConfiguracionAsync" />
        </div>
    </section>
}
else if (pestana == "nit" && consultaNit is not null)
{
    <section class="tarjeta" aria-labelledby="t-nit">
        <h2 id="t-nit">@L("Consulta del NIT al certificador")</h2>
        <p class="texto-ayuda">@L("Al facturar, si el NIT no está en la base, se pide el nombre al servicio del certificador de la compañía (")<strong>@(consultaNit.NombreCertificador ?? consultaNit.Certificador)</strong>@L(", ambiente {0}) y el cliente se graba solo. Si no responde, el cajero escribe el nombre.", consultaNit.Ambiente.ToLowerInvariant())</p>
        <div class="panel-formulario panel-ancho fel-formulario">
            <label class="campo-checkbox"><input type="checkbox" @bind="consultaNitActiva" /> @L("Consultar el NIT al certificador")</label>
            <div class="campo campo-ancho">
                <label for="n-url">@L("URL propia del servicio (opcional)")</label>
                <input id="n-url" maxlength="256" placeholder="@(consultaNit.Url ?? L("Se usa la del catálogo"))" @bind="consultaNitUrl" />
                <span class="texto-ayuda">@L("Déjela vacía para usar la del catálogo según el ambiente. Use {nit} donde va el número.")</span>
            </div>
        </div>
        <p class="texto-ayuda">@L("Credenciales (no se guardan en la base):") <code>Fel:Credenciales:@(consultaNit.NitEmisor):ConsultaNitUsuario</code> @L("y") <code>:ConsultaNitLlave</code>@L("; si faltan, se usan el usuario de la API y") <code>:LlaveApi</code>.</p>
        <div class="acciones-fila">
            <BotonIcono Icono="save" Tooltip="@L("Guardar la consulta de NIT")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="GuardarConsultaNitAsync" />
        </div>
        <div class="fila-edicion">
            <label for="n-prueba">@L("Probar con un NIT")</label>
            <input id="n-prueba" maxlength="20" placeholder="@L("Ej. 42932-5")" @bind="nitPrueba" />
            <BotonIcono Icono="search" Tooltip="@L("Consultar ahora")" Etiqueta="@L("Probar")" OnClick="ProbarNitAsync" />
        </div>
        @if (resultadoPrueba is not null)
        {
            <p class="@(resultadoPrueba.Encontrado ? "mensaje-ok" : "mensaje-error")" role="status">
                @(resultadoPrueba.Encontrado ? $"{resultadoPrueba.Nombre} — {resultadoPrueba.Mensaje}" : resultadoPrueba.Mensaje)
            </p>
        }
    </section>

    <section class="tarjeta" aria-labelledby="t-cat">
        <h2 id="t-cat">@L("Certificadores autorizados por SAT")</h2>
        <p class="texto-ayuda">@L("Cada certificador publica su propio servicio de consulta de NIT; se parametriza aquí (método, URL con {nit}, cuerpo, encabezado de la llave y campo del nombre en la respuesta) sin cambiar código. Los que dicen “Solicitar documentación” se completan con los datos que entrega el certificador al contratarlo.")</p>
        <div class="tabla-desplazable" tabindex="0">
            <table class="tabla-datos">
                <thead><tr><th class="col-codigo">@L("Código")</th><th>@L("Certificador")</th><th>@L("Servicio de consulta de NIT")</th><th class="col-estado">@L("Método")</th><th>@L("URL (pruebas / producción)")</th><th class="col-estado">@L("Estado")</th></tr></thead>
                <tbody>
                    @foreach (var c in certificadores)
                    {
                        <tr class="@(c.Codigo == consultaNit.Certificador ? "fila-seleccionada" : "")">
                            <td class="col-codigo">@c.Codigo</td>
                            <td>@c.Nombre@(c.Nit is null ? "" : L(" · NIT {0}", c.Nit))</td>
                            <td>@c.ApiConsultaNit
                                @if (!string.IsNullOrWhiteSpace(c.CampoNombre))
                                {
                                    <br /><span class="texto-tenue">@L("Nombre en «{0}»", c.CampoNombre)@(string.IsNullOrWhiteSpace(c.Encabezado) ? "" : L(", llave en «{0}»", c.Encabezado))</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Notas))
                                {
                                    <br /><span class="texto-tenue">@c.Notas</span>
                                }
                            </td>
                            <td class="col-estado">@c.Metodo</td>
                            <td class="texto-url">@c.UrlPruebas@if (c.UrlProduccion is not null && c.UrlProduccion != c.UrlPruebas) { <br />@c.UrlProduccion }</td>
                            <td class="col-estado"><span class="estado-badge @(c.Implementado ? "estado-badge-activo" : "estado-badge-pendiente")">@(c.Implementado ? L("Configurado") : L("Solicitar documentación"))</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (pestana == "frases")
{
    <section class="tarjeta">
        <p class="texto-ayuda">@L("Frases que SAT exige según el régimen del emisor (p. ej. tipo 1, escenario 1: sujeto a pagos trimestrales ISR). Van en facturas; en notas solo las marcadas.")</p>
        <table class="tabla-datos">
            <thead><tr><th class="num">@L("Tipo")</th><th class="num">@L("Escenario")</th><th>@L("Descripción")</th><th>@L("En notas")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @foreach (var f in frases)
                {
                    <tr>
                        <td class="num">@f.TipoFrase</td><td class="num">@f.CodigoEscenario</td><td>@f.Descripcion</td>
                        <td>@(f.AplicaNotas ? L("Sí") : L("No"))</td>
                        <td class="col-estado"><span class="estado-badge @(f.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(f.Estado == "A" ? L("Activa") : L("Inactiva"))</span></td>
                        <td class="col-acciones"><div class="acciones-fila">
                            <BotonIcono Icono="pencil" Tooltip="@L("Editar frase")" OnClick="() => frase = Copiar(f)" />
                            <BotonIcono Icono="trash-2" Tooltip="@L("Eliminar frase")" Confirmacion="@L("¿Eliminar la frase?")" Variante="peligro" OnClick="() => EliminarFraseAsync(f)" />
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (frase is null)
        {
            <div class="acciones-fila"><BotonIcono Icono="plus" Tooltip="@L("Agregar frase")" Etiqueta="@L("Agregar frase")" OnClick="() => frase = new FelFrase { CiaId = ciaId }" /></div>
        }
        else
        {
            <div class="panel-formulario panel-ancho fel-formulario">
                <div class="campo"><label for="f-tipo">@L("Tipo de frase")</label><input id="f-tipo" type="number" min="1" @bind="frase.TipoFrase" /></div>
                <div class="campo"><label for="f-esc">@L("Código de escenario")</label><input id="f-esc" type="number" min="1" @bind="frase.CodigoEscenario" /></div>
                <div class="campo campo-ancho"><label for="f-desc">@L("Descripción")</label><input id="f-desc" @bind="frase.Descripcion" maxlength="256" /></div>
                <label class="campo-checkbox"><input type="checkbox" @bind="frase.AplicaNotas" /> @L("Incluir en notas de crédito y débito")</label>
                <div class="campo"><label for="f-est">@L("Estado")</label><select id="f-est" @bind="frase.Estado"><option value="A">@L("Activa")</option><option value="I">@L("Inactiva")</option></select></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar frase")" Etiqueta="@L("Guardar")" Variante="primario" OnClick="GuardarFraseAsync" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => frase = null" />
                </div>
            </div>
        }
    </section>
}
else if (pestana == "establecimientos")
{
    <section class="tarjeta">
        <p class="texto-ayuda">@L("Cada sucursal es un establecimiento ante SAT: su código, nombre comercial y dirección van como emisor en el DTE.")</p>
        <table class="tabla-datos">
            <thead><tr><th class="num">@L("Código")</th><th>@L("Sucursal")</th><th>@L("Nombre comercial")</th><th>@L("Dirección")</th><th>C. P.</th><th>@L("Municipio")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @foreach (var e in establecimientos)
                {
                    @if (establecimiento?.SucId == e.SucId)
                    {
                        <tr class="fila-edicion-tabla">
                            <td class="num"><input type="number" min="1" aria-label="@L("Código de establecimiento")" @bind="establecimiento.CodigoEstablecimiento" /></td>
                            <td>@e.SucCodigo - @e.SucDescripcion</td>
                            <td><input aria-label="@L("Nombre comercial")" maxlength="256" @bind="establecimiento.NombreComercial" /></td>
                            <td>@e.Direccion</td>
                            <td><input aria-label="@L("Código postal")" maxlength="10" @bind="establecimiento.CodigoPostal" /></td>
                            <td>
                                <select aria-label="@L("Municipio")" @bind="establecimiento.ProvId">
                                    @foreach (var m in municipios)
                                    {
                                        <option value="@m.ProvId">@m.Municipio, @m.Departamento (@m.Pais)</option>
                                    }
                                </select>
                            </td>
                            <td class="col-acciones"><div class="acciones-fila">
                                <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="GuardarEstablecimientoAsync" />
                                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => establecimiento = null" />
                            </div></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="num">@(e.CodigoEstablecimiento?.ToString() ?? "—")</td>
                            <td>@e.SucCodigo - @e.SucDescripcion</td>
                            <td>@e.NombreComercial</td>
                            <td>@e.Direccion</td>
                            <td>@e.CodigoPostal</td>
                            <td>@(e.Municipio is null ? "—" : $"{e.Municipio}, {e.Departamento}")</td>
                            <td class="col-acciones"><div class="acciones-fila"><BotonIcono Icono="pencil" Tooltip="@L("Editar establecimiento")" OnClick="() => establecimiento = CopiarEstablecimiento(e)" /></div></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
}
else if (pestana == "tipos")
{
    <section class="tarjeta">
        <p class="texto-ayuda">@L("Qué tipo de DTE genera cada documento. Una factura a crédito puede ser FCAM (con abonos) y de contado FACT. Las compras no se certifican (lo hace el proveedor).")</p>
        <table class="tabla-datos">
            <thead><tr><th class="col-codigo">@L("Código")</th><th>@L("Documento")</th><th>@L("Tipo DTE")</th><th>@L("Tipo DTE de contado")</th><th>@L("Certifica")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @foreach (var t in tipos)
                {
                    @if (tipo?.TdoId == t.TdoId)
                    {
                        <tr class="fila-edicion-tabla">
                            <td class="col-codigo">@t.TdoCodigo</td><td>@t.TdoDescripcion</td>
                            <td><select aria-label="@L("Tipo DTE")" @bind="tipo.TipoDte"><option value="">—</option>@foreach (var c in TiposDte) { <option value="@c">@c</option> }</select></td>
                            <td><select aria-label="@L("Tipo DTE de contado")" @bind="tipo.TipoDteContado"><option value="">@L("(el mismo)")</option>@foreach (var c in TiposDte) { <option value="@c">@c</option> }</select></td>
                            <td><input type="checkbox" aria-label="@L("Certifica")" @bind="tipo.Certifica" /></td>
                            <td class="col-acciones"><div class="acciones-fila">
                                <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="GuardarTipoAsync" />
                                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => tipo = null" />
                            </div></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="col-codigo">@t.TdoCodigo</td><td>@t.TdoDescripcion</td><td>@(t.TipoDte ?? "—")</td><td>@(t.TipoDteContado ?? "—")</td>
                            <td><span class="estado-badge @(t.Certifica ? "estado-badge-activo" : "estado-badge-inactivo")">@(t.Certifica ? L("Sí") : L("No"))</span></td>
                            <td class="col-acciones"><div class="acciones-fila"><BotonIcono Icono="pencil" Tooltip="@L("Editar tipo")" OnClick="() => tipo = CopiarTipo(t)" /></div></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
}
else if (pestana == "unidades")
{
    <section class="tarjeta">
        <p class="texto-ayuda">@L("Código de la unidad de medida que va en cada ítem del DTE (hasta 3 caracteres).")</p>
        <table class="tabla-datos">
            <thead><tr><th class="col-codigo">@L("Código")</th><th>@L("Unidad")</th><th>@L("Código FEL")</th><th class="col-acciones">@L("Acciones")</th></tr></thead>
            <tbody>
                @foreach (var u in unidades)
                {
                    <tr>
                        <td class="col-codigo">@u.UmeCodigo</td><td>@u.UmeDescripcion</td>
                        <td>
                            @if (unidadEditando == u.UmeId)
                            {
                                <input aria-label="@L("Código FEL")" maxlength="3" @bind="codigoUnidad" />
                            }
                            else
                            {
                                @(u.FelCodigo ?? "—")
                            }
                        </td>
                        <td class="col-acciones"><div class="acciones-fila">
                            @if (unidadEditando == u.UmeId)
                            {
                                <BotonIcono Icono="save" Tooltip="@L("Guardar")" Variante="primario" OnClick="() => GuardarUnidadAsync(u)" />
                                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => unidadEditando = null" />
                            }
                            else
                            {
                                <BotonIcono Icono="pencil" Tooltip="@L("Editar código FEL")" OnClick="() => { unidadEditando = u.UmeId; codigoUnidad = u.FelCodigo ?? string.Empty; }" />
                            }
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly IReadOnlyList<PestanaItem> Pestanas = new[]
    {
        new PestanaItem("general", "Certificador y emisor"), new PestanaItem("frases", "Frases"),
        new PestanaItem("establecimientos", "Establecimientos"), new PestanaItem("tipos", "Tipos de documento"),
        new PestanaItem("unidades", "Unidades de medida"), new PestanaItem("nit", "Consulta de NIT"),
    };
    private static readonly string[] TiposDte = { "FACT", "FCAM", "FPEQ", "FCAP", "FESP", "NABN", "RDON", "RECI", "NDEB", "NCRE" };

    private string pestana = "general";
    private IReadOnlyList<Compania> companias = Array.Empty<Compania>();
    private int ciaId;
    private FelConfiguracion? config;
    private decimal? montoMaximoCf;
    private IReadOnlyList<FelFrase> frases = Array.Empty<FelFrase>();
    private FelFrase? frase;
    private IReadOnlyList<FelEstablecimiento> establecimientos = Array.Empty<FelEstablecimiento>();
    private FelEstablecimiento? establecimiento;
    private IReadOnlyList<FelMunicipio> municipios = Array.Empty<FelMunicipio>();
    private IReadOnlyList<FelTipoDocumento> tipos = Array.Empty<FelTipoDocumento>();
    private FelTipoDocumento? tipo;
    private IReadOnlyList<FelUnidadMedida> unidades = Array.Empty<FelUnidadMedida>();
    private int? unidadEditando;
    private string codigoUnidad = "";
    private string? mensaje;
    private bool esMensajeError;
    private IReadOnlyList<FelCertificador> certificadores = Array.Empty<FelCertificador>();
    private FelConsultaNitConfiguracion? consultaNit;
    private bool consultaNitActiva;
    private string? consultaNitUrl;
    private string nitPrueba = "";
    private Erp.Web.Fel.ConsultaNitResultado? resultadoPrueba;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            companias = await GeneralRepository.ConsultarCompaniasAsync(soloActivas: true);
            int? sucId = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerSucId();
            var sucursal = (await GeneralRepository.ConsultarSucursalesAsync(null, false)).FirstOrDefault(s => s.SucId == sucId);
            ciaId = sucursal?.CiaId ?? companias.FirstOrDefault()?.CiaId ?? 0;
            municipios = await FelRepository.ConsultarMunicipiosAsync();
            await CargarAsync();
        }
        catch (Exception ex) { Error(ex); }
    }

    private async Task<int?> UsuIdAsync() => AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();
    private void Error(Exception ex) { mensaje = MensajesError.Traducir(ex); esMensajeError = true; }
    private void Ok(string texto) { mensaje = texto; esMensajeError = false; }

    private async Task CargarAsync()
    {
        config = await FelRepository.ConsultarConfiguracionAsync(ciaId);
        montoMaximoCf = await FelRepository.ConsultarLimiteCfAsync(ciaId);
        frases = await FelRepository.ConsultarFrasesAsync(ciaId);
        establecimientos = await FelRepository.ConsultarEstablecimientosAsync(ciaId);
        tipos = await FelRepository.ConsultarTiposDocumentoAsync();
        unidades = await FelRepository.ConsultarUnidadesAsync();
        certificadores = await FelRepository.ConsultarCertificadoresAsync();
        consultaNit = await FelRepository.ConsultarConsultaNitAsync(ciaId);
        consultaNitActiva = consultaNit?.Activa ?? false;
        consultaNitUrl = consultaNit?.UrlPropia;
        resultadoPrueba = null;
    }

    private async Task GuardarConsultaNitAsync()
    {
        try
        {
            await FelRepository.GuardarConsultaNitAsync(ciaId, consultaNitActiva, string.IsNullOrWhiteSpace(consultaNitUrl) ? null : consultaNitUrl.Trim(), await UsuIdAsync());
            Ok(L("Consulta de NIT guardada."));
            await CargarAsync();
        }
        catch (Exception ex) { Error(ex); }
    }

    private async Task ProbarNitAsync()
    {
        mensaje = null;
        try { resultadoPrueba = await ConsultaNit.ConsultarAsync(ciaId, nitPrueba); }
        catch (Exception ex) { Error(ex); }
    }

    private async Task CambiarCompaniaAsync(ChangeEventArgs e)
    {
        ciaId = int.TryParse(e.Value?.ToString(), out var id) ? id : ciaId;
        await CargarAsync();
    }

    private async Task GuardarConfiguracionAsync()
    {
        if (config is null) return;
        try
        {
            await FelRepository.GuardarConfiguracionAsync(config, await UsuIdAsync());
            await FelRepository.GuardarLimiteCfAsync(ciaId, montoMaximoCf is > 0 ? montoMaximoCf : null, await UsuIdAsync());
            Ok(L("Configuración guardada."));
            await CargarAsync();
        }
        catch (Exception ex) { Error(ex); }
    }

    private static FelFrase Copiar(FelFrase f) => new()
    {
        FfrId = f.FfrId, CiaId = f.CiaId, TipoFrase = f.TipoFrase, CodigoEscenario = f.CodigoEscenario,
        Descripcion = f.Descripcion, AplicaNotas = f.AplicaNotas, Estado = f.Estado
    };

    private async Task GuardarFraseAsync()
    {
        if (frase is null) return;
        try { await FelRepository.GuardarFraseAsync(frase, await UsuIdAsync()); frase = null; Ok(L("Frase guardada.")); frases = await FelRepository.ConsultarFrasesAsync(ciaId); }
        catch (Exception ex) { Error(ex); }
    }

    private async Task EliminarFraseAsync(FelFrase f)
    {
        try { await FelRepository.EliminarFraseAsync(f.FfrId); Ok(L("Frase eliminada.")); frases = await FelRepository.ConsultarFrasesAsync(ciaId); }
        catch (Exception ex) { Error(ex); }
    }

    private FelEstablecimiento CopiarEstablecimiento(FelEstablecimiento e) => new()
    {
        SucId = e.SucId, SucCodigo = e.SucCodigo, SucDescripcion = e.SucDescripcion, CodigoEstablecimiento = e.CodigoEstablecimiento,
        NombreComercial = e.NombreComercial ?? e.SucDescripcion, CodigoPostal = e.CodigoPostal, ProvId = e.ProvId ?? municipios.FirstOrDefault()?.ProvId
    };

    private async Task GuardarEstablecimientoAsync()
    {
        if (establecimiento is null) return;
        try
        {
            await FelRepository.GuardarEstablecimientoAsync(establecimiento, await UsuIdAsync());
            establecimiento = null;
            Ok(L("Establecimiento guardado."));
            establecimientos = await FelRepository.ConsultarEstablecimientosAsync(ciaId);
        }
        catch (Exception ex) { Error(ex); }
    }

    private static FelTipoDocumento CopiarTipo(FelTipoDocumento t) => new()
    {
        TdoId = t.TdoId, TdoCodigo = t.TdoCodigo, TdoDescripcion = t.TdoDescripcion, TipoDte = t.TipoDte ?? "", TipoDteContado = t.TipoDteContado ?? "",
        Certifica = t.Certifica
    };

    private async Task GuardarTipoAsync()
    {
        if (tipo is null) return;
        try { await FelRepository.GuardarTipoDocumentoAsync(tipo, await UsuIdAsync()); tipo = null; Ok(L("Tipo de documento guardado.")); tipos = await FelRepository.ConsultarTiposDocumentoAsync(); }
        catch (Exception ex) { Error(ex); }
    }

    private async Task GuardarUnidadAsync(FelUnidadMedida u)
    {
        try { await FelRepository.GuardarUnidadAsync(u.UmeId, codigoUnidad, await UsuIdAsync()); unidadEditando = null; Ok(L("Unidad guardada.")); unidades = await FelRepository.ConsultarUnidadesAsync(); }
        catch (Exception ex) { Error(ex); }
    }
}
