@if (encabezadoSeleccionado is not null)
{
    <div class="doc-card">
        <div class="doc-card-header">
            <div>
                <h2>@(string.IsNullOrWhiteSpace(encabezadoSeleccionado.EncSerieDocto) ? $"{encabezadoSeleccionado.EncNumeroUnico}" : $"{encabezadoSeleccionado.EncSerieDocto}-{encabezadoSeleccionado.EncNumeroUnico}")</h2>
                <p>@L("{0} {1} · NIT: {2}", encabezadoSeleccionado.EncNombresCliente, encabezadoSeleccionado.EncApellidosCliente, encabezadoSeleccionado.CliNit ?? "C/F")</p>
            </div>
            <div class="acciones-fila">
                <a class="boton-icono boton-icono-primario boton-icono-con-etiqueta" href="@($"facturas/{encabezadoSeleccionado.EncId}/imprimir?auto=1")" target="_blank" rel="noopener">
                    <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">@L("Imprimir")</span>
                </a>
                <BotonIcono Icono="mail" Tooltip="@L("Enviar la factura al correo del cliente")" Etiqueta="@L("Enviar por correo")" OnClick="AbrirCorreoFacturaAsync" />
                @if (encabezadoSeleccionado.EncEstado == "G")
                {
                    <span class="estado-badge estado-badge-grabada">@L("Grabada")</span>
                }
                else
                {
                    <span class="estado-badge estado-badge-anulada">@L("Anulada")</span>
                }
            </div>
        </div>
        <div class="doc-card-body">
            <div class="fel-resumen fel-estado-@(felDetalle?.Estado ?? "N")">
                <span class="fel-resumen-titulo">@L("Factura electrónica")</span>
                <span class="estado-badge @Erp.Web.Fel.FelVista.Clase(felDetalle?.Estado)">@Erp.Web.Fel.FelService.EstadoTexto(felDetalle?.Estado)</span>
                @if (felDetalle?.Uuid is not null)
                {
                    <span>@L("Autorización") <strong>@felDetalle.Uuid</strong> @L("· Serie {0} · Número {1}", felDetalle.Serie, felDetalle.Numero)</span>
                }
                else if (felDetalle?.Mensaje is not null)
                {
                    <span class="texto-tenue">@Textos.Mensaje(felDetalle.Mensaje)</span>
                }
                @if (encabezadoSeleccionado.EncEstado == "G" && felDetalle?.Estado is null or "P" or "R")
                {
                    <AuthorizeView Policy="Permiso:FEL_ADMIN,VENTAS_FACTURA_CREAR" Context="felAuth">
                        <Authorized>
                            <BotonIcono Icono="refresh-cw" Tooltip="@L("Enviar al certificador")" Etiqueta="@(felDetalle is null ? L("Certificar") : L("Reintentar"))" OnClick="CertificarSeleccionadaAsync" />
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
            @if (correoFactura is not null)
            {
                <EnviarCorreoPanel Documento="correoFactura" Cerrar="() => correoFactura = null" />
            }
            @if (transferenciasFactura.Count > 0)
            {
                <div class="doc-nota">
                    <Icono Nombre="landmark" Tamano="15" />
                    <span>
                        @L("Transferencias recibidas:")
                        @foreach (var t in transferenciasFactura)
                        {
                            <span class="transferencia-recibida">
                                No. @t.Referencia@(t.Banco is null ? "" : $" · {t.Banco}") · @MonedaSimbolo @t.Monto.ToString("N2") ·
                                @if (t.TieneComprobante)
                                {
                                    <a href="@($"pagos/formas/{t.PpfId}/comprobante")" target="_blank" rel="noopener">@L("ver comprobante")</a>
                                }
                                else
                                {
                                    <span class="texto-tenue">@L("sin comprobante")</span>
                                }
                            </span>
                        }
                    </span>
                </div>
            }
            <BarraPestanas Pestanas="PestanasDetalleFactura" @bind-PestanaActiva="pestanaDetalleFactura" />

            @if (pestanaDetalleFactura == "detalle")
            {
                <table class="doc-tabla">
                    <thead>
                        <tr>
                            <th class="col-bs">B/S</th>
                            <th>@L("Descripción")</th>
                            <th class="num">@L("Cantidad")</th>
                            <th>@L("Unidad")</th>
                            <th>@L("Bodega")</th>
                            <th class="num">@L("Precio unit. (IVA incl.)")</th>
                            <th class="num">@L("Descuento")</th>
                            <th class="num">@L("Subtotal")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in detalleSeleccionado)
                        {
                            var precioConIva = d.DetPrecioUnitario * (1 + (d.DetPorcIva ?? 0) / 100m);
                            var descuentoConIva = d.DetValorDescuento * (1 + (d.DetPorcIva ?? 0) / 100m);
                            var subtotalConIva = d.DetSubTotal * (1 + (d.DetPorcIva ?? 0) / 100m);
                            <tr>
                                <td class="col-bs">@d.DetBienOServicio</td>
                                <td>@d.DetDescripcion</td>
                                <td class="num">@d.DetCantidad.ToString("#,##0.##")</td>
                                <td>@(unidadesMedida.FirstOrDefault(u => u.UmeId == d.UmeId)?.UmeCodigo ?? "—")</td>
                                <td>@(d.DetBienOServicio == "B" && d.ProId is not null ? bodegas.FirstOrDefault(b => b.BodId == d.BodId)?.BodDescripcion ?? "—" : "—")</td>
                                <td class="num">@precioConIva.ToString("N2")</td>
                                <td class="num">@descuentoConIva.ToString("N2")</td>
                                <td class="num">@subtotalConIva.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (pestanaDetalleFactura == "planpagos")
            {
                @if (detallePlanPagos.Count == 0)
                {
                    <div class="doc-nota">
                        <Icono Nombre="info" Tamano="15" />
                        <span>@L("Esta factura no tiene plan de pagos (fue de contado).")</span>
                    </div>
                }
                else
                {
                    <table class="doc-tabla">
                        <thead>
                            <tr><th class="num">@L("Cuota")</th><th>@L("Fecha máxima de pago")</th><th class="num">@L("Valor")</th><th>@L("Estado")</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in detallePlanPagos)
                            {
                                <tr>
                                    <td class="num">@c.CppNroCuota</td>
                                    <td>@c.CppFechaMaximaPago.ToString("dd/MM/yyyy")</td>
                                    <td class="num">@c.CppValorCuota.ToString("N2")</td>
                                    <td>@(c.CppEstado switch { "P" => L("Pendiente"), "A" => L("Abonado"), "V" => L("Vencido"), _ => c.CppEstado })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<FacturaEncabezado> facturas = Array.Empty<FacturaEncabezado>();
    private string textoFiltro = "";
    private string motivoAnulacion = "";
    private string? avisoFel;
    private Erp.Data.Fel.FelDocumentoDetalle? felDetalle;
    private int pagina = 1;
    private int? anulandoId;
    private IReadOnlyList<FacturaEncabezado> facturasFiltradas => string.IsNullOrWhiteSpace(textoFiltro)
        ? facturas
        : facturas.Where(f => $"{f.EncSerieDocto}-{f.EncNumeroDocto} {f.NombreCliente}".Contains(textoFiltro.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();
    private IReadOnlyList<Vendedor> vendedores = Array.Empty<Vendedor>();
    private IReadOnlyList<Moneda> monedas = Array.Empty<Moneda>();
    private IReadOnlyList<Bodega> bodegas = Array.Empty<Bodega>();
    private IReadOnlyList<Cliente> clientesEncontrados = Array.Empty<Cliente>();
    private bool mostrarNuevoCliente;
    private readonly ClienteRapidoModelo nuevoClienteRapido = new();
    private IReadOnlyList<Producto> productosEncontrados = Array.Empty<Producto>();
    private int tdoIdFactura;

    private FacturaEncabezadoDetalle? encabezadoSeleccionado;
    private IReadOnlyList<FacturaDetalleLinea> detalleSeleccionado = Array.Empty<FacturaDetalleLinea>();

    private IReadOnlyList<FacturaEncabezado> historialCliente = Array.Empty<FacturaEncabezado>();
    private int? historialClienteExpandidoId;
    private IReadOnlyList<FacturaDetalleLinea> historialClienteDetalleExpandido = Array.Empty<FacturaDetalleLinea>();
    private string pestanaNuevaFactura = "historial";
    private static readonly IReadOnlyList<PestanaItem> PestanasNuevaFactura = new[]
    {
        new PestanaItem("historial", "Historial del cliente"),
        new PestanaItem("planpagos", "Plan de pagos"),
    };

    private IReadOnlyList<CuotaPlanPago> detallePlanPagos = Array.Empty<CuotaPlanPago>();
    private string pestanaDetalleFactura = "detalle";
    private static readonly IReadOnlyList<PestanaItem> PestanasDetalleFactura = new[]
    {
        new PestanaItem("detalle", "Detalle"),
        new PestanaItem("planpagos", "Plan de pagos"),
    };

    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private string filtroEstado = "";
    private bool mostrarNuevaFactura;
    private string? mensaje;
    private bool esMensajeError;

    private string textoBusquedaCliente = "";
    private string textoBusquedaProducto = "";
    // NIT del cliente: se pide después del primer producto.
    private ElementReference campoNit;
    private ElementReference campoProducto;
    private bool enfocarNit;
    private bool enfocarProducto;
    private string textoNit = "";
    private string? nitMensaje;
    private bool nitError;
    private bool consultandoNit;
    private string? nitSinNombre;
    private string nombreNitManual = "";
    private int ciaIdSesion;

    private readonly NuevaFacturaModelo nuevaFactura = new();
    private readonly List<LineaCaptura> lineas = new();
    private IReadOnlyList<UnidadMedida> unidadesMedida = Array.Empty<UnidadMedida>();

    // En Guatemala el IVA (% de la compañía, 12 por defecto) va incluido en el precio unitario que ve el
    // cliente; no se suma aparte. El total es simplemente subtotal - descuento,
    // y el IVA que se muestra es solo informativo (extraído del total, no
    // sumado a él). Internamente sí se envía como precio neto + %IVA al SP,
    // porque así espera los datos paVentaFacturaCrear para el asiento
    // contable (ver GrabarFacturaAsync).
    // Se toma de gen_compania.cia_porc_iva (General > Compañías) al iniciar.
    private decimal PorcentajeIva = 12m;
    private string PorcentajeIvaTexto => PorcentajeIva.ToString("0.##");

    private decimal Subtotal => lineas.Sum(l => l.SubTotal);
    private decimal TotalDescuento => lineas.Sum(l => l.ValorDescuento);
    // Total que grabará paVentaFacturaCrear y certificará FEL: el precio se
    // guarda sin IVA a centavos y el total vuelve a sumarle el IVA por unidad,
    // así que puede diferir un centavo de la suma de los precios con IVA.
    private decimal Total => lineas.Sum(TotalLineaDocumento);
    private decimal AjusteRedondeo => Total - (Subtotal - TotalDescuento);
    private decimal SinIva(decimal conIva) => Math.Round(conIva / (1 + PorcentajeIva / 100m), 2, MidpointRounding.AwayFromZero);
    private decimal ConIva(decimal sinIva) => Math.Round(sinIva * (1 + PorcentajeIva / 100m), 2, MidpointRounding.AwayFromZero);
    private decimal TotalLineaDocumento(LineaCaptura l) =>
        Math.Round(ConIva(SinIva(l.PrecioUnitario)) * l.Cantidad, 2, MidpointRounding.AwayFromZero) - ConIva(SinIva(l.ValorDescuento));
    private string condicionPagoFactura = "contado";
    private Erp.Data.Cuentas.CreditoCliente? creditoCliente;
    private decimal ValorCuotaFactura => nuevaFactura.NumeroCuotas > 0
        ? Math.Round((Total - nuevaFactura.MontoEnganche) / nuevaFactura.NumeroCuotas, 2)
        : 0;
    private decimal IvaIncluido => Math.Round(Total * PorcentajeIva / (100m + PorcentajeIva), 2);
    private string MonedaSimbolo => monedas.FirstOrDefault(m => m.MonId == nuevaFactura.MonId)?.MonSimbolo ?? "Q";

    private IReadOnlyList<CajaAperturaActiva> cajasAbiertasSucursal = Array.Empty<CajaAperturaActiva>();
    private IReadOnlyList<FormaPagoTipo> formasPagoTipo = Array.Empty<FormaPagoTipo>();
    private IReadOnlyList<EntidadFinanciera> entidadesFinancieras = Array.Empty<EntidadFinanciera>();
    private readonly List<FormaPagoCaptura> formasPagoCapturadas = new();
    private readonly FormaPagoCaptura formaPagoNueva = new();
    private int pcaIdFactura;
    // Vuelto: si la caja lo calcula, lo que entrega el cliente en efectivo.
    private decimal? efectivoRecibido;
    private bool CajaCalculaVuelto => cajasAbiertasSucursal.FirstOrDefault(c => c.PcaId == pcaIdFactura)?.PcrCalculaVuelto == true;
    private decimal EfectivoACobrar => formasPagoCapturadas.Where(f => EsEfectivo(f.PftId)).Sum(f => f.Monto)
        + (formasPagoCapturadas.Count == 0 && EsEfectivo(formaPagoNueva.PftId) ? MontoAPagar : 0);
    private int? sucIdSesion;
    private int? pveIdUsuario;

