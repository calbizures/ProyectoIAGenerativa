    private sealed class LineaCaptura
    {
        public int? ProId { get; set; }			// obligatorio en bienes; en servicios, solo si viene del catálogo
        public string Descripcion { get; set; } = "";
        public string BienOServicio { get; set; } = "B";
        public decimal Cantidad { get => _cantidad; set => _cantidad = Montos.DosDecimales(value); }
        private decimal _cantidad = 1;
        public int UmeId { get; set; }
        public decimal PrecioUnitario { get => _precioUnitario; set => _precioUnitario = Montos.DosDecimales(value); }
        private decimal _precioUnitario;
        public decimal ValorDescuento { get => _valorDescuento; set => _valorDescuento = Montos.DosDecimales(value); }
        private decimal _valorDescuento;
        public decimal SubTotal => Math.Round(Cantidad * PrecioUnitario, 2);
        public decimal? CostoUnitario { get; set; }
        public int? PprId { get; set; }
        public bool ManejaExistencia { get; set; }
        // Bodega de despacho: la del encabezado, salvo que se cambie en la línea.
        public int BodId { get; set; }
        public bool BodegaManual { get; set; }
        // Búsqueda de producto dentro de la línea (bien sin producto todavía).
        public string Busqueda { get; set; } = "";
        public IReadOnlyList<Producto> Resultados { get; set; } = Array.Empty<Producto>();
    }
