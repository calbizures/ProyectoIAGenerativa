            nuevaFactura.BodId = bodegas.Where(b => b.SucId == sucIdSesion).OrderBy(b => b.BodCodigo).FirstOrDefault()?.BodId ?? bodegas.FirstOrDefault()?.BodId ?? 0;
        textoNit = "";
        nitMensaje = null;
        nitError = false;
        nitSinNombre = null;
        enfocarProducto = true;
        historialCliente = Array.Empty<FacturaEncabezado>();
        historialClienteExpandidoId = null;
        historialClienteDetalleExpandido = Array.Empty<FacturaDetalleLinea>();
