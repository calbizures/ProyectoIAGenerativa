@page "/facturas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:VENTAS_FACTURA_CREAR,VENTAS_FACTURA_ANULAR")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Caja
@using Erp.Data.Inventario
@using Erp.Data.Ventas
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject Erp.Data.General.IGeneralRepository GeneralRepository
@inject IFacturaRepository FacturaRepository
@inject IProductoRepository ProductoRepository
@inject IProductoPrecioRepository PrecioRepository
@inject IBodegaRepository BodegaRepository
@inject IClienteRepository ClienteRepository
@inject IVendedorRepository VendedorRepository
@inject ICajaRepository CajaRepository
@inject Erp.Data.Cuentas.ICuentasRepository CuentasRepository
@inject Erp.Web.Fel.FelService FelService
@inject ILogger<Facturas> Log
@inject Erp.Data.Fel.IFelRepository FelRepository
@inject Erp.Web.Fel.FelConsultaNitServicio ConsultaNit
@inject ICotizacionRepository CotizacionRepository
@inject Erp.Web.Correo.DocumentosCorreo DocumentosCorreo

<PageTitle>@L("Facturas")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Facturas")</h1>
    <p>@L("Ventas y facturación a clientes.")</p>
</div>

<BorradorDocumento TDatos="BorradorFactura" Clave="facturas" Nombre="@L("una factura")"
                   Capturar="CapturarBorrador" Describir="DescribirBorrador" Restaurar="RestaurarBorradorAsync" />

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}
@if (avisoFel is not null)
{
    <div class="doc-nota doc-nota-aviso" role="status">
        <Icono Nombre="alert-triangle" Tamano="15" />
        <span>@L("Factura electrónica: {0}", avisoFel) <a href="fel/documentos">@L("Ver documentos electrónicos")</a></span>
    </div>
}

<div class="barra-herramientas">
    <FiltroPeriodo @bind-Desde="filtroFechaDesde" @bind-Hasta="filtroFechaHasta" AlCambiar="BuscarAsync" />
    <select @bind="filtroEstado" aria-label="@L("Estado")">
        <option value="">@L("Todas")</option>
        <option value="G">@L("Grabadas")</option>
        <option value="A">@L("Anuladas")</option>
    </select>
    <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />
    <input type="search" placeholder="@L("Filtrar por número o cliente")" aria-label="@L("Filtrar por número o cliente")" @bind="textoFiltro" @bind:event="oninput" @bind:after="() => pagina = 1" />

    <span class="barra-herramientas-separador"></span>

    <AuthorizeView Policy="Permiso:VENTAS_FACTURA_CREAR">
        <Authorized>
            <BotonIcono Icono="plus" Tooltip="@L("Nueva factura")" Etiqueta="@L("Nueva factura")" Variante="primario" OnClick="MostrarNuevaFacturaAsync" />
        </Authorized>
    </AuthorizeView>
</div>

@if (mostrarNuevaFactura)
{
    <div class="doc-card">
        <div class="doc-card-header">
            <div>
                <h2>@L("Nueva factura")</h2>
                <p>@L("Escanee o busque los productos; después del primero se pide el NIT del cliente (si no existe, se consulta al certificador y se registra).")</p>
            </div>
            <Icono Nombre="receipt" Tamano="30" />
        </div>

        <div class="doc-card-body">
            @if (cotizacionOrigen is not null)
            {
                <div class="doc-nota" role="status">
                    <Icono Nombre="clipboard-list" Tamano="15" />
                    <span>@L("Desde la cotización") <strong>@cotizacionOrigen.Numero</strong>@L(", válida hasta el") <strong>@cotizacionOrigen.Vence.ToString("dd/MM/yyyy")</strong>@L(": se respetan los precios cotizados y la existencia se valida al grabar. Al grabar, la cotización queda facturada.")</span>
                    <BotonIcono Icono="x" Tooltip="@L("Facturar sin relacionar la cotización")" Variante="fantasma" OnClick="() => cotizacionOrigen = null" />
                </div>
            }
            <div class="doc-seccion">
                <p class="doc-seccion-titulo"><Icono Nombre="file-text" Tamano="15" /> @L("Datos generales")</p>
                <div class="doc-grid">
                    <div class="campo"><label for="facturas-factura-fecha">@L("Fecha")</label><input id="facturas-factura-fecha" type="date" @bind="nuevaFactura.Fecha" /></div>
                    <div class="campo"><label for="facturas-factura-seriedocumento">@L("Serie")</label><input id="facturas-factura-seriedocumento" @bind="nuevaFactura.SerieDocumento" /></div>
                    <div class="campo"><label for="facturas-factura-numerodocumento">@L("Número")</label><input id="facturas-factura-numerodocumento" @bind="nuevaFactura.NumeroDocumento" /></div>
                    <div class="campo">
                        <label for="facturas-factura-pveid">@L("Vendedor")</label>
                        <select id="facturas-factura-pveid" @bind="nuevaFactura.PveId">
                            <option value="">@L("(Sin asignar)")</option>
                            @foreach (var v in vendedores)
                            {
                                <option value="@v.PveId">@v.PveNombres @v.PveApellidos</option>
                            }
                        </select>
                        @if (pveIdUsuario is null)
                        {
                            <small class="texto-ayuda">@L("Su usuario no tiene vendedor: vincúlelo en RRHH › Empleados › Vínculos con el sistema.")</small>
                        }
                        else if (nuevaFactura.PveId == pveIdUsuario)
                        {
                            <small class="texto-ayuda">@L("El vendedor de su usuario.")</small>
                        }
                    </div>
                    <div class="campo">
                        <label for="facturas-factura-bodid">@L("Bodega")</label>
                        <select id="facturas-factura-bodid" @bind="nuevaFactura.BodId" @bind:after="AlCambiarBodegaEncabezado">
                            <option value="0">@L("Seleccione...")</option>
                            @foreach (var b in bodegas)
                            {
                                <option value="@b.BodId">@b.BodDescripcion</option>
                            }
                        </select>
                        <small class="texto-ayuda">@L("Se propone en cada línea; una línea puede despachar de otra bodega de la sucursal.")</small>
                    </div>
                    <div class="campo">
                        <label for="facturas-factura-monid">@L("Moneda")</label>
                        <select id="facturas-factura-monid" @bind="nuevaFactura.MonId">
                            @foreach (var m in monedas)
                            {
                                <option value="@m.MonId">@m.MonCodigo</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="doc-seccion">
                <p class="doc-seccion-titulo"><Icono Nombre="user" Tamano="15" /> @L("Cliente")</p>

                @if (nuevaFactura.CliId is null)
                {
                    <div class="doc-nit">
                        <div class="doc-nit-fila">
                            <label for="fac-nit">@L("NIT")</label>
                            <input id="fac-nit" @ref="campoNit" placeholder="@L("NIT, CUI o C/F y Enter")" aria-describedby="fac-nit-ayuda" maxlength="20" autocomplete="off"
                                   @bind="textoNit" @bind:event="oninput" @onkeyup="@(async e => { if (e.Key == "Enter") await ConsultarNitAsync(); })" />
                            <BotonIcono Icono="search" Tooltip="@L("Buscar el NIT (base de datos y certificador)")" Etiqueta="@L("Buscar NIT")" Variante="primario" Deshabilitado="consultandoNit" OnClick="ConsultarNitAsync" />
                            <BotonIcono Icono="user" Tooltip="@L("Consumidor final")" Etiqueta="C/F" OnClick="ConsumidorFinalAsync" />
                        </div>
                        <small id="fac-nit-ayuda" class="@(nitError ? "texto-error" : "texto-ayuda")">
                            @(nitMensaje ?? L("Si el cliente no existe se consulta su nombre al certificador FEL y se registra automáticamente."))
                        </small>
                        @if (nitSinNombre is not null)
                        {
                            <div class="doc-alta-rapida">
                                <p class="doc-alta-rapida-titulo">@L("Registrar el NIT {0}", nitSinNombre)</p>
                                <div class="doc-grid">
                                    <div class="campo campo-ancho"><label for="fac-nit-nombre">@L("Nombre o razón social")</label><input id="fac-nit-nombre" @bind="nombreNitManual" maxlength="128" /></div>
                                </div>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="@L("Registrar el cliente")" Etiqueta="@L("Registrar cliente")" Variante="primario" OnClick="RegistrarNitManualAsync" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => nitSinNombre = null" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="doc-buscador">
                        <div class="doc-buscador-fila">
                            <input placeholder="@L("O busque por código, nombre o NIT")" aria-label="@L("Buscar cliente por código, nombre o NIT")" @bind="textoBusquedaCliente" @bind:event="oninput" @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarClientesAsync(); })" />
                            <BotonIcono Icono="search" Tooltip="@L("Buscar cliente")" OnClick="BuscarClientesAsync" />
                            <BotonIcono Icono="plus" Tooltip="@L("Cliente nuevo")" OnClick="() => mostrarNuevoCliente = !mostrarNuevoCliente" />
                        </div>
                        @if (clientesEncontrados.Count > 0)
                        {
                            <div class="doc-buscador-resultados">
                                @foreach (var c in clientesEncontrados)
                                {
                                    <div class="doc-resultado-fila" @onclick="() => SeleccionarClienteAsync(c)">
                                        <span class="doc-avatar">@Iniciales(c.NombreCompleto)</span>
                                        <span class="doc-resultado-texto">
                                            <strong>@c.NombreCompleto</strong>
                                            <span>@L("{0} · NIT {1}", c.CliCodigo, c.CliNit ?? "C/F")</span>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        @if (mostrarNuevoCliente)
                        {
                            <div class="doc-alta-rapida">
                                <p class="doc-alta-rapida-titulo">@L("Cliente nuevo")</p>
                                <div class="doc-grid">
                                    <div class="campo"><label for="facturas-clienterapido-codigo">@L("Código")</label><input id="facturas-clienterapido-codigo" @bind="nuevoClienteRapido.Codigo" /></div>
                                    <div class="campo"><label for="facturas-clienterapido-nombres">@L("Nombres")</label><input id="facturas-clienterapido-nombres" @bind="nuevoClienteRapido.Nombres" /></div>
                                    <div class="campo"><label for="facturas-clienterapido-apellidos">@L("Apellidos")</label><input id="facturas-clienterapido-apellidos" @bind="nuevoClienteRapido.Apellidos" /></div>
                                    <div class="campo"><label for="facturas-clienterapido-nit">@L("NIT")</label><input id="facturas-clienterapido-nit" @bind="nuevoClienteRapido.Nit" /></div>
                                    <div class="campo"><label for="facturas-clienterapido-telefono">@L("Teléfono")</label><input id="facturas-clienterapido-telefono" @bind="nuevoClienteRapido.Telefono" /></div>
                                </div>
                                <div class="acciones-fila">
                                    <BotonIcono Icono="save" Tooltip="@L("Guardar cliente")" Etiqueta="@L("Guardar cliente")" Variante="primario" OnClick="CrearClienteRapidoAsync" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevoCliente = false" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="doc-chip">
                        <span class="doc-avatar">@Iniciales($"{nuevaFactura.NombresCliente} {nuevaFactura.ApellidosCliente}")</span>
                        <span class="doc-chip-texto">
                            <strong>@nuevaFactura.NombresCliente @nuevaFactura.ApellidosCliente</strong>
                            <span>@L("NIT: {0}", nuevaFactura.Nit ?? "C/F")</span>
                        </span>
                        <BotonIcono Icono="x" Tooltip="@L("Cambiar cliente")" Variante="fantasma" OnClick="LimpiarClienteSeleccionado" />
                    </div>
                }
            </div>

            <div class="doc-seccion">
                <p class="doc-seccion-titulo"><Icono Nombre="package" Tamano="15" /> @L("Detalle")</p>

                <div class="doc-buscador">
                    <div class="doc-buscador-fila">
                        <input @ref="campoProducto" placeholder="@L("Escanee o busque el producto por código o descripción")" aria-label="@L("Buscar producto por código o descripción")" @bind="textoBusquedaProducto" @bind:event="oninput" @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarProductosAsync(); })" />
                        <BotonIcono Icono="search" Tooltip="@L("Buscar producto")" OnClick="BuscarProductosAsync" />
                        <BotonIcono Icono="plus" Tooltip="@L("Agregar un servicio (sin producto)")" Etiqueta="@L("Agregar servicio")" OnClick="AgregarServicio" />
                    </div>
                    @if (productosEncontrados.Count > 0)
                    {
                        <div class="doc-buscador-resultados">
                            @foreach (var p in productosEncontrados)
                            {
                                <div class="doc-resultado-fila" @onclick="() => AgregarLineaAsync(p)">
                                    <span class="doc-avatar doc-avatar-icono"><Icono Nombre="package" Tamano="15" /></span>
                                    <span class="doc-resultado-texto">
                                        <strong>@p.ProDescripcion</strong>
                                        <span>@p.ProCodigo · @(p.ProTipoItem == "S" ? L("Servicio") : L("Bien"))</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="doc-nota">
                    <Icono Nombre="check-circle" Tamano="15" />
                    <span>@L("B = bien (producto del inventario), S = servicio (se describe en la línea). El precio unitario ya incluye IVA ({0}%), como se factura en Guatemala — no se suma aparte.", PorcentajeIvaTexto)</span>
                </div>

                <table class="doc-tabla doc-tabla-detalle">
                    <thead>
                        <tr>
                            <th class="col-bs">B/S</th>
                            <th>@L("Descripción")</th>
                            <th class="num">@L("Cantidad")</th>
                            <th>@L("Unidad")</th>
                            <th>@L("Bodega")</th>
                            <th class="num">@L("Precio unit. (IVA incl.)")</th>
                            <th class="num">@L("Descuento")</th>
                            <th class="num">@L("Subtotal")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lineas.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="doc-tabla-vacia">
                                        <Icono Nombre="package" Tamano="26" />
                                        @L("Busque un producto arriba o use «Agregar servicio» para una línea de servicio.")
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var linea in lineas)
                        {
                            <tr>
                                <td class="col-bs">
                                    <select aria-label="@L("Bien o servicio")" value="@linea.BienOServicio" @onchange="e => CambiarTipoLinea(linea, e.Value?.ToString())">
                                        <option value="B">B</option>
                                        <option value="S">S</option>
                                    </select>
                                </td>
                                <td>
                                    @if (linea.BienOServicio == "S")
                                    {
                                        <input class="doc-input-descripcion" placeholder="@L("Describa el servicio")" aria-label="@L("Descripción del servicio")" maxlength="256" @bind="linea.Descripcion" />
                                    }
                                    else if (linea.ProId is not null)
                                    {
                                        @linea.Descripcion
                                    }
                                    else
                                    {
                                        <div class="doc-buscador-linea">
                                            <input placeholder="@L("Buscar producto")" aria-label="@L("Buscar producto para esta línea")" @bind="linea.Busqueda" @bind:event="oninput"
                                                   @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarProductoLineaAsync(linea); })" />
                                            <BotonIcono Icono="search" Tooltip="@L("Buscar producto")" OnClick="() => BuscarProductoLineaAsync(linea)" />
                                            @if (linea.Resultados.Count > 0)
                                            {
                                                <div class="doc-buscador-resultados">
                                                    @foreach (var p in linea.Resultados)
                                                    {
                                                        <div class="doc-resultado-fila" @onclick="() => AsignarProductoLineaAsync(linea, p)">
                                                            <span class="doc-resultado-texto"><strong>@p.ProDescripcion</strong><span>@p.ProCodigo</span></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="num"><input type="number" min="0" step="@(linea.ManejaExistencia ? "1" : "0.01")" aria-label="@L("Cantidad")" @bind="linea.Cantidad" /></td>
                                <td>
                                    <select aria-label="@L("Unidad de medida")" @bind="linea.UmeId">
                                        <option value="0">—</option>
                                        @foreach (var u in unidadesMedida.Where(u => u.UmeEstado == "A" || u.UmeId == linea.UmeId))
                                        {
                                            <option value="@u.UmeId">@u.UmeCodigo</option>
                                        }
                                    </select>
                                </td>
                                <td class="col-bodega-linea">
                                    @if (linea.BienOServicio == "B" && linea.ManejaExistencia && linea.ProId is int proIdLinea)
                                    {
                                        var existencia = Existencia(proIdLinea, linea.BodId);
                                        <select aria-label="@L("Bodega de despacho")" value="@linea.BodId" @onchange="e => CambiarBodegaLinea(linea, e.Value?.ToString())">
                                            @foreach (var b in BodegasDespacho(linea.BodId))
                                            {
                                                <option value="@b.BodId">@b.BodDescripcion</option>
                                            }
                                        </select>
                                        <small class="@(existencia < linea.Cantidad ? "texto-error" : "texto-tenue")">@L("Exist. {0}", existencia.ToString("#,##0.##"))</small>
                                    }
                                    else
                                    {
                                        <span class="texto-tenue">—</span>
                                    }
                                </td>
                                <td class="num"><input type="number" step="0.01" min="0" aria-label="@L("Precio unitario")" @bind="linea.PrecioUnitario" /></td>
                                <td class="num"><input type="number" step="0.01" min="0" aria-label="@L("Descuento")" @bind="linea.ValorDescuento" /></td>
                                <td class="num">@MonedaSimbolo @linea.SubTotal.ToString("N2")</td>
                                <td><BotonIcono Icono="trash-2" Tooltip="@L("Quitar línea")" Variante="peligro" OnClick="() => lineas.Remove(linea)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="doc-seccion doc-totales-envoltorio">
                <div class="doc-totales">
                    <div class="doc-totales-fila"><span>@L("Subtotal")</span><span>@MonedaSimbolo @Subtotal.ToString("N2")</span></div>
                    <div class="doc-totales-fila"><span>@L("Descuento")</span><span>@MonedaSimbolo @TotalDescuento.ToString("N2")</span></div>
                    @if (AjusteRedondeo != 0)
                    {
                        <div class="doc-totales-fila"><span>@L("Redondeo del IVA")</span><span>@MonedaSimbolo @AjusteRedondeo.ToString("N2")</span></div>
                    }
                    <div class="doc-totales-total"><span>@L("Total")</span><span>@MonedaSimbolo @Total.ToString("N2")</span></div>
                    <div class="doc-totales-nota">@L("IVA incluido ({0}%): {1} {2}", PorcentajeIvaTexto, MonedaSimbolo, IvaIncluido.ToString("N2"))</div>
                </div>
            </div>

            <div class="doc-seccion">
                <p class="doc-seccion-titulo"><Icono Nombre="credit-card" Tamano="15" /> @L("Forma de pago")</p>
                <div class="doc-grid">
                    <div class="campo">
                        <label for="facturas-condicionpagofactura">@L("Condición")</label>
                        <select id="facturas-condicionpagofactura" @bind="condicionPagoFactura">
                            <option value="contado">@L("Contado")</option>
                            <option value="credito">@L("Crédito")</option>
                        </select>
                    </div>
                    @if (condicionPagoFactura == "credito")
                    {
                        <div class="campo"><label for="facturas-factura-montoenganche">@L("Enganche")</label><input id="facturas-factura-montoenganche" type="number" step="0.01" min="0" @bind="nuevaFactura.MontoEnganche" /></div>
                        <div class="campo"><label for="facturas-factura-numerocuotas">@L("Número de cuotas")</label><input id="facturas-factura-numerocuotas" type="number" min="1" @bind="nuevaFactura.NumeroCuotas" /></div>
                        <div class="campo"><label for="facturas-factura-fechaprimerpago">@L("Fecha del primer pago")</label><input id="facturas-factura-fechaprimerpago" type="date" @bind="nuevaFactura.FechaPrimerPago" /></div>
                    }
                </div>
                @if (condicionPagoFactura == "credito" && creditoCliente is not null)
                {
                    var financiado = Total - nuevaFactura.MontoEnganche;
                    var excede = creditoCliente.Disponible is not null && financiado > creditoCliente.Disponible;
                    <div class="credito-resumen @(excede ? "credito-excedido" : "")" role="@(excede ? "alert" : null)">
                        @if (creditoCliente.Limite == 0)
                        {
                            <span>@L("Cliente sin límite de crédito")</span>
                        }
                        else
                        {
                            <span>@L("Límite") <strong>@MonedaSimbolo @creditoCliente.Limite.ToString("N2")</strong></span>
                            <span>@L("Saldo actual") <strong>@MonedaSimbolo @creditoCliente.Saldo.ToString("N2")</strong></span>
                            <span>@L("Disponible") <strong>@MonedaSimbolo @((creditoCliente.Disponible ?? 0).ToString("N2"))</strong></span>
                        }
                        <span>@L("A financiar") <strong>@MonedaSimbolo @financiado.ToString("N2")</strong></span>
                        @if (excede)
                        {
                            <span>@L("Excede el crédito disponible: aumente el enganche o cobre saldos pendientes.")</span>
                        }
                    </div>
                }

                @if (condicionPagoFactura == "contado" || nuevaFactura.MontoEnganche > 0)
                {
                    @if (cajasAbiertasSucursal.Count == 0)
                    {
                        <div class="doc-nota">
                            <Icono Nombre="alert-triangle" Tamano="15" />
                            <span>@L("No hay una caja abierta en esta sucursal. Para grabar {0} abra la caja en Bancos › Caja.", condicionPagoFactura == "credito" ? L("una factura con enganche") : L("una factura de contado"))</span>
                        </div>
                    }
                    else
                    {
                        @if (cajasAbiertasSucursal.Count > 1)
                        {
                            <div class="campo">
                                <label for="facturas-pcaidfactura">@L("Caja receptora")</label>
                                <select id="facturas-pcaidfactura" @bind="pcaIdFactura">
                                    @foreach (var c in cajasAbiertasSucursal)
                                    {
                                        <option value="@c.PcaId">@c.PcrDescripcion</option>
                                    }
                                </select>
                            </div>
                        }

                        <p>@L("Monto a pagar ahora: {0} {1}", MonedaSimbolo, MontoAPagar.ToString("N2"))</p>

                        <table class="doc-tabla tabla-formas-pago">
                            <thead><tr><th>@L("Forma")</th><th class="num">@L("Monto")</th><th>@L("Entidad financiera")</th><th>@L("No. de cheque o referencia")</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var f in formasPagoCapturadas)
                                {
                                    <tr>
                                        <td>@NombreFormaPago(f.PftId)</td>
                                        <td class="num">@MonedaSimbolo @f.Monto.ToString("N2")</td>
                                        <td>@(entidadesFinancieras.FirstOrDefault(e => e.GefId == f.GefId)?.GefDescripcion ?? "—")</td>
                                        <td>
                                            @(f.NumeroCheque ?? f.NumeroTarjetaUlt4 ?? "—")
                                            @if (f.ComprobanteNombre is not null)
                                            {
                                                <span class="texto-tenue" title="@L("Comprobante adjunto")"> · <Icono Nombre="file-text" Tamano="13" /> @f.ComprobanteNombre</span>
                                            }
                                        </td>
                                        <td><BotonIcono Icono="trash-2" Tooltip="@L("Quitar")" Variante="peligro" OnClick="() => formasPagoCapturadas.Remove(f)" /></td>
                                    </tr>
                                }
                                <tr>
                                    <td>
                                        <select @bind="formaPagoNueva.PftId" @bind:after="AlCambiarFormaNueva" aria-label="@L("Forma de pago")">
                                            <option value="0">@L("Seleccione...")</option>
                                            @foreach (var t in formasPagoTipo)
                                            {
                                                <option value="@t.PftId">@t.PftDescripcion</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num"><input class="entrada-monto" type="number" step="0.01" min="0" @bind="formaPagoNueva.Monto" aria-label="@L("Monto")" /></td>
                                    <td>
                                        @if (RequiereEntidadFinanciera(formaPagoNueva.PftId) || EsTarjeta(formaPagoNueva.PftId))
                                        {
                                            <select @bind="formaPagoNueva.GefId" aria-label="@L("Entidad financiera")">
                                                <option value="0">@L("Entidad...")</option>
                                                @foreach (var e in entidadesFinancieras)
                                                {
                                                    <option value="@e.GefId">@e.GefDescripcion</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                    <td>
                                        @if (EsCheque(formaPagoNueva.PftId))
                                        {
                                            <input class="entrada-referencia" placeholder="@L("No. de cheque")" aria-label="@L("No. de cheque")" @bind="formaPagoNueva.NumeroCheque" />
                                        }
                                        else if (EsTarjeta(formaPagoNueva.PftId))
                                        {
                                            <input class="entrada-referencia" placeholder="@L("Últimos 4 dígitos")" aria-label="@L("Últimos 4 dígitos")" maxlength="4" @bind="formaPagoNueva.NumeroTarjetaUlt4" />
                                        }
                                        else if (EsTransferencia(formaPagoNueva.PftId))
                                        {
                                            <input class="entrada-referencia" placeholder="@L("No. de operación")" aria-label="@L("No. de operación de la transferencia")" maxlength="16" @bind="formaPagoNueva.NumeroCheque" />
                                            <AdjuntarArchivo Id="fac-comprobante" Etiqueta="@L("Comprobante")" Compacto="true" @bind-Archivo="comprobanteNuevo" AlError="MostrarErrorFormaPago" />
                                        }
                                    </td>
                                    <td><BotonIcono Icono="plus" Tooltip="@L("Agregar forma de pago")" OnClick="AgregarFormaPago" /></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="doc-totales-nota">
                            @L("Capturado: {0} {1} de {0} {2}", MonedaSimbolo, formasPagoCapturadas.Sum(f => f.Monto).ToString("N2"), MontoAPagar.ToString("N2"))
                            @if (formasPagoCapturadas.Count == 0 && formaPagoNueva.PftId > 0)
                            {
                                <span> @L("· si no agrega otra, todo se registra en {0}", NombreFormaPago(formaPagoNueva.PftId))</span>
                            }
                        </div>
                        <CalculoVuelto Activo="CajaCalculaVuelto" Efectivo="EfectivoACobrar" Simbolo="@MonedaSimbolo" Id="facturas-efectivo-recibido" @bind-Recibido="efectivoRecibido" />
                    }
                }
            </div>
            @if (nuevaFactura.CliId is not null)
            {
                <div class="doc-seccion">
                    <BarraPestanas Pestanas="PestanasNuevaFactura" @bind-PestanaActiva="pestanaNuevaFactura" />

                    @if (pestanaNuevaFactura == "historial")
                    {
                        @if (historialCliente.Count == 0)
                        {
                            <div class="doc-nota">
                                <Icono Nombre="info" Tamano="15" />
                                <span>@L("Este cliente no tiene compras registradas.")</span>
                            </div>
                        }
                        else
                        {
                            <table class="doc-tabla">
                                <thead>
                                    <tr><th>@L("Fecha")</th><th>@L("Serie/Número")</th><th class="num">@L("Total")</th><th>@L("Estado")</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in historialCliente)
                                    {
                                        <tr>
                                            <td>@h.EncFechaDocto.ToString("dd/MM/yyyy")</td>
                                            <td>@(string.IsNullOrWhiteSpace(h.EncSerieDocto) ? $"{h.EncNumeroDocto}" : $"{h.EncSerieDocto}-{h.EncNumeroDocto}")</td>
                                            <td class="num">@MonedaSimbolo @h.EncMontoTotal.ToString("N2")</td>
                                            <td>@(h.EncEstado == "G" ? L("Grabada") : L("Anulada"))</td>
                                            <td><BotonIcono Icono="eye" Tooltip="@L("Ver qué compró")" OnClick="() => AlternarDetalleHistorialAsync(h)" /></td>
                                        </tr>
                                        @if (historialClienteExpandidoId == h.EncId)
                                        {
                                            <tr>
                                                <td colspan="5">
                                                    <table class="doc-tabla">
                                                        <thead><tr><th>@L("Producto")</th><th class="num">@L("Cantidad")</th><th class="num">@L("Precio unit.")</th></tr></thead>
                                                        <tbody>
                                                            @foreach (var d in historialClienteDetalleExpandido)
                                                            {
                                                                var precioConIva = d.DetPrecioUnitario * (1 + (d.DetPorcIva ?? 0) / 100m);
                                                                <tr>
                                                                    <td>@d.DetDescripcion</td>
                                                                    <td class="num">@d.DetCantidad.ToString("#,##0.##")</td>
                                                                    <td class="num">@precioConIva.ToString("N2")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else if (pestanaNuevaFactura == "planpagos")
                    {
                        @if (condicionPagoFactura == "credito")
                        {
                            <div class="doc-nota">
                                <Icono Nombre="info" Tamano="15" />
                                <span>@L("Plan de pagos: {0} cuota(s) de {1} {2}, a partir del enganche de {3} {4}.", nuevaFactura.NumeroCuotas, MonedaSimbolo, ValorCuotaFactura.ToString("N2"), MonedaSimbolo, nuevaFactura.MontoEnganche.ToString("N2"))</span>
                            </div>
                        }
                        else
                        {
                            <div class="doc-nota">
                                <Icono Nombre="info" Tamano="15" />
                                <span>@L("Esta factura es de contado. Seleccione la condición \"Crédito\" en Forma de pago para ver el plan de cuotas.")</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="doc-card-footer">
            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevaFactura = false" />
            <BotonIcono Icono="save" Tooltip="@L("Grabar factura")" Etiqueta="@L("Grabar factura")" Variante="primario" OnClick="GrabarFacturaAsync" />
        </div>
    </div>
}

@if (!mostrarNuevaFactura)
{
