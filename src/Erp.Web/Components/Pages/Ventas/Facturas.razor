    private decimal MontoAPagar => condicionPagoFactura == "credito" ? nuevaFactura.MontoEnganche : Total;

    protected override async Task OnInitializedAsync()
    {
        vendedores = await FacturaRepository.ConsultarVendedoresAsync();
        int? sucIdParametros = null;
        if (AuthenticationStateTask is not null)
            sucIdParametros = (await AuthenticationStateTask).User.ObtenerSucId();
        var parametrosCompania = await GeneralRepository.ConsultarParametrosAsync(sucIdParametros);
        PorcentajeIva = parametrosCompania.CiaPorcIva;
        ciaIdSesion = parametrosCompania.CiaId;
        sucIdSesion = sucIdParametros;
        monedas = await FacturaRepository.ConsultarMonedasAsync();
        bodegas = await BodegaRepository.ConsultarAsync(sucId: null, estado: "A");
        unidadesMedida = await BodegaRepository.ConsultarUnidadesAsync(soloActivas: false);
        formasPagoTipo = await CajaRepository.ConsultarFormasPagoTipoAsync();
        entidadesFinancieras = await CajaRepository.ConsultarEntidadesFinancierasAsync();

        var tiposDocumento = await FacturaRepository.ConsultarTiposDocumentoAsync();
        tdoIdFactura = (tiposDocumento.FirstOrDefault(t => t.TdoCodigo == "FCAM") ?? tiposDocumento.FirstOrDefault())?.TdoId ?? 0;

        var monedaLocal = monedas.FirstOrDefault(m => m.MonEsLocal);
        if (monedaLocal is not null) nuevaFactura.MonId = monedaLocal.MonId;

        if (AuthenticationStateTask is not null)
        {
            var estado = await AuthenticationStateTask;
            var sucId = estado.User.ObtenerSucId();
            if (sucId is > 0)
                cajasAbiertasSucursal = await CajaRepository.ConsultarAperturaActivaPorSucursalAsync(sucId.Value);

            // Si el usuario es un empleado que también es vendedor, se propone como vendedor de la factura.
            var usuId = estado.User.ObtenerUsuId();
            if (usuId is not null)
                pveIdUsuario = (await VendedorRepository.ConsultarPorUsuarioAsync(usuId.Value))?.PveId;
        }

        await BuscarAsync();
        if (CotizacionId is int cotId)
            await CargarCotizacionAsync(cotId);
    }

    // Abre la factura nueva con las líneas, el cliente, la bodega y el vendedor
    // de una cotización vigente; todo queda editable antes de grabar.
    private async Task CargarCotizacionAsync(int cotId)
    {
        try
        {
            var (cotizacion, lineasCotizacion) = await CotizacionRepository.ConsultarPorIdAsync(cotId);
            if (cotizacion is null)
            {
                mensaje = L("No existe la cotización {0}.", cotId);
                esMensajeError = true;
                return;
            }
            if (!cotizacion.PuedeFacturarse)
            {
                mensaje = cotizacion.Estado switch
                {
                    "X" => L("La cotización {0} venció el {1:dd/MM/yyyy}: ya no se puede facturar. Duplíquela en Cotizaciones para cotizar con los precios de hoy.", cotizacion.Numero, cotizacion.Vence),
                    "F" => L("La cotización {0} ya se facturó en {1}.", cotizacion.Numero, cotizacion.Factura),
                    _ => L("La cotización {0} está anulada.", cotizacion.Numero)
                };
                esMensajeError = true;
                return;
            }

            await MostrarNuevaFacturaAsync();
            cotizacionOrigen = cotizacion;
            if (bodegas.Any(b => b.BodId == cotizacion.BodId)) nuevaFactura.BodId = cotizacion.BodId;
            nuevaFactura.MonId = cotizacion.MonId;
            nuevaFactura.PveId = cotizacion.PveId ?? pveIdUsuario;
            foreach (var l in lineasCotizacion)
            {
                lineas.Add(new LineaCaptura
                {
                    ProId = l.ProId,
                    Descripcion = l.Descripcion,
                    BienOServicio = l.BienOServicio,
                    Cantidad = l.Cantidad,
                    UmeId = l.UmeId ?? 0,
                    PrecioUnitario = l.PrecioUnitario,
                    ValorDescuento = l.Descuento,
                    CostoUnitario = l.CostoUnitario,
                    PprId = l.PprId,
                    ManejaExistencia = l.ManejaExistencia,
                    BodId = nuevaFactura.BodId
                });
                if (l.ManejaExistencia && l.ProId is int proIdCotizado) await CargarExistenciasAsync(proIdCotizado);
            }

            var cliente = cotizacion.CliId is int cliId ? await ClienteRepository.ConsultarPorIdAsync(cliId)
                : string.IsNullOrWhiteSpace(cotizacion.Nit) ? null : await ClienteRepository.BuscarPorNitAsync(cotizacion.Nit);
            if (cliente is not null)
            {
                await SeleccionarClienteAsync(cliente);
                enfocarProducto = true;
            }
            else
            {
                // Prospecto: el NIT cotizado queda escrito para registrarlo como cliente.
                textoNit = cotizacion.Nit ?? "";
                nombreNitManual = cotizacion.Cliente;
                enfocarNit = true;
                enfocarProducto = false;
            }

            var faltantes = lineasCotizacion.Count(l => l.ManejaExistencia && (l.Existencia ?? 0) < l.Cantidad);
            if (faltantes > 0)
            {
                mensaje = L("{0} {1} existencia suficiente en la bodega; ajuste las cantidades antes de grabar.", faltantes, (faltantes == 1 ? L("producto de la cotización no tiene") : L("productos de la cotización no tienen")));
                esMensajeError = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private string NombreFormaPago(int pftId) => formasPagoTipo.FirstOrDefault(t => t.PftId == pftId)?.PftDescripcion ?? "—";
    private bool EsEfectivo(int pftId) => NombreFormaPago(pftId).Equals("Efectivo", StringComparison.OrdinalIgnoreCase);
    private bool EsCheque(int pftId) => NombreFormaPago(pftId).Equals("Cheque", StringComparison.OrdinalIgnoreCase);
    private bool EsTarjeta(int pftId) => NombreFormaPago(pftId).Equals("Tarjeta", StringComparison.OrdinalIgnoreCase);
    private bool EsTransferencia(int pftId) => NombreFormaPago(pftId).Equals("Transferencia", StringComparison.OrdinalIgnoreCase);

    // Envío de la factura seleccionada al correo del cliente.
    private Erp.Web.Correo.DocumentosCorreo.Documento? correoFactura;

    private async Task AbrirCorreoFacturaAsync()
    {
        if (encabezadoSeleccionado is null) return;
