    }

    // Comprobante de la transferencia que se está capturando (opcional).
    private ArchivoCargado? comprobanteNuevo;
    private IReadOnlyList<Erp.Data.Cuentas.TransferenciaRecibida> transferenciasFactura = Array.Empty<Erp.Data.Cuentas.TransferenciaRecibida>();

    // Al elegir la forma de pago se propone lo que falta por pagar.
    private void AlCambiarFormaNueva()
    {
        var pendiente = MontoAPagar - formasPagoCapturadas.Sum(f => f.Monto);
        formaPagoNueva.Monto = pendiente > 0 ? pendiente : 0;
        if (!EsTransferencia(formaPagoNueva.PftId)) comprobanteNuevo = null;
    }

    private void MostrarErrorFormaPago(string texto)
    {
        mensaje = texto;
        esMensajeError = true;
    }

    // Una transferencia lleva su número de operación, distinto de las demás del mismo pago.
    private string? ValidarTransferencia(FormaPagoCaptura forma, IEnumerable<FormaPagoCaptura> otras)
    {
        if (!EsTransferencia(forma.PftId)) return null;
        if (string.IsNullOrWhiteSpace(forma.NumeroCheque)) return L("Escriba el número de operación de la transferencia.");
        if (otras.Any(o => EsTransferencia(o.PftId) && string.Equals(o.NumeroCheque?.Trim(), forma.NumeroCheque.Trim(), StringComparison.OrdinalIgnoreCase)))
            return L("Ya hay otra transferencia con ese número de operación en este pago.");
        return null;
    }
    private bool RequiereEntidadFinanciera(int pftId)
    {
        var nombre = NombreFormaPago(pftId);
        return nombre.Equals("Cheque", StringComparison.OrdinalIgnoreCase) || nombre.Equals("Transferencia", StringComparison.OrdinalIgnoreCase);
    }

    private void AgregarFormaPago()
    {
        if (formaPagoNueva.PftId <= 0 || formaPagoNueva.Monto <= 0)
        {
            mensaje = L("Seleccione la forma de pago e indique un monto mayor a cero.");
            esMensajeError = true;
            return;
        }

        var error = ValidarTransferencia(formaPagoNueva, formasPagoCapturadas);
        if (error is not null)
        {
            MostrarErrorFormaPago(error);
            return;
        }

        formasPagoCapturadas.Add(new FormaPagoCaptura
        {
            PftId = formaPagoNueva.PftId,
            Monto = formaPagoNueva.Monto,
            GefId = formaPagoNueva.GefId > 0 ? formaPagoNueva.GefId : null,
            NumeroTarjetaUlt4 = formaPagoNueva.NumeroTarjetaUlt4,
            FechaVencimientoTarjeta = formaPagoNueva.FechaVencimientoTarjeta,
            NumeroCheque = formaPagoNueva.NumeroCheque?.Trim(),
            ComprobanteNombre = comprobanteNuevo?.Nombre,
            ComprobanteTipo = comprobanteNuevo?.Tipo,
            Comprobante = comprobanteNuevo?.Contenido
        });
        comprobanteNuevo = null;

        formaPagoNueva.PftId = 0;
        formaPagoNueva.Monto = 0;
        formaPagoNueva.GefId = null;
        formaPagoNueva.NumeroTarjetaUlt4 = null;
        formaPagoNueva.FechaVencimientoTarjeta = null;
        formaPagoNueva.NumeroCheque = null;
        mensaje = null;
        // La fila de captura queda lista con lo que falta por pagar.
        var pendiente = MontoAPagar - formasPagoCapturadas.Sum(f => f.Monto);
        if (pendiente > 0)
        {
            formaPagoNueva.PftId = formasPagoTipo.FirstOrDefault(t => t.PftDescripcion == "Efectivo")?.PftId ?? 0;
            formaPagoNueva.Monto = pendiente;
        }
    }

