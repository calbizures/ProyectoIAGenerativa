@* Libro mayor: por cuenta, saldo inicial, movimientos con saldo corrido y saldo final. *@
@using Erp.Data.Contabilidad

@if (Cuentas.Count == 0)
{
    <p class="estado-vacio">No hay cuentas con saldo o movimientos en ese rango.</p>
}
else
{
    @foreach (var c in Cuentas)
    {
        <section class="mayor-cuenta">
            <h3><span class="col-codigo">@c.Codigo</span> @c.Cuenta <small class="texto-tenue">(@(c.Naturaleza == "D" ? "deudora" : "acreedora"))</small></h3>
            <div class="tabla-desplazable" tabindex="0" aria-label="Movimientos de @c.Cuenta">
                <table class="tabla-datos tabla-contable">
                    <thead><tr><th class="col-fecha">Fecha</th><th class="col-estado">Póliza</th><th>Concepto</th><th class="num col-monto">Debe</th><th class="num col-monto">Haber</th><th class="num col-monto">Saldo</th></tr></thead>
                    <tbody>
                        <tr class="fila-grupo"><td colspan="5">Saldo inicial</td><td class="num">@c.SaldoInicial.ToString("N2")</td></tr>
                        @foreach (var m in c.Movimientos)
                        {
                            <tr>
                                <td class="col-fecha">@m.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="col-estado">
                                    @if (AlVerPoliza.HasDelegate)
                                    {
                                        <button type="button" class="boton-enlace" title="Ver la póliza" @onclick="() => AlVerPoliza.InvokeAsync(m.AsiId)">#@m.AsiId</button>
                                    }
                                    else
                                    {
                                        <span>#@m.AsiId</span>
                                    }
                                </td>
                                <td>@m.Descripcion <span class="texto-tenue">· @OrigenesPoliza.Nombre(m.Origen)</span></td>
                                <td class="num col-monto">@(m.Debe == 0 ? "" : m.Debe.ToString("N2"))</td>
                                <td class="num col-monto">@(m.Haber == 0 ? "" : m.Haber.ToString("N2"))</td>
                                <td class="num col-monto">@m.Saldo.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fila-total"><td colspan="3">Movimiento del período y saldo final</td><td class="num">@c.Debe.ToString("N2")</td><td class="num">@c.Haber.ToString("N2")</td><td class="num">@c.SaldoFinal.ToString("N2")</td></tr>
                    </tfoot>
                </table>
            </div>
        </section>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MayorCuenta> Cuentas { get; set; } = Array.Empty<MayorCuenta>();
    [Parameter] public EventCallback<int> AlVerPoliza { get; set; }
}
