@* Libro diario: cada póliza con sus líneas (cargos primero). En pantalla se
   pagina por póliza (PolizasPorPagina); la vista para imprimir muestra todo. *@
@using Erp.Data.Contabilidad

@if (Lineas.Count == 0)
{
    <p class="estado-vacio">@L("No hay pólizas vigentes en ese rango.")</p>
}
else
{
    <div class="tabla-desplazable" tabindex="0" aria-label="@L("Libro diario")">
        <table class="tabla-datos tabla-contable">
            <thead><tr><th class="col-fecha">@L("Fecha")</th><th class="col-codigo">@L("Cuenta")</th><th>@L("Nombre / concepto")</th><th class="num col-monto">@L("Debe")</th><th class="num col-monto">@L("Haber")</th></tr></thead>
            <tbody>
                @foreach (var poliza in PolizasVisibles)
                {
                    var primera = poliza.First();
                    <tr class="fila-grupo">
                        <td class="col-fecha">@primera.Fecha.ToString("dd/MM/yyyy")</td>
                        <td colspan="4"><strong>@L("Póliza #{0}", poliza.Key)</strong> · @OrigenesPoliza.Nombre(primera.Origen) · @primera.Descripcion</td>
                    </tr>
                    @foreach (var l in poliza)
                    {
                        <tr>
                            <td></td>
                            <td class="col-codigo">@l.Codigo</td>
                            <td class="@(l.Haber > 0 ? "cuenta-abono" : "")">@l.Cuenta@(string.IsNullOrEmpty(l.DescripcionLinea) ? "" : $" — {l.DescripcionLinea}")</td>
                            <td class="num col-monto">@Monto(l.Debe)</td>
                            <td class="num col-monto">@Monto(l.Haber)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="fila-total"><td colspan="3">@L("Totales ({0} pólizas)", Lineas.Select(l => l.AsiId).Distinct().Count())</td><td class="num">@Lineas.Sum(l => l.Debe).ToString("N2")</td><td class="num">@Lineas.Sum(l => l.Haber).ToString("N2")</td></tr>
            </tfoot>
        </table>
    </div>
    @if (PolizasPorPagina is int tamano)
    {
        <Paginador Total="polizas.Count" @bind-Pagina="pagina" TamanoPagina="tamano" />
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LibroDiarioLinea> Lineas { get; set; } = Array.Empty<LibroDiarioLinea>();
    [Parameter] public int? PolizasPorPagina { get; set; }

    private IReadOnlyList<LibroDiarioLinea>? lineasAgrupadas;
    private List<IGrouping<int, LibroDiarioLinea>> polizas = new();
    private int pagina = 1;

    protected override void OnParametersSet()
    {
        // Una consulta nueva vuelve a la primera página.
        if (!ReferenceEquals(lineasAgrupadas, Lineas))
        {
            lineasAgrupadas = Lineas;
            polizas = Lineas.GroupBy(l => l.AsiId).ToList();
            pagina = 1;
        }
    }

    private IEnumerable<IGrouping<int, LibroDiarioLinea>> PolizasVisibles =>
        PolizasPorPagina is int tamano ? Paginador.Recortar(polizas, pagina, tamano) : polizas;

    private static string Monto(decimal valor) => valor == 0 ? "" : valor.ToString("N2");
}
