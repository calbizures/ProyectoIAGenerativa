@* Estado de Resultados: ingresos, costo de ventas, utilidad bruta, gastos y utilidad neta. *@
@using Erp.Data.Contabilidad

@{
    var t = Estado.Totales;
    var c = Estado.Comparativo ?? new ResultadosTotales();
    var ingresos = Estado.Filas.Where(f => f.Tipo == "I").ToList();
    var gastos = Estado.Filas.Where(f => f.Tipo == "G").ToList();
}
<div class="tabla-desplazable" tabindex="0" aria-label="Estado de Resultados">
    <table class="tabla-datos tabla-contable tabla-estado">
        <thead>
            <tr>
                <th class="col-codigo">Cuenta</th><th>Nombre</th>
                <th class="num col-monto">@Etiqueta</th>
                @if (Comparar)
                {
                    <th class="num col-monto">@EtiquetaComparativa</th><th class="num col-monto">Variación</th>
                }
            </tr>
        </thead>
        <tbody>
            @Filas(ingresos)
            <tr class="fila-subtotal"><td></td><td>Ventas e ingresos</td>@Montos(t.Ingresos, c.Ingresos)</tr>
            <tr class="fila-subtotal"><td></td><td>(−) Costo de ventas</td>@Montos(t.Costos, c.Costos)</tr>
            <tr class="fila-total"><td colspan="2">UTILIDAD BRUTA</td>@Montos(t.UtilidadBruta, c.UtilidadBruta)</tr>
            @Filas(gastos)
            <tr class="fila-subtotal"><td></td><td>(−) Total gastos de operación</td>@Montos(t.Gastos, c.Gastos)</tr>
            <tr class="fila-total"><td colspan="2">@(t.UtilidadNeta >= 0 ? "UTILIDAD" : "PÉRDIDA") NETA DEL PERÍODO</td>@Montos(t.UtilidadNeta, c.UtilidadNeta)</tr>
        </tbody>
    </table>
</div>
@if (t.Ingresos != 0)
{
    <p class="texto-ayuda">Margen bruto: @((t.UtilidadBruta / t.Ingresos).ToString("P1")) · Margen neto: @((t.UtilidadNeta / t.Ingresos).ToString("P1")) · No incluye la partida de cierre anual.</p>
}

@code {
    [Parameter, EditorRequired] public EstadoResultados Estado { get; set; } = new();
    [Parameter] public bool Comparar { get; set; }
    [Parameter] public string Etiqueta { get; set; } = "Período";
    [Parameter] public string EtiquetaComparativa { get; set; } = "Comparativo";
    // Por nodos: las cuentas de agrupación se expanden y contraen.
    [Parameter] public bool Nodos { get; set; }
    [Parameter] public int ExpandirHasta { get; set; } = 3;
    [Parameter] public int Version { get; set; }

    private readonly ArbolEstado arbol = new();
    private (EstadoResultados?, int, int) cargado;

    protected override void OnParametersSet()
    {
        if (!Nodos || cargado == (Estado, ExpandirHasta, Version)) return;
        cargado = (Estado, ExpandirHasta, Version);
        arbol.Cargar(Estado.Filas, ExpandirHasta);
    }

    private RenderFragment Filas(IEnumerable<EstadoFila> filas) => __builder =>
    {
        var maximo = Estado.Filas.Count == 0 ? 0 : Estado.Filas.Max(x => x.Nivel);
        foreach (var f in filas)
        {
            if (Nodos && !arbol.Visible(f)) continue;
            <tr class="@((Nodos ? arbol.TieneHijos(f) : f.Nivel < maximo) ? $"fila-nivel fila-nivel-{f.Nivel}" : "")">
                <td class="col-codigo">@f.Codigo</td>
                <td class="sangria-@f.Nivel">
                    @if (Nodos && arbol.TieneHijos(f))
                    {
                        <button type="button" class="arbol-toggle" aria-expanded="@(arbol.Expandido(f) ? "true" : "false")"
                                aria-label="@($"{(arbol.Expandido(f) ? "Contraer" : "Expandir")} {f.Cuenta}")" @onclick="() => arbol.Alternar(f)">@(arbol.Expandido(f) ? "▾" : "▸")</button>
                    }
                    else if (Nodos)
                    {
                        <span class="arbol-toggle-vacio"></span>
                    }
                    @(f.Tipo == "I" && f.Naturaleza == "D" ? "(−) " : "")@if (Nodos)
                    {
                        <a class="estado-cuenta" href="@($"contabilidad/libros?vista=mayor&cta={f.CtaId}")" title="Ver los movimientos en el libro mayor">@f.Cuenta</a>
                    }
                    else
                    {
                        @f.Cuenta
                    }
                </td>
                @Montos(f.Saldo, f.SaldoComparativo)
            </tr>
        }
    };

    private RenderFragment Montos(decimal actual, decimal comparativo) => __builder =>
    {
        <td class="num col-monto">@actual.ToString("N2")</td>
        if (Comparar)
        {
            <td class="num col-monto">@comparativo.ToString("N2")</td>
            <td class="num col-monto">@((actual - comparativo).ToString("N2"))</td>
        }
    };
}
