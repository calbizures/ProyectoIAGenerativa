@* Líneas de una póliza con sus totales. *@
@using Erp.Data.Contabilidad

<div class="tabla-desplazable" tabindex="0" aria-label="@L("Líneas de la póliza #{0}", Poliza.AsiId)">
    <table class="tabla-datos tabla-contable">
        <thead><tr><th class="col-codigo">@L("Cuenta")</th><th>@L("Nombre")</th><th>@L("Descripción")</th><th>@L("Centro de costo")</th><th class="num col-monto">@L("Debe")</th><th class="num col-monto">@L("Haber")</th></tr></thead>
        <tbody>
            @foreach (var l in Poliza.Detalle.OrderBy(l => l.Debe > 0 ? 0 : 1).ThenBy(l => l.AsdId))
            {
                <tr>
                    <td class="col-codigo">@l.Codigo</td>
                    <td class="@(l.Haber > 0 ? "cuenta-abono" : "")">@l.Cuenta</td>
                    <td>@l.Descripcion</td>
                    <td>@l.Departamento</td>
                    <td class="num col-monto">@(l.Debe == 0 ? "" : l.Debe.ToString("N2"))</td>
                    <td class="num col-monto">@(l.Haber == 0 ? "" : l.Haber.ToString("N2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fila-total"><td colspan="4">@L("Sumas iguales")</td><td class="num">@Poliza.Detalle.Sum(l => l.Debe).ToString("N2")</td><td class="num">@Poliza.Detalle.Sum(l => l.Haber).ToString("N2")</td></tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public Poliza Poliza { get; set; } = new();
}
