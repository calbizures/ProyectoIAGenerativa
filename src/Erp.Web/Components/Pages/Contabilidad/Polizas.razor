@page "/contabilidad/polizas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:CONTABILIDAD_POLIZAS,CONTABILIDAD_ASIENTO_MANUAL")]
@using Erp.Data.Contabilidad
@using Erp.Data.General
@using Erp.Data.Rrhh
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject ILibrosRepository LibrosRepository
@inject IGeneralRepository GeneralRepository
@inject IRrhhRepository RrhhRepository

<PageTitle>@L("Pólizas")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Pólizas contables")</h1>
    <p>@L("Todas las pólizas: las que generan las ventas, compras, cobros, pagos, cheques, nómina y demás procesos, y las pólizas manuales (ajustes, provisiones, reclasificaciones). Las automáticas se anulan desde su documento.")</p>
</div>

<BorradorDocumento TDatos="BorradorPoliza" Clave="polizas" Nombre="@L("una póliza manual")"
                   Capturar="CapturarBorrador" Describir="DescribirBorrador" Restaurar="RestaurarBorrador" />

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="barra-herramientas">
    <FiltroPeriodo @bind-Desde="filtroDesde" @bind-Hasta="filtroHasta" AlCambiar="ConsultarAsync" />
    <select @bind="filtroOrigen" @bind:after="ConsultarAsync" aria-label="@L("Origen")">
        <option value="">@L("Todos los orígenes")</option>
        @foreach (var o in OrigenesPoliza.Todos)
        {
            <option value="@o.Codigo">@L(o.Nombre)</option>
        }
    </select>
    <select @bind="filtroEstado" @bind:after="ConsultarAsync" aria-label="@L("Estado")">
        <option value="">@L("Vigentes y anuladas")</option>
        <option value="A">@L("Vigentes")</option>
        <option value="N">@L("Anuladas")</option>
    </select>
    <input type="search" placeholder="@L("Concepto, número de póliza o documento")" aria-label="@L("Buscar")" @bind="filtroTexto" @bind:after="ConsultarAsync" />
    <BotonIcono Icono="search" Tooltip="@L("Consultar")" OnClick="ConsultarAsync" />
    <span class="barra-herramientas-separador"></span>
    <AuthorizeView Policy="Permiso:CONTABILIDAD_ASIENTO_MANUAL" Context="permisoManual">
        <BotonIcono Icono="plus" Tooltip="@L("Grabar una póliza manual")" Etiqueta="@L("Nueva póliza")" Variante="primario" OnClick="() => NuevaPoliza(null, false)" />
    </AuthorizeView>
</div>

@if (captura is not null)
{
    <div class="doc-card">
        <div class="doc-card-header">
            <div>
                <h2>@L("Nueva póliza manual")</h2>
                <p>@L("Cada línea va al Debe o al Haber. La póliza se graba solo si cuadra, en cuentas de detalle y en un mes abierto.")</p>
            </div>
            <Icono Nombre="book-open" Tamano="30" />
        </div>
        <div class="doc-card-body">
            <div class="doc-seccion">
                <div class="doc-grid">
                    <div class="campo"><label for="pol-fecha">@L("Fecha")</label><input id="pol-fecha" type="date" @bind="captura.Fecha" /></div>
                    <div class="campo campo-ancho"><label for="pol-concepto">@L("Concepto")</label><input id="pol-concepto" maxlength="256" placeholder="@L("Ej.: Provisión de aguinaldo de septiembre")" @bind="captura.Descripcion" /></div>
                </div>
            </div>
            <div class="doc-seccion">
                <p class="doc-seccion-titulo"><Icono Nombre="list" Tamano="15" /> @L("Líneas")</p>
                <datalist id="cuentas-detalle">
                    @foreach (var c in cuentasDetalle)
                    {
                        <option value="@TextoCuenta(c)"></option>
                    }
                </datalist>
                <div class="tabla-desplazable" tabindex="0" aria-label="@L("Líneas de la póliza")">
                    <table class="doc-tabla poliza-captura">
                        <thead><tr><th>@L("Cuenta")</th><th>@L("Descripción de la línea")</th><th>@L("Centro de costo")</th><th class="num">@L("Debe")</th><th class="num">@L("Haber")</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < captura.Lineas.Count; i++)
                            {
                                var linea = captura.Lineas[i];
                                var numero = i + 1;
                                <tr>
                                    <td>
                                        <input list="cuentas-detalle" aria-label="@L("Cuenta de la línea {0}", numero)" placeholder="@L("Código o nombre")" class="@(linea.CuentaTexto.Length > 0 && linea.CtaId is null ? "entrada-invalida" : "")"
                                               value="@linea.CuentaTexto" @onchange="e => ElegirCuenta(linea, e.Value?.ToString())" />
                                        @if (linea.CuentaTexto.Length > 0 && linea.CtaId is null)
                                        {
                                            <small class="texto-error">@L("Elija una cuenta de detalle de la lista.")</small>
                                        }
                                    </td>
                                    <td><input aria-label="@L("Descripción de la línea {0}", numero)" maxlength="256" @bind="linea.Descripcion" /></td>
                                    <td>
                                        <select aria-label="@L("Centro de costo de la línea {0}", numero)" @bind="linea.IdDepartamento">
                                            <option value="">@L("(Ninguno)")</option>
                                            @foreach (var d in departamentos)
                                            {
                                                <option value="@d.IdDepartamento">@d.Descripcion</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num"><input type="number" step="0.01" min="0" aria-label="@L("Debe de la línea {0}", numero)" value="@linea.Debe" @onchange="e => CambiarMonto(linea, e.Value?.ToString(), true)" /></td>
                                    <td class="num"><input type="number" step="0.01" min="0" aria-label="@L("Haber de la línea {0}", numero)" value="@linea.Haber" @onchange="e => CambiarMonto(linea, e.Value?.ToString(), false)" /></td>
                                    <td><BotonIcono Icono="trash-2" Tooltip="@L("Quitar línea")" Variante="peligro" Deshabilitado="captura.Lineas.Count <= 2" OnClick="() => captura.Lineas.Remove(linea)" /></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fila-total">
                                <td colspan="3">
                                    <BotonIcono Icono="plus" Tooltip="@L("Agregar una línea")" Etiqueta="@L("Agregar línea")" OnClick="() => captura.Lineas.Add(new LineaCaptura())" />
                                    @if (Diferencia != 0)
                                    {
                                        <BotonIcono Icono="scale" Tooltip="@L("Pone la diferencia en la última línea vacía o en una línea nueva")" Etiqueta="@L("Cuadrar")" OnClick="Cuadrar" />
                                    }
                                </td>
                                <td class="num">@TotalDebe.ToString("N2")</td>
                                <td class="num">@TotalHaber.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                @if (Diferencia != 0)
                {
                    <p class="etiqueta-aviso" role="status"><Icono Nombre="alert-triangle" Tamano="14" /> @L("Falta cuadrar: diferencia de Q {0} al {1}.", Math.Abs(Diferencia).ToString("N2"), Diferencia > 0 ? L("Haber") : L("Debe"))</p>
                }
                else if (TotalDebe > 0)
                {
                    <p class="texto-ayuda"><Icono Nombre="check-circle" Tamano="14" /> @L("La póliza cuadra.")</p>
                }
            </div>
        </div>
        <div class="doc-card-footer">
            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => captura = null" />
            <BotonIcono Icono="save" Tooltip="@L("Grabar la póliza")" Etiqueta="@L("Grabar póliza")" Variante="primario" Deshabilitado="guardando" OnClick="GrabarAsync" />
        </div>
    </div>
}

@if (seleccionada is not null)
{
    <section class="tarjeta" aria-labelledby="titulo-poliza">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-poliza">@L("Póliza #{0} · {1}", seleccionada.AsiId, seleccionada.Fecha.ToString("dd/MM/yyyy"))</h2>
            <div class="acciones-fila">
                <a class="boton-icono boton-icono-con-etiqueta" href="contabilidad/polizas/@seleccionada.AsiId/imprimir" target="_blank" title="@L("Imprimir la póliza")">
                    <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">@L("Imprimir")</span>
                </a>
                <AuthorizeView Policy="Permiso:CONTABILIDAD_ASIENTO_MANUAL" Context="permisoCopia">
                    <BotonIcono Icono="copy" Tooltip="@L("Nueva póliza manual con las mismas líneas")" Etiqueta="@L("Copiar")" OnClick="() => NuevaPoliza(seleccionada, false)" />
                    <BotonIcono Icono="rotate-ccw" Tooltip="@L("Nueva póliza manual con las líneas invertidas (Debe ↔ Haber)")" Etiqueta="@L("Reversión")" OnClick="() => NuevaPoliza(seleccionada, true)" />
                    @if (seleccionada.Anulable && seleccionada.EstadoPeriodo == "A")
                    {
                        <BotonIcono Icono="ban" Tooltip="@L("Anular la póliza")" Etiqueta="@L("Anular")" Variante="peligro" OnClick="IniciarAnulacion" />
                    }
                </AuthorizeView>
                <BotonIcono Icono="x" Tooltip="@L("Cerrar el detalle")" OnClick="() => seleccionada = null" />
            </div>
        </div>
        <dl class="poliza-datos">
            <div><dt>@L("Concepto")</dt><dd>@seleccionada.Descripcion</dd></div>
            <div><dt>@L("Origen")</dt><dd>@OrigenesPoliza.Nombre(seleccionada.Origen)@(seleccionada.Documento is null ? "" : $" · {seleccionada.Documento}")</dd></div>
            <div><dt>@L("Estado")</dt><dd><span class="estado-badge @(seleccionada.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(seleccionada.Estado == "A" ? L("Vigente") : L("Anulada"))</span>@(seleccionada.EstadoPeriodo == "C" ? L(" · período cerrado") : "")</dd></div>
            <div><dt>@L("Grabada por")</dt><dd>@seleccionada.Usuario @seleccionada.Creada?.ToString("dd/MM/yyyy HH:mm")</dd></div>
            @if (seleccionada.MotivoAnulacion is not null)
            {
                <div><dt>@L("Motivo de anulación")</dt><dd>@seleccionada.MotivoAnulacion</dd></div>
            }
        </dl>
        @if (anulando)
        {
            <div class="fila-edicion">
                <label for="motivo-poliza">@L("Motivo de la anulación")</label>
                <input id="motivo-poliza" maxlength="250" placeholder="@L("Ej.: se registró en la cuenta equivocada")" @bind="motivoAnulacion" @bind:event="oninput" />
                <BotonIcono Icono="ban" Tooltip="@L("Confirmar anulación")" Etiqueta="@L("Anular póliza")" Variante="peligro" Deshabilitado="motivoAnulacion.Trim().Length < 5 || guardando" OnClick="AnularAsync" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => anulando = false" />
            </div>
        }
        <PolizaDetalle Poliza="seleccionada" />
    </section>
}

<section class="tarjeta" aria-labelledby="titulo-polizas">
    <div class="maestro-detalle-encabezado">
        <h2 id="titulo-polizas">@L("Pólizas")</h2>
        <span class="texto-tenue">@L("{0} vigente(s) · Q {1}", polizas.Count(p => p.Estado == "A"), polizas.Where(p => p.Estado == "A").Sum(p => p.Total).ToString("N2"))</span>
    </div>
    @if (polizas.Count == 0)
    {
        <p class="estado-vacio">@L("No hay pólizas con esos filtros.")</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead><tr><th class="col-fecha">@L("Fecha")</th><th class="col-estado">@L("Póliza")</th><th class="col-estado">@L("Origen")</th><th>@L("Concepto")</th><th class="num col-monto">@L("Total")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Ver")</th></tr></thead>
            <tbody>
                @foreach (var p in Paginador.Recortar(polizas, pagina))
                {
                    <tr class="@(seleccionada?.AsiId == p.AsiId ? "fila-seleccionada" : "")">
                        <td class="col-fecha">@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="col-estado"><strong>#@p.AsiId</strong></td>
                        <td class="col-estado">@OrigenesPoliza.Nombre(p.Origen)</td>
                        <td>@p.Descripcion@if (p.Documento is not null) {<br /><span class="texto-tenue">@p.Documento</span>}</td>
                        <td class="num col-monto">@p.Total.ToString("N2")</td>
                        <td class="col-estado"><span class="estado-badge @(p.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(p.Estado == "A" ? L("Vigente") : L("Anulada"))</span></td>
                        <td class="col-acciones"><BotonIcono Icono="eye" Tooltip="@L("Ver la póliza")" OnClick="() => VerAsync(p.AsiId)" /></td>
                    </tr>
                }
            </tbody>
        </table>
        <Paginador Total="polizas.Count" @bind-Pagina="pagina" />
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "id")] public int? IdInicial { get; set; }

    private IReadOnlyList<Poliza> polizas = Array.Empty<Poliza>();
    private IReadOnlyList<CuentaContable> cuentasDetalle = Array.Empty<CuentaContable>();
    private IReadOnlyList<Departamento> departamentos = Array.Empty<Departamento>();
    private DateTime? filtroDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
    private DateTime? filtroHasta = DateTime.Today;
    private string filtroOrigen = "";
    private string filtroEstado = "";
    private string? filtroTexto;
    private int pagina = 1;
    private Poliza? seleccionada;
    private Captura? captura;
    private bool anulando;
    private string motivoAnulacion = "";
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    private sealed class Captura
    {
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string Descripcion { get; set; } = "";
        public List<LineaCaptura> Lineas { get; } = new();
    }

    private sealed class LineaCaptura
    {
        public string CuentaTexto { get; set; } = "";
        public int? CtaId { get; set; }
        public decimal? Debe { get; set; }
        public decimal? Haber { get; set; }
        public string? Descripcion { get; set; }
        public int? IdDepartamento { get; set; }
    }

    private decimal TotalDebe => captura?.Lineas.Sum(l => l.Debe ?? 0) ?? 0;
    private decimal TotalHaber => captura?.Lineas.Sum(l => l.Haber ?? 0) ?? 0;
    private decimal Diferencia => TotalDebe - TotalHaber;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuentasDetalle = (await GeneralRepository.ConsultarCuentasContablesAsync())
                .Where(c => c.CtaAceptaMovimiento && c.CtaEstado == "A").OrderBy(c => c.CtaCodigo).ToList();
            departamentos = await RrhhRepository.ConsultarDepartamentosAsync(soloActivos: true);
            if (IdInicial is not null)
            {
                filtroDesde = null;
                filtroHasta = null;
                filtroTexto = IdInicial.ToString();
            }
            await ConsultarAsync();
            if (IdInicial is not null) await VerAsync(IdInicial.Value);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string TextoCuenta(CuentaContable c) => $"{c.CtaCodigo} — {c.CtaNombre}";

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private async Task ConsultarAsync()
    {
        try
        {
            polizas = await LibrosRepository.ConsultarPolizasAsync(filtroDesde, filtroHasta, filtroOrigen, filtroEstado, filtroTexto, null);
            pagina = 1;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task VerAsync(int asiId)
    {
        try
        {
            seleccionada = await LibrosRepository.ConsultarPolizaAsync(asiId);
            anulando = false;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    // Póliza en blanco, o copia / reversión de otra.
    private void NuevaPoliza(Poliza? origen, bool invertir)
    {
        mensaje = null;
        captura = new Captura();
        if (origen is null)
        {
            captura.Lineas.Add(new LineaCaptura());
            captura.Lineas.Add(new LineaCaptura());
            return;
        }
        captura.Descripcion = invertir ? $"Reversión de la póliza #{origen.AsiId}: {origen.Descripcion}" : origen.Descripcion;
        if (captura.Descripcion.Length > 256) captura.Descripcion = captura.Descripcion[..256];
        foreach (var l in origen.Detalle)
        {
            var cuenta = cuentasDetalle.FirstOrDefault(c => c.CtaId == l.CtaId);
            captura.Lineas.Add(new LineaCaptura
            {
                CtaId = cuenta?.CtaId,
                CuentaTexto = cuenta is null ? $"{l.Codigo} — {l.Cuenta}" : TextoCuenta(cuenta),
                Debe = (invertir ? l.Haber : l.Debe) is var d && d > 0 ? d : null,
                Haber = (invertir ? l.Debe : l.Haber) is var h && h > 0 ? h : null,
                Descripcion = l.Descripcion,
                IdDepartamento = l.IdDepartamento
            });
        }
    }

    private void ElegirCuenta(LineaCaptura linea, string? texto)
    {
        linea.CuentaTexto = texto?.Trim() ?? "";
        var codigo = linea.CuentaTexto.Split('—', 2)[0].Trim();
        var porNombre = cuentasDetalle.Where(c => c.CtaNombre.Contains(linea.CuentaTexto, StringComparison.OrdinalIgnoreCase)).Take(2).ToList();
        var cuenta = cuentasDetalle.FirstOrDefault(c => c.CtaCodigo == codigo) ?? (porNombre.Count == 1 && linea.CuentaTexto.Length >= 3 ? porNombre[0] : null);
        linea.CtaId = cuenta?.CtaId;
        if (cuenta is not null) linea.CuentaTexto = TextoCuenta(cuenta);
    }

    private static void CambiarMonto(LineaCaptura linea, string? texto, bool alDebe)
    {
        decimal? valor = decimal.TryParse(texto, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0
            ? Math.Round(v, 2) : null;
        if (alDebe)
        {
            linea.Debe = valor;
            if (valor is not null) linea.Haber = null;
        }
        else
        {
            linea.Haber = valor;
            if (valor is not null) linea.Debe = null;
        }
    }

    private void Cuadrar()
    {
        if (captura is null || Diferencia == 0) return;
        var diferencia = Diferencia;
        var linea = captura.Lineas.LastOrDefault(l => (l.Debe ?? 0) == 0 && (l.Haber ?? 0) == 0);
        if (linea is null)
        {
            linea = new LineaCaptura();
            captura.Lineas.Add(linea);
        }
        if (diferencia > 0) linea.Haber = diferencia; else linea.Debe = -diferencia;
    }

    private async Task GrabarAsync()
    {
        if (captura is null) return;
        var lineas = captura.Lineas.Where(l => l.CtaId is not null || (l.Debe ?? 0) > 0 || (l.Haber ?? 0) > 0).ToList();
        if (lineas.Any(l => l.CtaId is null))
        {
            mensaje = L("Hay líneas sin cuenta: elija la cuenta de la lista o quite la línea.");
            esMensajeError = true;
            return;
        }
        guardando = true;
        try
        {
            var asiId = await LibrosRepository.GrabarPolizaManualAsync(captura.Fecha, captura.Descripcion,
                lineas.Select(l => new PolizaManualLinea { CtaId = l.CtaId, Debe = l.Debe, Haber = l.Haber, Descripcion = l.Descripcion, IdDepartamento = l.IdDepartamento }).ToList(),
                await ObtenerUsuIdActualAsync());
            mensaje = L("Póliza #{0} grabada por Q {1:N2}.", asiId, TotalDebe);
            esMensajeError = false;
            captura = null;
            await ConsultarAsync();
            await VerAsync(asiId);
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    // ---- Borrador: la póliza en captura se conserva al salir de la pantalla ----
    private sealed record BorradorPoliza(DateTime Fecha, string Descripcion, IReadOnlyList<LineaCaptura> Lineas);

    private BorradorPoliza? CapturarBorrador()
    {
        if (captura is null) return null;
        var conDatos = captura.Lineas.Any(l => l.CtaId is not null || !string.IsNullOrWhiteSpace(l.CuentaTexto) || l.Debe is not null || l.Haber is not null);
        if (!conDatos && string.IsNullOrWhiteSpace(captura.Descripcion)) return null;
        return new BorradorPoliza(captura.Fecha, captura.Descripcion, captura.Lineas);
    }

    private static string DescribirBorrador(BorradorPoliza b) =>
        $"{(string.IsNullOrWhiteSpace(b.Descripcion) ? "sin descripción" : b.Descripcion.Length > 60 ? b.Descripcion[..60] + "…" : b.Descripcion)}, "
        + L("{0} {1}, debe Q {2:N2}", b.Lineas.Count, (b.Lineas.Count == 1 ? L("línea") : L("líneas")), b.Lineas.Sum(l => l.Debe ?? 0));

    private void RestaurarBorrador(BorradorPoliza b)
    {
        captura = new Captura { Fecha = b.Fecha, Descripcion = b.Descripcion };
        foreach (var l in b.Lineas)
        {
            // Una cuenta que ya no acepta movimientos queda como texto para elegir otra.
            if (l.CtaId is int ctaId && cuentasDetalle.All(c => c.CtaId != ctaId)) l.CtaId = null;
            captura.Lineas.Add(l);
        }
        mensaje = L("Se recuperó la póliza sin terminar. Revísela antes de grabar.");
        esMensajeError = false;
    }

    private void IniciarAnulacion()
    {
        anulando = true;
        motivoAnulacion = "";
    }

    private async Task AnularAsync()
    {
        if (seleccionada is null) return;
        guardando = true;
        try
        {
            await LibrosRepository.AnularPolizaAsync(seleccionada.AsiId, motivoAnulacion.Trim(), await ObtenerUsuIdActualAsync());
            mensaje = L("Póliza #{0} anulada.", seleccionada.AsiId);
            esMensajeError = false;
            var id = seleccionada.AsiId;
            await ConsultarAsync();
            await VerAsync(id);
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
