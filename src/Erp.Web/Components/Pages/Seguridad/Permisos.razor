@page "/permisos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:SEGURIDAD_USUARIO_ADMIN")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Security
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IPermisoRepository PermisoRepository
@inject IRolRepository RolRepository
@inject PermisoMapa PermisoMapa

<PageTitle>@L("Permisos")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Permisos")</h1>
    <p>@L("Catálogo de permisos del sistema: qué pantallas y botones abre cada uno, qué roles lo tienen y qué usuarios lo reciben por esos roles.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="maestro-detalle permisos-maestro">
    <section class="tarjeta" aria-labelledby="titulo-permisos">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-permisos">@L("Permisos") <span class="texto-tenue">(@permisos.Count)</span></h2>
            <BotonIcono Icono="plus" Tooltip="@L("Nuevo permiso")" Etiqueta="@L("Nuevo permiso")" Variante="primario" OnClick="NuevoPermiso" />
        </div>

        <div class="barra-filtros">
            <input type="search" placeholder="@L("Buscar código o descripción")" aria-label="@L("Buscar permiso por código o descripción")" @bind="filtroTexto" @bind:event="oninput" @bind:after="BuscarAsync" />
            <select aria-label="@L("Módulo")" @bind="filtroModulo" @bind:after="BuscarAsync">
                <option value="">@L("Todos los módulos")</option>
                @foreach (var modulo in modulos)
                {
                    <option value="@modulo">@L(modulo)</option>
                }
            </select>
            <select aria-label="@L("Estado")" @bind="filtroEstado" @bind:after="BuscarAsync">
                <option value="">@L("Activos e inactivos")</option>
                <option value="A">@L("Activos")</option>
                <option value="I">@L("Inactivos")</option>
            </select>
        </div>

        @if (mostrarNuevo)
        {
            <EditForm Model="nuevoPermiso" OnValidSubmit="CrearPermisoAsync" class="panel-formulario">
                <DataAnnotationsValidator />
                <ResumenValidacion />
                <div class="campo"><label for="permisos-permiso-modulo">@L("Módulo")</label><InputText id="permisos-permiso-modulo" @bind-Value="nuevoPermiso.Modulo" /></div>
                <div class="campo"><label for="permisos-permiso-codigo">@L("Código")</label><InputText id="permisos-permiso-codigo" @bind-Value="nuevoPermiso.Codigo" placeholder="@L("EJEMPLO_PERMISO")" /></div>
                <div class="campo campo-ancho"><label for="permisos-permiso-descripcion">@L("Descripción")</label><InputText id="permisos-permiso-descripcion" @bind-Value="nuevoPermiso.Descripcion" /></div>
                <p class="texto-ayuda campo-ancho">@L("El código no se puede cambiar después: la aplicación lo usa para mostrar pantallas y botones. Un permiso nuevo no abre ninguna opción hasta que una pantalla lo pida.")</p>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar")" Etiqueta="@L("Guardar")" Variante="primario" TipoBoton="submit" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => mostrarNuevo = false" />
                </div>
            </EditForm>
        }

        <div class="tabla-desplazable">
            <table class="tabla-datos">
                <thead>
                    <tr><th>@L("Permiso")</th><th class="num">@L("Roles")</th><th class="num">@L("Usuarios")</th><th>@L("Estado")</th></tr>
                </thead>
                <tbody>
                    @if (permisos.Count == 0)
                    {
                        <tr><td colspan="4" class="doc-tabla-vacia">@L("Ningún permiso coincide con el filtro.")</td></tr>
                    }
                    @foreach (var permiso in permisos)
                    {
                        <tr class="fila-seleccionable @(detalle?.Permiso.PerId == permiso.PerId ? "fila-seleccionada" : "")" tabindex="0"
                            @onclick="() => SeleccionarAsync(permiso.PerId)" @onkeydown="e => TeclaFilaAsync(e, permiso.PerId)">
                            <td><strong class="permiso-codigo">@permiso.PerCodigo</strong><small class="texto-tenue permiso-descripcion">@L(permiso.PerModulo) · @L(permiso.PerDescripcion)</small></td>
                            <td class="num">@permiso.Roles</td>
                            <td class="num">@permiso.Usuarios</td>
                            <td><span class="estado-badge @(permiso.PerEstado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(permiso.PerEstado == "A" ? L("Activo") : L("Inactivo"))</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="tarjeta" aria-labelledby="titulo-detalle-permiso">
        @if (detalle is null)
        {
            <h2 id="titulo-detalle-permiso">@L("Detalle")</h2>
            <p class="estado-vacio">@L("Seleccione un permiso para ver dónde se usa y quién lo tiene.")</p>
        }
        else
        {
            var p = detalle.Permiso;
            var usos = PermisoMapa.Consultar(p.PerCodigo);
            <div class="maestro-detalle-encabezado">
                <h2 id="titulo-detalle-permiso">@p.PerCodigo</h2>
                <div class="acciones-fila">
                    @if (!editando)
                    {
                        <BotonIcono Icono="pencil" Tooltip="@L("Modificar módulo, descripción o estado")" Etiqueta="@L("Editar")" OnClick="IniciarEdicion" />
                    }
                    <BotonIcono Icono="trash-2" Variante="peligro" Etiqueta="@L("Eliminar")"
                                Tooltip="@(MotivoNoEliminar(usos) ?? L("Eliminar el permiso"))"
                                Deshabilitado="@(MotivoNoEliminar(usos) is not null)"
                                Confirmacion="@L("¿Eliminar el permiso? No se puede deshacer.")" OnClick="EliminarAsync" />
                </div>
            </div>

            <EditForm Model="edicion" OnValidSubmit="GuardarAsync" class="panel-formulario">
                <DataAnnotationsValidator />
                <ResumenValidacion />
                <div class="campo"><label for="permiso-modulo">@L("Módulo")</label><InputText id="permiso-modulo" @bind-Value="edicion.Modulo" disabled="@(!editando)" /></div>
                <div class="campo">
                    <label for="permiso-estado">@L("Estado")</label>
                    <InputSelect id="permiso-estado" @bind-Value="edicion.Estado" disabled="@(!editando)">
                        <option value="A">@L("Activo")</option>
                        <option value="I">@L("Inactivo")</option>
                    </InputSelect>
                </div>
                <div class="campo campo-ancho"><label for="permiso-descripcion">@L("Descripción")</label><InputText id="permiso-descripcion" @bind-Value="edicion.Descripcion" disabled="@(!editando)" /></div>
                @if (editando)
                {
                    @if (edicion.Estado == "I" && p.PerEstado == "A")
                    {
                        <p class="doc-nota campo-ancho" role="status"><Icono Nombre="alert-triangle" Tamano="15" /><span>@L("Inactivo, nadie lo recibe aunque su rol lo tenga: {0} usuario(s) dejarán de ver lo que abre este permiso.", detalle.Usuarios.Count(u => u.Vigente))</span></p>
                    }
                    <div class="acciones-fila">
                        <BotonIcono Icono="save" Tooltip="@L("Guardar los cambios")" Etiqueta="@L("Guardar")" Variante="primario" TipoBoton="submit" />
                        <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="CancelarEdicion" />
                    </div>
                }
            </EditForm>
            <p class="texto-tenue permisos-auditoria">Creado @(detalle.Creado?.ToString("dd/MM/yyyy") ?? "—")@(detalle.CreadoPor is null ? "" : L(" por {0}", detalle.CreadoPor))@(detalle.Modificado is null ? "" : L(" · modificado {0:dd/MM/yyyy HH:mm}", detalle.Modificado))</p>

            <h3>@L("Dónde se usa")</h3>
            @if (usos.Count == 0)
            {
                <p class="estado-vacio">@L("Ninguna pantalla de la aplicación pide este permiso.")</p>
            }
            else
            {
                <div class="tabla-desplazable">
                    <table class="tabla-datos">
                        <thead><tr><th>@L("Opción")</th><th>@L("Qué abre")</th></tr></thead>
                        <tbody>
                            @foreach (var uso in usos)
                            {
                                <tr>
                                    <td>@if (uso.Ruta.Contains('{')) { @OpcionTraducida(uso.Opcion) } else { <a href="@uso.Ruta">@OpcionTraducida(uso.Opcion)</a> }</td>
                                    <td>@(uso.EsAccion ? L("Botones o secciones dentro de la pantalla") : L("Entrar a la pantalla"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h3>@L("Roles que lo tienen") <span class="texto-tenue">(@detalle.Roles.Count)</span></h3>
            <div class="barra-filtros">
                <select aria-label="@L("Rol al que se asigna el permiso")" @bind="rolAsignar">
                    <option value="0">@L("Asignar a un rol...")</option>
                    @foreach (var rol in roles.Where(r => detalle.Roles.All(x => x.RolId != r.RolId)))
                    {
                        <option value="@rol.RolId">@rol.RolCodigo - @rol.RolNombre</option>
                    }
                </select>
                <BotonIcono Icono="plus" Tooltip="@L("Asignar el permiso al rol elegido")" Etiqueta="@L("Asignar")" Deshabilitado="rolAsignar == 0" OnClick="AsignarAsync" />
            </div>
            @if (detalle.Roles.Count == 0)
            {
                <p class="estado-vacio">@L("Ningún rol tiene este permiso.")</p>
            }
            else
            {
                <div class="tabla-desplazable">
                    <table class="tabla-datos">
                        <thead><tr><th>@L("Rol")</th><th class="num">@L("Usuarios")</th><th>@L("Estado")</th><th class="col-acciones"><span class="sr-only">@L("Acciones")</span></th></tr></thead>
                        <tbody>
                            @foreach (var rol in detalle.Roles)
                            {
                                <tr>
                                    <td><strong>@rol.Codigo</strong> <span class="texto-tenue">@rol.Nombre</span></td>
                                    <td class="num">@rol.Usuarios</td>
                                    <td><span class="estado-badge @(rol.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(rol.Estado == "A" ? L("Activo") : L("Inactivo"))</span></td>
                                    <td class="col-acciones">
                                        <BotonIcono Icono="x" Variante="peligro" Tooltip="@(L("Quitar el permiso al rol {0}", rol.Codigo))"
                                                    Confirmacion="@(L("¿Quitar {0} al rol {1}?", p.PerCodigo, rol.Codigo))" OnClick="() => QuitarAsync(rol.RolId)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h3>@L("Usuarios que lo tienen") <span class="texto-tenue">@L("({0} con acceso)", detalle.Usuarios.Count(u => u.Vigente))</span></h3>
            @if (detalle.Usuarios.Count == 0)
            {
                <p class="estado-vacio">@L("Ningún usuario tiene este permiso.")</p>
            }
            else
            {
                <div class="tabla-desplazable">
                    <table class="tabla-datos">
                        <thead><tr><th>@L("Usuario")</th><th>@L("Por el rol")</th><th>@L("Último ingreso")</th><th>@L("Acceso")</th></tr></thead>
                        <tbody>
                            @foreach (var usuario in detalle.Usuarios)
                            {
                                <tr>
                                    <td><strong>@usuario.Usuario</strong><small class="texto-tenue permiso-descripcion">@(string.IsNullOrWhiteSpace(usuario.Empleado) ? usuario.Email : usuario.Empleado)</small></td>
                                    <td>@usuario.Roles</td>
                                    <td class="celda-fecha">@(usuario.UltimoIngreso?.ToString("dd/MM/yy HH:mm") ?? L("Nunca"))</td>
                                    <td>
                                        @if (usuario.Vigente && p.PerEstado == "A")
                                        {
                                            <span class="estado-badge estado-badge-activo">@L("Sí")</span>
                                        }
                                        else
                                        {
                                            <span class="estado-badge estado-badge-inactivo" title="@(usuario.Estado != "A" ? L("Usuario inactivo") : p.PerEstado != "A" ? L("Permiso inactivo") : L("Su rol está inactivo"))">@L("No")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<Permiso> permisos = Array.Empty<Permiso>();
    private IReadOnlyList<string> modulos = Array.Empty<string>();
    private IReadOnlyList<Rol> roles = Array.Empty<Rol>();
    private PermisoDetalle? detalle;
    private string filtroTexto = "";
    private string filtroModulo = "";
    private string filtroEstado = "";
    private int rolAsignar;
    private bool mostrarNuevo;
    private bool editando;
    private string? mensaje;
    private bool esMensajeError;

    private NuevoPermisoModelo nuevoPermiso = new();
    private readonly EdicionModelo edicion = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            modulos = (await PermisoRepository.ConsultarAsync(null, null)).Select(x => x.PerModulo).Distinct().OrderBy(x => x).ToList();
            roles = await RolRepository.ConsultarAsync("A");
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private async Task BuscarAsync()
    {
        try
        {
            permisos = await PermisoRepository.ConsultarAsync(NullSiVacio(filtroModulo), NullSiVacio(filtroEstado), NullSiVacio(filtroTexto));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string? NullSiVacio(string texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private async Task SeleccionarAsync(int perId)
    {
        try
        {
            detalle = await PermisoRepository.ConsultarDetalleAsync(perId);
            editando = false;
            rolAsignar = 0;
            CargarEdicion();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task TeclaFilaAsync(KeyboardEventArgs e, int perId)
    {
        if (e.Key is "Enter" or " ") await SeleccionarAsync(perId);
    }

    private void CargarEdicion()
    {
        if (detalle is null) return;
        edicion.Modulo = detalle.Permiso.PerModulo;
        edicion.Descripcion = detalle.Permiso.PerDescripcion;
        edicion.Estado = detalle.Permiso.PerEstado;
    }

    private void IniciarEdicion() => editando = true;

    private void CancelarEdicion()
    {
        editando = false;
        CargarEdicion();
    }

    // Se elimina solo lo que nadie usa: ni un rol ni una pantalla.
    private string? MotivoNoEliminar(IReadOnlyList<PermisoMapa.Uso> usos) =>
        detalle is null ? null
        : detalle.Roles.Count > 0 ? L("Está asignado a roles: quíteselo primero o inactívelo")
        : usos.Count > 0 ? L("La aplicación lo usa: se puede inactivar, no eliminar")
        : null;

    private void NuevoPermiso()
    {
        nuevoPermiso = new NuevoPermisoModelo { Modulo = filtroModulo };
        mostrarNuevo = true;
    }

    private async Task CrearPermisoAsync()
    {
        try
        {
            var perId = await PermisoRepository.InsertarAsync(nuevoPermiso.Modulo, nuevoPermiso.Codigo, nuevoPermiso.Descripcion, await ObtenerUsuIdActualAsync());
            mostrarNuevo = false;
            MostrarOk(L("Permiso {0} creado.", nuevoPermiso.Codigo.Trim().ToUpperInvariant()));
            await BuscarAsync();
            await SeleccionarAsync(perId);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task GuardarAsync()
    {
        if (detalle is null) return;
        try
        {
            await PermisoRepository.ActualizarAsync(detalle.Permiso.PerId, edicion.Modulo, edicion.Descripcion, edicion.Estado, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Permiso {0} guardado.", detalle.Permiso.PerCodigo));
            await BuscarAsync();
            await SeleccionarAsync(detalle.Permiso.PerId);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task EliminarAsync()
    {
        if (detalle is null) return;
        try
        {
            var codigo = detalle.Permiso.PerCodigo;
            await PermisoRepository.EliminarAsync(detalle.Permiso.PerId);
            detalle = null;
            MostrarOk(L("Permiso {0} eliminado.", codigo));
            await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AsignarAsync()
    {
        if (detalle is null || rolAsignar == 0) return;
        try
        {
            await RolRepository.AsignarPermisoAsync(rolAsignar, detalle.Permiso.PerId, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Permiso asignado al rol. Los usuarios lo verán al recargar la página (se actualiza cada minuto)."));
            await BuscarAsync();
            await SeleccionarAsync(detalle.Permiso.PerId);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task QuitarAsync(int rolId)
    {
        if (detalle is null) return;
        try
        {
            await RolRepository.RevocarPermisoAsync(rolId, detalle.Permiso.PerId);
            MostrarOk(L("Permiso quitado al rol."));
            await BuscarAsync();
            await SeleccionarAsync(detalle.Permiso.PerId);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void MostrarOk(string texto) { mensaje = texto; esMensajeError = false; }
    private void MostrarError(Exception ex) { mensaje = MensajesError.Traducir(ex); esMensajeError = true; }

    private sealed class NuevoPermisoModelo
    {
        [Required(ErrorMessage = "Indique el módulo.")] public string Modulo { get; set; } = "";
        [Required(ErrorMessage = "Indique el código.")] public string Codigo { get; set; } = "";
        public string? Descripcion { get; set; }
    }

    private sealed class EdicionModelo
    {
        [Required(ErrorMessage = "Indique el módulo.")] public string Modulo { get; set; } = "";
        public string? Descripcion { get; set; }
        public string Estado { get; set; } = "A";
    }

    // "Ventas / POS › Facturas" (del menú, en español): cada parte se traduce.
    private static string OpcionTraducida(string opcion) => string.Join(" › ", opcion.Split(" › ").Select(L));
}
