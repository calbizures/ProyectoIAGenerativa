@page "/roles"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:SEGURIDAD_USUARIO_ADMIN")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Security
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IRolRepository RolRepository
@inject IPermisoRepository PermisoRepository

<PageTitle>Roles</PageTitle>

<div class="pagina-encabezado">
    <h1>Roles</h1>
    <p>Roles y los permisos que otorga cada uno.</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="maestro-detalle roles-maestro">
    <section class="tarjeta" aria-labelledby="titulo-roles">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-roles">Roles</h2>
            <BotonIcono Icono="plus" Tooltip="Nuevo rol" Etiqueta="Nuevo rol" Variante="primario" OnClick="() => mostrarNuevo = true" />
        </div>

        @if (mostrarNuevo)
        {
            <EditForm Model="nuevoRol" OnValidSubmit="CrearRolAsync" class="panel-formulario">
                <DataAnnotationsValidator />
                <ResumenValidacion />
                <div class="campo"><label for="roles-rol-codigo">Código</label><InputText id="roles-rol-codigo" @bind-Value="nuevoRol.Codigo" /></div>
                <div class="campo"><label for="roles-rol-nombre">Nombre</label><InputText id="roles-rol-nombre" @bind-Value="nuevoRol.Nombre" /></div>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="Guardar" Etiqueta="Guardar" Variante="primario" TipoBoton="submit" />
                    <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNuevo = false" />
                </div>
            </EditForm>
        }

        <table class="tabla-datos">
            <thead>
                <tr><th class="col-codigo">Código</th><th>Nombre</th><th class="num">Permisos</th><th class="col-acciones"><span class="sr-only">Acciones</span></th></tr>
            </thead>
            <tbody>
                @foreach (var rol in roles)
                {
                    <tr class="fila-seleccionable @(seleccionado?.RolId == rol.RolId ? "fila-seleccionada" : "")" @onclick="() => SeleccionarAsync(rol)">
                        <td class="col-codigo">@rol.RolCodigo</td>
                        <td>@rol.RolNombre</td>
                        <td class="num">@(conteoPermisos.TryGetValue(rol.RolId, out var cuantos) ? cuantos : 0)</td>
                        <td class="col-acciones" @onclick:stopPropagation="true">
                            <div class="acciones-fila">
                                <BotonIcono Icono="trash-2" Tooltip="Desactivar rol" Confirmacion="¿Desactivar el rol?" Variante="peligro" OnClick="() => DesactivarAsync(rol)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="tarjeta" aria-labelledby="titulo-permisos-rol">
        @if (seleccionado is null)
        {
            <h2 id="titulo-permisos-rol">Permisos</h2>
            <p class="estado-vacio">Seleccione un rol para ver y cambiar sus permisos.</p>
        }
        else
        {
            <div class="maestro-detalle-encabezado">
                @if (editandoNombre)
                {
                    <EditForm Model="edicionRol" OnValidSubmit="GuardarEdicionAsync" class="rol-nombre-edicion">
                        <DataAnnotationsValidator />
                        <label for="rol-nombre" class="sr-only">Nombre del rol</label>
                        <InputText id="rol-nombre" @bind-Value="edicionRol.Nombre" />
                        <BotonIcono Icono="save" Tooltip="Guardar nombre" Variante="primario" TipoBoton="submit" />
                        <BotonIcono Icono="x" Tooltip="Cancelar" OnClick="() => editandoNombre = false" />
                    </EditForm>
                }
                else
                {
                    <h2 id="titulo-permisos-rol">@seleccionado.RolNombre</h2>
                    <BotonIcono Icono="pencil" Tooltip="Cambiar el nombre del rol" Etiqueta="Editar nombre" OnClick="IniciarEdicion" />
                }
            </div>
            <p class="texto-tenue">@permisosAsignadosId.Count de @todosLosPermisos.Count permisos asignados. Marque o desmarque para cambiarlos; se guardan al instante.</p>

            <div class="roles-permisos">
                @foreach (var modulo in todosLosPermisos.GroupBy(p => p.PerModulo).OrderBy(g => g.Key))
                {
                    <fieldset class="roles-modulo">
                        <legend>@modulo.Key <span class="texto-tenue">(@modulo.Count(p => permisosAsignadosId.Contains(p.PerId))/@modulo.Count())</span></legend>
                        @foreach (var permiso in modulo.OrderBy(p => p.PerCodigo))
                        {
                            var asignado = permisosAsignadosId.Contains(permiso.PerId);
                            <label class="casilla roles-permiso">
                                <input type="checkbox" checked="@asignado" @onchange="e => CambiarPermisoAsync(permiso.PerId, (bool)(e.Value ?? false))" />
                                <span><strong>@(permiso.PerDescripcion ?? permiso.PerCodigo)</strong><small>@permiso.PerCodigo</small></span>
                            </label>
                        }
                    </fieldset>
                }
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<Rol> roles = Array.Empty<Rol>();
    private IReadOnlyList<Permiso> todosLosPermisos = Array.Empty<Permiso>();
    private IReadOnlyList<int> permisosAsignadosId = Array.Empty<int>();
    private Rol? seleccionado;
    private bool editandoNombre;
    private Dictionary<int, int> conteoPermisos = new();

    private bool mostrarNuevo;
    private string? mensaje;
    private bool esMensajeError;

    private readonly NuevoRolModelo nuevoRol = new();
    private readonly EdicionRolModelo edicionRol = new();

    protected override async Task OnInitializedAsync()
    {
        todosLosPermisos = await PermisoRepository.ConsultarAsync(modulo: null, estado: "A");
        await BuscarAsync();
    }

    private async Task<int?> ObtenerUsuIdActualAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var estado = await AuthenticationStateTask;
        return estado.User.ObtenerUsuId();
    }

    private async Task BuscarAsync()
    {
        roles = await RolRepository.ConsultarAsync(estado: "A");
        var conteo = new Dictionary<int, int>();
        foreach (var rol in roles)
            conteo[rol.RolId] = (await RolRepository.ConsultarPermisosAsignadosAsync(rol.RolId)).Count;
        conteoPermisos = conteo;
        if (seleccionado is null && roles.Count > 0) await SeleccionarAsync(roles[0]);
    }

    private async Task CrearRolAsync()
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await RolRepository.InsertarAsync(nuevoRol.Codigo, nuevoRol.Nombre, usuId);
            mostrarNuevo = false;
            mensaje = "Rol creado correctamente.";
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task SeleccionarAsync(Rol rol)
    {
        seleccionado = rol;
        editandoNombre = false;
        edicionRol.Nombre = rol.RolNombre;
        mensaje = null;
        permisosAsignadosId = await RolRepository.ConsultarPermisosAsignadosAsync(rol.RolId);
    }

    private void IniciarEdicion()
    {
        if (seleccionado is null) return;
        edicionRol.Nombre = seleccionado.RolNombre;
        mensaje = null;
        editandoNombre = true;
    }

    private async Task GuardarEdicionAsync()
    {
        if (seleccionado is null) return;
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await RolRepository.ActualizarAsync(seleccionado.RolId, edicionRol.Nombre, usuId);
            mensaje = "Cambios guardados.";
            esMensajeError = false;
            await BuscarAsync();
            seleccionado = roles.FirstOrDefault(r => r.RolId == seleccionado.RolId) ?? seleccionado;
            editandoNombre = false;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task DesactivarAsync(Rol rol)
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await RolRepository.EliminarAsync(rol.RolId, usuId);
            mensaje = "Rol desactivado.";
            esMensajeError = false;
            if (seleccionado?.RolId == rol.RolId)
                seleccionado = null;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task CambiarPermisoAsync(int perId, bool asignar)
    {
        if (seleccionado is null) return;
        try
        {
            if (asignar)
            {
                var usuId = await ObtenerUsuIdActualAsync();
                await RolRepository.AsignarPermisoAsync(seleccionado.RolId, perId, usuId);
            }
            else
            {
                await RolRepository.RevocarPermisoAsync(seleccionado.RolId, perId);
            }

            permisosAsignadosId = await RolRepository.ConsultarPermisosAsignadosAsync(seleccionado.RolId);
            conteoPermisos[seleccionado.RolId] = permisosAsignadosId.Count;
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private sealed class NuevoRolModelo
    {
        [Required] public string Codigo { get; set; } = "";
        [Required] public string Nombre { get; set; } = "";
    }

    private sealed class EdicionRolModelo
    {
        [Required] public string Nombre { get; set; } = "";
    }
}
