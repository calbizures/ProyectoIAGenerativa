@page "/bancos/formatos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:BANCOS_FORMATO_ARCHIVO")]
@using System.Text
@using Erp.Data.Caja
@using Erp.Data.General
@using Erp.Data.Pagos
@using Erp.Web.Reportes
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IPagosRepository PagosRepository
@inject IGeneralRepository GeneralRepository

<PageTitle>@L("Formatos de archivo")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Formatos del archivo de transferencias")</h1>
    <p>@L("Cada banco pide el archivo de transferencias con su propio formato. Configúrelo aquí con la especificación que entrega el banco: delimitado (CSV) o de ancho fijo, las columnas en orden, el formato de la fecha y del monto, los códigos del tipo de cuenta y el código de cada banco destino. Se usa para pagar a proveedores y la planilla.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<div class="maestro-detalle">
    <section class="tarjeta maestro-detalle-maestro" aria-labelledby="titulo-formatos">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-formatos">@L("Formatos")</h2>
            <BotonIcono Icono="plus" Tooltip="@L("Nuevo formato")" Etiqueta="@L("Nuevo formato")" Variante="primario" OnClick="Nuevo" />
        </div>
        @if (formatos.Count == 0)
        {
            <p class="estado-vacio">@L("No hay formatos.")</p>
        }
        else
        {
            <table class="tabla-datos">
                <thead><tr><th>@L("Formato")</th><th>@L("Uso")</th><th class="col-estado">@L("Estado")</th></tr></thead>
                <tbody>
                    @foreach (var f in formatos)
                    {
                        <tr class="fila-seleccionable @(edicion?.BfaId == f.BfaId && f.BfaId != 0 ? "fila-seleccionada" : "")" @onclick="() => Seleccionar(f)">
                            <td><strong>@f.Nombre</strong><br /><span class="texto-tenue">@(f.Tipo == "F" ? L("Ancho fijo") : L("Delimitado")) · .@f.Extension@(f.Banco is null ? "" : $" · {f.Banco}")</span></td>
                            <td>@UsoTexto(f.Uso)</td>
                            <td class="col-estado"><span class="estado-badge @(f.Estado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(f.Estado == "A" ? L("Activo") : L("Inactivo"))</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="tarjeta maestro-detalle-detalle tarjeta-encogible" aria-labelledby="titulo-formato">
        @if (edicion is null)
        {
            <h2 id="titulo-formato">@L("Formato")</h2>
            <p class="estado-vacio">@L("Seleccione un formato o cree uno nuevo.")</p>
        }
        else
        {
            <div class="maestro-detalle-encabezado">
                <h2 id="titulo-formato">@(edicion.BfaId == 0 ? L("Nuevo formato") : edicion.Nombre)</h2>
                @if (!editando)
                {
                    <BotonIcono Icono="pencil" Tooltip="@L("Editar el formato")" Etiqueta="@L("Editar")" OnClick="() => editando = true" />
                }
            </div>
            @if (!editando)
            {
                <dl class="formato-resumen">
                    <dt>@L("Banco")</dt><dd>@(edicion.Banco ?? L("Cualquiera"))</dd>
                    <dt>@L("Se usa para")</dt><dd>@UsoTexto(edicion.Uso)</dd>
                    <dt>@L("Archivo")</dt><dd>@(edicion.Tipo == "F" ? L("Ancho fijo") : L("Delimitado por {0}{1}{2}", SeparadorTexto(edicion.Separador), (edicion.Titulos ? L(", con títulos") : ""), (edicion.Comillas ? L(", entre comillas") : ""))) · .@edicion.Extension · @edicion.Codificacion · @edicion.FinLinea</dd>
                    <dt>@L("Fecha")</dt><dd>@edicion.FormatoFecha</dd>
                    <dt>@L("Monto")</dt><dd>@edicion.Decimales decimales@(edicion.MontoSinPunto ? L(", sin punto") : L(", separador \"{0}\"", edicion.SeparadorDecimal))</dd>
                    <dt>@L("Tipo de cuenta")</dt><dd>@L("Monetaria = {0} · Ahorro = {1}", edicion.CodigoMonetaria, edicion.CodigoAhorro)</dd>
                    @if (edicion.Encabezado is not null) { <dt>@L("Encabezado")</dt><dd><code>@edicion.Encabezado</code></dd> }
                    @if (edicion.Pie is not null) { <dt>@L("Línea final")</dt><dd><code>@edicion.Pie</code></dd> }
                    <dt>@L("Columnas")</dt><dd>@string.Join(" · ", edicion.Columnas.Select(c => c.Campo == "FIJO" ? $"\"{c.Valor}\"" : c.Longitud is int l ? $"{c.Campo} ({l})" : c.Campo))</dd>
                    <dt>@L("Códigos de bancos")</dt><dd>@(edicion.Bancos.Count == 0 ? L("Los de cada entidad financiera") : string.Join(" · ", edicion.Bancos.Select(x => $"{bancos.FirstOrDefault(y => y.GefId == x.GefId)?.GefCodigo ?? x.Banco} = {x.Codigo}")))</dd>
                </dl>
            }
            else
            {
            <fieldset class="sin-borde">
                <legend class="sr-only">@L("Datos del formato")</legend>
                <div class="panel-formulario panel-ancho">
                    <div class="campo"><label for="fmt-nombre">@L("Nombre")</label><input id="fmt-nombre" maxlength="80" @bind="edicion.Nombre" /></div>
                    <div class="campo">
                        <label for="fmt-banco">@L("Banco que lo recibe")</label>
                        <select id="fmt-banco" value="@(edicion.GefId?.ToString() ?? "")" @onchange="e => { edicion.GefId = int.TryParse(e.Value?.ToString(), out var g) ? g : null; Previsualizar(); }">
                            <option value="">@L("(Cualquiera)")</option>
                            @foreach (var b in bancos)
                            {
                                <option value="@b.GefId">@b.GefDescripcion</option>
                            }
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fmt-uso">@L("Se usa para")</label>
                        <select id="fmt-uso" @bind="edicion.Uso">
                            <option value="A">@L("Proveedores y planilla")</option>
                            <option value="P">@L("Solo proveedores")</option>
                            <option value="N">@L("Solo planilla")</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fmt-tipo">@L("Tipo de archivo")</label>
                        <select id="fmt-tipo" @bind="edicion.Tipo" @bind:after="Previsualizar">
                            <option value="D">@L("Delimitado (CSV, punto y coma…)")</option>
                            <option value="F">@L("Ancho fijo")</option>
                        </select>
                    </div>
                    @if (edicion.Tipo == "D")
                    {
                        <div class="campo">
                            <label for="fmt-separador">@L("Separador")</label>
                            <select id="fmt-separador" @bind="edicion.Separador" @bind:after="Previsualizar">
                                <option value=",">@L("Coma ( , )")</option>
                                <option value=";">@L("Punto y coma ( ; )")</option>
                                <option value="|">@L("Barra ( | )")</option>
                                <option value="TAB">@L("Tabulador")</option>
                            </select>
                        </div>
                        <div class="campo campo-checkbox"><label><input type="checkbox" @bind="edicion.Titulos" @bind:after="Previsualizar" /> @L("Primera línea con títulos")</label></div>
                        <div class="campo campo-checkbox"><label><input type="checkbox" @bind="edicion.Comillas" @bind:after="Previsualizar" /> @L("Valores entre comillas")</label></div>
                    }
                    <div class="campo"><label for="fmt-extension">@L("Extensión")</label><input id="fmt-extension" maxlength="5" @bind="edicion.Extension" @bind:after="Previsualizar" /></div>
                    <div class="campo">
                        <label for="fmt-codificacion">@L("Codificación")</label>
                        <select id="fmt-codificacion" @bind="edicion.Codificacion">
                            <option value="ANSI">@L("ANSI (Windows)")</option>
                            <option value="UTF-8">@L("UTF-8")</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fmt-fin">@L("Fin de línea")</label>
                        <select id="fmt-fin" @bind="edicion.FinLinea">
                            <option value="CRLF">@L("Windows (CRLF)")</option>
                            <option value="LF">@L("Unix (LF)")</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fmt-fecha">@L("Formato de fecha")</label>
                        <select id="fmt-fecha" @bind="edicion.FormatoFecha" @bind:after="Previsualizar">
                            @foreach (var f in FormatosFecha)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="campo"><label for="fmt-decimales">@L("Decimales del monto")</label><input id="fmt-decimales" type="number" min="0" max="4" @bind="edicion.Decimales" @bind:after="Previsualizar" /></div>
                    <div class="campo">
                        <label for="fmt-sep-decimal">@L("Separador decimal")</label>
                        <select id="fmt-sep-decimal" @bind="edicion.SeparadorDecimal" @bind:after="Previsualizar">
                            <option value=".">@L("Punto (1250.50)")</option>
                            <option value=",">@L("Coma (1250,50)")</option>
                        </select>
                    </div>
                    <div class="campo campo-checkbox"><label><input type="checkbox" @bind="edicion.MontoSinPunto" @bind:after="Previsualizar" /> @L("Monto sin punto decimal (1250.50 → 125050)")</label></div>
                    <div class="campo"><label for="fmt-monetaria">@L("Código de cuenta monetaria")</label><input id="fmt-monetaria" maxlength="20" @bind="edicion.CodigoMonetaria" @bind:after="Previsualizar" /></div>
                    <div class="campo"><label for="fmt-ahorro">@L("Código de cuenta de ahorro")</label><input id="fmt-ahorro" maxlength="20" @bind="edicion.CodigoAhorro" @bind:after="Previsualizar" /></div>
                    <div class="campo campo-ancho">
                        <label for="fmt-encabezado">@L("Línea de encabezado (opcional)")</label>
                        <input id="fmt-encabezado" maxlength="500" @bind="edicion.Encabezado" @bind:after="Previsualizar" placeholder="@L("Ej.: H{CUENTA_ORIGEN,20}{FECHA}{CANTIDAD,5}{TOTAL,15}")" />
                    </div>
                    <div class="campo campo-ancho">
                        <label for="fmt-pie">@L("Línea final (opcional)")</label>
                        <input id="fmt-pie" maxlength="500" @bind="edicion.Pie" @bind:after="Previsualizar" placeholder="@L("Ej.: T{CANTIDAD,5}{TOTAL,15}")" />
                        <small class="texto-ayuda">Marcadores: {NUMERO} {FECHA} {REFERENCIA} {DESCRIPCION} {TOTAL} {CANTIDAD} {CUENTA_ORIGEN} {MONEDA}; con L(",ancho") se rellenan (los números con ceros a la izquierda).</small>
                    </div>
                    <div class="campo">
                        <label for="fmt-estado">@L("Estado")</label>
                        <select id="fmt-estado" @bind="edicion.Estado">
                            <option value="A">@L("Activo")</option>
                            <option value="I">@L("Inactivo")</option>
                        </select>
                    </div>
                </div>

                <h3>@L("Columnas de cada transferencia")</h3>
                <div class="tabla-desplazable" tabindex="0" aria-label="@L("Columnas del formato")">
                <table class="tabla-datos tabla-formato-columnas">
                    <thead>
                        <tr><th class="num">#</th><th>@L("Campo")</th><th>@L("Título")</th><th class="num">@L("Ancho")</th><th>@L("Relleno")</th><th>@L("Alineación")</th><th>@L("Texto fijo / moneda")</th><th>@L("MAYÚS.")</th><th class="col-acciones"><span class="sr-only">@L("Acciones")</span></th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < edicion.Columnas.Count; i++)
                        {
                            var indice = i;
                            var c = edicion.Columnas[i];
                            <tr>
                                <td class="num">@(i + 1)</td>
                                <td>
                                    <select aria-label="@(L("Campo de la columna {0}", i + 1))" @bind="c.Campo" @bind:after="Previsualizar">
                                        @foreach (var campo in ArchivoBanco.Campos)
                                        {
                                            <option value="@campo.Key" title="@campo.Value">@campo.Key</option>
                                        }
                                    </select>
                                </td>
                                <td><input aria-label="@(L("Título de la columna {0}", i + 1))" maxlength="60" @bind="c.Titulo" @bind:after="Previsualizar" /></td>
                                <td class="num"><input class="entrada-monto" type="number" min="1" max="200" aria-label="@(L("Ancho de la columna {0}", i + 1))" @bind="c.Longitud" @bind:after="Previsualizar" /></td>
                                <td>
                                    <select aria-label="@(L("Relleno de la columna {0}", i + 1))" @bind="c.Relleno" @bind:after="Previsualizar">
                                        <option value="">@L("Espacios")</option>
                                        <option value="0">@L("Ceros")</option>
                                    </select>
                                </td>
                                <td>
                                    <select aria-label="@(L("Alineación de la columna {0}", i + 1))" @bind="c.Alineacion" @bind:after="Previsualizar">
                                        <option value="I">@L("Izquierda")</option>
                                        <option value="D">@L("Derecha")</option>
                                    </select>
                                </td>
                                <td><input aria-label="@(L("Texto fijo de la columna {0}", i + 1))" maxlength="100" disabled="@(c.Campo is not ("FIJO" or "MONEDA"))" @bind="c.Valor" @bind:after="Previsualizar" /></td>
                                <td><input type="checkbox" aria-label="@(L("Mayúsculas en la columna {0}", i + 1))" @bind="c.Mayusculas" @bind:after="Previsualizar" /></td>
                                <td class="col-acciones">
                                    <div class="acciones-fila">
                                        <BotonIcono Icono="chevron-left" Tooltip="@L("Subir")" Deshabilitado="indice == 0" OnClick="() => Mover(indice, -1)" />
                                        <BotonIcono Icono="chevron-right" Tooltip="@L("Bajar")" Deshabilitado="indice == edicion.Columnas.Count - 1" OnClick="() => Mover(indice, 1)" />
                                        <BotonIcono Icono="x" Tooltip="@L("Quitar la columna")" Variante="peligro" OnClick="() => Quitar(indice)" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <div class="acciones-fila">
                    <BotonIcono Icono="plus" Tooltip="@L("Agregar una columna")" Etiqueta="@L("Agregar columna")" OnClick="Agregar" />
                </div>

                <h3>@L("Código de cada banco destino")</h3>
                <p class="texto-ayuda">@L("El código con que este banco identifica a los demás bancos en el archivo. Vacío = el código de la entidad financiera.")</p>
                <table class="tabla-datos">
                    <thead><tr><th>@L("Banco destino")</th><th>@L("Código en el archivo")</th></tr></thead>
                    <tbody>
                        @foreach (var b in bancos)
                        {
                            <tr>
                                <td>@b.GefDescripcion <span class="texto-tenue">(@b.GefCodigo)</span></td>
                                <td><input class="entrada-referencia" maxlength="10" aria-label="@(L("Código de {0}", b.GefDescripcion))" value="@CodigoBanco(b.GefId)" @onchange="e => CambiarCodigo(b.GefId, e.Value?.ToString())" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </fieldset>
            }

            <h3>@L("Vista previa con datos de ejemplo")</h3>
            @if (vista.Errores.Count > 0)
            {
                @foreach (var e in vista.Errores) { <p class="mensaje-error" role="alert">@e</p> }
            }
            else
            {
                <pre class="archivo-banco-vista-pre" tabindex="0" aria-label="@L("Vista previa del archivo")">@vistaTexto</pre>
            }

            @if (editando)
            {
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="@L("Guardar el formato")" Etiqueta="@L("Guardar")" Variante="primario" Deshabilitado="guardando" OnClick="GuardarAsync" />
                    <BotonIcono Icono="copy" Tooltip="@L("Copiar como un formato nuevo")" Etiqueta="@L("Duplicar")" OnClick="Duplicar" />
                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="CancelarAsync" />
                </div>
            }
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly string[] FormatosFecha = ["yyyyMMdd", "ddMMyyyy", "dd/MM/yyyy", "yyyy-MM-dd", "MM/dd/yyyy", "ddMMyy"];

    private IReadOnlyList<FormatoArchivo> formatos = Array.Empty<FormatoArchivo>();
    private IReadOnlyList<EntidadFinanciera> bancos = Array.Empty<EntidadFinanciera>();
    private FormatoArchivo? edicion;
    private bool editando;
    private bool guardando;
    private ArchivoBanco.Resultado vista = new(null, "", [], []);
    private string vistaTexto = "";
    private string? mensaje;
    private bool esMensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tipoBanco = (await GeneralRepository.ConsultarTiposEntidadAsync()).FirstOrDefault(t => t.GeftDescripcion == "Banco");
            if (tipoBanco is not null) bancos = await GeneralRepository.ConsultarEntidadesAsync(tipoBanco.GeftId, soloActivas: true);
            await CargarAsync();
            if (formatos.Count > 0) Seleccionar(formatos[0]);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string SeparadorTexto(string? s) => s switch { ";" => L("punto y coma"), "|" => "barra", "TAB" => "tabulador", _ => "coma" };

    private static string UsoTexto(string uso) => uso switch { "P" => L("Proveedores"), "N" => L("Planilla"), _ => L("Ambos") };

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private async Task CargarAsync() => formatos = await PagosRepository.ConsultarFormatosAsync(null, soloActivos: false);

    // Se edita una copia para que Cancelar no deje cambios a medias en la lista.
    private static FormatoArchivo Copiar(FormatoArchivo f) => new()
    {
        BfaId = f.BfaId, Nombre = f.Nombre, GefId = f.GefId, Banco = f.Banco, Uso = f.Uso, Tipo = f.Tipo, Separador = f.Separador ?? ",",
        Titulos = f.Titulos, Comillas = f.Comillas, Encabezado = f.Encabezado, Pie = f.Pie, Extension = f.Extension,
        Codificacion = f.Codificacion, FinLinea = f.FinLinea, FormatoFecha = f.FormatoFecha, Decimales = f.Decimales,
        SeparadorDecimal = f.SeparadorDecimal, MontoSinPunto = f.MontoSinPunto, CodigoMonetaria = f.CodigoMonetaria,
        CodigoAhorro = f.CodigoAhorro, Estado = f.Estado,
        Columnas = f.Columnas.Select(c => new FormatoColumna
        {
            Orden = c.Orden, Campo = c.Campo, Titulo = c.Titulo, Longitud = c.Longitud, Relleno = c.Relleno ?? "",
            Alineacion = c.Alineacion, Valor = c.Valor, Mayusculas = c.Mayusculas
        }).ToList(),
        Bancos = f.Bancos.Select(b => new FormatoBanco { GefId = b.GefId, Banco = b.Banco, Codigo = b.Codigo }).ToList()
    };

    private void Seleccionar(FormatoArchivo f)
    {
        edicion = Copiar(f);
        editando = false;
        mensaje = null;
        Previsualizar();
    }

    private void Nuevo()
    {
        edicion = new FormatoArchivo
        {
            Nombre = "",
            Columnas =
            [
                new() { Campo = "CUENTA_DESTINO", Titulo = "Cuenta" },
                new() { Campo = "BENEFICIARIO", Titulo = "Nombre" },
                new() { Campo = "MONTO", Titulo = "Monto", Alineacion = "D" }
            ]
        };
        editando = true;
        mensaje = null;
        Previsualizar();
    }

    private void Duplicar()
    {
        if (edicion is null) return;
        edicion = Copiar(edicion);
        edicion.BfaId = 0;
        edicion.Nombre = L("{0} (copia)", edicion.Nombre);
        Previsualizar();
    }

    private async Task CancelarAsync()
    {
        var id = edicion?.BfaId ?? 0;
        await CargarAsync();
        var original = formatos.FirstOrDefault(f => f.BfaId == id) ?? formatos.FirstOrDefault();
        if (original is null) edicion = null;
        else Seleccionar(original);
    }

    private void Agregar()
    {
        edicion?.Columnas.Add(new FormatoColumna { Campo = "REFERENCIA", Titulo = "Referencia" });
        Previsualizar();
    }

    private void Quitar(int indice)
    {
        edicion?.Columnas.RemoveAt(indice);
        Previsualizar();
    }

    private void Mover(int indice, int paso)
    {
        if (edicion is null) return;
        var destino = indice + paso;
        if (destino < 0 || destino >= edicion.Columnas.Count) return;
        (edicion.Columnas[indice], edicion.Columnas[destino]) = (edicion.Columnas[destino], edicion.Columnas[indice]);
        Previsualizar();
    }

    private string CodigoBanco(int gefId) => edicion?.Bancos.FirstOrDefault(b => b.GefId == gefId)?.Codigo ?? "";

    private void CambiarCodigo(int gefId, string? codigo)
    {
        if (edicion is null) return;
        edicion.Bancos.RemoveAll(b => b.GefId == gefId);
        if (!string.IsNullOrWhiteSpace(codigo)) edicion.Bancos.Add(new FormatoBanco { GefId = gefId, Codigo = codigo.Trim() });
        Previsualizar();
    }

    // Dos transferencias de ejemplo con el formato tal como está en pantalla.
    private void Previsualizar()
    {
        if (edicion is null) return;
        var banco1 = bancos.FirstOrDefault();
        var banco2 = bancos.Skip(1).FirstOrDefault() ?? banco1;
        var datos = new ArchivoBancoDatos
        {
            Encabezado = new ArchivoBancoEncabezado
            {
                Numero = "LT-000001", Fecha = DateTime.Today, Referencia = L("Pago semana"), Total = 15250.50m, Cantidad = 2,
                CuentaOrigen = "301-0001122-3", GefIdOrigen = edicion.GefId ?? banco1?.GefId ?? 0, BancoOrigen = edicion.Banco ?? "", Estado = "A",
                Descripcion = L("Pago a proveedores")
            },
            Lineas =
            [
                new() { Correlativo = 1, Codigo = "PRV01", Beneficiario = L("Distribuidora Ejemplo, S.A."), Identificacion = "1234567K", GefId = banco1?.GefId,
                        BancoCodigo = banco1?.GefCodigo, Banco = banco1?.GefDescripcion, TipoCuenta = "M", Cuenta = "3000012345", Monto = 12000m,
                        Referencia = L("Pago contraseña CP-000001"), Correo = "pagos@ejemplo.com" },
                new() { Correlativo = 2, Codigo = "PRV02", Beneficiario = L("Servicios Técnicos Peña"), Identificacion = "7654321", GefId = banco2?.GefId,
                        BancoCodigo = banco2?.GefCodigo, Banco = banco2?.GefDescripcion, TipoCuenta = "A", Cuenta = "40-0098765-1", Monto = 3250.50m,
                        Referencia = L("Pago contraseña CP-000002") }
            ]
        };
        vista = ArchivoBanco.Generar(edicion, datos);
        vistaTexto = vista.Contenido is { } bytes
            ? (edicion.Codificacion == "UTF-8" ? Encoding.UTF8 : Encoding.Latin1).GetString(bytes).Replace("\r", "").Replace(' ', '·').Replace("\t", "→")
            : "";
    }

    private async Task GuardarAsync()
    {
        if (edicion is null) return;
        guardando = true;
        try
        {
            var usuario = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();
            var id = await PagosRepository.GuardarFormatoAsync(edicion, usuario);
            await CargarAsync();
            var guardado = formatos.First(f => f.BfaId == id);
            Seleccionar(guardado);
            mensaje = L("Formato {0} guardado.", guardado.Nombre);
            esMensajeError = false;
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
