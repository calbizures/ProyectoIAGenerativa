@page "/bancos/cheques"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:BANCOS_ADMIN")]
@using Erp.Data.Bancos
@using Erp.Data.General
@using Erp.Data.Rrhh
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IBancosRepository BancosRepository
@inject IGeneralRepository GeneralRepository
@inject IRrhhRepository RrhhRepository

<PageTitle>Cheques</PageTitle>

<div class="pagina-encabezado">
    <h1>Cheques</h1>
    <p>Todos los cheques emitidos: a proveedores (se emiten en Cuentas por pagar), de nómina (en RRHH &gt; Nóminas) y libres, que se emiten aquí con su beneficiario, motivo y cuenta de gasto.</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<div class="barra-herramientas">
    <select @bind="filtroBcbId" @bind:after="ConsultarAsync" aria-label="Cuenta bancaria">
        <option value="">Todas las cuentas</option>
        @foreach (var c in cuentas)
        {
            <option value="@c.BcbId">@c.Nombre</option>
        }
    </select>
    <select @bind="filtroTipo" @bind:after="ConsultarAsync" aria-label="Tipo de cheque">
        <option value="">Todos los tipos</option>
        <option value="L">Libres</option>
        <option value="P">A proveedores</option>
        <option value="N">De nómina</option>
    </select>
    <select @bind="filtroEstado" @bind:after="ConsultarAsync" aria-label="Estado">
        <option value="">Todos los estados</option>
        <option value="E">Emitidos</option>
        <option value="C">Cobrados</option>
        <option value="A">Anulados</option>
    </select>
    <label class="filtro-campo">Desde <input type="date" @bind="filtroDesde" @bind:after="ConsultarAsync" /></label>
    <label class="filtro-campo">Hasta <input type="date" @bind="filtroHasta" @bind:after="ConsultarAsync" /></label>
    <span class="barra-herramientas-separador"></span>
    <BotonIcono Icono="plus" Tooltip="Emitir un cheque libre" Etiqueta="Nuevo cheque" Variante="primario" OnClick="NuevoCheque" />
</div>

@if (nuevo is not null)
{
    <section class="tarjeta" aria-labelledby="titulo-nuevo">
        <h2 id="titulo-nuevo">Nuevo cheque</h2>
        <p class="texto-ayuda">Genera su póliza: Debe a la cuenta elegida (con su centro de costo) y Haber a la cuenta contable del banco.</p>
        <div class="panel-formulario panel-ancho">
            <div class="campo">
                <label for="chq-chequera">Chequera</label>
                <select id="chq-chequera" value="@nuevo.CbcId" @onchange="CambiarChequera">
                    @foreach (var q in chequeras)
                    {
                        <option value="@q.CbcId">@q.Nombre (@q.Disponibles disp.)</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-numero">Número</label>
                <input id="chq-numero" maxlength="16" inputmode="numeric" @bind="nuevo.Numero" />
                <small class="texto-ayuda">Se propone el siguiente de la chequera.</small>
            </div>
            <div class="campo"><label for="chq-fecha">Fecha</label><input id="chq-fecha" type="date" @bind="nuevo.Fecha" /></div>
            <div class="campo"><label for="chq-beneficiario">Páguese a la orden de</label><input id="chq-beneficiario" maxlength="150" @bind="nuevo.Beneficiario" /></div>
            <div class="campo"><label for="chq-valor">Valor (Q)</label><input id="chq-valor" type="number" step="0.01" min="0" @bind="nuevo.Valor" /></div>
            <div class="campo">
                <label for="chq-motivo">Motivo</label>
                <select id="chq-motivo" @bind="nuevo.BmpId">
                    <option value="0">Seleccione...</option>
                    @foreach (var m in motivos)
                    {
                        <option value="@m.BmpId">@m.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-cuenta">Cuenta contable (Debe)</label>
                <select id="chq-cuenta" @bind="nuevo.CtaId">
                    <option value="0">Seleccione...</option>
                    @foreach (var c in cuentasContables)
                    {
                        <option value="@c.CtaId">@c.CtaCodigo — @c.CtaNombre</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-depto">Centro de costo</label>
                <select id="chq-depto" @bind="nuevo.IdDepartamento">
                    <option value="">(Sin centro de costo)</option>
                    @foreach (var d in departamentos)
                    {
                        <option value="@d.IdDepartamento">@d.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo"><label for="chq-obs">Observaciones</label><input id="chq-obs" maxlength="250" @bind="nuevo.Observaciones" /></div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Emitir el cheque" Etiqueta="Emitir cheque" Variante="primario" Deshabilitado="chequeras.Count == 0 || guardando" OnClick="EmitirAsync" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => nuevo = null" />
            </div>
            @if (chequeras.Count == 0)
            {
                <p class="mensaje-error" role="alert">No hay chequeras activas con cheques disponibles. Regístrelas en Bancos &gt; Cuentas bancarias.</p>
            }
        </div>
    </section>
}

<section class="tarjeta" aria-labelledby="titulo-cheques">
    <div class="maestro-detalle-encabezado">
        <h2 id="titulo-cheques">Cheques emitidos</h2>
        <span class="texto-tenue">@cheques.Count(c => c.EstadoCheque != "A") vigente(s) · Q @cheques.Where(c => c.EstadoCheque != "A").Sum(c => c.Valor).ToString("N2")</span>
    </div>
    @if (cheques.Count == 0)
    {
        <p class="estado-vacio">No hay cheques con esos filtros.</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr><th class="col-fecha">Fecha</th><th>Cheque</th><th class="col-estado">Tipo</th><th>Beneficiario</th><th>Motivo / cuenta</th><th class="num col-monto">Valor</th><th class="col-estado">Estado</th><th class="col-acciones">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var c in cheques)
                {
                    <tr>
                        <td class="col-fecha">@c.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><strong>@c.Numero</strong><br /><span class="texto-tenue">@c.Cuenta</span></td>
                        <td class="col-estado">@NombreTipo(c.Tipo)</td>
                        <td>@c.Beneficiario@(c.Nomina is null ? "" : $" · {c.Nomina}")</td>
                        <td>
                            @c.Motivo
                            @if (c.CuentaCodigo is not null)
                            {
                                <br /><span class="texto-tenue">@c.CuentaCodigo @c.CuentaNombre@(c.Departamento is null ? "" : $" · {c.Departamento}")</span>
                            }
                            @if (!string.IsNullOrEmpty(c.Observaciones))
                            {
                                <br /><span class="texto-tenue">@c.Observaciones</span>
                            }
                        </td>
                        <td class="num col-monto">@c.Valor.ToString("N2")</td>
                        <td class="col-estado"><span class="estado-badge @(c.EstadoCheque == "A" ? "estado-badge-inactivo" : "estado-badge-activo")">@NombreEstado(c)</span></td>
                        <td class="col-acciones">
                            @if (c.EstadoCheque == "E")
                            {
                                <div class="acciones-fila">
                                    <BotonIcono Icono="check-check" Tooltip="Marcar como cobrado" Confirmacion="¿El banco ya pagó este cheque?" OnClick="() => CobrarAsync(c)" />
                                    <BotonIcono Icono="ban" Tooltip="Anular cheque" Variante="peligro" OnClick="() => IniciarAnulacion(c)" />
                                </div>
                            }
                        </td>
                    </tr>
                    @if (anulando?.BceId == c.BceId)
                    {
                        <tr class="fila-subdetalle">
                            <td colspan="8">
                                <div class="fila-edicion">
                                    <label for="motivo-cheque">Motivo de la anulación del cheque @c.Numero</label>
                                    <input id="motivo-cheque" maxlength="200" placeholder="Ej.: cheque impreso con error" @bind="motivoAnulacion" @bind:event="oninput" />
                                    <BotonIcono Icono="ban" Tooltip="Confirmar anulación" Etiqueta="Anular cheque" Variante="peligro"
                                                Deshabilitado="motivoAnulacion.Trim().Length < 5 || guardando" OnClick="AnularAsync" />
                                    <BotonIcono Icono="x" Tooltip="Cancelar" OnClick="() => anulando = null" />
                                </div>
                                <small class="texto-ayuda">@TextoAnulacion(c)</small>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<CuentaBancaria> cuentas = Array.Empty<CuentaBancaria>();
    private IReadOnlyList<Chequera> chequeras = Array.Empty<Chequera>();
    private IReadOnlyList<MotivoPago> motivos = Array.Empty<MotivoPago>();
    private IReadOnlyList<CuentaContable> cuentasContables = Array.Empty<CuentaContable>();
    private IReadOnlyList<Departamento> departamentos = Array.Empty<Departamento>();
    private IReadOnlyList<Cheque> cheques = Array.Empty<Cheque>();

    private int? filtroBcbId;
    private string filtroTipo = "";
    private string filtroEstado = "";
    private DateTime? filtroDesde = DateTime.Today.AddDays(-60);
    private DateTime? filtroHasta;

    private ChequeLibre? nuevo;
    private Cheque? anulando;
    private string motivoAnulacion = "";
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuentas = await BancosRepository.ConsultarCuentasAsync(soloActivas: false);
            motivos = await BancosRepository.ConsultarMotivosAsync(soloActivos: true);
            departamentos = await RrhhRepository.ConsultarDepartamentosAsync(soloActivos: true);
            cuentasContables = (await GeneralRepository.ConsultarCuentasContablesAsync())
                .Where(c => c.CtaAceptaMovimiento && c.CtaEstado == "A").OrderBy(c => c.CtaCodigo).ToList();
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string NombreTipo(string tipo) => tipo switch { "P" => "Proveedor", "N" => "Nómina", _ => "Libre" };

    private static string NombreEstado(Cheque c) => c.EstadoCheque switch
    {
        "C" => c.FechaCobro is null ? "Cobrado" : $"Cobrado {c.FechaCobro:dd/MM}",
        "A" => "Anulado",
        _ => "Emitido"
    };

    private static string TextoAnulacion(Cheque c) => c.Tipo switch
    {
        "P" => "Se anula su póliza y el saldo vuelve a la cuota del proveedor.",
        "N" => "Se anula su póliza y el empleado vuelve a quedar pendiente de pago en la nómina.",
        _ => "Se anula su póliza."
    };

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private async Task ConsultarAsync()
    {
        try
        {
            cheques = await BancosRepository.ConsultarChequesAsync(filtroBcbId, filtroTipo == "" ? null : filtroTipo,
                filtroEstado == "" ? null : filtroEstado, filtroDesde, filtroHasta);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task NuevoCheque()
    {
        mensaje = null;
        try
        {
            chequeras = (await BancosRepository.ConsultarChequerasAsync(filtroBcbId, soloActivas: true)).Where(q => q.Disponibles > 0).ToList();
            var chequera = chequeras.FirstOrDefault();
            nuevo = new ChequeLibre
            {
                CbcId = chequera?.CbcId ?? 0,
                Numero = chequera?.Siguiente?.ToString(),
                BmpId = motivos.FirstOrDefault(m => m.Descripcion.Contains("varios", StringComparison.OrdinalIgnoreCase))?.BmpId ?? 0
            };
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void CambiarChequera(ChangeEventArgs e)
    {
        if (nuevo is null) return;
        nuevo.CbcId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        nuevo.Numero = chequeras.FirstOrDefault(q => q.CbcId == nuevo.CbcId)?.Siguiente?.ToString();
    }

    private async Task EmitirAsync()
    {
        if (nuevo is null) return;
        if (nuevo.CbcId == 0 || nuevo.BmpId == 0 || nuevo.CtaId == 0 || nuevo.Valor <= 0 || string.IsNullOrWhiteSpace(nuevo.Beneficiario))
        {
            mensaje = "Complete la chequera, el beneficiario, el valor, el motivo y la cuenta contable.";
            esMensajeError = true;
            return;
        }
        guardando = true;
        try
        {
            nuevo.Beneficiario = nuevo.Beneficiario.Trim();
            await BancosRepository.EmitirChequeLibreAsync(nuevo, await ObtenerUsuIdActualAsync());
            MostrarOk($"Cheque emitido a {nuevo.Beneficiario} por Q {nuevo.Valor:N2}, con su póliza.");
            nuevo = null;
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    private async Task CobrarAsync(Cheque c)
    {
        try
        {
            await BancosRepository.CobrarChequeAsync(c.BceId, null, await ObtenerUsuIdActualAsync());
            MostrarOk($"Cheque {c.Numero} marcado como cobrado; ya no se puede anular.");
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarAnulacion(Cheque c)
    {
        mensaje = null;
        anulando = c;
        motivoAnulacion = "";
    }

    private async Task AnularAsync()
    {
        if (anulando is null) return;
        guardando = true;
        try
        {
            await BancosRepository.AnularChequeAsync(anulando.BceId, motivoAnulacion.Trim(), await ObtenerUsuIdActualAsync());
            MostrarOk($"Cheque {anulando.Numero} anulado junto con su póliza.");
            anulando = null;
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
