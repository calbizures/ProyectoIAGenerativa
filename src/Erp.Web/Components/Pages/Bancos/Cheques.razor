@page "/bancos/cheques"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:BANCOS_ADMIN,BANCOS_CHEQUE_EMITIR")]
@using Erp.Data.Bancos
@using Erp.Data.General
@using Erp.Data.Rrhh
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IBancosRepository BancosRepository
@inject IGeneralRepository GeneralRepository
@inject IRrhhRepository RrhhRepository

<PageTitle>@L("Cheques")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Cheques")</h1>
    <p>@L("Todos los cheques emitidos: a proveedores (se emiten en Cuentas por pagar), de nómina (en RRHH > Nóminas) y libres, que se emiten aquí con su beneficiario, motivo y cuenta de gasto.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<div class="barra-herramientas">
    <select @bind="filtroBcbId" @bind:after="ConsultarAsync" aria-label="@L("Cuenta bancaria")">
        <option value="">@L("Todas las cuentas")</option>
        @foreach (var c in cuentas)
        {
            <option value="@c.BcbId">@c.Nombre</option>
        }
    </select>
    <select @bind="filtroTipo" @bind:after="ConsultarAsync" aria-label="@L("Tipo de cheque")">
        <option value="">@L("Todos los tipos")</option>
        <option value="L">@L("Libres")</option>
        <option value="P">@L("A proveedores")</option>
        <option value="N">@L("De nómina")</option>
    </select>
    <select @bind="filtroEstado" @bind:after="ConsultarAsync" aria-label="@L("Estado")">
        <option value="">@L("Todos los estados")</option>
        <option value="E">@L("Emitidos")</option>
        <option value="C">@L("Cobrados")</option>
        <option value="A">@L("Anulados")</option>
    </select>
    <FiltroPeriodo @bind-Desde="filtroDesde" @bind-Hasta="filtroHasta" AlCambiar="ConsultarAsync" />
    <span class="barra-herramientas-separador"></span>
    <BotonIcono Icono="plus" Tooltip="@L("Emitir un cheque libre")" Etiqueta="@L("Nuevo cheque")" Variante="primario" OnClick="NuevoCheque" />
</div>

@if (nuevo is not null)
{
    <section class="tarjeta" aria-labelledby="titulo-nuevo">
        <h2 id="titulo-nuevo">@L("Nuevo cheque")</h2>
        <p class="texto-ayuda">@L("Genera su póliza: Debe a la cuenta elegida (con su centro de costo) y Haber a la cuenta contable del banco.")</p>
        <div class="panel-formulario panel-ancho">
            <div class="campo">
                <label for="chq-chequera">@L("Chequera")</label>
                <select id="chq-chequera" value="@nuevo.CbcId" @onchange="CambiarChequera">
                    @foreach (var q in chequeras)
                    {
                        <option value="@q.CbcId">@L("{0} ({1} disp.)", q.Nombre, q.Disponibles)</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-numero">@L("Número")</label>
                <input id="chq-numero" maxlength="16" inputmode="numeric" @bind="nuevo.Numero" />
                <small class="texto-ayuda">@L("Se propone el siguiente de la chequera.")</small>
            </div>
            <div class="campo"><label for="chq-fecha">@L("Fecha")</label><input id="chq-fecha" type="date" @bind="nuevo.Fecha" /></div>
            <div class="campo"><label for="chq-beneficiario">@L("Páguese a la orden de")</label><input id="chq-beneficiario" maxlength="150" @bind="nuevo.Beneficiario" /></div>
            <div class="campo"><label for="chq-valor">@L("Valor (Q)")</label><input id="chq-valor" type="number" step="0.01" min="0" @bind="nuevo.Valor" /></div>
            <div class="campo">
                <label for="chq-motivo">@L("Motivo")</label>
                <select id="chq-motivo" @bind="nuevo.BmpId">
                    <option value="0">@L("Seleccione...")</option>
                    @foreach (var m in motivos)
                    {
                        <option value="@m.BmpId">@m.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-cuenta">@L("Cuenta contable (Debe)")</label>
                <select id="chq-cuenta" @bind="nuevo.CtaId">
                    <option value="0">@L("Seleccione...")</option>
                    @foreach (var c in cuentasContables)
                    {
                        <option value="@c.CtaId">@c.CtaCodigo — @c.CtaNombre</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="chq-depto">@L("Centro de costo")</label>
                <select id="chq-depto" @bind="nuevo.IdDepartamento">
                    <option value="">@L("(Sin centro de costo)")</option>
                    @foreach (var d in departamentos)
                    {
                        <option value="@d.IdDepartamento">@d.Descripcion</option>
                    }
                </select>
            </div>
            <div class="campo"><label for="chq-obs">@L("Observaciones")</label><input id="chq-obs" maxlength="250" @bind="nuevo.Observaciones" /></div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Emitir el cheque")" Etiqueta="@L("Emitir cheque")" Variante="primario" Deshabilitado="chequeras.Count == 0 || guardando" OnClick="EmitirAsync" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => nuevo = null" />
            </div>
            @if (chequeras.Count == 0)
            {
                <p class="mensaje-error" role="alert">@L("No hay chequeras activas con cheques disponibles. Regístrelas en Bancos > Cuentas bancarias.")</p>
            }
        </div>
    </section>
}

<section class="tarjeta" aria-labelledby="titulo-cheques">
    <div class="maestro-detalle-encabezado">
        <h2 id="titulo-cheques">@L("Cheques emitidos")</h2>
        <span class="texto-tenue">@L("{0} vigente(s) · Q {1}", cheques.Count(c => c.EstadoCheque != "A"), cheques.Where(c => c.EstadoCheque != "A").Sum(c => c.Valor).ToString("N2"))</span>
    </div>
    @if (cheques.Count == 0)
    {
        <p class="estado-vacio">@L("No hay cheques con esos filtros.")</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr><th class="col-fecha">@L("Fecha")</th><th>@L("Cheque")</th><th class="col-estado">@L("Tipo")</th><th>@L("Beneficiario")</th><th>@L("Motivo / cuenta")</th><th class="num col-monto">@L("Valor")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr>
            </thead>
            <tbody>
                @foreach (var c in cheques)
                {
                    <tr>
                        <td class="col-fecha">@c.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><strong>@c.Numero</strong><br /><span class="texto-tenue">@c.Cuenta</span></td>
                        <td class="col-estado">@NombreTipo(c.Tipo)</td>
                        <td>@c.Beneficiario@(c.Nomina is null ? "" : $" · {c.Nomina}")</td>
                        <td>
                            @c.Motivo
                            @if (c.CuentaCodigo is not null)
                            {
                                <br /><span class="texto-tenue">@c.CuentaCodigo @c.CuentaNombre@(c.Departamento is null ? "" : $" · {c.Departamento}")</span>
                            }
                            @if (!string.IsNullOrEmpty(c.Observaciones))
                            {
                                <br /><span class="texto-tenue">@c.Observaciones</span>
                            }
                        </td>
                        <td class="num col-monto">@c.Valor.ToString("N2")</td>
                        <td class="col-estado"><span class="estado-badge @(c.EstadoCheque == "A" ? "estado-badge-inactivo" : "estado-badge-activo")">@NombreEstado(c)</span></td>
                        <td class="col-acciones">
                            @if (c.EstadoCheque == "E")
                            {
                                <AuthorizeView Policy="Permiso:BANCOS_ADMIN" Context="permisoBancos">
                                <div class="acciones-fila">
                                    <BotonIcono Icono="check-check" Tooltip="@L("Marcar como cobrado")" Confirmacion="@L("¿El banco ya pagó este cheque?")" OnClick="() => CobrarAsync(c)" />
                                    <BotonIcono Icono="ban" Tooltip="@L("Anular cheque")" Variante="peligro" OnClick="() => IniciarAnulacion(c)" />
                                </div>
                                </AuthorizeView>
                            }
                        </td>
                    </tr>
                    @if (anulando?.BceId == c.BceId)
                    {
                        <tr class="fila-subdetalle">
                            <td colspan="8">
                                <div class="fila-edicion">
                                    <label for="motivo-cheque">@L("Motivo de la anulación del cheque {0}", c.Numero)</label>
                                    <input id="motivo-cheque" maxlength="200" placeholder="@L("Ej.: cheque impreso con error")" @bind="motivoAnulacion" @bind:event="oninput" />
                                    <BotonIcono Icono="ban" Tooltip="@L("Confirmar anulación")" Etiqueta="@L("Anular cheque")" Variante="peligro"
                                                Deshabilitado="motivoAnulacion.Trim().Length < 5 || guardando" OnClick="AnularAsync" />
                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => anulando = null" />
                                </div>
                                <small class="texto-ayuda">@TextoAnulacion(c)</small>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<CuentaBancaria> cuentas = Array.Empty<CuentaBancaria>();
    private IReadOnlyList<Chequera> chequeras = Array.Empty<Chequera>();
    private IReadOnlyList<MotivoPago> motivos = Array.Empty<MotivoPago>();
    private IReadOnlyList<CuentaContable> cuentasContables = Array.Empty<CuentaContable>();
    private IReadOnlyList<Departamento> departamentos = Array.Empty<Departamento>();
    private IReadOnlyList<Cheque> cheques = Array.Empty<Cheque>();

    private int? filtroBcbId;
    private string filtroTipo = "";
    private string filtroEstado = "";
    private DateTime? filtroDesde = DateTime.Today.AddDays(-60);
    private DateTime? filtroHasta;

    private ChequeLibre? nuevo;
    private Cheque? anulando;
    private string motivoAnulacion = "";
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuentas = await BancosRepository.ConsultarCuentasAsync(soloActivas: false);
            motivos = await BancosRepository.ConsultarMotivosAsync(soloActivos: true);
            departamentos = await RrhhRepository.ConsultarDepartamentosAsync(soloActivos: true);
            cuentasContables = (await GeneralRepository.ConsultarCuentasContablesAsync())
                .Where(c => c.CtaAceptaMovimiento && c.CtaEstado == "A").OrderBy(c => c.CtaCodigo).ToList();
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private static string NombreTipo(string tipo) => tipo switch { "P" => L("Proveedor"), "N" => L("Nómina"), _ => L("Libre") };

    private static string NombreEstado(Cheque c) => c.EstadoCheque switch
    {
        "C" => c.FechaCobro is null ? L("Cobrado") : L("Cobrado {0:dd/MM}", c.FechaCobro),
        "A" => L("Anulado"),
        _ => L("Emitido")
    };

    private static string TextoAnulacion(Cheque c) => c.Tipo switch
    {
        "P" => L("Se anula su póliza y el saldo vuelve a la cuota del proveedor."),
        "N" => L("Se anula su póliza y el empleado vuelve a quedar pendiente de pago en la nómina."),
        _ => L("Se anula su póliza.")
    };

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private async Task ConsultarAsync()
    {
        try
        {
            cheques = await BancosRepository.ConsultarChequesAsync(filtroBcbId, filtroTipo == "" ? null : filtroTipo,
                filtroEstado == "" ? null : filtroEstado, filtroDesde, filtroHasta);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task NuevoCheque()
    {
        mensaje = null;
        try
        {
            chequeras = (await BancosRepository.ConsultarChequerasAsync(filtroBcbId, soloActivas: true)).Where(q => q.Disponibles > 0).ToList();
            var chequera = chequeras.FirstOrDefault();
            nuevo = new ChequeLibre
            {
                CbcId = chequera?.CbcId ?? 0,
                Numero = chequera?.Siguiente?.ToString(),
                BmpId = motivos.FirstOrDefault(m => m.Descripcion.Contains("varios", StringComparison.OrdinalIgnoreCase))?.BmpId ?? 0
            };
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void CambiarChequera(ChangeEventArgs e)
    {
        if (nuevo is null) return;
        nuevo.CbcId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        nuevo.Numero = chequeras.FirstOrDefault(q => q.CbcId == nuevo.CbcId)?.Siguiente?.ToString();
    }

    private async Task EmitirAsync()
    {
        if (nuevo is null) return;
        if (nuevo.CbcId == 0 || nuevo.BmpId == 0 || nuevo.CtaId == 0 || nuevo.Valor <= 0 || string.IsNullOrWhiteSpace(nuevo.Beneficiario))
        {
            mensaje = L("Complete la chequera, el beneficiario, el valor, el motivo y la cuenta contable.");
            esMensajeError = true;
            return;
        }
        guardando = true;
        try
        {
            nuevo.Beneficiario = nuevo.Beneficiario.Trim();
            await BancosRepository.EmitirChequeLibreAsync(nuevo, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Cheque emitido a {0} por Q {1:N2}, con su póliza.", nuevo.Beneficiario, nuevo.Valor));
            nuevo = null;
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    private async Task CobrarAsync(Cheque c)
    {
        try
        {
            await BancosRepository.CobrarChequeAsync(c.BceId, null, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Cheque {0} marcado como cobrado; ya no se puede anular.", c.Numero));
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarAnulacion(Cheque c)
    {
        mensaje = null;
        anulando = c;
        motivoAnulacion = "";
    }

    private async Task AnularAsync()
    {
        if (anulando is null) return;
        guardando = true;
        try
        {
            await BancosRepository.AnularChequeAsync(anulando.BceId, motivoAnulacion.Trim(), await ObtenerUsuIdActualAsync());
            MostrarOk(L("Cheque {0} anulado junto con su póliza.", anulando.Numero));
            anulando = null;
            await ConsultarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }
}
