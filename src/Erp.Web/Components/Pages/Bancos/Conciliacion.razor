@page "/bancos/conciliacion"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:CONCILIACION_BANCARIA")]
@using Erp.Data.Bancos
@using Erp.Data.Conciliacion
@using Erp.Data.Contabilidad
@using Erp.Data.General
@using Erp.Web.Reportes
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IConciliacionRepository ConciliacionRepository
@inject IBancosRepository BancosRepository
@inject IGeneralRepository GeneralRepository

<PageTitle>@L("Conciliación bancaria")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Conciliación bancaria")</h1>
    <p>@L("Compare cada mes el estado de cuenta del banco con los movimientos en libros: importe el archivo que descarga de la banca en línea (Excel o CSV), concilie automáticamente, empareje o marque lo que falte, registre con una póliza de ajuste lo que el banco cargó o abonó (comisiones, intereses) y cierre cuando la diferencia sea cero.")</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<div class="barra-herramientas">
    <select value="@bcbId" @onchange="CambiarCuentaAsync" aria-label="@L("Cuenta bancaria")" class="selector-cuenta">
        @foreach (var c in cuentas)
        {
            <option value="@c.BcbId">@c.Nombre@(string.IsNullOrEmpty(c.Descripcion) ? "" : $" · {c.Descripcion}")</option>
        }
    </select>
    <span class="barra-herramientas-separador"></span>
    <a class="boton-icono boton-icono-con-etiqueta" href="reportes/bancos/plantilla-estado-cuenta.xlsx" download title="@L("Plantilla de Excel para el estado de cuenta")">
        <Icono Nombre="download" Tamano="16" /><span class="boton-icono-etiqueta">@L("Plantilla")</span>
    </a>
    <BotonIcono Icono="plus" Tooltip="@L("Empezar la conciliación de un mes")" Etiqueta="@L("Nueva conciliación")" Variante="primario" OnClick="NuevaConciliacion" />
</div>

@if (nueva is not null)
{
    <section class="tarjeta" aria-labelledby="titulo-nueva">
        <h2 id="titulo-nueva">@L("Nueva conciliación")</h2>
        <div class="panel-formulario panel-ancho cch-gasto">
            <div class="campo"><label for="bcn-mes">@L("Mes")</label><input id="bcn-mes" type="month" value="@($"{nueva.Anio:0000}-{nueva.Mes:00}")" @onchange="CambiarMesNueva" /></div>
            <div class="campo">
                <label for="bcn-inicial">@L("Saldo inicial según el banco")</label>
                <input id="bcn-inicial" type="number" step="0.01" @bind="nueva.SaldoInicialBanco" />
                <small class="texto-ayuda">@L("Se propone el saldo final de la conciliación anterior.")</small>
            </div>
            <div class="campo">
                <label for="bcn-final">@L("Saldo final según el banco")</label>
                <input id="bcn-final" type="number" step="0.01" @bind="nueva.SaldoBanco" />
                <small class="texto-ayuda">@L("Si importa el archivo con columna Saldo se toma de ahí.")</small>
            </div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="@L("Crear la conciliación")" Etiqueta="@L("Crear")" Variante="primario" Deshabilitado="guardando" OnClick="CrearAsync" />
                <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="() => nueva = null" />
            </div>
        </div>
    </section>
}

<section class="tarjeta" aria-labelledby="titulo-conciliaciones">
    <h2 id="titulo-conciliaciones">@L("Conciliaciones de la cuenta")</h2>
    @if (conciliaciones.Count == 0)
    {
        <p class="estado-vacio">@L("La cuenta todavía no tiene conciliaciones. Empiece con Nueva conciliación.")</p>
    }
    else
    {
        <table class="tabla-datos">
            <thead><tr><th>@L("Mes")</th><th class="num col-monto">@L("Saldo según banco")</th><th class="num col-estado">@L("Líneas")</th><th class="num col-estado">@L("Sin conciliar")</th><th class="col-estado">@L("Estado")</th><th>@L("Cerrada")</th><th class="col-acciones">@L("Abrir")</th></tr></thead>
            <tbody>
                @foreach (var c in conciliaciones)
                {
                    <tr class="@(detalle?.Resumen.BcnId == c.BcnId ? "fila-seleccionada" : "")">
                        <td>@NombreMes(c.Mes) @c.Anio</td>
                        <td class="num col-monto">@c.SaldoBanco.ToString("N2")</td>
                        <td class="num col-estado">@c.LineasExtracto</td>
                        <td class="num col-estado">@c.Pendientes</td>
                        <td class="col-estado"><span class="estado-badge @(c.Estado == "C" ? "estado-badge-activo" : "estado-badge-pendiente")">@(c.Estado == "C" ? L("Cerrada") : L("En proceso"))</span></td>
                        <td>@(c.FechaCierre is null ? "" : $"{c.FechaCierre:dd/MM/yyyy} · {c.CerradaPor}")</td>
                        <td class="col-acciones"><BotonIcono Icono="eye" Tooltip="@L("Abrir la conciliación")" OnClick="() => AbrirAsync(c.BcnId)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@if (detalle is not null)
{
    var r = detalle.Resumen;
    var enProceso = r.Estado == "B";
    <section class="tarjeta" aria-labelledby="titulo-detalle">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-detalle">@r.Cuenta · @NombreMes(r.Mes) @r.Anio</h2>
            <div class="acciones-fila">
                <a class="boton-icono boton-icono-con-etiqueta" href="bancos/conciliacion/@r.BcnId/imprimir" target="_blank" title="@L("Imprimir la conciliación")">
                    <Icono Nombre="printer" Tamano="16" /><span class="boton-icono-etiqueta">@L("Imprimir")</span>
                </a>
                @if (enProceso)
                {
                    <BotonIcono Icono="check-check" Tooltip="@(r.Diferencia != 0 ? L("Para cerrar, la diferencia debe ser cero") : detalle.Extracto.Any(l => l.AsdId is null) ? L("Para cerrar, concilie o registre con ajuste todas las líneas del banco") : L("Cerrar la conciliación"))" Etiqueta="@L("Cerrar conciliación")" Variante="primario" Deshabilitado="guardando || r.Diferencia != 0 || detalle.Extracto.Any(l => l.AsdId is null)"
                                Confirmacion="@L("¿Cerrar la conciliación? Los movimientos en tránsito pasan al mes siguiente.")" OnClick="CerrarAsync" />
                    <BotonIcono Icono="trash-2" Tooltip="@L("Eliminar esta conciliación en proceso")" Variante="peligro" Confirmacion="@L("¿Eliminar la conciliación y las líneas importadas?")" OnClick="EliminarAsync" />
                }
                else
                {
                    <BotonIcono Icono="unlock" Tooltip="@L("Volver a abrir (solo la última de la cuenta)")" Etiqueta="@L("Reabrir")" Confirmacion="@L("¿Volver a abrir la conciliación?")" OnClick="ReabrirAsync" />
                }
            </div>
        </div>

        <div class="conciliacion-resumen">
            <dl>
                <div><dt>@L("Saldo según banco al {0}", r.FechaCorte.ToString("dd/MM/yyyy"))</dt><dd>@r.SaldoBanco.ToString("N2")</dd></div>
                <div><dt>@L("(+) Depósitos en tránsito")</dt><dd>@r.DepositosTransito.ToString("N2")</dd></div>
                <div><dt>@L("(−) Cheques y pagos en circulación")</dt><dd>@r.ChequesCirculacion.ToString("N2")</dd></div>
                <div class="total"><dt>@L("Saldo según banco ajustado")</dt><dd>@r.BancoAjustado.ToString("N2")</dd></div>
            </dl>
            <dl>
                <div><dt>@L("Saldo según libros")</dt><dd>@r.SaldoLibros.ToString("N2")</dd></div>
                <div><dt>@L("(+) Créditos del banco sin registrar")</dt><dd>@r.CreditosNoRegistrados.ToString("N2")</dd></div>
                <div><dt>@L("(−) Débitos del banco sin registrar")</dt><dd>@r.DebitosNoRegistrados.ToString("N2")</dd></div>
                <div class="total"><dt>@L("Saldo según libros ajustado")</dt><dd>@r.LibrosAjustado.ToString("N2")</dd></div>
            </dl>
            <div class="conciliacion-diferencia @(r.Diferencia == 0 ? "cuadra" : "")" role="status">
                @if (r.Diferencia == 0)
                {
                    <Icono Nombre="check-circle" Tamano="20" /><span>@L("La conciliación cuadra.")</span>
                }
                else
                {
                    <Icono Nombre="alert-triangle" Tamano="20" /><span>@L("Diferencia: Q {0}", r.Diferencia.ToString("N2"))</span>
                }
            </div>
        </div>
        @if (r.DiferenciaExtracto != 0 && detalle.Extracto.Count > 0)
        {
            <p class="etiqueta-aviso"><Icono Nombre="alert-triangle" Tamano="14" /> @L("El estado de cuenta no cuadra con sus saldos: inicial Q {0} + créditos Q {1} − débitos Q {2} difiere del final por Q {3}. Revise los saldos o si falta alguna línea.", r.SaldoInicialBanco.ToString("N2"), r.CreditosExtracto.ToString("N2"), r.DebitosExtracto.ToString("N2"), r.DiferenciaExtracto.ToString("N2"))</p>
        }

        @if (enProceso)
        {
            <div class="barra-herramientas conciliacion-acciones">
                <label class="filtro-campo">@L("Saldo inicial banco") <input type="number" step="0.01" @bind="saldoInicial" /></label>
                <label class="filtro-campo">@L("Saldo final banco") <input type="number" step="0.01" @bind="saldoFinal" /></label>
                <BotonIcono Icono="save" Tooltip="@L("Guardar los saldos del estado de cuenta")" Etiqueta="@L("Guardar saldos")" BloquearTrasGuardar="false" OnClick="GuardarSaldosAsync" />
                <span class="barra-herramientas-separador"></span>
                <label class="boton-icono boton-icono-con-etiqueta boton-archivo" title="@L("Importar el estado de cuenta (Excel o CSV)")">
                    <Icono Nombre="upload" Tamano="16" /><span class="boton-icono-etiqueta">@L("Importar estado de cuenta")</span>
                    <InputFile OnChange="ImportarAsync" accept=".xlsx,.csv,.txt" aria-label="@L("Archivo del estado de cuenta")" />
                </label>
                <label class="casilla"><input type="checkbox" @bind="reemplazar" /> @L("Reemplazar las líneas no conciliadas")</label>
                <BotonIcono Icono="check-check" Tooltip="@L("Empareja por número de cheque o documento, y por monto y fecha cercana")" Etiqueta="@L("Conciliar automáticamente")" Variante="primario" OnClick="ConciliarAutomaticoAsync" />
            </div>
            @if (erroresImportacion.Count > 0)
            {
                <ul class="mensaje-error" role="alert">
                    @foreach (var e in erroresImportacion.Take(10))
                    {
                        <li>@e</li>
                    }
                </ul>
            }
        }

        <div class="barra-herramientas">
            <label class="casilla"><input type="checkbox" @bind="soloPendientes" /> @L("Solo lo que falta conciliar")</label>
            @if (bancoElegido is not null)
            {
                <span class="etiqueta-aviso">@L("Línea del banco elegida: {0} · Q {1}. Ahora elija el movimiento de libros con el mismo monto.", bancoElegido.Fecha.ToString("dd/MM"), Math.Max(bancoElegido.Debito, bancoElegido.Credito).ToString("N2"))</span>
                <BotonIcono Icono="x" Tooltip="@L("Cancelar la selección")" OnClick="() => bancoElegido = null" />
            }
        </div>

        <div class="conciliacion-columnas">
            <section aria-labelledby="titulo-extracto">
                <h3 id="titulo-extracto">@L("Estado de cuenta del banco ({0} sin conciliar de {1})", detalle.Extracto.Count(l => l.AsdId is null), detalle.Extracto.Count)</h3>
                @if (detalle.Extracto.Count == 0)
                {
                    <p class="estado-vacio">@L("Importe el estado de cuenta del mes.")</p>
                }
                else
                {
                    <div class="tabla-desplazable" tabindex="0" aria-label="@L("Estado de cuenta")">
                        <table class="tabla-datos tabla-conciliacion">
                            <thead><tr><th class="col-fecha">@L("Fecha")</th><th>@L("Descripción")</th><th class="num">@L("Débito")</th><th class="num">@L("Crédito")</th><th class="col-acciones">@L("Acción")</th></tr></thead>
                            <tbody>
                                @foreach (var l in detalle.Extracto.Where(l => !soloPendientes || l.AsdId is null))
                                {
                                    <tr class="@(l.AsdId is not null ? "fila-conciliada" : bancoElegido?.BexId == l.BexId ? "fila-seleccionada" : "")">
                                        <td class="col-fecha">@l.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@l.Descripcion@if (l.Referencia is not null) {<br /><span class="texto-tenue">@L("Ref. {0}", l.Referencia)</span>}@if (l.AsiId is not null) {<br /><span class="texto-tenue">@NombreForma(l.Forma) · <a href="contabilidad/polizas?id=@l.AsiId">@L("póliza #{0}", l.AsiId)</a></span>}</td>
                                        <td class="num">@(l.Debito == 0 ? "" : l.Debito.ToString("N2"))</td>
                                        <td class="num">@(l.Credito == 0 ? "" : l.Credito.ToString("N2"))</td>
                                        <td class="col-acciones">
                                            @if (enProceso)
                                            {
                                                <div class="acciones-fila">
                                                    @if (l.AsdId is null)
                                                    {
                                                        <BotonIcono Icono="link" Tooltip="@L("Emparejar con un movimiento de libros")" OnClick="() => ElegirBanco(l)" />
                                                        <BotonIcono Icono="book-open" Tooltip="@L("Registrar con una póliza de ajuste (comisión, interés, nota del banco)")" OnClick="() => IniciarAjuste(l)" />
                                                        <BotonIcono Icono="trash-2" Tooltip="@L("Quitar la línea")" Variante="peligro" OnClick="() => EliminarLineaAsync(l)" />
                                                    }
                                                    else if (l.Forma != "J")
                                                    {
                                                        <BotonIcono Icono="x" Tooltip="@L("Deshacer la conciliación de esta línea")" OnClick="() => DesemparejarAsync(l.BexId, null)" />
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                    @if (ajuste?.Linea.BexId == l.BexId)
                                    {
                                        <tr class="fila-subdetalle">
                                            <td colspan="5">
                                                <div class="fila-edicion">
                                                    <label for="ajuste-cuenta">@L("Cuenta contable")</label>
                                                    <select id="ajuste-cuenta" @bind="ajuste.CtaId">
                                                        <option value="">@L("Por omisión ({0})", l.Debito > 0 ? L("comisiones bancarias") : L("otros ingresos"))</option>
                                                        @foreach (var c in cuentasDetalle)
                                                        {
                                                            <option value="@c.CtaId">@c.CtaCodigo — @c.CtaNombre</option>
                                                        }
                                                    </select>
                                                    <label for="ajuste-descripcion">@L("Concepto")</label>
                                                    <input id="ajuste-descripcion" maxlength="256" @bind="ajuste.Descripcion" />
                                                    <BotonIcono Icono="save" Tooltip="@L("Grabar la póliza de ajuste")" Etiqueta="@L("Grabar ajuste")" Variante="primario" Deshabilitado="guardando" OnClick="GrabarAjusteAsync" />
                                                    <BotonIcono Icono="x" Tooltip="@L("Cancelar")" OnClick="() => ajuste = null" />
                                                </div>
                                                <small class="texto-ayuda">@(l.Debito > 0 ? L("Débito del banco: Debe la cuenta elegida / Haber el banco.") : L("Crédito del banco: Debe el banco / Haber la cuenta elegida."))</small>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            <section aria-labelledby="titulo-libros">
                <h3 id="titulo-libros">@L("Movimientos en libros ({0} en tránsito)", detalle.Libros.Count(l => !l.Conciliado))</h3>
                <div class="tabla-desplazable" tabindex="0" aria-label="@L("Movimientos en libros")">
                    <table class="tabla-datos tabla-conciliacion">
                        <thead><tr><th class="col-fecha">@L("Fecha")</th><th>@L("Póliza / concepto")</th><th class="num">@L("Debe")</th><th class="num">@L("Haber")</th><th class="col-acciones">@L("Acción")</th></tr></thead>
                        <tbody>
                            @foreach (var l in detalle.Libros.Where(l => !soloPendientes || !l.Conciliado))
                            {
                                var coincide = bancoElegido is not null && !l.Conciliado
                                               && ((bancoElegido.Debito > 0 && l.Haber == bancoElegido.Debito) || (bancoElegido.Credito > 0 && l.Debe == bancoElegido.Credito));
                                <tr class="@(l.Conciliado ? "fila-conciliada" : coincide ? "fila-candidata" : "")">
                                    <td class="col-fecha">@l.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><a href="contabilidad/polizas?id=@l.AsiId">#@l.AsiId</a> @l.Descripcion<br /><span class="texto-tenue">@OrigenesPoliza.Nombre(l.Origen)@(l.Conciliado ? l.BexId is null ? L(" · marcado a mano") : L(" · conciliado") : "")</span></td>
                                    <td class="num">@(l.Debe == 0 ? "" : l.Debe.ToString("N2"))</td>
                                    <td class="num">@(l.Haber == 0 ? "" : l.Haber.ToString("N2"))</td>
                                    <td class="col-acciones">
                                        @if (enProceso)
                                        {
                                            <div class="acciones-fila">
                                                @if (coincide)
                                                {
                                                    <BotonIcono Icono="link" Tooltip="@L("Emparejar con la línea del banco elegida")" Variante="primario" OnClick="() => EmparejarAsync(l)" />
                                                }
                                                else if (!l.Conciliado)
                                                {
                                                    <BotonIcono Icono="check-circle" Tooltip="@L("Marcar como conciliado sin línea del banco (por ejemplo, ya está en el saldo inicial)")" OnClick="() => MarcarAsync(l, true)" />
                                                }
                                                else if (l.BexId is null)
                                                {
                                                    <BotonIcono Icono="x" Tooltip="@L("Quitar la marca")" OnClick="() => MarcarAsync(l, false)" />
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly string[] Meses = { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };

    private IReadOnlyList<CuentaBancaria> cuentas = Array.Empty<CuentaBancaria>();
    private IReadOnlyList<ConciliacionBancaria> conciliaciones = Array.Empty<ConciliacionBancaria>();
    private IReadOnlyList<CuentaContable> cuentasDetalle = Array.Empty<CuentaContable>();
    private ConciliacionDetalle? detalle;
    private int bcbId;
    private NuevaConciliacionModelo? nueva;
    private decimal saldoInicial;
    private decimal saldoFinal;
    private bool reemplazar = true;
    private bool soloPendientes;
    private LineaExtracto? bancoElegido;
    private AjusteModelo? ajuste;
    private List<string> erroresImportacion = new();
    private bool guardando;
    private string? mensaje;
    private bool esMensajeError;

    private sealed class NuevaConciliacionModelo
    {
        public int Anio { get; set; }
        public int Mes { get; set; }
        public decimal? SaldoInicialBanco { get; set; }
        public decimal? SaldoBanco { get; set; }
    }

    private sealed class AjusteModelo
    {
        public LineaExtracto Linea { get; set; } = new();
        public int? CtaId { get; set; }
        public string? Descripcion { get; set; }
    }

    private static string NombreMes(int mes) => L(Meses[mes - 1]);
    private static string NombreForma(string? forma) => forma switch { "A" => L("Automática"), "M" => L("Manual"), "J" => L("Ajuste"), _ => "" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuentas = await BancosRepository.ConsultarCuentasAsync(soloActivas: true);
            cuentasDetalle = (await GeneralRepository.ConsultarCuentasContablesAsync())
                .Where(c => c.CtaAceptaMovimiento && c.CtaEstado == "A" && c.CtaTipo is "G" or "I").OrderBy(c => c.CtaCodigo).ToList();
            bcbId = cuentas.FirstOrDefault()?.BcbId ?? 0;
            await CargarConciliacionesAsync(abrirPrimera: true);
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private async Task CargarConciliacionesAsync(bool abrirPrimera)
    {
        conciliaciones = bcbId == 0 ? Array.Empty<ConciliacionBancaria>() : await ConciliacionRepository.ConsultarAsync(bcbId);
        if (abrirPrimera)
        {
            var abrir = conciliaciones.FirstOrDefault(c => c.Estado == "B") ?? conciliaciones.FirstOrDefault();
            detalle = null;
            if (abrir is not null) await AbrirAsync(abrir.BcnId);
        }
    }

    private async Task CambiarCuentaAsync(ChangeEventArgs e)
    {
        mensaje = null;
        nueva = null;
        bcbId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        try { await CargarConciliacionesAsync(abrirPrimera: true); }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AbrirAsync(int bcnId)
    {
        try
        {
            detalle = await ConciliacionRepository.ConsultarDetalleAsync(bcnId);
            if (detalle is not null)
            {
                saldoInicial = detalle.Resumen.SaldoInicialBanco;
                saldoFinal = detalle.Resumen.SaldoBanco;
            }
            bancoElegido = null;
            ajuste = null;
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task RecargarAsync()
    {
        if (detalle is null) return;
        var id = detalle.Resumen.BcnId;
        await CargarConciliacionesAsync(abrirPrimera: false);
        await AbrirAsync(id);
    }

    private void NuevaConciliacion()
    {
        mensaje = null;
        var ultima = conciliaciones.OrderByDescending(c => c.Anio * 100 + c.Mes).FirstOrDefault();
        var mes = ultima is null ? DateTime.Today.AddMonths(-1) : new DateTime(ultima.Anio, ultima.Mes, 1).AddMonths(1);
        nueva = new NuevaConciliacionModelo { Anio = mes.Year, Mes = mes.Month, SaldoInicialBanco = ultima?.SaldoBanco };
    }

    private void CambiarMesNueva(ChangeEventArgs e)
    {
        if (nueva is not null && DateTime.TryParse($"{e.Value}-01", out var fecha))
        {
            nueva.Anio = fecha.Year;
            nueva.Mes = fecha.Month;
        }
    }

    private async Task CrearAsync()
    {
        if (nueva is null) return;
        guardando = true;
        try
        {
            var id = await ConciliacionRepository.CrearAsync(bcbId, nueva.Anio, nueva.Mes, nueva.SaldoInicialBanco, nueva.SaldoBanco, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Conciliación de {0} {1} creada: importe el estado de cuenta.", NombreMes(nueva.Mes), nueva.Anio));
            nueva = null;
            await CargarConciliacionesAsync(abrirPrimera: false);
            await AbrirAsync(id);
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

    private async Task GuardarSaldosAsync()
    {
        if (detalle is null) return;
        try
        {
            await ConciliacionRepository.GuardarSaldosAsync(detalle.Resumen.BcnId, saldoInicial, saldoFinal, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Saldos guardados."));
            await RecargarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task ImportarAsync(InputFileChangeEventArgs e)
    {
        if (detalle is null) return;
        erroresImportacion = new();
        mensaje = null;
        try
        {
            using var memoria = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoria);
            memoria.Position = 0;
            var leido = ExtractoBancario.Leer(memoria, e.File.Name);
            erroresImportacion = leido.Errores.ToList();
            if (leido.Lineas.Count == 0) return;
            await ConciliacionRepository.CargarExtractoAsync(detalle.Resumen.BcnId, leido.Lineas, reemplazar, await ObtenerUsuIdActualAsync());
            // Con columna Saldo se toman los saldos del archivo.
            if (leido.SaldoFinal is not null)
            {
                saldoFinal = leido.SaldoFinal.Value;
                if (detalle.Extracto.Count == 0 || reemplazar) saldoInicial = leido.SaldoInicial ?? saldoInicial;
                await ConciliacionRepository.GuardarSaldosAsync(detalle.Resumen.BcnId, saldoInicial, saldoFinal, await ObtenerUsuIdActualAsync());
            }
            var emparejadas = await ConciliacionRepository.ConciliarAutomaticoAsync(detalle.Resumen.BcnId);
            MostrarOk(L("Se importaron {0} líneas del estado de cuenta y se conciliaron {1} automáticamente.{2}", leido.Lineas.Count, emparejadas, (leido.Errores.Count > 0 ? L(" Revise las filas con error.") : "")));
            await RecargarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task ConciliarAutomaticoAsync()
    {
        if (detalle is null) return;
        try
        {
            var emparejadas = await ConciliacionRepository.ConciliarAutomaticoAsync(detalle.Resumen.BcnId);
            MostrarOk(emparejadas == 0 ? L("No se encontraron más coincidencias: empareje o marque a mano lo que falte.") : L("Se conciliaron {0} línea(s).", emparejadas));
            await RecargarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void ElegirBanco(LineaExtracto l)
    {
        mensaje = null;
        ajuste = null;
        bancoElegido = l;
        soloPendientes = true;
    }

    private async Task EmparejarAsync(LineaLibro l)
