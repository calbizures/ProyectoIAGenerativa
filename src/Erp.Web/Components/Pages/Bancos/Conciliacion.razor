    private void IniciarAjuste(LineaExtracto l)
    {
        bancoElegido = null;
        ajuste = new AjusteModelo { Linea = l, Descripcion = $"Conciliación bancaria: {l.Descripcion ?? (l.Debito > 0 ? "cargo del banco" : "crédito del banco")}" };
    }

    private async Task GrabarAjusteAsync()
    {
        if (detalle is null || ajuste is null) return;
        guardando = true;
        try
        {
            var asiId = await ConciliacionRepository.GrabarAjusteAsync(detalle.Resumen.BcnId, ajuste.Linea.BexId, ajuste.CtaId, ajuste.Descripcion, await ObtenerUsuIdActualAsync());
            MostrarOk(L("Póliza de ajuste #{0} grabada y conciliada.", asiId));
            ajuste = null;
            await RecargarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
        finally { guardando = false; }
    }

