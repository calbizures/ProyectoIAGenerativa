@page "/compras/ordenes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:COMPRAS_ORDEN,COMPRAS_ORDEN_APROBAR_BODEGA,COMPRAS_ORDEN_APROBAR,COMPRAS_ORDEN_RECIBIR")]
@using Erp.Data.Compras
@using Erp.Data.Inventario
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IOrdenCompraRepository OrdenCompraRepository
@inject ICompraRepository CompraRepository
@inject IProductoRepository ProductoRepository
@inject IProductoProveedorRepository ProductoProveedorRepository
@inject IBodegaRepository BodegaRepository
@inject Erp.Data.General.IGeneralRepository GeneralRepository
@inject ILogger<OrdenesCompra> Log

<PageTitle>@L("Órdenes de compra")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Órdenes de compra")</h1>
    <p>@L("Pedidos a proveedores. Una orden aprobada se recibe en la bodega, completa o por partes: cada recepción graba la compra con la factura del proveedor (inventario, cuenta por pagar y póliza).")</p>
</div>

<BorradorDocumento TDatos="BorradorOrden" Clave="ordenes-compra" Nombre="@L("una orden de compra")"
                   Capturar="CapturarBorrador" Describir="DescribirBorrador" Restaurar="RestaurarBorradorAsync" />

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@Textos.Mensaje(mensaje)</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-herramientas">
        <select @bind="filtroEstado" @bind:after="BuscarAsync" aria-label="@L("Estado")">
            <option value="X">@L("Por recibir")</option>
            <option value="F">@L("Pendientes de firma")</option>
            <option value="B">@L("Borradores")</option>
            <option value="V">@L("Con visto bueno de bodega")</option>
            <option value="A">@L("Aprobadas")</option>
            <option value="P">@L("Recibidas en parte")</option>
            <option value="R">@L("Recibidas")</option>
            <option value="C">@L("Cerradas")</option>
            <option value="N">@L("Anuladas")</option>
            <option value="">@L("Todas")</option>
        </select>
        <FiltroPeriodo @bind-Desde="filtroDesde" @bind-Hasta="filtroHasta" AlCambiar="BuscarAsync" />
        <input type="search" placeholder="@L("Número, proveedor o NIT")" aria-label="@L("Buscar por número, proveedor o NIT")" @bind="filtroTexto"
               @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarAsync(); })" />
        <BotonIcono Icono="search" Tooltip="@L("Buscar")" Etiqueta="@L("Buscar")" OnClick="BuscarAsync" />
        <span class="barra-herramientas-separador"></span>
        <AuthorizeView Policy="Permiso:COMPRAS_ORDEN" Context="permisoOrden">
            <BotonIcono Icono="plus" Tooltip="@L("Nueva orden de compra")" Etiqueta="@L("Nueva orden")" Variante="primario" OnClick="IniciarNueva" />
        </AuthorizeView>
    </div>

    <div class="tabla-desplazable" tabindex="0">
        <table class="tabla-datos">
            <thead>
                <tr><th class="col-codigo">@L("Número")</th><th class="col-fecha">@L("Fecha")</th><th>@L("Proveedor")</th><th class="col-fecha">@L("Entrega")</th><th class="num">@L("Recibido")</th><th class="num col-monto">@L("Total")</th><th class="col-estado">@L("Estado")</th><th class="col-acciones">@L("Acciones")</th></tr>
            </thead>
            <tbody>
                @if (!ordenes.Any())
                {
                    <tr><td colspan="8" class="doc-tabla-vacia">@L("No hay órdenes de compra con esos filtros.")</td></tr>
                }
                @foreach (var o in ordenes)
                {
                    <tr class="@(seleccionada?.OcpId == o.OcpId ? "fila-seleccionada" : "")">
                        <td class="col-codigo">@o.Numero</td>
                        <td class="col-fecha">@o.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@o.Proveedor<br /><span class="texto-tenue">@o.Bodega</span></td>
                        <td class="col-fecha">@(o.FechaEntrega?.ToString("dd/MM/yyyy") ?? "—")@if (o.Atrasada) { <br /><span class="texto-error">@L("Atrasada")</span> }</td>
                        <td class="num">@o.Recibido / @o.Ordenado</td>
                        <td class="num col-monto">@o.Simbolo @o.Total.ToString("N2")</td>
                        <td class="col-estado"><span class="estado-badge @ClaseEstado(o.Estado)">@TextoEstado(o.Estado)</span></td>
                        <td class="col-acciones">
                            <div class="acciones-fila">
                                <BotonIcono Icono="eye" Tooltip="@L("Ver la orden")" OnClick="() => AbrirAsync(o.OcpId)" />
                                <a class="boton-icono boton-icono-neutral" href="@($"compras/ordenes/{o.OcpId}/imprimir")" target="_blank" aria-label="@L("Imprimir la orden")">
                                    <Icono Nombre="printer" Tamano="17" /><span class="boton-icono-tip" aria-hidden="true">@L("Imprimir")</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (pestanaActiva == "orden")
{
    <section class="tarjeta" aria-labelledby="titulo-orden">
        <h2 id="titulo-orden">@(orden.OcpId is null ? L("Nueva orden de compra") : L("Editar {0}", numeroEditando))</h2>
        <p class="texto-ayuda">@L("Queda en borrador hasta que se aprueba; solo una orden aprobada se puede recibir. Los costos incluyen IVA, como los cotiza el proveedor.")</p>

        <div class="fel-formulario">
            <div class="campo">
                <label for="oc-proveedor">@L("Proveedor")</label>
                <select id="oc-proveedor" @bind="orden.PrvId" @bind:after="CargarProductosProveedorAsync">
                    <option value="0">@L("Seleccione…")</option>
                    @foreach (var p in proveedores)
                    {
                        <option value="@p.PrvId">@p.PrvCodigo · @p.PrvNombreComercial</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="oc-bodega">@L("Recibir en la bodega")</label>
                <select id="oc-bodega" @bind="orden.BodId">
                    <option value="0">@L("Seleccione…")</option>
                    @foreach (var b in BodegasSucursal)
                    {
                        <option value="@b.BodId">@b.SucDescripcion · @b.BodDescripcion</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label for="oc-fecha">@L("Fecha")</label>
                <input id="oc-fecha" type="date" @bind="orden.Fecha" />
            </div>
            <div class="campo">
                <label for="oc-entrega">@L("Entrega esperada")</label>
                <input id="oc-entrega" type="date" @bind="orden.FechaEntrega" />
            </div>
            <div class="campo campo-ancho">
                <label for="oc-condiciones">@L("Condiciones (forma de pago, plazo)")</label>
                <input id="oc-condiciones" maxlength="256" @bind="orden.Condiciones" />
            </div>
            <div class="campo">
                <label for="oc-flete-tipo">@L("Flete")</label>
                <select id="oc-flete-tipo" @bind="orden.FleteTipo">
                    <option value="N">@L("Sin flete (precio puesto en bodega)")</option>
                    <option value="I">@L("Incluido en la factura del proveedor")</option>
                    <option value="S">@L("Facturado aparte (transportista u otra factura)")</option>
                </select>
            </div>
            @if (orden.FleteTipo != "N")
            {
                <div class="campo">
                    <label for="oc-flete">@(orden.FleteTipo == "I" ? L("Monto del flete (IVA incl.)") : L("Flete estimado (IVA incl.)"))</label>
                    <input id="oc-flete" type="number" min="0" step="0.01" @bind="orden.Flete" />
                </div>
            }
            <div class="campo campo-ancho">
                <label for="oc-obs">@L("Observaciones")</label>
                <input id="oc-obs" maxlength="500" @bind="orden.Observaciones" />
            </div>
        </div>

        <h3>@L("Productos")</h3>
        @if (productosProveedor.Count > 0)
        {
            <div class="barra-herramientas">
                <select aria-label="@L("Productos del proveedor")" @bind="proIdProveedor">
                    <option value="0">@L("Productos de este proveedor ({0})…", productosProveedor.Count)</option>
                    @foreach (var r in productosProveedor)
                    {
                        <option value="@r.ProId">@r.ProCodigo · @r.ProDescripcion@(r.UltimoCosto is decimal u ? L(" · último costo Q {0:N2}", ConIva(u)) : "")</option>
                    }
                </select>
                <BotonIcono Icono="plus" Tooltip="@L("Agregar el producto elegido")" Etiqueta="@L("Agregar")" Deshabilitado="proIdProveedor == 0" OnClick="AgregarDelProveedor" />
            </div>
        }
        <div class="barra-herramientas">
            <input type="search" placeholder="@L("Buscar cualquier producto por código o descripción")" aria-label="@L("Buscar producto por código o descripción")" @bind="textoProducto"
                   @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarProductosAsync(); })" />
            <BotonIcono Icono="search" Tooltip="@L("Buscar producto")" Etiqueta="@L("Buscar")" OnClick="BuscarProductosAsync" />
        </div>
        @if (productosEncontrados.Count > 0)
        {
            <table class="tabla-datos tabla-compacta">
                <thead><tr><th class="col-codigo">@L("Código")</th><th>@L("Producto")</th><th class="col-acciones"><span class="sr-only">@L("Agregar")</span></th></tr></thead>
                <tbody>
                    @foreach (var p in productosEncontrados.Take(15))
                    {
                        <tr>
                            <td class="col-codigo">@p.ProCodigo</td>
                            <td>@p.ProDescripcion</td>
                            <td class="col-acciones"><BotonIcono Icono="plus" Tooltip="@L("Agregar a la orden")" OnClick="() => AgregarProducto(p.ProId, p.ProCodigo, p.ProDescripcion, null, p.ProCostoUnitario)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="tabla-desplazable" tabindex="0">
            <table class="tabla-datos">
                <thead>
                    <tr><th class="col-codigo">@L("Código")</th><th>@L("Descripción")</th><th class="num col-monto">@L("Cantidad")</th><th class="num col-monto">@L("Costo con IVA")</th><th class="num col-monto">@L("Total")</th><th class="col-acciones"><span class="sr-only">@L("Quitar")</span></th></tr>
                </thead>
                <tbody>
                    @if (lineas.Count == 0)
                    {
                        <tr><td colspan="6" class="doc-tabla-vacia">@L("Agregue los productos a pedir.")</td></tr>
                    }
                    @foreach (var l in lineas)
                    {
                        <tr>
                            <td class="col-codigo">@l.Codigo</td>
                            <td>@l.Descripcion@if (l.CodigoProveedor is not null) { <br /><span class="texto-tenue">@L("Código del proveedor: {0}", l.CodigoProveedor)</span> }</td>
                            <td class="num col-monto"><input class="entrada-numero" type="number" min="1" step="1" aria-label="@L("Cantidad")" @bind="l.Cantidad" @bind:event="oninput" /></td>
                            <td class="num col-monto"><input class="entrada-numero" type="number" min="0" step="0.01" aria-label="@L("Costo con IVA")" @bind="l.CostoUnitario" @bind:event="oninput" /></td>
                            <td class="num col-monto">@l.Total.ToString("N2")</td>
                            <td class="col-acciones"><BotonIcono Icono="trash-2" Tooltip="@L("Quitar")" Variante="peligro" OnClick="() => lineas.Remove(l)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="resumen-totales">
            <span>@L("Unidades:") <strong>@lineas.Sum(l => l.Cantidad)</strong></span>
            @if (orden.FleteTipo == "I" && orden.Flete > 0)
            {
                <span>@L("Flete:") <strong>Q @orden.Flete.ToString("N2")</strong></span>
            }
            <span>@L("IVA incluido:") <strong>Q @Math.Round(TotalOrden * porcentajeIva / (100 + porcentajeIva), 2).ToString("N2")</strong></span>
            <span>@L("Total:") <strong>Q @TotalOrden.ToString("N2")</strong></span>
        </div>

        <div class="acciones-fila">
            <BotonIcono Icono="save" Tooltip="@L("Grabar la orden en borrador")" Etiqueta="@L("Grabar borrador")" Variante="primario" Deshabilitado="lineas.Count == 0" OnClick="GrabarAsync" />
            <BotonIcono Icono="x" Tooltip="@L("Cancelar")" Etiqueta="@L("Cancelar")" OnClick="CancelarFormulario" />
        </div>
    </section>
}
else if (pestanaActiva == "detalle" && seleccionada is not null)
{
    var o = seleccionada;
    <section class="tarjeta" aria-labelledby="titulo-detalle">
        <div class="maestro-detalle-encabezado">
            <h2 id="titulo-detalle">@L("Orden de compra {0}", o.Numero)</h2>
            <span class="estado-badge @ClaseEstado(o.Estado)">@TextoEstado(o.Estado)</span>
        </div>
        @if (o.Estado == "B")
        {
            <p class="doc-nota" role="status"><Icono Nombre="info" Tamano="15" /><span>@L("Borrador: se puede editar. Necesita el visto bueno del jefe de bodega y la aprobación del contador general antes de enviarla al proveedor y recibir la mercadería.")</span></p>
            @if (!string.IsNullOrWhiteSpace(o.MotivoDevolucion))
            {
                <p class="doc-nota doc-nota-aviso" role="status"><Icono Nombre="alert-triangle" Tamano="15" /><span>@L("Devuelta para corregir: {0}", o.MotivoDevolucion)</span></p>
            }
        }
        else if (o.Estado == "V")
        {
            <p class="doc-nota" role="status"><Icono Nombre="info" Tamano="15" /><span>@L("Visto bueno de bodega: {0} ({1}). Falta la aprobación del contador general, que debe darla otro usuario.", o.VistoBueno, o.FechaVistoBueno?.ToString("dd/MM/yyyy HH:mm"))</span></p>
        }
        else if (o.Estado is "C" or "N")
        {
            <p class="doc-nota doc-nota-aviso" role="status"><Icono Nombre="ban" Tamano="15" /><span>@(o.Estado == "C" ? L("Cerrada") : L("Anulada")): @o.MotivoCierre</span></p>
        }
        else if (o.FechaEntrega < DateTime.Today && o.PorRecibir)
        {
            <p class="doc-nota doc-nota-aviso" role="status"><Icono Nombre="alert-triangle" Tamano="15" /><span>@L("La entrega se esperaba el {0} y todavía hay producto pendiente.", o.FechaEntrega?.ToString("dd/MM/yyyy"))</span></p>
        }

        <div class="resumen-totales">
            <span>@L("Proveedor:") <strong>@o.Proveedor</strong>@(string.IsNullOrWhiteSpace(o.Nit) ? "" : L(" · NIT {0}", o.Nit))</span>
            <span>@L("Fecha:") <strong>@o.Fecha.ToString("dd/MM/yyyy")</strong></span>
            <span>@L("Entrega:") <strong>@(o.FechaEntrega?.ToString("dd/MM/yyyy") ?? "—")</strong></span>
            <span>@L("Bodega:") <strong>@o.Bodega</strong></span>
            @if (o.VistoBueno is not null) { <span>@L("Visto bueno de bodega:") <strong>@o.VistoBueno</strong> (@o.FechaVistoBueno?.ToString("dd/MM/yyyy HH:mm"))</span> }
            @if (o.Aprobo is not null) { <span>@L("Aprobó (contador general):") <strong>@o.Aprobo</strong> (@o.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm"))</span> }
        </div>

        <div class="tabla-desplazable" tabindex="0">
            <table class="tabla-datos">
                <thead><tr><th class="num">#</th><th>@L("Producto")</th><th class="num">@L("Pedido")</th><th class="num">@L("Recibido")</th><th class="num">@L("Pendiente")</th><th class="num col-monto">@L("Costo con IVA")</th><th class="num col-monto">@L("Total")</th><th class="num">@L("Existencia hoy")</th></tr></thead>
                <tbody>
                    @foreach (var l in lineasDetalle)
                    {
                        <tr>
                            <td class="num">@l.Item</td>
                            <td>@l.Descripcion<br /><span class="texto-tenue">@l.Codigo@(l.CodigoProveedor is null ? "" : L(" · proveedor {0}", l.CodigoProveedor))</span></td>
                            <td class="num">@l.Cantidad</td>
                            <td class="num">@l.Recibido</td>
                            <td class="num">@(l.Pendiente > 0 && o.PorRecibir ? l.Pendiente.ToString() : "—")</td>
                            <td class="num col-monto">@l.CostoUnitario.ToString("N2")</td>
                            <td class="num col-monto">@l.Total.ToString("N2")</td>
                            <td class="num">@((l.Existencia ?? 0).ToString("#,##0"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="resumen-totales">
            <span>@L("Avance:") <strong>@L("{0} de {1} unidades", o.Recibido, o.Ordenado)</strong></span>
            @if (o.FleteTipo == "I")
            {
                <span>@L("Flete:") <strong>@o.Simbolo @o.Flete.ToString("N2")</strong></span>
            }
            <span>@L("IVA incluido:") <strong>@o.Simbolo @o.IvaIncluido.ToString("N2")</strong></span>
            <span>@L("Total:") <strong>@o.Simbolo @o.Total.ToString("N2")</strong></span>
        </div>
        @if (o.FleteTipo == "S")
        {
            <p class="texto-ayuda">@L("Flete facturado aparte (transportista u otra factura), estimado {0} {1}: se carga al costo al grabar esa factura en Compras.", o.Simbolo, o.Flete.ToString("N2"))</p>
        }
        else if (o.FleteTipo == "I" && o.FleteRecibido > 0)
        {
            <p class="texto-ayuda">@L("Flete ya facturado en las recepciones: {0} {1}.", o.Simbolo, o.FleteRecibido.ToString("N2"))</p>
        }
        @if (!string.IsNullOrWhiteSpace(o.Condiciones)) { <p class="texto-ayuda">@L("Condiciones: {0}", o.Condiciones)</p> }
        @if (!string.IsNullOrWhiteSpace(o.Observaciones)) { <p class="texto-ayuda">@L("Observaciones: {0}", o.Observaciones)</p> }

        <div class="acciones-fila">
            <a class="boton-icono boton-icono-neutral boton-icono-con-etiqueta" href="@($"compras/ordenes/{o.OcpId}/imprimir")" target="_blank">
                <Icono Nombre="printer" Tamano="17" /><span class="boton-icono-etiqueta">@L("Imprimir")</span>
            </a>
            @if (o.Estado == "B")
            {
                <AuthorizeView Policy="Permiso:COMPRAS_ORDEN" Context="permisoEditar">
                    <BotonIcono Icono="pencil" Tooltip="@L("Editar el borrador")" Etiqueta="@L("Editar")" OnClick="EditarAsync" />
                </AuthorizeView>
                <AuthorizeView Policy="Permiso:COMPRAS_ORDEN_APROBAR_BODEGA" Context="permisoVistoBueno">
                    <BotonIcono Icono="check-circle" Tooltip="@L("Primera firma: visto bueno del jefe de bodega")" Etiqueta="@L("Visto bueno de bodega")" Variante="primario"
                                Confirmacion="@L("¿Dar el visto bueno? La orden ya no se podrá editar.")" OnClick="AprobarBodegaAsync" />
                </AuthorizeView>
            }
            @if (o.Estado == "V")
            {
                <AuthorizeView Policy="Permiso:COMPRAS_ORDEN_APROBAR" Context="permisoAprobar">
                    <BotonIcono Icono="check-circle" Tooltip="@L("Segunda firma: aprobación del contador general")" Etiqueta="@L("Aprobar")" Variante="primario"
                                Confirmacion="@L("¿Aprobar la orden de compra?")" OnClick="AprobarAsync" />
                </AuthorizeView>
            }
            @if (o.PorRecibir && !mostrarRecepcion)
            {
                <AuthorizeView Policy="Permiso:COMPRAS_ORDEN_RECIBIR" Context="permisoRecibir">
                    <BotonIcono Icono="truck" Tooltip="@L("Recibir la mercadería con la factura del proveedor")" Etiqueta="@L("Recibir mercadería")" Variante="primario" OnClick="IniciarRecepcion" />
                </AuthorizeView>
            }
        </div>

        @if (mostrarRecepcion && o.PorRecibir)
        {
            <RecibirOrdenCompra Orden="o" Lineas="lineasDetalle" OnGrabada="RecepcionGrabadaAsync" OnCancelar="() => mostrarRecepcion = false" />
        }

        @if (recepciones.Count > 0)
        {
            <h3>@L("Recepciones")</h3>
            <table class="tabla-datos tabla-compacta">
                <thead><tr><th class="col-fecha">@L("Fecha")</th><th>@L("Factura del proveedor")</th><th class="num">@L("Unidades")</th><th class="num col-monto">@L("Total")</th><th class="col-estado">@L("Compra")</th><th>@L("Usuario")</th></tr></thead>
                <tbody>
                    @foreach (var r in recepciones)
                    {
                        <tr class="@(r.EstadoCompra == "A" ? "fila-anulada" : "")">
                            <td class="col-fecha">@r.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@r.Documento</td>
                            <td class="num">@r.Unidades</td>
                            <td class="num col-monto">@r.Total.ToString("N2")</td>
                            <td class="col-estado"><span class="estado-badge @(r.EstadoCompra == "A" ? "estado-badge-anulada" : "estado-badge-grabada")">@(r.EstadoCompra == "A" ? L("Anulada") : L("Grabada"))</span></td>
                            <td>@r.Usuario</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (recepciones.Any(r => r.EstadoCompra == "A"))
            {
                <p class="texto-ayuda">@L("Lo recibido en una compra anulada vuelve a quedar pendiente.")</p>
            }
        }

        @if (o.Estado == "V")
        {
            <AuthorizeView Policy="Permiso:COMPRAS_ORDEN_APROBAR_BODEGA,COMPRAS_ORDEN_APROBAR" Context="permisoDevolver">
                <div class="fila-edicion">
                    <label for="oc-devolver">@L("Devolver a borrador para corregir")</label>
                    <input id="oc-devolver" maxlength="256" placeholder="@L("Qué debe corregirse")" @bind="motivoDevolucion" @bind:event="oninput" />
                    <BotonIcono Icono="rotate-ccw" Tooltip="@L("Devolver la orden al bodeguero")" Etiqueta="@L("Devolver")" Deshabilitado="motivoDevolucion.Trim().Length < 3"
                                Confirmacion="@L("¿Devolver la orden a borrador? Se borra el visto bueno.")" OnClick="DevolverAsync" />
                </div>
            </AuthorizeView>
        }

        @if (o.Estado is "B" or "V" or "A" or "P")
        {
            <AuthorizeView Policy="Permiso:COMPRAS_ORDEN" Context="permisoAnular">
                <div class="fila-edicion">
                    <label for="oc-motivo">@(o.Estado == "P" ? L("Cerrar la orden (cancelar lo pendiente)") : L("Anular la orden"))</label>
                    <input id="oc-motivo" maxlength="256" placeholder="@L("Motivo")" @bind="motivo" @bind:event="oninput" />
                    @if (o.Estado == "P")
                    {
                        <BotonIcono Icono="ban" Tooltip="@L("Cerrar: lo pendiente ya no se espera")" Etiqueta="@L("Cerrar")" Variante="peligro" Deshabilitado="motivo.Trim().Length < 3"
                                    Confirmacion="@L("¿Cerrar la orden? Lo pendiente ya no se recibirá.")" OnClick="CerrarAsync" />
                    }
                    else
                    {
                        <BotonIcono Icono="ban" Tooltip="@L("Anular la orden")" Etiqueta="@L("Anular")" Variante="peligro" Deshabilitado="motivo.Trim().Length < 3"
                                    Confirmacion="@L("¿Anular la orden de compra?")" OnClick="AnularAsync" />
                    }
                </div>
            </AuthorizeView>
        }
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // ?id=N abre una orden (por ejemplo, las que genera el punto de reorden).
    [SupplyParameterFromQuery(Name = "id")]
    public int? OrdenId { get; set; }

    private sealed class LineaOrden
    {
        public int ProId { get; set; }
        public string Codigo { get; set; } = "";
        public string? CodigoProveedor { get; set; }
        public string Descripcion { get; set; } = "";
        public int Cantidad { get; set; } = 1;
        public decimal CostoUnitario { get; set; }
        public decimal Total => Math.Round(Cantidad * CostoUnitario, 2);
    }

    private IReadOnlyList<OrdenCompraResumen> ordenes = Array.Empty<OrdenCompraResumen>();
    private OrdenCompraEncabezado? seleccionada;
    private IReadOnlyList<OrdenCompraLinea> lineasDetalle = Array.Empty<OrdenCompraLinea>();
    private IReadOnlyList<OrdenCompraRecepcion> recepciones = Array.Empty<OrdenCompraRecepcion>();
    private IReadOnlyList<Proveedor> proveedores = Array.Empty<Proveedor>();
    private IReadOnlyList<Bodega> bodegas = Array.Empty<Bodega>();
    private IReadOnlyList<ProductoProveedor> productosProveedor = Array.Empty<ProductoProveedor>();
    private IReadOnlyList<Producto> productosEncontrados = Array.Empty<Producto>();
    private readonly List<LineaOrden> lineas = new();
    private NuevaOrdenCompra orden = new();
    private bool mostrarRecepcion;
    private string? numeroEditando;
    private int proIdProveedor;

    private string pestanaActiva = "lista";
    private string filtroEstado = "X";
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string filtroTexto = "";
    private string textoProducto = "";
    private string motivo = "";
    private decimal porcentajeIva = 12m;
    private int? sucIdSesion;
    // Se recibe en una bodega de la sucursal con la que se entró (al editar, también la que ya tenía la orden).
    private IEnumerable<Bodega> BodegasSucursal => sucIdSesion is null ? bodegas
        : bodegas.Where(b => b.SucId == sucIdSesion || b.BodId == orden.BodId).OrderBy(b => b.BodCodigo);
    private string? mensaje;
    private bool esMensajeError;

    // El flete incluido en la factura del proveedor suma al total de la orden.
    private decimal TotalOrden => lineas.Sum(l => l.Total) + (orden.FleteTipo == "I" ? orden.Flete : 0);
    private decimal ConIva(decimal sinIva) => Math.Round(sinIva * (1 + porcentajeIva / 100m), 2);

    private IReadOnlyList<PestanaItem> Pestanas
    {
        get
        {
            var lista = new List<PestanaItem> { new("lista", L("Órdenes")) };
            if (seleccionada is not null) lista.Add(new("detalle", seleccionada.Numero));
            if (pestanaActiva == "orden") lista.Add(new("orden", orden.OcpId is null ? L("Nueva orden") : L("Editar")));
            return lista;
        }
    }

    private static string ClaseEstado(string estado) => estado switch
    {
        "B" => "estado-badge-pendiente",
        "V" => "estado-badge-pendiente",
        "A" => "estado-badge-activo",
        "P" => "estado-badge-pendiente",
        "R" => "estado-badge-grabada",
        "N" => "estado-badge-anulada",
        _ => "estado-badge-inactivo"
    };

    private static string TextoEstado(string estado) => estado switch
    {
        "B" => L("Borrador"),
        "V" => L("Visto bueno de bodega"),
        "A" => L("Aprobada"),
        "P" => L("Recibida en parte"),
        "R" => L("Recibida"),
        "C" => L("Cerrada"),
        "N" => L("Anulada"),
        _ => estado
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sucIdSesion = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerSucId();
            porcentajeIva = (await GeneralRepository.ConsultarParametrosAsync(sucIdSesion)).CiaPorcIva;
            proveedores = await CompraRepository.ConsultarProveedoresAsync(null, "A");
            bodegas = await BodegaRepository.ConsultarAsync(sucId: null, estado: "A");
            if (OrdenId is int id)
            {
                filtroEstado = "";
                await BuscarAsync();
                await AbrirAsync(id);
            }
            else
                await BuscarAsync();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task<int?> ObtenerUsuIdActualAsync() =>
        AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User.ObtenerUsuId();

    private void MostrarError(Exception ex)
    {
        mensaje = MensajesError.Traducir(ex);
        esMensajeError = true;
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        esMensajeError = true;
    }

    private void MostrarOk(string texto)
    {
        mensaje = texto;
        esMensajeError = false;
    }

    private async Task BuscarAsync()
    {
        try
        {
            ordenes = await OrdenCompraRepository.ConsultarAsync(filtroEstado, null, filtroDesde, filtroHasta,
                string.IsNullOrWhiteSpace(filtroTexto) ? null : filtroTexto.Trim());
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarNueva()
    {
        mensaje = null;
        orden = new NuevaOrdenCompra
        {
            Fecha = DateTime.Today,
            FechaEntrega = DateTime.Today.AddDays(7),
            BodId = bodegas.Where(b => b.SucId == sucIdSesion || sucIdSesion == null).OrderBy(b => b.BodCodigo).FirstOrDefault()?.BodId ?? 0
        };
        numeroEditando = null;
        lineas.Clear();
        productosProveedor = Array.Empty<ProductoProveedor>();
        productosEncontrados = Array.Empty<Producto>();
        proIdProveedor = 0;
        pestanaActiva = "orden";
    }

    private async Task EditarAsync()
    {
        if (seleccionada is null) return;
        var o = seleccionada;
        mensaje = null;
        orden = new NuevaOrdenCompra
        {
            OcpId = o.OcpId,
            Fecha = o.Fecha,
            FechaEntrega = o.FechaEntrega,
            PrvId = o.PrvId,
            BodId = o.BodId,
            MonId = o.MonId,
            Condiciones = o.Condiciones,
            Observaciones = o.Observaciones,
            FleteTipo = o.FleteTipo,
            Flete = o.Flete
        };
        numeroEditando = o.Numero;
        lineas.Clear();
        lineas.AddRange(lineasDetalle.Select(l => new LineaOrden
        {
            ProId = l.ProId,
            Codigo = l.Codigo,
            CodigoProveedor = l.CodigoProveedor,
            Descripcion = l.Descripcion,
            Cantidad = l.Cantidad,
            CostoUnitario = l.CostoUnitario
        }));
        productosEncontrados = Array.Empty<Producto>();
        await CargarProductosProveedorAsync();
        pestanaActiva = "orden";
        edicionOriginal = System.Text.Json.JsonSerializer.Serialize(CapturarBorrador());
    }

    private void CancelarFormulario()
    {
        lineas.Clear();
        pestanaActiva = seleccionada is null ? "lista" : "detalle";
    }

    private async Task CargarProductosProveedorAsync()
    {
        proIdProveedor = 0;
        if (orden.PrvId == 0) { productosProveedor = Array.Empty<ProductoProveedor>(); return; }
        try
        {
            productosProveedor = (await ProductoProveedorRepository.ConsultarAsync(orden.PrvId, null))
                .Where(r => r.ProTipoItem == "B" && r.ProEstado == "A").OrderByDescending(r => r.Preferido).ThenBy(r => r.ProDescripcion).ToList();
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void AgregarDelProveedor()
    {
        var r = productosProveedor.FirstOrDefault(p => p.ProId == proIdProveedor);
        if (r is null) return;
        AgregarProducto(r.ProId, r.ProCodigo, r.ProDescripcion, r.CodigoProveedor, r.UltimoCosto ?? r.ProCostoUnitario);
        proIdProveedor = 0;
    }

    // costoSinIva: último costo con el proveedor o costo promedio; se propone con IVA.
    private void AgregarProducto(int proId, string codigo, string descripcion, string? codigoProveedor, decimal costoSinIva)
    {
        var existente = lineas.FirstOrDefault(l => l.ProId == proId);
        if (existente is not null) existente.Cantidad += 1;
        else
            lineas.Add(new LineaOrden
            {
                ProId = proId,
                Codigo = codigo,
                CodigoProveedor = codigoProveedor ?? productosProveedor.FirstOrDefault(p => p.ProId == proId)?.CodigoProveedor,
                Descripcion = descripcion,
                CostoUnitario = ConIva(costoSinIva)
            });
        productosEncontrados = Array.Empty<Producto>();
        textoProducto = "";
        mensaje = null;
    }

    private async Task BuscarProductosAsync()
    {
        var texto = textoProducto.Trim();
        if (texto.Length == 0) return;
        try
        {
            var porCodigo = await ProductoRepository.ConsultarAsync(texto, null, prtId: null, estado: "A", pagina: 1, tamanioPagina: 20);
            var porDescripcion = await ProductoRepository.ConsultarAsync(null, texto, prtId: null, estado: "A", pagina: 1, tamanioPagina: 20);
            productosEncontrados = porCodigo.Concat(porDescripcion).DistinctBy(p => p.ProId).Where(p => p.ProTipoItem == "B").Take(20).ToList();
            var exacto = productosEncontrados.FirstOrDefault(p => p.ProCodigo.Equals(texto, StringComparison.OrdinalIgnoreCase));
            if (exacto is not null)
            {
                var relacion = productosProveedor.FirstOrDefault(r => r.ProId == exacto.ProId);
                AgregarProducto(exacto.ProId, exacto.ProCodigo, exacto.ProDescripcion, relacion?.CodigoProveedor, relacion?.UltimoCosto ?? exacto.ProCostoUnitario);
            }
            else if (productosEncontrados.Count == 0) MostrarError(L("No se encontraron productos con ese texto."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task GrabarAsync()
    {
        if (orden.PrvId == 0) { MostrarError(L("Elija el proveedor.")); return; }
        if (orden.BodId == 0) { MostrarError(L("Elija la bodega donde se recibirá.")); return; }
        var sinCosto = lineas.FirstOrDefault(l => l.Cantidad <= 0 || l.CostoUnitario <= 0);
        if (sinCosto is not null) { MostrarError(L("Indique la cantidad y el costo de {0}.", sinCosto.Descripcion)); return; }
        if (orden.FechaEntrega < orden.Fecha) { MostrarError(L("La entrega no puede ser antes de la fecha de la orden.")); return; }
        try
        {
            var (ocpId, numero) = await OrdenCompraRepository.GuardarAsync(orden,
                lineas.Select(l => new NuevaLineaOrdenCompra { ProId = l.ProId, Cantidad = l.Cantidad, CostoUnitario = l.CostoUnitario }).ToList(),
                await ObtenerUsuIdActualAsync());
            lineas.Clear();
            filtroEstado = "B";
            await BuscarAsync();
            await AbrirAsync(ocpId);
            MostrarOk(L("Orden {0} grabada en borrador. Apruébela para enviarla al proveedor.", numero));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    // ---- Borrador: la orden en captura se conserva al salir de la pantalla ----
    private sealed record BorradorOrden(NuevaOrdenCompra Orden, string? NumeroEditando, IReadOnlyList<LineaOrden> Lineas);

    // Al editar una orden, lo que tenía al abrirla: sin cambios no hay borrador.
    private string? edicionOriginal;

    private BorradorOrden? CapturarBorrador()
    {
        if (pestanaActiva != "orden") return null;
        if (lineas.Count == 0 && orden.PrvId == 0) return null;
        var borrador = new BorradorOrden(orden, numeroEditando, lineas);
        if (orden.OcpId is not null && edicionOriginal is not null && System.Text.Json.JsonSerializer.Serialize(borrador) == edicionOriginal)
            return null;
        return borrador;
    }

    private string DescribirBorrador(BorradorOrden b)
    {
        var proveedor = proveedores.FirstOrDefault(p => p.PrvId == b.Orden.PrvId)?.PrvNombreComercial ?? L("sin proveedor");
        var cual = b.NumeroEditando is null ? "" : L("cambios a la {0}, ", b.NumeroEditando);
        return $"{cual}{proveedor}, {b.Lineas.Count} {(b.Lineas.Count == 1 ? "producto" : "productos")}, Q {b.Lineas.Sum(l => l.Total):N2}";
    }

    private async Task RestaurarBorradorAsync(BorradorOrden b)
    {
        IniciarNueva();
        orden = b.Orden;
        if (!bodegas.Any(x => x.BodId == orden.BodId)) orden.BodId = bodegas.FirstOrDefault()?.BodId ?? 0;
        numeroEditando = b.NumeroEditando;
        lineas.AddRange(b.Lineas);
        await CargarProductosProveedorAsync();
        edicionOriginal = null;
        MostrarOk(b.NumeroEditando is null
            ? L("Se recuperó la orden sin terminar. Revise los costos antes de grabar.")
            : L("Se recuperaron los cambios sin grabar de la orden {0}. Solo se graban si la orden sigue en borrador.", b.NumeroEditando));
    }

    private async Task AbrirAsync(int ocpId)
    {
        try
        {
            (seleccionada, lineasDetalle, recepciones) = await OrdenCompraRepository.ConsultarPorIdAsync(ocpId);
            motivo = "";
            mostrarRecepcion = false;
            mensaje = null;
            pestanaActiva = seleccionada is null ? "lista" : "detalle";
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task RefrescarAsync(string texto)
    {
        if (seleccionada is null) return;
        var id = seleccionada.OcpId;
        await BuscarAsync();
        await AbrirAsync(id);
        MostrarOk(texto);
    }

    private async Task AprobarBodegaAsync()
    {
        if (seleccionada is null) return;
        try
        {
            await OrdenCompraRepository.AprobarBodegaAsync(seleccionada.OcpId, await ObtenerUsuIdActualAsync());
            await RefrescarAsync(L("Orden {0} con visto bueno de bodega. Falta la aprobación del contador general.", seleccionada.Numero));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AprobarAsync()
    {
        if (seleccionada is null) return;
        try
        {
            await OrdenCompraRepository.AprobarAsync(seleccionada.OcpId, await ObtenerUsuIdActualAsync());
            await RefrescarAsync(L("Orden {0} aprobada con las dos firmas. Ya se puede imprimir para el proveedor y recibir.", seleccionada.Numero));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private string motivoDevolucion = "";

    private async Task DevolverAsync()
    {
        if (seleccionada is null) return;
        try
        {
            await OrdenCompraRepository.DevolverAsync(seleccionada.OcpId, motivoDevolucion.Trim(), await ObtenerUsuIdActualAsync());
            motivoDevolucion = "";
            await RefrescarAsync(L("Orden {0} devuelta a borrador para corregir.", seleccionada.Numero));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task AnularAsync()
    {
        if (seleccionada is null) return;
        try
        {
            await OrdenCompraRepository.AnularAsync(seleccionada.OcpId, motivo.Trim(), await ObtenerUsuIdActualAsync());
            await RefrescarAsync(L("Orden anulada."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private async Task CerrarAsync()
    {
        if (seleccionada is null) return;
        try
        {
            await OrdenCompraRepository.CerrarAsync(seleccionada.OcpId, motivo.Trim(), await ObtenerUsuIdActualAsync());
            await RefrescarAsync(L("Orden cerrada: lo pendiente ya no se espera."));
        }
        catch (Exception ex) { MostrarError(ex); }
    }

    private void IniciarRecepcion()
    {
        mensaje = null;
        mostrarRecepcion = true;
    }

    private async Task RecepcionGrabadaAsync((string Mensaje, int EncId) resultado) => await RefrescarAsync(resultado.Mensaje);

}
