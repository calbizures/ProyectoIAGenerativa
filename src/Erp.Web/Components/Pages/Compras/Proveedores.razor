@page "/proveedores"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:COMPRAS_DOCUMENTO_CREAR")]
@using System.ComponentModel.DataAnnotations
@using Erp.Data.Compras
@using Erp.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject IProveedorRepository ProveedorRepository
@inject Erp.Data.Pagos.IPagosRepository PagosRepository
@inject Erp.Data.General.IGeneralRepository GeneralRepository

<PageTitle>Proveedores</PageTitle>

<div class="pagina-encabezado">
    <h1>Proveedores</h1>
    <p>Mantenimiento de proveedores.</p>
</div>

@if (mensaje is not null)
{
    <p class="@(esMensajeError ? "mensaje-error" : "mensaje-ok")" role="@(esMensajeError ? "alert" : "status")">@mensaje</p>
}

<BarraPestanas Pestanas="Pestanas" @bind-PestanaActiva="pestanaActiva" />

@if (pestanaActiva == "lista")
{
    <div class="barra-herramientas">
        <input placeholder="Buscar por código, nombre o NIT" aria-label="Buscar por código, nombre o NIT" @bind="textoBusqueda" type="search" @onkeyup="@(async e => { if (e.Key == "Enter") await BuscarAsync(); })" />
        <select @bind="filtroEstado" aria-label="Estado">
            <option value="A">Activos</option>
            <option value="I">Inactivos</option>
            <option value="">Todos</option>
        </select>
        <BotonIcono Icono="search" Tooltip="Buscar" Etiqueta="Buscar" OnClick="BuscarAsync" />
        <span class="barra-herramientas-separador"></span>
        <BotonIcono Icono="plus" Tooltip="Nuevo proveedor" Etiqueta="Nuevo proveedor" Variante="primario" OnClick="MostrarFormularioNuevo" />
    </div>

    @if (mostrarNuevo)
    {
        <EditForm Model="nuevoProveedor" OnValidSubmit="CrearProveedorAsync" class="panel-formulario">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label for="proveedores-proveedor-codigo">Código</label><InputText id="proveedores-proveedor-codigo" @bind-Value="nuevoProveedor.Codigo" /></div>
            <div class="campo"><label for="proveedores-proveedor-nombrecomercial">Nombre comercial</label><InputText id="proveedores-proveedor-nombrecomercial" @bind-Value="nuevoProveedor.NombreComercial" /></div>
            <div class="campo"><label for="proveedores-proveedor-nit">NIT</label><InputText id="proveedores-proveedor-nit" @bind-Value="nuevoProveedor.Nit" /></div>
            <div class="campo"><label for="proveedores-proveedor-contacto">Contacto</label><InputText id="proveedores-proveedor-contacto" @bind-Value="nuevoProveedor.Contacto" /></div>
            <div class="campo"><label for="proveedores-proveedor-telefonooficina">Teléfono oficina</label><InputText id="proveedores-proveedor-telefonooficina" @bind-Value="nuevoProveedor.TelefonoOficina" /></div>
            <div class="campo"><label for="proveedores-proveedor-direccion">Dirección</label><InputText id="proveedores-proveedor-direccion" @bind-Value="nuevoProveedor.Direccion" /></div>
            <div class="campo"><label for="proveedores-proveedor-emailempresa">Email empresa</label><InputText id="proveedores-proveedor-emailempresa" @bind-Value="nuevoProveedor.EmailEmpresa" /></div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Guardar" Etiqueta="Guardar" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => mostrarNuevo = false" />
            </div>
        </EditForm>
    }

    <table class="tabla-datos">
        <thead>
            <tr><th class="col-codigo">Código</th><th>Nombre comercial</th><th class="col-codigo">NIT</th><th>Contacto</th><th class="col-estado">Estado</th><th class="col-acciones">Acciones</th></tr>
        </thead>
        <tbody>
            @if (!proveedores.Any())
            {
                <tr><td colspan="6" class="doc-tabla-vacia">Ningún proveedor coincide con la búsqueda.</td></tr>
            }
            @foreach (var p in proveedores)
            {
                <tr class="@(seleccionado?.PrvId == p.PrvId ? "fila-seleccionada" : "")">
                    <td class="col-codigo">@p.PrvCodigo</td>
                    <td>@p.PrvNombreComercial</td>
                    <td class="col-codigo">@p.PrvNit</td>
                    <td>@p.PrvContacto</td>
                    <td class="col-estado"><span class="estado-badge @(p.PrvEstado == "A" ? "estado-badge-activo" : "estado-badge-inactivo")">@(p.PrvEstado == "A" ? "Activo" : "Inactivo")</span></td>
                    <td class="col-acciones">
                        <div class="acciones-fila">
                            <BotonIcono Icono="eye" Tooltip="Ver detalle" OnClick="() => SeleccionarAsync(p)" />
                            <a class="boton-icono boton-icono-neutral" href="compras/productos-proveedor?prv=@p.PrvId" aria-label="Productos del proveedor">
                                <Icono Nombre="package" Tamano="17" /><span class="boton-icono-tip" aria-hidden="true">Productos del proveedor</span>
                            </a>
                            @if (p.PrvEstado == "A")
                            {
                                <BotonIcono Icono="trash-2" Tooltip="Desactivar proveedor" Confirmacion="¿Desactivar el proveedor?" Variante="peligro" OnClick="() => DesactivarAsync(p)" />
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (pestanaActiva == "detalle" && seleccionado is not null)
{
    <div class="panel-detalle">
        <h2>Detalle: @seleccionado.PrvNombreComercial</h2>
        <div class="campo"><label>Nombre comercial</label><span class="valor-detalle">@seleccionado.PrvNombreComercial</span></div>
        <div class="campo"><label>NIT</label><span class="valor-detalle">@seleccionado.PrvNit</span></div>
        <div class="campo"><label>Contacto</label><span class="valor-detalle">@seleccionado.PrvContacto</span></div>
        <div class="campo"><label>Teléfono oficina</label><span class="valor-detalle">@seleccionado.PrvTelefonoOficina</span></div>
        <div class="campo"><label>Email empresa</label><span class="valor-detalle">@seleccionado.PrvEmailEmpresa</span></div>
        <div class="acciones-fila">
            <BotonIcono Icono="pencil" Tooltip="Editar" Etiqueta="Editar" OnClick="IniciarEdicion" />
        </div>

        <h3 id="titulo-datos-pago">Datos de pago</h3>
        @if (pagoEdicion is null)
        {
            <div class="campo"><label>Forma de pago</label><span class="valor-detalle">@(datosPago?.FormaPago == "T" ? "Transferencia" : "Cheque")</span></div>
            <div class="campo"><label>Banco</label><span class="valor-detalle">@(datosPago?.Banco ?? "—")</span></div>
            <div class="campo"><label>Cuenta</label><span class="valor-detalle">@(datosPago?.NumeroCuenta is null ? "—" : $"{(datosPago.TipoCuenta == "A" ? "Ahorro" : "Monetaria")} {datosPago.NumeroCuenta}")</span></div>
            <div class="campo"><label>A nombre de</label><span class="valor-detalle">@(datosPago?.Titular ?? seleccionado.PrvNombreComercial)</span></div>
            <div class="acciones-fila">
                <BotonIcono Icono="pencil" Tooltip="Editar los datos de pago" Etiqueta="Editar datos de pago" OnClick="IniciarEdicionPago" />
            </div>
        }
        else
        {
            <div class="panel-formulario">
                <div class="campo">
                    <label for="prv-forma-pago">Forma de pago</label>
                    <select id="prv-forma-pago" @bind="pagoEdicion.FormaPago">
                        <option value="C">Cheque</option>
                        <option value="T">Transferencia</option>
                    </select>
                </div>
                <div class="campo">
                    <label for="prv-banco">Banco</label>
                    <select id="prv-banco" value="@(pagoEdicion.GefId?.ToString() ?? "")" @onchange="e => pagoEdicion.GefId = int.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">(Ninguno)</option>
                        @foreach (var b in bancos)
                        {
                            <option value="@b.GefId">@b.GefDescripcion</option>
                        }
                    </select>
                </div>
                <div class="campo">
                    <label for="prv-tipo-cuenta">Tipo de cuenta</label>
                    <select id="prv-tipo-cuenta" value="@(pagoEdicion.TipoCuenta ?? "")" @onchange="e => pagoEdicion.TipoCuenta = e.Value?.ToString() is { Length: > 0 } v ? v : null">
                        <option value="">(Ninguno)</option>
                        <option value="M">Monetaria</option>
                        <option value="A">Ahorro</option>
                    </select>
                </div>
                <div class="campo"><label for="prv-cuenta">Número de cuenta</label><input id="prv-cuenta" maxlength="30" inputmode="numeric" @bind="pagoEdicion.NumeroCuenta" /></div>
                <div class="campo"><label for="prv-titular">Nombre de la cuenta</label><input id="prv-titular" maxlength="150" placeholder="Si difiere del nombre comercial" @bind="pagoEdicion.Titular" /></div>
                <p class="texto-ayuda">Para pagar por transferencia se necesitan el banco, el tipo y el número de cuenta. La forma de pago se propone al emitir la contraseña.</p>
                <div class="acciones-fila">
                    <BotonIcono Icono="save" Tooltip="Guardar los datos de pago" Etiqueta="Guardar" Variante="primario" OnClick="GuardarPagoAsync" />
                    <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="() => pagoEdicion = null" />
                </div>
            </div>
        }
    </div>
}
else if (pestanaActiva == "editar" && seleccionado is not null)
{
    <div class="panel-formulario">
        <h2>Editar: @seleccionado.PrvNombreComercial</h2>
        <EditForm Model="edicionProveedor" OnValidSubmit="GuardarEdicionAsync">
            <DataAnnotationsValidator />
            <ResumenValidacion />
            <div class="campo"><label for="proveedores-edicionproveedor-nombrecomercial">Nombre comercial</label><InputText id="proveedores-edicionproveedor-nombrecomercial" @bind-Value="edicionProveedor.NombreComercial" /></div>
            <div class="campo"><label for="proveedores-edicionproveedor-nit">NIT</label><InputText id="proveedores-edicionproveedor-nit" @bind-Value="edicionProveedor.Nit" /></div>
            <div class="campo"><label for="proveedores-edicionproveedor-contacto">Contacto</label><InputText id="proveedores-edicionproveedor-contacto" @bind-Value="edicionProveedor.Contacto" /></div>
            <div class="campo"><label for="proveedores-edicionproveedor-telefonooficina">Teléfono oficina</label><InputText id="proveedores-edicionproveedor-telefonooficina" @bind-Value="edicionProveedor.TelefonoOficina" /></div>
            <div class="campo"><label for="proveedores-edicionproveedor-direccion">Dirección</label><InputText id="proveedores-edicionproveedor-direccion" @bind-Value="edicionProveedor.Direccion" /></div>
            <div class="campo"><label for="proveedores-edicionproveedor-emailempresa">Email empresa</label><InputText id="proveedores-edicionproveedor-emailempresa" @bind-Value="edicionProveedor.EmailEmpresa" /></div>
            <div class="acciones-fila">
                <BotonIcono Icono="save" Tooltip="Guardar cambios" Etiqueta="Guardar cambios" Variante="primario" TipoBoton="submit" />
                <BotonIcono Icono="x" Tooltip="Cancelar" Etiqueta="Cancelar" OnClick="CancelarEdicion" />
            </div>
        </EditForm>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<Proveedor> proveedores = Array.Empty<Proveedor>();
    private Proveedor? seleccionado;
    private string pestanaActiva = "lista";

    private IReadOnlyList<PestanaItem> Pestanas => seleccionado is null
        ? new[] { new PestanaItem("lista", "Lista") }
        : pestanaActiva == "editar"
            ? new[] { new PestanaItem("lista", "Lista"), new PestanaItem("detalle", "Detalle"), new PestanaItem("editar", "Editar") }
            : new[] { new PestanaItem("lista", "Lista"), new PestanaItem("detalle", "Detalle") };

    private string textoBusqueda = "";
    private string filtroEstado = "A";
    private bool mostrarNuevo;
    private string? mensaje;
    private bool esMensajeError;

    private readonly ProveedorModelo nuevoProveedor = new();
    private readonly ProveedorModelo edicionProveedor = new();
    private Erp.Data.Pagos.ProveedorPago? datosPago;
    private Erp.Data.Pagos.ProveedorPago? pagoEdicion;
    private IReadOnlyList<Erp.Data.Caja.EntidadFinanciera> bancos = Array.Empty<Erp.Data.Caja.EntidadFinanciera>();

    protected override async Task OnInitializedAsync() => await BuscarAsync();

    private async Task<int?> ObtenerUsuIdActualAsync()
    {
        if (AuthenticationStateTask is null) return null;
        var estado = await AuthenticationStateTask;
        return estado.User.ObtenerUsuId();
    }

    private async Task BuscarAsync()
    {
        proveedores = await ProveedorRepository.ConsultarAsync(
            string.IsNullOrWhiteSpace(textoBusqueda) ? null : textoBusqueda,
            string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado);
    }

    private void MostrarFormularioNuevo()
    {
        mensaje = null;
        nuevoProveedor.Codigo = "";
        nuevoProveedor.NombreComercial = "";
        nuevoProveedor.Nit = null;
        nuevoProveedor.Contacto = null;
        nuevoProveedor.TelefonoOficina = null;
        nuevoProveedor.Direccion = null;
        nuevoProveedor.EmailEmpresa = null;
        mostrarNuevo = true;
    }

    private async Task CrearProveedorAsync()
    {
        try
        {
            if (!Erp.Data.General.NitValidador.EsValido(nuevoProveedor.Nit))
            {
                mensaje = Erp.Data.General.NitValidador.MensajeInvalido(nuevoProveedor.Nit);
                esMensajeError = true;
                return;
            }
            nuevoProveedor.Nit = Erp.Data.General.NitValidador.Formatear(nuevoProveedor.Nit);
            var usuId = await ObtenerUsuIdActualAsync();
            await ProveedorRepository.InsertarAsync(
                nuevoProveedor.Codigo, nuevoProveedor.NombreComercial, nuevoProveedor.Nit, nuevoProveedor.Contacto,
                nuevoProveedor.Direccion, nuevoProveedor.TelefonoOficina, nuevoProveedor.EmailEmpresa, usuId);
            mostrarNuevo = false;
            mensaje = "Proveedor creado correctamente.";
            esMensajeError = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task SeleccionarAsync(Proveedor proveedor)
    {
        seleccionado = proveedor;
        pestanaActiva = "detalle";
        mensaje = null;
        pagoEdicion = null;
        try { datosPago = await PagosRepository.ConsultarProveedorPagoAsync(proveedor.PrvId); }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); esMensajeError = true; }
    }

    private async Task IniciarEdicionPago()
    {
        if (seleccionado is null) return;
        try
        {
            if (bancos.Count == 0)
            {
                var tipoBanco = (await GeneralRepository.ConsultarTiposEntidadAsync()).FirstOrDefault(t => t.GeftDescripcion == "Banco");
                if (tipoBanco is not null) bancos = await GeneralRepository.ConsultarEntidadesAsync(tipoBanco.GeftId, soloActivas: true);
            }
            pagoEdicion = new Erp.Data.Pagos.ProveedorPago
            {
                PrvId = seleccionado.PrvId, FormaPago = datosPago?.FormaPago ?? "C", GefId = datosPago?.GefId, TipoCuenta = datosPago?.TipoCuenta,
                NumeroCuenta = datosPago?.NumeroCuenta, Titular = datosPago?.Titular
            };
            mensaje = null;
        }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); esMensajeError = true; }
    }

    private async Task GuardarPagoAsync()
    {
        if (pagoEdicion is null) return;
        try
        {
            await PagosRepository.GuardarProveedorPagoAsync(pagoEdicion, await ObtenerUsuIdActualAsync());
            datosPago = await PagosRepository.ConsultarProveedorPagoAsync(pagoEdicion.PrvId);
            pagoEdicion = null;
            mensaje = "Datos de pago guardados.";
            esMensajeError = false;
        }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); esMensajeError = true; }
    }

    private void IniciarEdicion()
    {
        if (seleccionado is null) return;
        edicionProveedor.NombreComercial = seleccionado.PrvNombreComercial;
        edicionProveedor.Nit = seleccionado.PrvNit;
        edicionProveedor.Contacto = seleccionado.PrvContacto;
        edicionProveedor.TelefonoOficina = seleccionado.PrvTelefonoOficina;
        edicionProveedor.EmailEmpresa = seleccionado.PrvEmailEmpresa;
        mensaje = null;
        pestanaActiva = "editar";
    }

    private void CancelarEdicion()
    {
        pestanaActiva = "detalle";
    }

    private async Task GuardarEdicionAsync()
    {
        if (seleccionado is null) return;
        try
        {
            if (!Erp.Data.General.NitValidador.EsValido(edicionProveedor.Nit))
            {
                mensaje = Erp.Data.General.NitValidador.MensajeInvalido(edicionProveedor.Nit);
                esMensajeError = true;
                return;
            }
            edicionProveedor.Nit = Erp.Data.General.NitValidador.Formatear(edicionProveedor.Nit);
            var usuId = await ObtenerUsuIdActualAsync();
            await ProveedorRepository.ActualizarAsync(
                seleccionado.PrvId, edicionProveedor.NombreComercial, edicionProveedor.Nit, edicionProveedor.Contacto,
                edicionProveedor.Direccion, edicionProveedor.TelefonoOficina, edicionProveedor.EmailEmpresa, usuId);
            mensaje = "Cambios guardados.";
            esMensajeError = false;
            await BuscarAsync();
            seleccionado = proveedores.FirstOrDefault(p => p.PrvId == seleccionado.PrvId) ?? seleccionado;
            pestanaActiva = "detalle";
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private async Task DesactivarAsync(Proveedor proveedor)
    {
        try
        {
            var usuId = await ObtenerUsuIdActualAsync();
            await ProveedorRepository.EliminarAsync(proveedor.PrvId, usuId);
            mensaje = "Proveedor desactivado.";
            esMensajeError = false;
            if (seleccionado?.PrvId == proveedor.PrvId)
            {
                seleccionado = null;
                pestanaActiva = "lista";
            }
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            mensaje = MensajesError.Traducir(ex);
            esMensajeError = true;
        }
    }

    private sealed class ProveedorModelo
    {
        [Required] public string Codigo { get; set; } = "";
        [Required] public string NombreComercial { get; set; } = "";
        public string? Nit { get; set; }
        public string? Contacto { get; set; }
        public string? TelefonoOficina { get; set; }
        public string? Direccion { get; set; }
        public string? EmailEmpresa { get; set; }
    }
}
