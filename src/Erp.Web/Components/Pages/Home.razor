@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@L("Inicio")</PageTitle>

<section class="inicio-hero">
    <div class="inicio-hero-texto">
        <p class="inicio-hero-etiqueta">@L("SISTEMA ERP")</p>
        <h1>@L("Bienvenido, {0}", nombreUsuario)</h1>
        <p class="inicio-hero-descripcion">
            @L("Plataforma integral para inventario, ventas, compras, bancos y contabilidad de Servicios Informáticos Integrados.")
        </p>
    </div>
    <img src="images/hero-erp.svg" alt="" class="inicio-hero-ilustracion" />
</section>

<section class="inicio-modulos">
    <h2>@L("Módulos")</h2>
    <div class="modulos-grid">
        <AuthorizeView Policy="Permiso:SEGURIDAD_USUARIO_ADMIN">
            <Authorized>
                <a href="usuarios" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="lock" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Seguridad")</span>
                    <span class="modulo-desc">@L("Usuarios, roles y permisos")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR">
            <Authorized>
                <a href="productos" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="package" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Inventario")</span>
                    <span class="modulo-desc">@L("Productos y existencias")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:VENTAS_FACTURA_CREAR,VENTAS_FACTURA_ANULAR">
            <Authorized>
                <a href="facturas" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="receipt" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Ventas / POS")</span>
                    <span class="modulo-desc">@L("Facturación a clientes")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:COMPRAS_DOCUMENTO_CREAR">
            <Authorized>
                <a href="compras" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="shopping-cart" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Compras")</span>
                    <span class="modulo-desc">@L("Compras a proveedores")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:CXC_ADMIN">
            <Authorized>
                <a href="cxc/estado-cuenta" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="wallet" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Cuentas por cobrar")</span>
                    <span class="modulo-desc">@L("Estado de cuenta, cobros, notas y antigüedad")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:CXP_ADMIN">
            <Authorized>
                <a href="cxp/estado-cuenta" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="banknote" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Cuentas por pagar")</span>
                    <span class="modulo-desc">@L("Estado de cuenta, pagos, notas y antigüedad")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:BANCOS_CAJA_ADMIN">
            <Authorized>
                <a href="caja" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="landmark" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Bancos")</span>
                    <span class="modulo-desc">@L("Caja, cortes y depósitos")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:RRHH_ADMIN">
            <Authorized>
                <a href="rrhh/empleados" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="briefcase" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("RRHH")</span>
                    <span class="modulo-desc">@L("Empleados y nómina")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:GENERAL_CONFIG_ADMIN">
            <Authorized>
                <a href="general/companias" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="settings" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("General")</span>
                    <span class="modulo-desc">@L("Compañías, parámetros y entidades financieras")</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:CONTABILIDAD_NOMENCLATURA_ADMIN">
            <Authorized>
                <a href="contabilidad/nomenclatura" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="bar-chart-2" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Contabilidad")</span>
                    <span class="modulo-desc">@L("Nomenclatura contable y cuentas de pólizas")</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <div class="modulo-card modulo-card-proximamente" aria-disabled="true">
                    <span class="modulo-icono"><Icono Nombre="bar-chart-2" Tamano="26" /></span>
                    <span class="modulo-titulo">@L("Contabilidad")</span>
                    <span class="modulo-badge">@L("Próximamente")</span>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string nombreUsuario = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null) return;
        var estado = await AuthenticationStateTask;
        nombreUsuario = estado.User.Identity?.Name ?? "";
    }
}
