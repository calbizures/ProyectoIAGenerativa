@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Inicio</PageTitle>

<section class="inicio-hero">
    <div class="inicio-hero-texto">
        <p class="inicio-hero-etiqueta">SISTEMA ERP</p>
        <h1>Bienvenido, @nombreUsuario</h1>
        <p class="inicio-hero-descripcion">
            Plataforma integral para inventario, ventas, compras, bancos y contabilidad
            de Servicios Informáticos Integrados.
        </p>
    </div>
    <img src="images/hero-erp.svg" alt="" class="inicio-hero-ilustracion" />
</section>

<section class="inicio-modulos">
    <h2>Módulos</h2>
    <div class="modulos-grid">
        <AuthorizeView Policy="Permiso:SEGURIDAD_USUARIO_ADMIN">
            <Authorized>
                <a href="usuarios" class="modulo-card">
                    <span class="modulo-icono"><Icono Nombre="lock" Tamano="26" /></span>
                    <span class="modulo-titulo">Seguridad</span>
                    <span class="modulo-desc">Usuarios, roles y permisos</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <div class="modulo-card modulo-card-proximamente">
            <span class="modulo-icono"><Icono Nombre="package" Tamano="26" /></span>
            <span class="modulo-titulo">Inventario</span>
            <span class="modulo-badge">Próximamente</span>
        </div>

        <div class="modulo-card modulo-card-proximamente">
            <span class="modulo-icono"><Icono Nombre="receipt" Tamano="26" /></span>
            <span class="modulo-titulo">Ventas / POS</span>
            <span class="modulo-badge">Próximamente</span>
        </div>

        <div class="modulo-card modulo-card-proximamente">
            <span class="modulo-icono"><Icono Nombre="shopping-cart" Tamano="26" /></span>
            <span class="modulo-titulo">Compras</span>
            <span class="modulo-badge">Próximamente</span>
        </div>

        <div class="modulo-card modulo-card-proximamente">
            <span class="modulo-icono"><Icono Nombre="landmark" Tamano="26" /></span>
            <span class="modulo-titulo">Bancos</span>
            <span class="modulo-badge">Próximamente</span>
        </div>

        <div class="modulo-card modulo-card-proximamente">
            <span class="modulo-icono"><Icono Nombre="bar-chart-2" Tamano="26" /></span>
            <span class="modulo-titulo">Contabilidad</span>
            <span class="modulo-badge">Próximamente</span>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string nombreUsuario = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null) return;
        var estado = await AuthenticationStateTask;
        nombreUsuario = estado.User.Identity?.Name ?? "";
    }
}
