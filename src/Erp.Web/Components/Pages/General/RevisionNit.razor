@page "/general/revision-nit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permiso:GENERAL_NIT_REVISION,GENERAL_CONFIG_ADMIN")]
@using Erp.Data.General
@inject IGeneralRepository GeneralRepository

<PageTitle>@L("Revisión de NIT")</PageTitle>

<div class="pagina-encabezado">
    <h1>@L("Revisión de NIT")</h1>
    <p>@L("Registros grabados antes de la validación del NIT (módulo 11) y del CUI/DPI que no la cumplen. Se pueden seguir usando, pero al editarlos la pantalla pide corregir el dato. C/F y los clientes del extranjero no se revisan.")</p>
</div>

@if (mensaje is not null)
{
    <p class="mensaje-error" role="alert">@Textos.Mensaje(mensaje)</p>
}

<div class="barra-herramientas">
    <select @bind="filtroTipo" aria-label="@L("Tipo de registro")">
        <option value="">@L("Todos ({0})", registros.Count)</option>
        @foreach (var g in registros.GroupBy(r => r.Tipo).OrderBy(g => g.Key))
        {
            <option value="@g.Key">@g.Key (@g.Count())</option>
        }
    </select>
    <input placeholder="@L("Buscar por código, nombre o valor")" aria-label="@L("Buscar")" @bind="texto" @bind:event="oninput" />
    <span class="barra-herramientas-separador"></span>
    <BotonIcono Icono="refresh-cw" Tooltip="@L("Volver a revisar")" Etiqueta="@L("Actualizar")" OnClick="CargarAsync" />
</div>

@if (cargando)
{
    <p class="estado-vacio">@L("Revisando…")</p>
}
else if (registros.Count == 0)
{
    <p class="estado-vacio mensaje-ok">@L("Todos los NIT y DPI grabados son válidos.")</p>
}
else
{
    <table class="tabla-datos">
        <thead><tr><th class="col-estado">@L("Tipo")</th><th class="col-codigo">@L("Código")</th><th>@L("Nombre")</th><th class="col-estado">@L("Dato")</th><th class="col-codigo">@L("Valor grabado")</th><th class="col-acciones">@L("Corregir")</th></tr></thead>
        <tbody>
            @if (!Visibles.Any())
            {
                <tr><td colspan="6" class="doc-tabla-vacia">@L("Ningún registro coincide con el filtro.")</td></tr>
            }
            @foreach (var r in Visibles)
            {
                <tr>
                    <td class="col-estado">@r.Tipo</td>
                    <td class="col-codigo">@r.Codigo</td>
                    <td>@r.Nombre</td>
                    <td class="col-estado">@r.Dato</td>
                    <td class="col-codigo"><span class="texto-error">@(string.IsNullOrWhiteSpace(r.Valor) ? L("(vacío)") : r.Valor)</span></td>
                    <td class="col-acciones">
                        <a class="boton-icono" href="@r.Pantalla.TrimStart('/')" aria-label="@(L("Abrir {0} {1} para corregir el {2}", r.Tipo.ToLowerInvariant(), r.Codigo, r.Dato))">
                            <Icono Nombre="pencil" Tamano="16" /><span class="boton-icono-tip" role="tooltip">@L("Abrir {0} (código {1})", r.Tipo.ToLowerInvariant(), r.Codigo)</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<NitRevision> registros = Array.Empty<NitRevision>();
    private string filtroTipo = "";
    private string texto = "";
    private bool cargando = true;
    private string? mensaje;

    private IEnumerable<NitRevision> Visibles => registros.Where(r =>
        (filtroTipo.Length == 0 || r.Tipo == filtroTipo)
        && (texto.Length == 0 || r.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase)
            || r.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
            || (r.Valor ?? "").Contains(texto, StringComparison.OrdinalIgnoreCase)));

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        mensaje = null;
        try { registros = await GeneralRepository.ConsultarNitRevisionAsync(); }
        catch (Exception ex) { mensaje = MensajesError.Traducir(ex); }
        finally { cargando = false; }
    }
}
