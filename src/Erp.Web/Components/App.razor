<!DOCTYPE html>
<html lang="@Textos.CodigoIdioma" data-theme="@TemaHtml">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1b4c" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Erp.Web.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="components-reconnect-modal" role="alertdialog" aria-live="assertive" aria-label="@L("Conexión con el servidor")">
        <div class="reconexion-dialogo">
            <div class="reconexion-mensaje reconexion-intentando">
                <p>@L("Se perdió la conexión con el servidor. Intentando reconectar…")</p>
            </div>
            <div class="reconexion-mensaje reconexion-fallida">
                <p>@L("No se pudo reconectar con el servidor.")</p>
                <button type="button" class="boton-icono boton-icono-primario boton-icono-con-etiqueta" onclick="Blazor.reconnect()">@L("Reintentar")</button>
            </div>
            <div class="reconexion-mensaje reconexion-rechazada">
                <p>@L("La sesión con el servidor terminó. Recargue la página para continuar.")</p>
                <button type="button" class="boton-icono boton-icono-primario boton-icono-con-etiqueta" onclick="location.reload()">@L("Recargar página")</button>
            </div>
        </div>
    </div>
    @* Antes de blazor.web.js: su aviso del botón Atrás debe correr primero. *@
    <script src="js/tema.js"></script>
    <script src="js/cambios.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/graficos.js"></script>
    <script src="js/accesibilidad.js"></script>
    <script src="js/guardado.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Tema elegido en el menú (cookie erp-tema); sin elección, el del sistema.
    private string? TemaHtml => HttpContext?.Request.Cookies[Textos.CookieTema] switch
    {
        "oscuro" => "dark",
        "claro" => "light",
        _ => null
    };
}
