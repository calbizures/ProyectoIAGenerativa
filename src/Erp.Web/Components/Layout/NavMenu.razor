                    <NavLink href="roles" class="sidebar-hijo-link">@L("Roles")</NavLink>
                    <NavLink href="permisos" class="sidebar-hijo-link">@L("Permisos")</NavLink>
                </SidebarNodo>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR,INVENTARIO_FISICO,INVENTARIO_CARGA_INICIAL,INVENTARIO_TRASLADO_ENVIAR,INVENTARIO_TRASLADO_RECIBIR,INVENTARIO_REORDEN">
            <Authorized>
                <SidebarNodo Titulo="@L("Inventario")" IconoNombre="package" Rutas="@(new[] { "productos", "caracteristicas", "tipos-caracteristica", "existencias", "precios", "bodegas", "unidades-medida", "inventario" })">
                    <AuthorizeView Policy="Permiso:INVENTARIO_PRODUCTO_CREAR,INVENTARIO_PRODUCTO_EDITAR" Context="productosContexto">
                        <Authorized>
                            <NavLink href="productos" class="sidebar-hijo-link">@L("Productos")</NavLink>
                            <NavLink href="caracteristicas" class="sidebar-hijo-link">@L("Características")</NavLink>
                            <NavLink href="tipos-caracteristica" class="sidebar-hijo-link">@L("Tipos de característica")</NavLink>
                            <NavLink href="existencias" class="sidebar-hijo-link">@L("Existencias")</NavLink>
                            <NavLink href="precios" class="sidebar-hijo-link">@L("Precios")</NavLink>
                            <NavLink href="bodegas" class="sidebar-hijo-link">@L("Bodegas")</NavLink>
                            <NavLink href="unidades-medida" class="sidebar-hijo-link">@L("Unidades de medida")</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permiso:INVENTARIO_FISICO" Context="fisicoContexto">
                        <Authorized>
                            <NavLink href="inventario/fisico" class="sidebar-hijo-link">@L("Inventario físico")</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permiso:INVENTARIO_TRASLADO_ENVIAR,INVENTARIO_TRASLADO_RECIBIR" Context="trasladoContexto">
                        <Authorized>
                            <NavLink href="inventario/traslados" class="sidebar-hijo-link">@L("Traslados entre bodegas")</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permiso:INVENTARIO_CARGA_INICIAL" Context="inicialContexto">
                        <Authorized>
                            <NavLink href="inventario/carga-inicial" class="sidebar-hijo-link">@L("Inventario inicial")</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permiso:INVENTARIO_REORDEN" Context="reordenContexto">
                        <Authorized>
                            <NavLink href="inventario/rotacion" class="sidebar-hijo-link">@L("Rotación y reorden")</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </SidebarNodo>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="Permiso:VENTAS_FACTURA_CREAR,VENTAS_FACTURA_ANULAR,VENTAS_COTIZACION">
