@code {
    private bool menuAbierto;

    protected override void OnInitialized() => NavigationManager.LocationChanged += AlCambiarUbicacion;

    private void AlternarMenu() => menuAbierto = !menuAbierto;

    // En móvil el menú se cierra al elegir una pantalla, para mostrar el contenido.
    private void AlCambiarUbicacion(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!menuAbierto) return;
        menuAbierto = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavigationManager.LocationChanged -= AlCambiarUbicacion;
}
