@inherits LayoutComponentBase

<div class="app-shell">
    <NavMenu @rendermode="InteractiveServer" />

    <div class="app-contenido">
        <main class="app-main">
            @Body
        </main>
        <BarraEstado @rendermode="InteractiveServer" />
    </div>
</div>

<Avisos @rendermode="InteractiveServer" />

<div id="blazor-error-ui" role="alert">
    @L("Ocurrió un error inesperado.")
    <a href="" class="reload">@L("Recargar la página")</a>
    <a class="dismiss" aria-label="@L("Cerrar aviso")">✕</a>
</div>
