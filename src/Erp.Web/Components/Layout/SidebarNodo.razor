@implements IDisposable
@inject NavigationManager NavigationManager

<div class="sidebar-nodo">
    <button type="button"
            class="sidebar-nodo-header @(Disponible ? "" : "sidebar-nodo-inactivo") @(activo ? "sidebar-nodo-activo" : "")"
            aria-expanded="@(expandido ? "true" : "false")"
            @onclick="Alternar">
        <span class="sidebar-icono"><Icono Nombre="@IconoNombre" Tamano="17" /></span>
        <span class="sidebar-titulo">@Titulo</span>
        @if (!Disponible)
        {
            <span class="sidebar-badge">Próx.</span>
        }
        <span class="sidebar-chevron @(expandido ? "sidebar-chevron-abierto" : "")" aria-hidden="true">›</span>
    </button>

    @if (expandido)
    {
        <div class="sidebar-nodo-hijos">
            @if (Disponible)
            {
                @ChildContent
            }
            else
            {
                <span class="sidebar-proximamente">Módulo en construcción</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string IconoNombre { get; set; } = "";
    [Parameter] public bool Disponible { get; set; } = true;
    [Parameter] public bool ExpandidoInicial { get; set; }
    [Parameter] public string[] Rutas { get; set; } = Array.Empty<string>();
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool expandido;
    private bool activo;

    protected override void OnInitialized()
    {
        activo = ContieneRutaActual();
        expandido = ExpandidoInicial || activo;
        NavigationManager.LocationChanged += AlCambiarUbicacion;
    }

    private void Alternar() => expandido = !expandido;

    // La sección de la pantalla actual siempre queda abierta y resaltada, para
    // que el usuario sepa en qué módulo está; las demás conservan lo que el
    // usuario haya abierto o cerrado a mano.
    private void AlCambiarUbicacion(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        activo = ContieneRutaActual();
        if (activo) expandido = true;
        InvokeAsync(StateHasChanged);
    }

    private bool ContieneRutaActual()
    {
        var ruta = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return Rutas.Any(r => ruta == r || ruta.StartsWith(r + "/"));
    }

    public void Dispose() => NavigationManager.LocationChanged -= AlCambiarUbicacion;
}
