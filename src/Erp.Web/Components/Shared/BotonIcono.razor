@* Botón de acción con ícono + tooltip. Uso tipico en filas de tabla:
   <BotonIcono Icono="pencil" Tooltip="Editar" OnClick="() => Editar(fila)" />
   Para acciones principales (una sola vez por pantalla, ej. "Nuevo") pasar Etiqueta
   para mostrar además un texto junto al ícono.
   Para acciones que no se pueden deshacer (eliminar, anular) pasar Confirmacion con
   la pregunta: el primer clic la muestra junto al botón y la acción corre con "Sí".
   Mientras la acción está en curso el botón queda deshabilitado e ignora otros
   clics: un doble clic no graba dos veces la misma factura, pago o póliza. *@
@if (confirmando)
{
    <span class="confirmacion-en-linea" role="group" aria-label="@Confirmacion">
        <span class="confirmacion-texto">@Confirmacion</span>
        <button type="button" class="boton-mini boton-mini-peligro" @onclick="ConfirmarAsync" @ref="botonSi">Sí</button>
        <button type="button" class="boton-mini" @onclick="() => confirmando = false">No</button>
    </span>
}
else
{
    <button type="@TipoBoton"
            class="boton-icono boton-icono-@Variante @(string.IsNullOrEmpty(Etiqueta) ? "" : "boton-icono-con-etiqueta")"
            aria-label="@(string.IsNullOrEmpty(Etiqueta) ? Tooltip : null)"
            disabled="@(Deshabilitado || ejecutando)"
            aria-busy="@(ejecutando ? "true" : null)"
            @onclick="ClicAsync">
        <Icono Nombre="@Icono" Tamano="@TamanoIcono" />
        @if (!string.IsNullOrEmpty(Etiqueta))
        {
            <span class="boton-icono-etiqueta">@Etiqueta</span>
        }
        @if (string.IsNullOrEmpty(Etiqueta))
        {
            <span class="boton-icono-tip" aria-hidden="true">@Tooltip</span>
        }
    </button>
}

@code {
    [Parameter] public string Icono { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "";
    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Variante { get; set; } = "neutral";
    [Parameter] public string TipoBoton { get; set; } = "button";
    [Parameter] public int TamanoIcono { get; set; } = 17;
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public string? Confirmacion { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool confirmando;
    private bool ejecutando;
    private bool enfocarSi;
    private ElementReference botonSi;

    private async Task ClicAsync()
    {
        if (ejecutando) return;
        if (string.IsNullOrEmpty(Confirmacion))
        {
            await EjecutarAsync();
            return;
        }
        confirmando = true;
        enfocarSi = true;
    }

    private async Task ConfirmarAsync()
    {
        if (ejecutando) return;
        confirmando = false;
        await EjecutarAsync();
    }

    // La marca se pone antes del primer await, así un segundo clic que llegue
    // mientras la base responde ya la encuentra puesta.
    private async Task EjecutarAsync()
    {
        ejecutando = true;
        try { await OnClick.InvokeAsync(); }
        finally { ejecutando = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!enfocarSi) return;
        enfocarSi = false;
        try { await botonSi.FocusAsync(); } catch (InvalidOperationException) { }
    }
}
