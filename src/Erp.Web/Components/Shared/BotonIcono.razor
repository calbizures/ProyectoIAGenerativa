@* Botón de acción con ícono + tooltip. Uso tipico en filas de tabla:
   <BotonIcono Icono="pencil" Tooltip="Editar" OnClick="() => Editar(fila)" />
   Para acciones principales (una sola vez por pantalla, ej. "Nuevo") pasar Etiqueta
   para mostrar además un texto junto al ícono. *@
<button type="@TipoBoton"
        class="boton-icono boton-icono-@Variante @(string.IsNullOrEmpty(Etiqueta) ? "" : "boton-icono-con-etiqueta")"
        title="@Tooltip"
        aria-label="@Tooltip"
        disabled="@Deshabilitado"
        @onclick="OnClick">
    <Icono Nombre="@Icono" Tamano="@TamanoIcono" />
    @if (!string.IsNullOrEmpty(Etiqueta))
    {
        <span class="boton-icono-etiqueta">@Etiqueta</span>
    }
    <span class="boton-icono-tip">@Tooltip</span>
</button>

@code {
    [Parameter] public string Icono { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "";
    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Variante { get; set; } = "neutral";
    [Parameter] public string TipoBoton { get; set; } = "button";
    [Parameter] public int TamanoIcono { get; set; } = 17;
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
