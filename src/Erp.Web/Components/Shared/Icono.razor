@* Set de iconos propio, estilo trazo (24x24, stroke-width 2, sin relleno) para no
   depender de una librería externa. Agregar un nuevo case aquí cuando se necesite
   un ícono que todavía no existe. *@
<svg xmlns="http://www.w3.org/2000/svg" width="@Tamano" height="@Tamano" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     class="icono @CssClass" aria-hidden="true">
    @switch (Nombre)
    {
        case "plus":
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
            break;

        case "pencil":
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
            break;

        case "trash-2":
            <path d="M3 6h18" />
            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <line x1="10" y1="11" x2="10" y2="17" />
            <line x1="14" y1="11" x2="14" y2="17" />
            break;

        case "save":
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
            <path d="M17 21v-8H7v8" />
            <path d="M7 3v5h8" />
            break;

        case "x":
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
            break;

        case "refresh-cw":
            <path d="M21 12a9 9 0 0 0-15-6.7L3 8" />
            <path d="M3 3v5h5" />
            <path d="M3 12a9 9 0 0 0 15 6.7l3-2.7" />
            <path d="M21 21v-5h-5" />
            break;

        case "search":
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            break;

        case "filter":
            <path d="M4 4h16l-6 8v6l-4 2v-8Z" />
            break;

        case "download":
            <path d="M12 3v12" />
            <path d="M7 10l5 5 5-5" />
            <path d="M4 20h16" />
            break;

        case "upload":
            <path d="M12 21V9" />
            <path d="M7 14l5-5 5 5" />
            <path d="M4 20h16" />
            break;

        case "file-text":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" />
            <path d="M14 3v5h5" />
            <line x1="8.5" y1="13" x2="15.5" y2="13" />
            <line x1="8.5" y1="17" x2="13" y2="17" />
            break;

        case "receipt":
            <path d="M6 3h12v17l-2.5-1.5L13 20l-2.5-1.5L8 20l-2-1.5Z" />
            <line x1="9" y1="7" x2="15" y2="7" />
            <line x1="9" y1="11" x2="15" y2="11" />
            break;

        case "clipboard-list":
            <path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1Z" />
            <path d="M6 6h12v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1Z" />
            <line x1="9" y1="11" x2="15" y2="11" />
            <line x1="9" y1="15" x2="15" y2="15" />
            break;

        case "check-circle":
            <circle cx="12" cy="12" r="9" />
            <path d="M8.5 12.5l2.5 2.5 5-5.5" />
            break;

        case "check-check":
            <path d="M4 12.5l3.5 3.5L16 7" />
            <path d="M9 12.5l3.5 3.5L21 7" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l4 2" />
            break;

        case "ban":
            <circle cx="12" cy="12" r="9" />
            <line x1="6" y1="6" x2="18" y2="18" />
            break;

        case "copy":
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            break;

        case "printer":
            <path d="M6 9V3h12v6" />
            <rect x="4" y="9" width="16" height="8" rx="2" />
            <path d="M6 17v4h12v-4" />
            break;

        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
            break;

        case "user":
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;

        case "users":
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            break;

        case "user-plus":
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="8.5" cy="7" r="4" />
            <line x1="20" y1="8" x2="20" y2="14" />
            <line x1="17" y1="11" x2="23" y2="11" />
            break;

        case "user-cog":
            <circle cx="10" cy="8" r="4" />
            <path d="M2 21v-2a4 4 0 0 1 4-4h3" />
            <circle cx="18" cy="16" r="2.4" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" transform="rotate(60 18 16)" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" transform="rotate(120 18 16)" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" transform="rotate(180 18 16)" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" transform="rotate(240 18 16)" />
            <rect x="17.1" y="12.4" width="1.8" height="2" rx="0.4" transform="rotate(300 18 16)" />
            break;

        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;

        case "key-round":
            <circle cx="7" cy="15" r="4" />
            <path d="M9.5 12.5L20 2" />
            <path d="M17 5l2 2" />
            <path d="M14 8l2 2" />
            break;

        case "home":
            <path d="M3 11.5L12 4l9 7.5" />
            <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10" />
            break;

        case "package":
            <path d="M21 8l-9-5-9 5 9 5 9-5Z" />
            <path d="M3 8v9l9 5 9-5V8" />
            <path d="M12 13v9" />
            break;

        case "shopping-cart":
            <circle cx="9" cy="20" r="1.5" />
            <circle cx="18" cy="20" r="1.5" />
            <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 8H6" />
            break;

        case "landmark":
            <line x1="4" y1="21" x2="20" y2="21" />
            <line x1="6" y1="10" x2="6" y2="18" />
            <line x1="10" y1="10" x2="10" y2="18" />
            <line x1="14" y1="10" x2="14" y2="18" />
            <line x1="18" y1="10" x2="18" y2="18" />
            <path d="M4 10l8-6 8 6" />
            break;

        case "bar-chart-2":
            <line x1="6" y1="20" x2="6" y2="12" />
            <line x1="12" y1="20" x2="12" y2="4" />
            <line x1="18" y1="20" x2="18" y2="9" />
            break;

        case "credit-card":
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <line x1="2" y1="10" x2="22" y2="10" />
            break;

        case "info":
            <circle cx="12" cy="12" r="9" />
            <line x1="12" y1="11" x2="12" y2="16" />
            <line x1="12" y1="8" x2="12" y2="8.01" />
            break;
    }
</svg>

@code {
    [Parameter] public string Nombre { get; set; } = "";
    [Parameter] public int Tamano { get; set; } = 18;
    [Parameter] public string CssClass { get; set; } = "";
}
